@implements IAsyncDisposable
@inject AppSession Session
@inject PaletteSwitch Switch
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject GridFocus Focus

@* One flat surface with deep reach, rather than a menu bar that grows an item per feature.
   Everything stays reachable in two keystrokes without the nav having to name it. *@

@if (_open)
{
    @* A real <dialog>, opened with showModal(). The focus trap, Escape, the inert background, the
       ::backdrop and focus restoration on close are all the platform's rather than ours — this
       used to be a hand-rolled trap in palette.js plus an inert wrapper around the whole layout.
       aria-modal is deliberately absent: showModal() already conveys modality, and setting it by
       hand on a native dialog is redundant. *@
    <dialog class="palette" @ref="_dialog" aria-label="Command palette" @onclose="OnDialogClose">
        <input class="palette-input" @ref="_input" placeholder="Jump to a card, set, deck, or action…"
               @bind="_query" @bind:event="oninput" @bind:after="Search"
               @onkeydown="OnKeyDown" @onkeydown:stopPropagation="true" aria-label="Search" />

        @* Announced, not shown: the rows below are real buttons so they are already reachable and
           read out, but nothing told a screen-reader user that the list had changed as they typed. *@
        <p class="visually-hidden" aria-live="polite">
            @(_items.Count == 0 ? "No matches" : $"{_items.Count} {(_items.Count == 1 ? "match" : "matches")}")
        </p>

        @if (_items.Count == 0)
        {
            <p class="palette-empty">Nothing matches &ldquo;@_query&rdquo;.</p>
        }
        else
        {
            <div class="palette-list">
                @for (var i = 0; i < _items.Count; i++)
                {
                    var index = i;
                    var item = _items[i];
                    <button class="palette-item @(index == _selected ? "sel" : "")"
                            @onclick="() => Run(item)"
                            @onmouseenter="() => _selected = index">
                        @if (item.Thumb is { Length: > 0 } art)
                        {
                            <span class="pack-thumb deck-thumb" style="background-image:url('@art')"></span>
                        }
                        else
                        {
                            <span class="kind">@item.Kind</span>
                        }
                        <span class="lbl">@item.Label</span>
                        <span class="sub">@item.Sub</span>
                    </button>
                }
            </div>
        }

        <div class="palette-foot">
            <span><kbd>&uarr;</kbd><kbd>&darr;</kbd> Move</span>
            <span><kbd>enter</kbd> Go</span>
            <span><kbd>esc</kbd> Close</span>
        </div>
    </dialog>
}

@code {
    /// <summary>One row. A destination or an action, never both.</summary>
    private sealed record Item(string Kind, string Label, string? Sub, string? Href, Action? Do = null, string? Thumb = null);

    private bool _open;
    private string _query = "";
    private int _selected;
    private List<Item> _items = [];
    private ElementReference _input;
    private ElementReference _dialog;

    private DotNetObjectReference<CommandPalette>? _self;
    private bool _focusPending;
    private bool _disposed;

    private const int MaxPerGroup = 6;

    protected override void OnInitialized() => Switch.Requested += OnRequested;

    private void OnRequested() => _ = ToggleFromHotkey();

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (_disposed) return;

        if (first)
        {
            _self = DotNetObjectReference.Create(this);
            try { await JS.InvokeVoidAsync("ppPalette.register", _self); }
            catch { /* the palette is an accelerator; the app works without it */ }

            // Disposed while that was in flight: DisposeAsync has already unregistered and thrown
            // _self away, so take the registration back off rather than leave the hotkey pointing
            // at a component that is gone.
            if (_disposed)
            {
                try { await JS.InvokeVoidAsync("ppPalette.unregister"); }
                catch { /* the page may already be gone */ }
                return;
            }
        }

        if (_focusPending && _open)
        {
            _focusPending = false;
            // showModal() first: it is what puts the dialog in the top layer, makes the rest of
            // the document inert and records where focus came from. Focusing the input afterwards
            // just moves the caret within an already-open dialog.
            try { await JS.InvokeVoidAsync("ppPalette.open", _dialog, _input); }
            catch { /* the palette is an accelerator; the app works without it */ }
        }
    }

    [JSInvokable]
    public async Task ToggleFromHotkey()
    {
        if (_open) await Close(); else Open();
        await InvokeAsync(StateHasChanged);
    }

    private void Open()
    {
        _open = true;
        _query = "";
        _selected = 0;
        _focusPending = true;
        Search();
    }

    /// <summary>
    /// Closes the dialog itself. The browser then fires its close event, and <see cref="OnDialogClose"/>
    /// does the state teardown — so a dismissal we initiate and one the user triggers with Escape
    /// or a backdrop click take exactly the same path.
    /// </summary>
    private async Task Close()
    {
        if (!_open) return;
        try { await JS.InvokeVoidAsync("ppPalette.close", _dialog); }
        catch { ClearOpenState(); /* if the interop is gone, at least stop rendering it */ }
    }

    /// <summary>
    /// The dialog's own close event: Escape, a backdrop click, or <see cref="Close"/>. Focus goes
    /// back to whatever opened the palette without any help from us — the browser restores it as
    /// part of closing a modal dialog, which is what the old requestAnimationFrame dance was for.
    /// </summary>
    private void OnDialogClose() => ClearOpenState();

    private void ClearOpenState()
    {
        _open = false;
        _items = [];
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Escape":
                await Close();
                break;
            case "ArrowDown":
                if (_items.Count > 0) _selected = (_selected + 1) % _items.Count;
                break;
            case "ArrowUp":
                if (_items.Count > 0) _selected = (_selected - 1 + _items.Count) % _items.Count;
                break;
            case "Enter":
                if (_selected < _items.Count) await Run(_items[_selected]);
                break;
        }
    }

    private async Task Run(Item item)
    {
        await Close();
        // Closed first, so an action that changes state renders against a dismissed palette
        // rather than briefly showing stale results over the page it just changed.
        if (item.Do is not null) { item.Do(); return; }
        if (item.Href is { Length: > 0 } href) Nav.NavigateTo(href);
    }

    // ---- searching ---------------------------------------------------------------------

    private void Search()
    {
        _selected = 0;
        var q = _query.Trim();
        var items = new List<Item>();

        // With an empty box this is a menu, not a search: it has to show what the palette can
        // reach, or a first-time user sees a blank box and closes it.
        items.AddRange(Pages(q));
        items.AddRange(Actions(q));

        if (Session.Ready)
        {
            items.AddRange(Sets(q));
            items.AddRange(Decks(q));
            items.AddRange(ChaseListItems(q));
            // Cards last and only once there is something to match: 3,700 rows would bury
            // every other kind of result.
            if (q.Length >= 2) items.AddRange(Cards(q));
        }

        _items = items;
    }

    private static bool Matches(string text, string q) =>
        q.Length == 0 || text.Contains(q, StringComparison.CurrentCultureIgnoreCase);

    private static readonly (string Label, string Href, string Sub)[] PageList =
    [
        ("Log", "log", "Log a pack you just opened"),
        ("Collection", "collection", "Browse and mark what you own"),
        ("Packs", "packs", "Which pack to open next — the ranking"),
        ("Decks", "decks", "Saved decks and the builder"),
        ("Chases", "chase", "Your chase lists — cards you want, for any reason"),
        ("Wonder Pick", "wonder", "Take it or skip it"),
        ("Trades", "trades", "Which trade deserves your next stamina"),
        ("Wishlist", "board", "What to put in the game's 20 trade slots"),
        ("Resources", "resources", "Stamina, hourglasses and shinedust"),
        ("History", "history", "What you have opened"),
        ("Settings", "settings", "Targets, backup, appearance"),
    ];

    private IEnumerable<Item> Pages(string q) =>
        PageList.Where(p => Matches(p.Label, q) || Matches(p.Sub, q))
                .Select(p => new Item("Page", p.Label, p.Sub, p.Href));

    private IEnumerable<Item> Actions(string q)
    {
        var actions = new List<Item>
        {
            new("Action", "Import a deck from a screenshot", "Scan the in-game code", "decks/import"),
            // Three imports in three places, because the same five cards mean different things
            // depending on where you are. Named by the in-game screen rather than by what the app
            // does with it, since the screen is what the user is looking at.
            new("Action", "Import cards from a My Cards screenshot", "Read your card list off the game",
                "collection/screenshot"),
            new("Action", "Log a pack from a screenshot", "Reads the pack from the cards", "log"),
            new("Action", "Read a Wonder Pick from a screenshot", "Appraise the offer", "wonder"),
            new("Action", "Import a collection from another tracker", "Read a CSV export",
                "collection/import"),
            new("Action", "Export this collection as CSV", "For a spreadsheet or another tracker",
                "collection/export"),
            new("Action", "New deck", "Build one by hand", "decks/new"),
            new("Action", "New chase list", null, null, () => Nav.NavigateTo($"chase/{Session.CreateChaseList()}")),
            new("Action", $"Theme: {ThemeName(Session.Theme)}", "Switch light, dark or auto", null, () => _ = Session.SetThemeAsync(NextTheme())),
            new("Action", $"Colours: {SkinName(Session.Skin)}", "Switch paper or slate", null, () => _ = Session.SetSkinAsync(NextSkin())),
        };

        // Switching collections belongs here: with two or three alts it is a frequent move, and
        // the palette reaches it without the top bar growing a menu.
        if (Session.MultipleProfiles)
        {
            actions.Add(new("Action", "Compare collections", "Trades you could make with yourself", "compare"));

            foreach (var profile in Session.Profiles.Where(x => x.Id != Session.ActiveProfileId))
            {
                var id = profile.Id;
                actions.Add(new("Action", $"Switch to {profile.Name}",
                                $"{profile.Collection.Values.Sum()} cards", null,
                                () => Session.SwitchProfile(id)));
            }
        }

        // A route to the card grid that costs no counting of tab stops. Ctrl+K is advertised in
        // the nav, so it is discoverable.
        if (Focus.Available)
        {
            actions.Add(new("Action", "Jump to the cards",
                            "Keyboard entry: arrows to move, digits to set a count", null,
                            () => _ = Focus.FocusAsync()));
        }

        if (Session.CanUndo) actions.Add(new("Action", "Undo", "Ctrl+Z, anywhere", null, Session.Undo));
        if (Session.CanRedo) actions.Add(new("Action", "Redo", "Ctrl+Shift+Z", null, Session.Redo));

        return actions.Where(a => Matches(a.Label, q) || Matches(a.Sub ?? "", q));
    }

    private static string ThemeName(string theme) => theme switch
    {
        "light" => "Light",
        "dark" => "Dark",
        _ => "Auto"
    };

    private string NextTheme() => Session.Theme switch
    {
        "auto" => "light",
        "light" => "dark",
        _ => "auto"
    };

    private static string SkinName(string skin) => skin == "slate" ? "Slate" : "Paper";

    private string NextSkin() => Session.Skin == "slate" ? "paper" : "slate";

    private IEnumerable<Item> Sets(string q) =>
        Session.Index.BySet.Keys
            .Where(set => Matches(set, q) || Matches(Session.Sets.DisplayName(set), q))
            .OrderBy(set => set, StringComparer.Ordinal)
            .Take(MaxPerGroup)
            .Select(set => new Item("Set", $"{set} — {Session.Sets.DisplayName(set)}",
                $"{Session.Index.BySet[set].Count} cards", $"collection?set={set}"));

    private IEnumerable<Item> Decks(string q) =>
        Session.Profile.Decks
            .Where(d => Matches(d.Name, q))
            .Take(MaxPerGroup)
            .Select(d => new Item("Deck", d.Name, Sub(Session.MissingCount(d)), $"decks/{d.Id}"));

    private static string Sub(int missing) =>
        missing == 0 ? "Buildable" : $"{missing} card(s) missing";

    private IEnumerable<Item> ChaseListItems(string q) =>
        Session.ChaseLists
            .Where(w => Matches(w.Name, q))
            .Take(MaxPerGroup)
            .Select(w => new Item("Chase list", w.Name,
                $"{Session.MissingInChaseList(w)} of {Session.WantedTotal(w)} still missing",
                $"chase/{w.Id}"));

    /// <summary>
    /// Cards by name only. The deck builder is where rules text is searched; here the job is
    /// to reach a card you can already name, and scanning every card's text on each keystroke
    /// would make the palette feel slower than navigating by hand.
    /// </summary>
    private IEnumerable<Item> Cards(string q) =>
        Session.Index.All
            .Where(c => c.Name.Contains(q, StringComparison.CurrentCultureIgnoreCase))
            .DistinctBy(c => c.OwnershipKey)
            .OrderBy(c => c.Name.Length)           // an exact-ish match first
            .ThenBy(c => c.Name, StringComparer.CurrentCultureIgnoreCase)
            .Take(8)
            .Select(c => new Item("Card", c.Name,
                $"{c.Set} {c.Number} · {Owned(c)}", $"card/{c.Key}", null, c.ArtUrl));

    private string Owned(PocketCard card)
    {
        var n = Session.CountOf(card);
        return n == 0 ? "Not owned" : $"You own {n}";
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Switch.Requested -= OnRequested;
        try { await JS.InvokeVoidAsync("ppPalette.unregister"); }
        catch { /* the page may already be gone */ }
        _self?.Dispose();
    }
}
