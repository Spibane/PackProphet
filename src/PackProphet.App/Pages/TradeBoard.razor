@page "/board"
@implements IDisposable
@inject AppSession Session
@inject UiBusy Busy

<PageTitle>Wishlist · PackProphet</PageTitle>

@if (!Session.Ready)
{
    <Loading />
}
else
{
    <div class="page-head folded">
        <h1 class="title">Wishlist</h1>
        @* The slots, and what the plan was made under. The tuning decides which cards are even
           eligible, so a board read without it is a board you cannot account for -- and on a phone
           the controls are behind a button, where a badge reading "3" would say there are settings
           without saying what they are. *@
        <span class="subtitle">
            @GameRules.TradeBoardSlots slots, seen by anyone looking to trade
            &middot; @TuningSummary
        </span>

        <span class="actions">
            @* The plan is computed from what you owned when it ran, and you have just spent a
               minute retyping the board in the game. Re-running is the natural next act, and it
               was reachable only by changing a control and changing it back. *@
            <button class="btn btn-sm btn-outline-secondary" @onclick="Rerun"
                    aria-label="Work the plan out again" title="Work the plan out again">
                &#8635;
            </button>
        </span>
    </div>

    <PageShell Measure="PageShell.Width.Wide" Class="railed">

    <PageRail Id="board-rail" OpenLabel="Tuning" Count="@TuningCount">
        <div class="rail-group">
            <span class="ttl">Working toward</span>
            <ScopePicker Label="What the slots should work toward" Scope="@_scope" OnScope="OnScope" />
        </div>

        @* Three knobs, each with its own visible label. They wrapped the old bar to three rows at
           375px, which is what put them behind a disclosure; a column has room for all three and
           for the heading that says what they are.

           All three stay exposed, because no default suits everyone: a patient collector and
           someone who wants a trade this week want different boards. *@
        <div class="rail-group">
            <span class="ttl">Tuning</span>

        <select id="liquid" class="form-select form-select-sm"
                aria-label="How many board slots to keep for cards that attract an offer"
                @onchange="OnLiquid">
            @for (var n = 0; n <= 8; n++)
            {
                <option value="@n" selected="@(n == _liquidSlots)">
                    @(n == 0 ? "No slots kept for likely offers" : $"{n} slot{(n == 1 ? "" : "s")} kept for likely offers")
                </option>
            }
        </select>

        @* Parallel foils are diamond-rarity, so no rarity filter separates them, and they
           come only from a limited-time pack, which makes them among the dearest things
           here and prone to filling the board. Offered only when they are collected at
           all. *@
        @if (ShowFoilFilter)
        {
            <button class="btn btn-sm @(_foils == "with" ? "btn-secondary" : "btn-outline-secondary")"
                    @onclick="CycleFoils"
                    title="Foils are listed as the 1-3 diamond cards they are printed as. Exclude them if the game will not let you wishlist a foil printing.">
                @(_foils == "with" ? "Parallel foils included" : "Parallel foils left out")
            </button>
        }

        <select id="floor" class="form-select form-select-sm"
                aria-label="Leave out cards cheaper than this" @onchange="OnFloor">
            <option value="0" selected="@(_floor == 0)">However cheap the card</option>
            <option value="15" selected="@(_floor == 15)">Leave out under 15 packs</option>
            <option value="50" selected="@(_floor == 50)">Leave out under 50 packs</option>
            <option value="150" selected="@(_floor == 150)">Leave out under 150 packs</option>
        </select>
        </div>

        @* Not controls: the two pools a trade actually spends. They are here because the board is
           a list of trades you are inviting, and "can I afford to accept one" is answered by these
           two figures and nothing else on the page. A reading, so it goes last. *@
        <div class="rail-group">
            <span class="ttl">To spend</span>
            <div class="pool-read">
                <span class="lbl">Trade stamina</span>
                <span class="fig">@Session.Profile.Resources.Trade.Balance of @GameRules.StaminaCap</span>
            </div>
            <div class="pool-read">
                <span class="lbl">Shinedust</span>
                <span class="fig">@Session.Profile.Resources.Shinedust.ToString("N0")</span>
            </div>
        </div>
    </PageRail>

    @* One element for everything beside the rail, because .railed puts every child of the shell
       in the same grid cell -- so the content has to be one child or it stacks on top of itself.

       It carries `sections`, not the shell. The shell had it, and `.sections > h2` is a CHILD
       selector: with the headings a level further down inside this wrapper the rule matched
       nothing, and this page declared a heading style it was not getting. *@
    <div class="rail-main sections">


        @if (_plan is null)
        {
            <p class="text-body-secondary">Nothing to recommend yet.</p>
        }
        else if (_plan.Slots.Count == 0)
        {
            <p class="text-body-secondary">
                Nothing in this scope can go on the board: either it is complete, or
                everything left in it is untradeable.
                @if (_floor > 0)
                {
                    <span>The @_floor-pack floor may also be excluding everything; try "no floor".</span>
                }
            </p>
        }
        else
        {
            @* What to change, first and separately. The board is retyped by hand in the game, so
               the useful output is a couple of edits rather than twenty rows to transcribe. *@
            @if (_plan.Unchanged)
            {
                @* The same block as the branch below, because it fills the same slot: this is the
                   verdict when the answer is "nothing". It was the app's other verdict component,
                   so the page drew one shape when there were edits to make and a different one
                   when there were not. *@
                <div class="verdict-lead">
                    <span class="micro">What to change</span>

                    <div class="lead-head">
                        <div class="lead-text">
                            <h2 class="name take">Your board is already right</h2>
                            <p class="says">
                                All @_plan.Keep.Count slots still earn their place. Nothing to retype.
                            </p>
                        </div>
                    </div>
                </div>
            }
            else
            {
                @* The verdict is EDITS, not a ranking.
                   ==================================================================================
                   Every other Answer page recommends one thing out of many. This one recommends a
                   diff, because the board already exists and is retyped by hand in the game --
                   twenty rows of "here is your board" is a transcription job, and five edits is a
                   minute. So the headline counts the edits and the cost is stated in the only
                   currency that applies here, which is effort. *@
                <div class="verdict-lead">
                    <span class="micro">What to change</span>

                    <div class="lead-head">
                        <div class="lead-text">
                            <h2 class="name">@Edits(_plan)</h2>

                            <p class="says">
                                @if (_plan.Drop.Count > 0)
                                {
                                    <text>Take down <strong class="key">@Names(_plan.Drop.Select(c => c.Name))</strong>&mdash;</text>
                                    <text>@DropReason(_plan). </text>
                                }
                                @if (_plan.Add.Count > 0)
                                {
                                    <text>Put up <strong>@Names(_plan.Add.Select(x => x.Card.Name))</strong>. </text>
                                }
                                @if (_plan.Keep.Count > 0)
                                {
                                    <text>The other @_plan.Keep.Count still earn their slots.</text>
                                }
                            </p>

                            @* The cost, in the currency this page actually spends. Every figure on
                               the other Answer pages is packs or days; this one is typing. *@
                            <p class="then">
                                @EditTotal(_plan) in total, @Minutes(_plan) of retyping in the game.
                            </p>
                        </div>
                    </div>

                    @* Twenty boxes, the literal set this component was written for: the board HAS
                       twenty slots, they are numbered, and the picture is the point. Mostly solid
                       with three dashed gaps at the end says "nearly right" without anyone counting
                       to twenty, which no list of names can do.

                       Ten across in two rows rather than twenty in a line -- twenty in a line is a
                       line nobody reads the shape of. *@
                    <BoxStrip Label="The board, once you have typed it"
                              Clause="@SlotClause(_plan)" Columns="10">
                        @foreach (var (slot, n) in BoardSlots(_plan))
                        {
                            <Box State="@(slot is null ? Box.Kind.Dead : Box.Kind.Live)"
                                 Label="@n.ToString()">
                                @if (slot is not null)
                                {
                                    <span class="slot-art @(IsNew(slot, _plan) ? "new" : "")"
                                          style="@slot.Card.ArtVars"
                                          title="@slot.Card.Name" aria-hidden="true"></span>
                                    <span class="visually-hidden">@slot.Card.Name</span>
                                }
                            </Box>
                        }
                    </BoxStrip>

                    <div class="lead-actions">
                        <button class="btn btn-sm btn-primary" @onclick="AcceptPlan">
                            I have made these changes in the game
                        </button>
                    </div>
                </div>
            }

            @* Ordered by set and number rather than by rank: the board is entered by walking the
               in-game card list, and rank order would mean jumping between sets for every entry.
               Rank picks the cards; this order gets them typed. *@
            <h2>The board, in the order you will enter it</h2>
            <DataTable Label="In-game wishlist board">
                <thead>
                    <tr>
                        <th scope="col" data-pri="1">Card</th>
                        <th scope="col" data-pri="1">Set</th>
                        <th scope="col" data-pri="2">Rarity</th>
                        <th scope="col" class="num" data-pri="2" title="On average, how many packs before you get it, or the packs' worth of points to buy it outright, whichever is fewer">Packs to get it</th>
                        <th scope="col" data-pri="3" title="A pull figure is an average you could beat or miss badly; a points figure is a guarantee after that many packs of the set">How</th>
                        <th scope="col" class="num" data-pri="3">Dust to Trade</th>
                        <th scope="col" data-pri="3">A card to give?</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var slot in Transcription())
                    {
                        <tr class="@(OnBoard(slot) ? "" : "board-new")">
                            <td>
                                <a href="card/@slot.Card.Key">@slot.Card.Name</a>
                                @* No "add" badge: on a first run every row is an addition, and the
                                   summary above already names the changes. The row tint marks them
                                   without spending a word on each one. *@
                                @* Labelled by what is known — roughly how many copies are out
                                   there — rather than by a prediction about other players. See the
                                   note under the table for how weak the estimate is. *@
                                @if (slot.Band == BoardBand.Liquid)
                                {
                                    <span class="badge text-bg-secondary ms-1"
                                          title="Estimated from the card's drop rate and how long its set has been on sale, so more copies exist in other people's collections. It says nothing about whether anyone will part with one.">
                                        Widely Held
                                    </span>
                                }
                                @if (IsFoil(slot.Card))
                                {
                                    <span class="badge text-bg-info ms-1"
                                          title="A Deluxe-pack parallel foil, listed as its printed diamond rarity">
                                        Foil
                                    </span>
                                }
                            </td>
                            <td data-pri="1">@slot.Card.Set @slot.Card.Number</td>
                            <td data-pri="2">
                                <span class="glyphs @Session.Index.GlyphClass(slot.Card)" title="@Session.Index.Symbol(slot.Card)">
                                    @Session.Index.Glyphs(slot.Card)
                                </span>
                            </td>
                            <td class="num" data-pri="2">@Cost(slot.NormalCost)</td>
                            <td class="small text-body-secondary" data-pri="3">@How(slot)</td>
                            <td class="num" data-pri="3">@(slot.Dust > 0 ? slot.Dust.ToString("N0") : "free")</td>
                            <td class="small" data-pri="3">
                                @if (slot.SparesAtRarity > 0)
                                {
                                    @* What the number means, spelled out: these are your surplus
                                       cards at the same rarity, one of which the trade would cost
                                       you. A bare count next to a rarity glyph read as neither. *@
                                    <span title="You hold @slot.SparesAtRarity surplus @Session.Index.Symbol(slot.Card) card(s), and a trade would cost you one of them">
                                        Yes, @slot.SparesAtRarity spare
                                        @Session.Index.Symbol(slot.Card) to give
                                    </span>
                                }
                                else
                                {
                                    @* Flagged rather than removed: you may pull a spare tomorrow,
                                       and the request is what generates the offer. *@
                                    <span class="text-warning-emphasis"
                                          title="A trade is a swap at the same rarity, and you have no surplus @Session.Index.Symbol(slot.Card) to hand over">
                                        No spare @Session.Index.Symbol(slot.Card) to give
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </DataTable>

        @* Why the board is built this way, under the board rather than over it. Both paragraphs
           are worth reading once -- the game's wishlist advertises rather than tracks, and foils
           are listed at their printed rarity -- and neither is worth 378px above the answer on
           every later visit. The verdict and the "I have made these changes" button stay above:
           those are the answer and the action, not the explanation. *@
        <p class="small text-body-secondary">
            The game's wishlist is an advertisement: it makes other players offer you those cards.
            Slots cost nothing and never expire, so the board is the @GameRules.TradeBoardSlots
            <strong>tradeable cards you still want that cost the most to get any other way</strong>,
            with a few slots held back for cards someone plausibly has spare.
        </p>

        @if (ShowFoilFilter)
        {
            <p class="small text-body-secondary">
                <strong>Parallel foils</strong> are listed as the 1-3 diamond cards they are
                printed as, which is what decides trade eligibility and the dust price. If the game
                will not let you wishlist a foil printing, exclude them above.
            </p>
        }

            @* The limits of the one heuristic on this page. It is a guess about other players made
               from data about card drops, which is worth knowing before deciding whether to keep
               the slots reserved. *@
            @if (_plan.Slots.Any(s => s.Band == BoardBand.Liquid))
            {
                <p class="small text-body-secondary">
                    <strong>About the @_plan.Slots.Count(s => s.Band == BoardBand.Liquid)
                    &ldquo;widely held&rdquo; slots.</strong>
                    Some slots go to cards more copies of which likely exist: drop rate
                    times how long the set has been on sale. It is a weak guess: it cannot know who
                    still needs the card or would part with one. Set the reserve to
                    <strong>0</strong> above to rank purely by what a card costs you.
                </p>
            }

            @if (_plan.Slots.Any(s => s.SparesAtRarity == 0))
            {
                <p class="small text-body-secondary">
                    A trade needs a card of the same rarity to give back, so <em>no spare to
                    give</em> means you could not honour the request today. Kept anyway, since a
                    spare may turn up first.
                </p>
            }

            @if (_plan.Excluded.Count > 0)
            {
                <h2>Wanted, but cannot be listed</h2>
                <p class="small text-body-secondary">
                </p>
                <ul class="small text-body-secondary">
                    @foreach (var group in _plan.Excluded.GroupBy(x => x.Reason).OrderBy(g => g.Key))
                    {
                        @* Every name rather than the first few. These groups are small by nature —
                           only 3-star and Crown are excluded on rarity — so the full list costs a
                           line or two, and a truncated one would not say which cards are
                           affected. *@
                        <li>
                            <strong>@group.Count() card(s)</strong>: @group.Key
                            <div class="text-body-tertiary">
                                @string.Join(", ", group.Select(x => x.Card.Name)
                                                        .OrderBy(n => n, StringComparer.CurrentCultureIgnoreCase))
                            </div>
                        </li>
                    }
                </ul>
            }
        }
    </div>
    </PageShell>
}

@code {
    private string _scope = "everything";
    private BoardPlan? _plan;

    @* Read straight from saved settings rather than copied into local fields: all three change what
       is recommended, so a stale copy would put the table out of step with the swap list. *@
    private int _liquidSlots => Session.BoardLiquidSlots;

    private double _floor => Session.BoardMinimumCost;

    /// <summary>with / without / only, as on the Trades page.</summary>
    private string _foils => Session.BoardFoils;

    /// <summary>
    /// Where the three knobs are set, as one line for the collapsed panel. Only the parts that
    /// are not the default: a summary listing every setting at its default reads as clutter,
    /// where "3 slots for likely offers" reads as something you chose.
    /// </summary>
    private string TuningSummary
    {
        get
        {
            var parts = new List<string>();
            if (_liquidSlots > 0) parts.Add($"{_liquidSlots} slot{(_liquidSlots == 1 ? "" : "s")} for likely offers");
            if (ShowFoilFilter && _foils != "with") parts.Add("no parallel foils");
            if (_floor > 0) parts.Add($"nothing under {_floor:0} packs");
            return parts.Count == 0 ? "every card that fits, at any price" : string.Join(" \u00b7 ", parts);
        }
    }

    /// <summary>
    /// Only offered when foils are being collected: with the Parallel Foils chip off they are not
    /// in the target's demands, so nothing here could be a foil.
    /// </summary>
    private bool ShowFoilFilter => Session.FoilSets.Count > 0 && Session.FoilCopies > 0;

    private bool IsFoil(PocketCard card) =>
        Session.Odds?.FoilOwnershipKeys.Contains(card.OwnershipKey) == true;

    /// <summary>
    /// Which route the figure beside it came from. The distinction matters: an average is not a
    /// promise, and the points shop is a promise rather than an average.
    /// </summary>
    private static string How(BoardSlot slot) => slot.Unpullable
        ? "no other route"
        : slot.CostRoute == AcquisitionRoute.PackPoints
            ? "points shop, guaranteed"
            : "pulling, on average";

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnChanged;
        await Session.InitAsync();
        Rebuild();
    }

    private void OnChanged()
    {
        Rebuild();
        InvokeAsync(StateHasChanged);
    }

    private void Rebuild()
    {
        if (!Session.Ready) return;

        // A filter that has just disappeared must not go on filtering.
        if (!ShowFoilFilter && _foils != "with") Session.SetBoardSettings(foils: "with");

        _plan = Session.RecommendBoard(CurrentTarget(), _liquidSlots, _floor, _foils);
    }

    private ICompletionTarget CurrentTarget() => Session.TargetForScope(_scope);

    /// <summary>
    /// Selection order is by value; this is the order you will TYPE it in, walking the in-game
    /// card list set by set. Two different jobs, so two different orders.
    /// </summary>
    private IEnumerable<BoardSlot> Transcription() =>
        (_plan?.Slots ?? []).OrderBy(s => Session.Sets.SortKey(s.Card), StringComparer.Ordinal);

    private bool OnBoard(BoardSlot slot) =>
        Session.TradeBoard.Contains(slot.Card.OwnershipKey, StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// Records the board as the app recommended it. Deliberately a confirmation of work already
    /// done in the game rather than an "apply": nothing here can change the game, and a button
    /// implying otherwise would leave the two out of step.
    /// </summary>
    private Task AcceptPlan()
    {
        if (_plan is null) return Task.CompletedTask;

        var keys = _plan.Slots.Select(s => s.Card.OwnershipKey).ToArray();
        return Busy.RunAsync("Saving your board…", () =>
        {
            Session.SetTradeBoard(keys);
            Rebuild();
        });
    }

    private Task OnScope(ChangeEventArgs e)
    {
        _scope = e.Value?.ToString() ?? "everything";
        return Busy.RunAsync("Choosing slots…", Rebuild);
    }

    private Task OnLiquid(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var n)) Session.SetBoardSettings(liquidSlots: n);
        return Busy.RunAsync("Choosing slots…", Rebuild);
    }

    private Task CycleFoils()
    {
        var next = _foils switch { "with" => "without", "without" => "only", _ => "with" };
        Session.SetBoardSettings(foils: next);
        return Busy.RunAsync("Choosing slots…", Rebuild);
    }

    /// <summary>
    /// How many of the three knobs are narrowing the board, for the phone button's badge.
    ///
    /// The same three conditions <see cref="TuningSummary"/> spells out, deliberately: the badge
    /// and the words are the same fact at two lengths, and a "3" over a sentence naming two
    /// settings is the kind of disagreement nobody notices until they are wondering why the board
    /// is short.
    ///
    /// The scope is not one of them. It is the question the page is answering rather than a
    /// narrowing of it, and it is named in full in the subtitle.
    /// </summary>
    private int TuningCount =>
        (_liquidSlots > 0 ? 1 : 0)
        + (ShowFoilFilter && _foils != "with" ? 1 : 0)
        + (_floor > 0 ? 1 : 0);

    /// <summary>
    /// Work the plan out again from what is owned now.
    ///
    /// The plan is a reading of the collection at the moment it ran, and the act that follows it is
    /// retyping twenty slots in the game and then opening more packs. Until this button existed the
    /// only way to re-run was to change a control and change it back, which also changed the plan.
    /// </summary>
    private Task Rerun() => Busy.RunAsync("Choosing slots\u2026", Rebuild);

    private Task OnFloor(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var n)) Session.SetBoardSettings(minimumCost: n);
        return Busy.RunAsync("Choosing slots…", Rebuild);
    }

    /// <summary>The edit count, as the phrase the headline uses.</summary>
    private static string Edits(BoardPlan plan)
    {
        var parts = new List<string>(2);
        if (plan.Add.Count > 0) parts.Add($"{plan.Add.Count} to add");
        if (plan.Drop.Count > 0) parts.Add($"{plan.Drop.Count} to remove");
        return string.Join(", ", parts);
    }

    /// <summary>
    /// The edits as time at the keyboard, which is the cost this page actually asks of you.
    ///
    /// Rough on purpose, and said in words: the figure is not a measurement, it is a reassurance
    /// that this is a minute's work rather than the twenty-row transcription the page used to
    /// hand over. Ten seconds an entry is a slow, careful typist searching a card list.
    /// </summary>
    private static string Minutes(BoardPlan plan)
    {
        var seconds = (plan.Add.Count + plan.Drop.Count) * 10;
        return seconds < 60 ? "about half a minute"
             : seconds < 150 ? "a minute or two"
             : $"about {seconds / 60} minutes";
    }

    /// <summary>
    /// The edits counted rather than split. The headline says what KIND of edit -- "3 to add, 2 to
    /// remove" -- and this line says how much work that is, which is one number; "3 to add, 2 to
    /// remove in total" counts nothing and reads as the headline said twice.
    /// </summary>
    private static string EditTotal(BoardPlan plan)
    {
        var n = plan.Add.Count + plan.Drop.Count;
        return n == 1 ? "One edit" : $"{n} edits";
    }

    /// <summary>
    /// Names as a list a person would read out, with an "and" before the last, and cut off before
    /// it stops being a sentence.
    ///
    /// A first run on an empty collection asks for all twenty slots, and twenty names in a row is
    /// not prose -- it is the transcription job this page exists to replace, printed above the
    /// table that already lists them properly. Three and a count keeps it a sentence, and the
    /// table below is where you read the rest.
    /// </summary>
    private const int NamesShown = 3;

    private static string Names(IEnumerable<string> names)
    {
        var all = names.ToList();

        if (all.Count > NamesShown + 1)
        {
            var rest = all.Count - NamesShown;
            return $"{string.Join(", ", all.Take(NamesShown))} and {rest} more";
        }

        return all.Count switch
        {
            0 => "",
            1 => all[0],
            2 => $"{all[0]} and {all[1]}",
            _ => $"{string.Join(", ", all.Take(all.Count - 1))} and {all[^1]}",
        };
    }

    /// <summary>
    /// Why the drops are being dropped, in one clause.
    ///
    /// A diff that says "remove these two" and nothing else is asking to be trusted. The advisor
    /// drops a card for one of two reasons and they read very differently: you pulled it, so it is
    /// no longer wanted, or it fell under the floor you set.
    /// </summary>
    private string DropReason(BoardPlan plan)
    {
        var owned = plan.Drop.Count(c => Session.CountOf(c) > 0);

        if (owned == plan.Drop.Count)
            return plan.Drop.Count == 1 ? "you have pulled it since" : "you have pulled them since";

        if (owned == 0)
            return _floor > 0
                ? $"they fell under the {_floor:0}-pack floor"
                : "they no longer earn a slot";

        return "you have pulled some, and the rest no longer earn a slot";
    }

    /// <summary>
    /// The twenty slots as they will stand once the edits are made: what is kept, plus what is
    /// being added, then dashed boxes for whatever is left over.
    ///
    /// Ordered keep-then-add so the additions cluster at the end, which is what makes the strip
    /// read as a shape -- solid, then the new ones, then the gaps.
    /// </summary>
    private static IReadOnlyList<(BoardSlot? Slot, int Number)> BoardSlots(BoardPlan plan)
    {
        var filled = plan.Keep.Concat(plan.Add).Take(GameRules.TradeBoardSlots).ToList();

        return Enumerable.Range(0, GameRules.TradeBoardSlots)
            .Select(i => (i < filled.Count ? filled[i] : null, i + 1))
            .ToList();
    }

    private static bool IsNew(BoardSlot slot, BoardPlan plan) => plan.Add.Contains(slot);

    /// <summary>
    /// Why the strip has gaps, where it has them. Empty slots on a wishlist are not a fault -- the
    /// scope may simply not hold twenty tradeable cards worth asking for -- and a dashed box with
    /// no explanation reads as one.
    /// </summary>
    private static string? SlotClause(BoardPlan plan)
    {
        var filled = plan.Keep.Count + plan.Add.Count;
        if (filled >= GameRules.TradeBoardSlots) return null;

        return $"{GameRules.TradeBoardSlots - filled} slots stay empty: "
             + "nothing else in this scope is worth asking for";
    }

    /// <summary>
    /// Unbounded cost is stated in words. An infinity symbol reads as a bug, and what matters is
    /// that trading is the only way in — see the note in TradeBoardAdvisor on why no tradeable card
    /// is in that position today.
    /// </summary>
    private static string Cost(double packs) =>
        double.IsInfinity(packs) ? "no other route"
        : packs >= 1000 ? $"{packs:N0} packs"
        : packs >= 10 ? $"{packs:0} packs"
        : $"{packs:0.#} packs";

    public void Dispose() => Session.Changed -= OnChanged;
}
