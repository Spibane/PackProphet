@inject AppSession Session
@inject PaletteSwitch Palette
@implements IDisposable

<nav class="app-nav">
    <span class="brand">PackProphet</span>
    <NavLink class="nav-item" href="log">Log a pack</NavLink>
    <NavLink class="nav-item" href="collection" Match="NavLinkMatch.All">Collection</NavLink>
    <NavLink class="nav-item" href="packs">Which pack</NavLink>
    <NavLink class="nav-item" href="decks">Decks</NavLink>
    <NavLink class="nav-item" href="wonder">Wonder</NavLink>
    <NavLink class="nav-item" href="trades">Trades</NavLink>
    <NavLink class="nav-item" href="board">In-game list</NavLink>
    @* Only with something to compare. A link that always reads "Compare" and always says "you
       have one collection" is a permanent dead end in a nav that is already long. *@
    @if (Session.MultipleProfiles)
    {
        <NavLink class="nav-item" href="compare">Compare</NavLink>
    }
    <NavLink class="nav-item" href="resources">Resources</NavLink>
    <NavLink class="nav-item" href="wishlists">Wishlists</NavLink>
    <NavLink class="nav-item" href="history">History</NavLink>
    <NavLink class="nav-item" href="settings">Settings</NavLink>

    @* The hotkey alone would be invisible — and on a phone there is no Ctrl+K at all — so the
       palette gets a button. The shortcut is printed on it rather than hidden in a tooltip,
       which is how anyone learns it exists. *@
    <button class="palette-btn ms-auto" @onclick="() => Palette.Toggle()"
            title="Jump to a card, set, deck or action (Ctrl+K)" aria-label="Open the command palette">
        <span class="glyph" aria-hidden="true">
            <svg viewBox="0 0 16 16" width="14" height="14" focusable="false">
                <circle cx="7" cy="7" r="4.4" fill="none" stroke="currentColor" stroke-width="1.6" />
                <path d="M10.4 10.4L14 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            </svg>
        </span>
        <span class="hint">ctrl K</span>
    </button>

    @* Switching collections is frequent enough to belong in the chrome; creating and deleting
       are not, and live on the Settings page. Hidden entirely with one collection, so the
       majority who never make an alt pay nothing for the feature. *@
    @if (Session.MultipleProfiles)
    {
        <select class="profile-switch" @onchange="PickProfile"
                title="Active collection" aria-label="Active collection">
            @foreach (var profile in Session.Profiles)
            {
                <option value="@profile.Id" selected="@(profile.Id == Session.ActiveProfileId)">
                    @profile.Name
                </option>
            }
        </select>
    }

    @* One cycling button rather than three, because the nav has to survive a phone width.
       The label names the CURRENT setting, and the tooltip names what a tap will do — a
       cycling control is only usable if both are legible. *@
    <button class="theme-btn" @onclick="CycleTheme"
            title="Theme: @Label(Session.Theme). Tap for @Label(Next(Session.Theme))."
            aria-label="Theme: @Label(Session.Theme)">
        @* Drawn, not typed. The half-filled circle for "auto" was U+25D1, which plenty of
           system fonts do not carry — so it fell back to a tofu box. An inline SVG cannot be
           missing from a font. *@
        <span class="glyph" aria-hidden="true">
            <svg viewBox="0 0 16 16" width="14" height="14" focusable="false">
                @switch (Session.Theme)
                {
                    case "light":
                        <circle cx="8" cy="8" r="3.2" fill="currentColor" />
                        <g stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
                            <path d="M8 1.2v1.8M8 13v1.8M1.2 8h1.8M13 8h1.8" />
                            <path d="M3.2 3.2l1.3 1.3M11.5 11.5l1.3 1.3M12.8 3.2l-1.3 1.3M4.5 11.5l-1.3 1.3" />
                        </g>
                        break;
                    case "dark":
                        <path d="M10.8 1.8a6.2 6.2 0 1 0 0 12.4 7.2 7.2 0 0 1 0-12.4z" fill="currentColor" />
                        break;
                    default:
                        @* Half light, half dark: it follows the system. *@
                        <circle cx="8" cy="8" r="6" fill="none" stroke="currentColor" stroke-width="1.4" />
                        <path d="M8 2a6 6 0 0 1 0 12z" fill="currentColor" />
                        break;
                }
            </svg>
        </span>
        <span class="theme-label">@Label(Session.Theme)</span>
    </button>
</nav>

@code {
    protected override void OnInitialized() => Session.Changed += OnChanged;

    public void Dispose() => Session.Changed -= OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void PickProfile(ChangeEventArgs e)
    {
        if (e.Value?.ToString() is { Length: > 0 } id) Session.SwitchProfile(id);
    }

    // auto -> light -> dark -> auto. Auto is first because it is the default and the one most
    // people should stay on; the explicit modes are for overriding the OS deliberately.
    private static string Next(string theme) => theme switch
    {
        "auto" => "light",
        "light" => "dark",
        _ => "auto"
    };

    private Task CycleTheme() => Session.SetThemeAsync(Next(Session.Theme));

    private static string Label(string theme) => theme switch
    {
        "light" => "light",
        "dark" => "dark",
        _ => "auto"
    };

}
