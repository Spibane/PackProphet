@page "/card/{Key}"
@inject AppSession Session
@inject NavigationManager Nav
@inject NavHistory History
@implements IDisposable

<PageTitle>@(_card?.Name ?? "Card") · PackProphet</PageTitle>

@if (!Session.Ready)
{
    <Loading />
}
else if (_card is null)
{
    <PageShell Measure="PageShell.Width.Text">
        <p>No card with the code <code>@Key</code>.</p>
        <a class="btn btn-sm btn-primary" href="collection">Back to the Collection</a>
    </PageShell>
}
else
{
    @* Focused on arrival and listening for Escape, which is the keyboard route back. Without it,
       returning meant hunting for the back button: it is early in the tab order, but nothing says
       so, and after reading a card focus is hard to place.

       tabindex -1 so it can take focus without joining the tab order, and no focus ring: it is
       plumbing for the key handler rather than somewhere anyone chose to be. *@
    <div class="detail-keys" tabindex="-1" @ref="_root" @onkeydown="OnKey">

    <div class="page-head">
        <button class="btn btn-sm btn-outline-secondary" @onclick="Back"
                title="Back to @History.LastListPage, or press Escape">&larr; back</button>
        <h1 class="title">@_card.Name</h1>
        <span class="subtitle">@_card.Set&thinsp;@_card.Number</span>
        <span class="actions">
            @if (_rung is not null)
            {
                <span class="glyphs @_rung.GlyphClass" title="@_rung.Symbol">@_rung.Glyphs</span>
            }
            @if (_card.IsPromo)
            {
                <span class="badge text-bg-secondary">Promo</span>
            }
        </span>
    </div>

    <PageShell>
    <div class="card-detail">
        <div class="art">
            @* Background rather than <img>: a failed load leaves the placeholder instead of a
               broken-image gap, with no error handling needed. *@
            <div class="big-art @(Session.HasGoldFlair(_card) ? "gold-flair" : "")"
                 style="--art:url('@_card.ArtUrl')"
                 role="img" aria-label="@_card.Name"></div>

            @* Said in words as well as drawn: the ring alone does not explain itself, and being
               two copies away is worth knowing. *@
            @if (Session.HasGoldFlair(_card))
            {
                <p class="small mb-0 flair-note">
                    Gold flair earned: @_owned copies.
                </p>
            }
            @* Same rule as the flair itself, so the hint does not promise gold to a four-diamond
               card that can never earn it. *@
            else if (_rung is { GlyphClass: "diamond" } r && !_card.IsPromo
                     && r.Count <= GameRules.GoldFlairMaxDiamonds && _owned > 0)
            {
                <p class="small text-body-secondary mb-0">
                    @(GameRules.GoldFlairCopies - _owned) more for gold flair.
                </p>
            }

            <div class="own-row">
                <span class="label">You Own</span>
                <button class="step" @onclick="() => Bump(-1)"
                        disabled="@(_owned == 0)" aria-label="Remove one">&minus;</button>
                <span class="count">@_owned</span>
                <button class="step" @onclick="() => Bump(1)" aria-label="Add one">+</button>
            </div>

            @* Wanting a card is a separate fact from owning it, and this is the screen that has
               the card in hand, so the chase lists live here rather than requiring another search
               from the list side. *@
            <div class="want-row">
                <span class="label">Want It</span>

                @* The same heart the collection grid has, on the same list, doing the same one
                   thing. It comes first and it is always here, whether or not that list exists yet
                   -- on a phone the tile hearts are hidden, so this is the only route to wanting a
                   card, and "no chase lists yet" must not be the reason there is no way to say so.
                   The curated lists follow it, where they can carry counts. *@
                @{ var hearted = Session.WantedOnHeartList(_card.OwnershipKey) > 0; }
                <button class="btn btn-sm want-heart @(hearted ? "on" : "")"
                        @onclick="() => Session.ToggleWanted(_card.OwnershipKey)"
                        aria-pressed="@Aria.Flag(hearted)"
                        title="@(hearted ? $"On your {AppSession.WantListName} list. Tap to take it off" : $"Add to your {AppSession.WantListName} list")">
                    <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" focusable="false">
                        <path d="M8 14S1.6 9.8 1.6 5.9A3.4 3.4 0 0 1 8 4.3a3.4 3.4 0 0 1 6.4 1.6C14.4 9.8 8 14 8 14z"
                              fill="@(hearted ? "currentColor" : "none")"
                              stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                    </svg>
                    @AppSession.WantListName
                </button>

                @{
                    // The hearts' own list is the button above, not one of the rows below: two
                    // controls for one list, disagreeing about whether a tap means "on" or "one
                    // more", is how you get a heart that appears to do nothing.
                    var curated = Session.ChaseLists.Where(w => w.Id != Session.Profile.WantListId).ToArray();
                }
                @if (curated.Length > 0)
                {
                    @foreach (var list in curated)
                    {
                        var wanted = list.Wanted.GetValueOrDefault(_card.OwnershipKey);
                        @* Each tap adds a copy, so wanting four is four taps. The separate remove
                           exists because there is no ceiling to cycle past. *@
                        <span class="want-pair">
                            <button class="btn btn-sm @(wanted > 0 ? "btn-primary" : "btn-outline-secondary")"
                                    @onclick="() => Session.BumpWanted(list.Id, _card.OwnershipKey, 1)"
                                    title="@(wanted == 0 ? $"Add to {list.Name}" : $"Wanting {wanted} on {list.Name}. Tap for one more")">
                                @list.Name@(wanted > 0 ? $" ×{wanted}" : "")
                            </button>
                            @if (wanted > 0)
                            {
                                <button class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => Session.BumpWanted(list.Id, _card.OwnershipKey, -1)"
                                        title="Want one fewer on @list.Name"
                                        aria-label="Want one fewer on @list.Name">&minus;</button>
                            }
                        </span>
                    }
                }
            </div>

            @* Owning one copy counts for every set it appears in, so a reprint is not a second card
               to chase. Stated here because the number above would otherwise look wrong on a card
               listed in two sets. *@
            @if (_reprints.Count > 1)
            {
                <p class="small text-body-secondary mb-0">
                    Also listed as
                    @string.Join(", ", _reprints.Where(c => c.Key != _card.Key).Select(c => $"{c.Set} {c.Number}")).
                    One copy counts for all of them.
                </p>
            }
        </div>

        <div>
            @if (_fact is null)
            {
                <p class="text-body-secondary">
                    @if (!Session.FactsReady)
                    {
                        <span>Card detail is still downloading&hellip;</span>
                    }
                    else
                    {
                        @* Not a dead end: art, rarity, packs and routes are all still shown. *@
                        <span>No printed detail published for this card yet.</span>
                    }
                </p>
            }
            else
            {
                <h2 class="h6">@(_fact.IsPokemon ? "Pokémon" : "Trainer")</h2>
                <DataTable Label="Card stats" Fit="true">
                    <tbody>
                        @* One row however many types the card has. A dual-typed Pokémon gets a
                           pip and a word each, which is the one place in the app with room to
                           spell both out in full. *@
                        @if (_fact.Subtypes.Count > 0)
                        {
                            <tr>
                                <td>@(_fact.Subtypes.Count > 1 ? "Types" : "Type")</td>
                                <td>
                                    @foreach (var sub in _fact.Subtypes)
                                    {
                                        <span class="ty-one">
                                            @if (HasPip(sub))
                                            {
                                                <EnergyPip Type="@sub" />
                                            }
                                            @sub
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                        @if (_fact.Stage is { Length: > 0 } stage)
                        {
                            <tr>
                                <td>Stage</td>
                                <td>
                                    @stage
                                    @if (_fact.EvolvesFrom is { Length: > 0 } from)
                                    {
                                        <span class="text-body-secondary">(evolves from @from)</span>
                                        @* An evolution you cannot evolve is dead weight in a deck,
                                           and nothing else on the page would say so. *@
                                        @if (!OwnsAnyNamed(from))
                                        {
                                            <span class="badge text-bg-warning ms-1"
                                                  title="You own none. Any printing of it will do: the game evolves on the printed name.">
                                                You Own None
                                            </span>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                        @if (_fact.Health is int hp)
                        {
                            <tr><td>HP</td><td>@hp</td></tr>
                        }
                        @if (_fact.Weakness is { Length: > 0 } weak)
                        {
                            <tr><td>Weakness</td><td>@weak</td></tr>
                        }
                        @if (_fact.Retreat is int retreat)
                        {
                            <tr><td>Retreat</td><td>@retreat</td></tr>
                        }
                        @if (_fact.Artist is { Length: > 0 } artist)
                        {
                            <tr><td>Illustrator</td><td>@artist</td></tr>
                        }
                    </tbody>
                </DataTable>

                @if (_fact.HasAbility)
                {
                    <h2 class="h6">Ability: @_fact.Ability!.Name</h2>
                    <p class="small">@(_fact.Ability.Effect ?? "")</p>
                }

                @if (_fact.AttackList.Count > 0)
                {
                    <h2 class="h6">Attacks</h2>
                    @foreach (var atk in _fact.AttackList)
                    {
                        <div class="attack">
                            <span class="cost">
                                @foreach (var sym in atk.CostSymbols)
                                {
                                    <EnergyPip Type="@sym" />
                                }
                            </span>
                            <strong>@atk.Name</strong>
                            @* Printed damage, so a multiplier or bonus is not lost. *@
                            @if (atk.DamageLabel is { Length: > 0 } dmg)
                            {
                                <span class="dmg">@dmg</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(atk.Effect))
                            {
                                <div class="effect small text-body-secondary">@atk.Effect</div>
                            }
                        </div>
                    }
                }

                @if (_fact.CardText is { Length: > 0 } text)
                {
                    <h2 class="h6">Card text</h2>
                    <p class="small">@text</p>
                }
            }
        </div>

        <div class="routes">
            <h2 class="h6">How to get it</h2>
            @* Every route, including the ones that do not exist for this rarity, because the
               absence of a route is the answer as often as a price is: "you cannot trade for this"
               is what you came to find out when the card is a crown.

               A strip rather than the table this was, for exactly the reason BoxStrip exists. A
               table cell for an impossible route is blank, and blank reads as a figure that failed
               to load; a dashed box with the reason under it reads as the fact it is. The set is
               literal -- the game has these routes and no others -- which is the precondition.

               No bars. The four are priced in three currencies that do not exchange, and drawing
               them at one scale would invent a rate the game does not have. *@
            <BoxStrip Columns="@(_routes?.Options.Count ?? 4)">
                @foreach (var option in _routes?.Options ?? [])
                {
                    @* Only the closed routes carry a note in the box, and it is the short one this
                       page writes. The engine's own notes are whole sentences -- they have to be,
                       they are explaining a price -- and five of them inside five boxes is a wall
                       of prose in the one place on the page that exists to be compared at a
                       glance. They are kept, under the strip, where they read as prose. *@
                    <Box Label="@RouteName(option.Route)"
                         State="@(!option.Available ? Box.Kind.Dead
                                  : option == _routes?.Cheapest ? Box.Kind.Best
                                  : Box.Kind.Live)"
                         Figure="@RouteFigure(option)"
                         Unit="@RouteUnit(option)"
                         Note="@(option.Available ? null : BlockReason(option.Block))" />
                }
            </BoxStrip>

            @* The prose the boxes gave up, in full. Every word the table carried, and they are
               worth keeping: "points accrue while you open, so this is what you give up from a
               shared per-set budget, not extra packs" is the difference between a figure that
               means something and one that does not. *@
            @if ((_routes?.Options ?? []).Any(o => o.Available && o.Note is { Length: > 0 }))
            {
                <dl class="route-notes">
                    @foreach (var option in _routes!.Options.Where(o => o.Available && o.Note is { Length: > 0 }))
                    {
                        <dt>@RouteName(option.Route)</dt>
                        <dd>@option.Note</dd>
                    }
                </dl>
            }

            <p class="small text-body-secondary">
                Only <strong>pull</strong> and <strong>pack points</strong> are priced in packs.
                Shinedust and stamina are separate currencies with no exchange rate.
            </p>

            <h2 class="mt-3 h6">Packs that can give it</h2>
            @if (_packs.Count == 0)
            {
                <p class="small text-body-secondary">
                    None: @(_card.IsPromo ? "promos come from events, not packs." : "this card is not sold in packs.")
                </p>
            }
            else
            {
                <div class="pack-links">
                    @foreach (var packKey in _packs)
                    {
                        <span class="pack-link">
                            <span class="pack-thumb"
                                  style="--art:url('@Session.PackArtUrl(packKey)')"></span>
                            <span>
                                @packKey.Split(':')[1]
                                <span class="small text-body-secondary">@packKey.Split(':')[0]</span>
                                @if (Session.UnavailablePacks.Contains(packKey))
                                {
                                    <span class="badge text-bg-warning">Not on Sale</span>
                                }
                            </span>
                        </span>
                    }
                </div>
            }

            @if (_printingPoints is int printPoints)
            {
                <p class="small text-body-secondary mt-2 mb-0">
                    This printing costs <strong>@printPoints.ToString("N0")</strong> pack points.
                    Alternate arts are priced far above their base card, so each printing has its
                    own price.
                </p>
            }
        </div>
    </div>
    </PageShell>

    </div>@* .detail-keys *@
}

@code {
    [Parameter] public string Key { get; set; } = "";

    private PocketCard? _card;
    private CardFact? _fact;
    private CardRoutes? _routes;
    private RarityRung? _rung;
    private IReadOnlyList<string> _packs = [];
    private IReadOnlyList<PocketCard> _reprints = [];
    private int? _printingPoints;
    private int _owned;

    /// <summary>
    /// Everything EnergyPip can draw: the energies, plus the trainer kinds it renders as
    /// outlined rings.
    /// </summary>
    private static readonly HashSet<string> PipTypes = new(StringComparer.OrdinalIgnoreCase)
    {
        "Grass", "Fire", "Water", "Lightning", "Psychic", "Fighting", "Darkness", "Metal",
        "Dragon", "Colorless", "Item", "Supporter", "Tool", "Stadium"
    };

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnChanged;
        await Session.InitAsync();
        Load();
    }

    protected override void OnParametersSet() => Load();

    public void Dispose() => Session.Changed -= OnChanged;

    private void OnChanged()
    {
        Load();
        InvokeAsync(StateHasChanged);
    }

    private void Load()
    {
        if (!Session.Ready) return;

        _card = Session.Index.ByKey.GetValueOrDefault(Key);
        if (_card is null) return;

        _owned = Session.CountOf(_card);
        _fact = Session.FactFor(_card);
        _rung = Session.Index.Rung(_card);
        _routes = Session.Routes?.For(_card, Session.Owned);

        // Only openable packs: a promo's "Vol. 3" grouping records how it was handed out at an
        // event, not something anyone can choose to open.
        var openable = Session.Index.OpenablePackKeys.ToHashSet(StringComparer.Ordinal);
        _packs = Session.Index.PacksYielding(_card.OwnershipKey)
            .Where(openable.Contains)
            .OrderBy(p => p, StringComparer.Ordinal)
            .ToArray();

        _reprints = Session.Index.ByOwnershipKey.GetValueOrDefault(_card.OwnershipKey) ?? [];

        // Per PRINTING, not per identity: an art rare and its base card share attacks and stage
        // but not price, so an identity lookup would report the base card's.
        _printingPoints = Session.Facts.ForPrinting(_card)?.PackPoints;
    }

    private void Bump(int delta)
    {
        if (_card is null) return;
        Session.SetCount(_card, Math.Max(0, _owned + delta));
    }

    /// <summary>
    /// Returns to whichever page opened this one — the collection, a deck, the pack ranking, or
    /// History. Falls back to the collection on a deep link, where there is nothing to return to.
    /// </summary>
    private void Back() => Nav.NavigateTo(History.LastListPage);

    private ElementReference _root;
    private bool _focused;

    /// <summary>
    /// Focus the page once on arrival, so Escape works without clicking first. Also the right thing
    /// for a screen reader after a client-side navigation, which otherwise leaves the cursor parked
    /// on whatever was clicked on the previous page.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focused || _card is null) return;

        _focused = true;
        try { await _root.FocusAsync(); }
        catch { /* the element is gone, or the browser refused; Escape simply needs a click first */ }
    }

    /// <summary>
    /// Escape goes back, which is the only keyboard route out that does not involve hunting. The
    /// grid it returns to puts the cursor back on this card, so reading about one costs nothing.
    /// </summary>
    private void OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") Back();
    }

    private static bool HasPip(string subtype) => PipTypes.Contains(subtype);

    /// <summary>
    /// Whether any printing with this name is owned. By NAME rather than identity, and that is
    /// correct rather than a shortcut: the game evolves on the printed name, so every Charmeleon
    /// is as good as every other. The ambiguity that killed name-based decklist import does not
    /// apply to a question phrased this way.
    /// </summary>
    private bool OwnsAnyNamed(string name) =>
        Session.Index.All.Any(c =>
            string.Equals(c.Name, name, StringComparison.OrdinalIgnoreCase)
            && Session.CountOf(c) > 0);

    /// <summary>
    /// The figure for a route, in whichever currency prices it.
    ///
    /// One figure per box, because a box has one. Where a route costs two things -- a trade is
    /// shinedust AND a stamina -- the dust leads and the stamina goes in the note: they are not
    /// addable, so putting both on the figure line would read as a sum.
    /// </summary>
    private static string RouteFigure(RouteOption option) => option switch
    {
        { Available: false } => "",
        { PacksEquivalent: double packs } => Fmt(packs),
        { Dust: int dust } => dust.ToString("N0"),
        { Stamina: int stamina } => stamina.ToString("N0"),
        { Points: int points } => points.ToString("N0"),
        // Available and priced in nothing at all, which is Share: no card back, no dust, no
        // stamina. It still needs a figure -- a live box with a blank where its number goes is the
        // exact failure the dashed box exists to avoid, and "free" is what the note already says.
        _ => "free",
    };

    private static string RouteUnit(RouteOption option) => option switch
    {
        { Available: false } => "",
        { PacksEquivalent: not null } => "packs",
        { Dust: not null } => "shinedust",
        { Stamina: not null } => "stamina",
        { Points: not null } => "pack points",
        // "free" is its own unit. What it actually costs is a day's allowance, and that is in the
        // note rather than here, because a day is not a currency the other boxes are counted in.
        _ => "but 1 a day",
    };

    /// <summary>
    /// Why a route is closed, in the words a player would use.
    ///
    /// The engine names the reason rather than just refusing, and this is the whole point of
    /// spending a box on an unavailable route: "not tradeable" is an answer, and an empty cell is
    /// not. A trade's stamina rides along here too, since it is a second cost rather than a
    /// second price.
    /// </summary>
    private static string BlockReason(RouteBlock block) => block switch
    {
        RouteBlock.NotSoldInPacks => "not sold in packs",
        RouteBlock.NoPullRates => "no published pull rates",
        RouteBlock.NotTradeable => "not tradeable at this rarity",
        RouteBlock.NotShareable => "not shareable at this rarity",
        RouteBlock.NotInWonderPick => "never offered in a Wonder Pick",
        RouteBlock.NoDustPrice => "no shinedust price",
        _ => "unavailable",
    };

    private static string RouteName(AcquisitionRoute route) => route switch
    {
        AcquisitionRoute.Pull => "Open Packs",
        AcquisitionRoute.PackPoints => "Pack Points",
        AcquisitionRoute.Trade => "Trade",
        AcquisitionRoute.Share => "Share",
        _ => "Wonder Pick"
    };

    private static string Fmt(double packs) => Text.Fmt.Packs(packs);
}
