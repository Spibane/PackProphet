@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject GridFocus Focus

@* Virtualized card grid. Two JS modules do the heavy lifting:
     - gridsweep.js hit-tests with elementFromPoint, because touch's implicit pointer capture
       makes per-tile pointerenter useless for drag-select, and paints the selection in the DOM
       so a sweep costs zero Blazor re-renders.
     - imgloader.js caps in-flight image requests, because native loading="lazy" let a fast
       scroll queue thousands of requests and the CDN dropped the connection. *@

@* One row that stays, and a disclosure holding everything else.

   The rule this follows: hide controls freely, never hide active state that changes what the
   numbers mean. "286 cards" with an invisible filter applied is a lie, and so is a tap that
   removes a copy when the toolbar looks like it adds one. So search, the add/remove mode, a chip
   per active filter and the count are always on screen, and the controls that SET those things
   fold away with the layout options.

   details rather than a sheet or a modal: you want to watch the count move as you change a
   filter, and a modal is precisely what stops you. It also needs no JavaScript, no focus trap and
   no escape handling, and Find-in-page opens it on its own. *@
<div class="grid-toolbar">
    @Search

    @* The one or two filter states worth a tap rather than a trip into the disclosure. Passed in
       by the page, because which view you reach for most often differs from page to page. *@
    @Toggles

    @* An explicit add/remove mode, since there was otherwise no way to decrement on a touch
       device: shift-click is both undiscoverable and unavailable on a phone.

       Only where it governs something. It is read by exactly two paths -- a tap on a tile, and a
       release of a sweep -- so in list mode with the sweep unarmed it governs nothing at all: a
       tap on a row does nothing (every row carries its own -/+ buttons instead), and the keyboard
       has its own +/- keys that pass their direction explicitly and never consult this. It sat
       there anyway, labelled "Tapping a card adds a copy", next to rows where tapping does not.

       The label follows suit, because in list mode the thing it governs is the drag, not the tap. *@
    @if (AllowRemove && (!ListView || Sweeping))
    {
        @* Either half flips it, so a tap on the side already chosen still does something. With two
           states, "the other one" is unambiguous. *@
        <div class="btn-group btn-group-sm" role="group" aria-label="@Gesture action">
            <button class="btn @(Removing ? "btn-outline-secondary" : "btn-success")"
                    @onclick="() => Removing = !Removing" aria-pressed="@Aria.Flag(!Removing)"
                    title="@(Removing ? $"Switch back to adding a copy per {Gesture}" : $"{GestureVerb} adds a copy")">
                add
            </button>
            <button class="btn @(Removing ? "btn-danger" : "btn-outline-secondary")"
                    @onclick="() => Removing = !Removing" aria-pressed="@Aria.Flag(Removing)"
                    title="@(Removing ? $"{GestureVerb} removes a copy" : $"Switch to removing a copy per {Gesture}")">
                remove
            </button>
        </div>
    }

    @FilterChips

    <span class="ms-auto small text-body-secondary grid-count">
        @if (ListView && FactOf is not null && !FactsReady)
        {
            <span class="text-body-tertiary">loading card detail&hellip; &middot; </span>
        }
        @if (Removing && (!ListView || Sweeping))
        {
            <span class="text-danger-emphasis fw-semibold">@Gesture removes a copy &middot; </span>
        }
        @if (Summary is not null)
        {
            @Summary
        }
        else
        {
            @Cards.Count
            <text> cards</text>
        }
        @if (_imgFailed > 0)
        {
            <span class="text-danger-emphasis"> · @_imgFailed art failed</span>
        }
    </span>

    <span class="bar-sep" aria-hidden="true"></span>

    @* Promoted out of the disclosure it used to share with the layout options. List mode is not a
       preference among equals: it is the only view that carries a count per row, a typed count, the
       set and number, type, rarity and the printed text, and it is the answer to half of what a
       tile grid cannot do. Behind a summary reading "filters and layout" it was findable only by
       someone who already suspected it existed. The density toggle stays inside, because it only
       means anything once you are in list mode and this row has to survive a phone. *@
    <div class="btn-group btn-group-sm layout-switch" role="group" aria-label="Layout">
        <button class="btn @(ListView ? "btn-outline-secondary" : "btn-secondary")"
                @onclick="() => SetList(!ListView)" aria-pressed="@Aria.Flag(!ListView)"
                title="Card images in a grid">grid</button>
        <button class="btn @(ListView ? "btn-secondary" : "btn-outline-secondary")"
                @onclick="() => SetList(!ListView)" aria-pressed="@Aria.Flag(ListView)"
                title="Compact rows with the set and number, type, rarity, an exact count you can type into, and the printed text">
            list
        </button>
    </div>
</div>

<details class="toolbar-more">
    <summary>filters and layout</summary>
    <div class="toolbar-more-body">
    @if (Filters is not null)
    {
        @Filters
        <span class="bar-sep" aria-hidden="true"></span>
    }

    @* Density, list only. Compact fits far more cards on screen; roomy trades that for the
       attack and ability text inline, which compact can only show on hover. *@
    @if (ListView)
    {
        <div class="btn-group btn-group-sm" role="group" aria-label="Row height">
            <button class="btn @(Roomy ? "btn-outline-secondary" : "btn-secondary")"
                    @onclick="() => SetRoomy(!Roomy)" aria-pressed="@Aria.Flag(!Roomy)"
                    title="Short rows — most cards per screen">compact</button>
            <button class="btn @(Roomy ? "btn-secondary" : "btn-outline-secondary")"
                    @onclick="() => SetRoomy(!Roomy)" aria-pressed="@Aria.Flag(Roomy)"
                    title="Taller rows with attack and ability text shown in full">roomy</button>
        </div>
    }

    @* Hidden where it cannot do anything: in grid mode an unarmed mouse drag already
       range-selects, so on a device with no touch input the button would change nothing. It stays
       in list mode (where a mouse drag means "select this text" until armed) and on anything with
       a touchscreen (where a drag is a scroll until armed). *@
    @* Visible rather than revealed on focus, so keyboard entry can be found without already
       knowing about it. It is also the switch a pointer user wants when they stop tapping and
       start typing counts. *@
    <button class="btn btn-sm btn-outline-secondary" @onclick="() => FocusGridAsync()"
            title="Put the keyboard cursor on the cards. Arrow keys move, 0-9 set a count, enter adds one, minus removes one, i opens card detail, w wants it. Shift+move selects a range to add or remove in bulk.">
        keyboard
    </button>

    @if (ShowSweepToggle)
    {
        <button class="btn btn-sm @(Sweeping ? "btn-primary" : "btn-outline-primary")"
                @onclick="ToggleSweep"
                title="Drag across cards to @(Removing ? "remove" : "add") them in bulk">
            sweep @(Sweeping ? "on" : "off")
        </button>
    }
    @ToolbarExtras
    </div>
</details>

@* Which set is under your thumb, while you scroll. Only where the list spans more than one: with
   a single set selected the header two bars up already says it, and a strip repeating it would be
   one more row between the toolbar and the first card.

   Filled by js/gridspy.js rather than by a render, and empty until it has something to say -- the
   stylesheet drops an empty strip, so there is no attribute for Blazor's diff and the script to
   fight over. aria-hidden because it duplicates what every row already carries and changes on
   every scroll, which a screen reader would read out as a stream of set names nobody asked for. *@
<div class="grid-spy" @ref="_spyEl" aria-hidden="true">
    @* Two spans rather than one, so the script that fills this can set a background-image and a
       text node without ever writing markup: the wrapper's URL goes on one, the set's name on the
       other. Both are always present and empty until there is something to say. *@
    <span class="art" data-spy-art></span>
    <span class="txt" data-spy-text></span>
</div>

@* Back to the top.
   ==================================================================================
   A set is a couple of hundred cards and "every set" is three and a half thousand, so getting back
   to the controls -- the search box, the set picker, the filters -- was a flick and a wait. Every
   one of those controls is at the top of the page and nowhere else.

   Rendered always and shown by js/gridspy.js once there is enough scrolled past to be worth
   undoing: a button that appears at the top of an unscrolled page is a button that says nothing.
   It scrolls rather than animates, because a virtualised list of thousands smooth-scrolled is
   every row in between rendered and every image in between queued for nothing. *@
<button class="to-top" data-to-top type="button" @onclick="ScrollToTopAsync"
        title="Back to the top of the list" aria-label="Back to the top of the list">
    <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" focusable="false">
        <path d="M8 13V4M3.5 8.5 8 3.5l4.5 5" fill="none" stroke="currentColor"
              stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
</button>

@* "listing" is read by gridsweep.js, not by CSS: a mouse drag over list rows must obey the
   sweep toggle, while a drag over the tile grid need not. See the comment on onDown there. *@
@* tabindex, role and aria-activedescendant are set from js/gridkeys.js, which owns the cursor —
   see the note there on why a roving tabindex does not suit a virtualised grid. The container is
   the single tab stop for however many thousand cards are in scope. *@
<div class="grid-wrap @(ListView ? "listing" : "") @(Sweeping ? "sweeping" : "") @(Removing ? "removing" : "") @(PickedOf is null ? "" : "picking") @(OnWant.HasDelegate ? "wanting" : "")"
     id="@_gridId" role="grid"
     aria-label="@(ListView ? "Card list" : "Card grid") — arrow keys to move, digits to set a count"
     @ref="_gridEl">
    @* Named by the cursor as it moves, and after every count change. Outside the virtualised
       region so scrolling never destroys it mid-announcement. *@
    <div data-grid-live class="visually-hidden" aria-live="polite" aria-atomic="true"></div>

    @* Shown only while the grid has focus, so it costs a pointer user nothing and a keyboard user
       does not have to guess at the keys. *@
    <div class="kb-hint" aria-hidden="true">
        <span><kbd>&larr;</kbd><kbd>&rarr;</kbd><kbd>&uarr;</kbd><kbd>&darr;</kbd> move</span>
        <span><kbd>0</kbd>&ndash;<kbd>9</kbd> set count</span>
        <span><kbd>enter</kbd> add one</span>
        <span><kbd>&minus;</kbd> remove one</span>
        <span><kbd>shift</kbd>+move select a range, then <kbd>enter</kbd>/<kbd>&minus;</kbd> applies to all</span>
        <span><kbd>i</kbd> card detail, <kbd>esc</kbd> back</span>
        @if (OnWant.HasDelegate)
        {
            <span><kbd>w</kbd> want it</span>
        }
    </div>

    @if (Cards.Count == 0)
    {
        <p class="p-4 text-body-secondary">Nothing matches those filters.</p>
    }
    else if (ListView)
    {
        @* Sortable columns. The wider layout has room for information a tile cannot show, so
           it carries type, stage and an exact count. Narrow screens keep only the two that
           matter most — type and rarity — via CSS rather than a second code path. *@
        @* Every cell is always present, header and rows alike: the row is a CSS grid, so a
           conditionally-omitted cell would shift every column after it out of alignment. *@
        <div class="card-line head @(Roomy ? "roomy" : "")" role="row">
            <span class="c-thumb" role="columnheader"></span>
            @* Its own column, at the front. It was next to the -/+ buttons, where it read as a
               third stepper -- three small square buttons in a row, one of which does something
               completely different from the other two -- and it sat beside the count, which is the
               number it was most likely to be mistaken for. At the front it reads as a mark against
               the row, the way a starred message does.

               The header is named for a screen reader and blank on screen: a visible "want" over a
               column of hearts would be the only header in the row explaining an icon that already
               says it, but a column header with no accessible name at all is announced as nothing.
               The column does not sort, so it is not a button. *@
            <span class="c-want" role="columnheader"><span class="visually-hidden">want</span></span>
            <button class="c-nm" role="columnheader" @onclick="() => SortBy(ListSort.Name)">name @Caret(ListSort.Name)</button>
            <button class="c-id" role="columnheader" @onclick="() => SortBy(ListSort.Number)">set @Caret(ListSort.Number)</button>
            @* The column is a row of pips, so its heading is one too — a three-wedge key rather
               than a named type, which would read as a filter. The word joins it when there is
               room, and the accessible name is always "type" regardless of which are showing. *@
            <button class="c-ty" role="columnheader" @onclick="() => SortBy(ListSort.Type)">
                <span class="ty-key" aria-hidden="true">
                    <svg viewBox="0 0 16 16" focusable="false">
                        <path d="M8 8 L8 1 A7 7 0 0 1 14.06 11.5 Z" fill="#63bc5a" />
                        <path d="M8 8 L14.06 11.5 A7 7 0 0 1 1.94 11.5 Z" fill="#ff9c54" />
                        <path d="M8 8 L1.94 11.5 A7 7 0 0 1 8 1 Z" fill="#4d90d5" />
                    </svg>
                </span>
                <span class="ty-name" aria-hidden="true">type</span>
                <span class="visually-hidden">type</span>@Caret(ListSort.Type)
            </button>
            <button class="c-st" role="columnheader" @onclick="() => SortBy(ListSort.Stage)">stage @Caret(ListSort.Stage)</button>
            <button class="c-rr" role="columnheader" @onclick="() => SortBy(ListSort.Rarity)">rarity @Caret(ListSort.Rarity)</button>
            <button class="c-hp" role="columnheader" @onclick="() => SortBy(ListSort.Health)">hp @Caret(ListSort.Health)</button>
            <span class="c-a1" role="columnheader">attack 1</span>
            <span class="c-a2" role="columnheader">attack 2</span>
            <span class="c-ab" role="columnheader">ability</span>
            <span class="c-pick" role="columnheader"></span>
            <button class="c-ct" role="columnheader" @onclick="() => SortBy(ListSort.Count)">have @Caret(ListSort.Count)</button>
            <span class="c-acts" role="columnheader"></span>
        </div>

        @* ItemSize must match the rendered row height or Virtualize mis-sizes the scrollbar
           and the list jumps while scrolling. Both values live in app.css next to each other. *@
        <Virtualize Items="_flat" ItemSize="@(Roomy ? 95f : 51f)" Context="card" OverscanCount="8">
            @{
                var idx = _indexOf.GetValueOrDefault(card.Key, -1);
                var count = CountOf(card);
                var rung = RungOf?.Invoke(card);
                var picked = PickedOf?.Invoke(card) ?? 0;
                var fact = FactOf?.Invoke(card);
            }
            @* Keyed so a row is never reused for a different card. Without this Virtualize
               recycles the DOM and only rewrites data-src, which left the previous card's
               art on screen after switching sets. The loader also detects that case, but not
               creating it is the better fix. *@
            @* A row of cells, so the list reads as the data table it looks like. The label is what
               gridkeys.js announces as the cursor moves, so it has to be the whole sentence. *@
            <div @key="card.Key" class="card-line @(Roomy ? "roomy" : "") @(count > 0 ? "owned" : "")"
                 data-idx="@idx" data-group="@GroupLabelOf(card)"
                 data-group-art="@GroupArtFor(card)"
                 id="@($"{_gridId}-tile-{idx}")" role="row"
                 aria-label="@Describe(card, count)">
                @* The image is pointer-events:none so sweep hit-testing lands on the row, so
                   the hover target has to be this wrapper rather than the image itself. *@
                <span class="c-thumb @(Gold(card, count) ? "gold-flair" : "")"
                      data-tip-img="@card.ArtUrl" data-tip="@card.Name" role="gridcell">
                    <img class="thumb" data-src="@card.ArtUrl" alt="" decoding="async" draggable="false" />
                    <span class="art-wait" aria-hidden="true"></span>
                </span>

                @* Always rendered, empty or not: the row is a CSS grid, so a skipped cell shifts
                   every column after it -- which is exactly what it did the first time this went
                   in with the header cell and without this one. *@
                <span class="c-want" role="gridcell">
                    @if (OnWant.HasDelegate)
                    {
                        var wanted = WantedOf?.Invoke(card) ?? 0;
                        <button class="want @(wanted > 0 ? "on" : "")" @onclick="() => OnWant.InvokeAsync(card)"
                                @onclick:stopPropagation="true"
                                aria-pressed="@Aria.Flag(wanted > 0)"
                                aria-label="@(wanted > 0 ? $"On your want list: {card.Name}" : $"Add {card.Name} to your want list")"
                                title="@(wanted > 0 ? "On your want list" : "Add to your want list")">
                            <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" focusable="false">
                                <path d="M8 14S1.6 9.8 1.6 5.9A3.4 3.4 0 0 1 8 4.3a3.4 3.4 0 0 1 6.4 1.6C14.4 9.8 8 14 8 14z"
                                      fill="@(wanted > 0 ? "currentColor" : "none")"
                                      stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                            </svg>
                        </button>
                    }
                </span>
                @* The name is the link. A tile tap means "I own one more", so detail needs its
                   own target rather than stealing that gesture. *@
                <span class="c-nm" role="gridcell">
                    <a href="card/@card.Key" title="@card.Name"
                       @onclick:stopPropagation="true">@card.Name</a>
                </span>
                <span class="c-id" role="gridcell">@card.Set&thinsp;@card.Number</span>
                @{ var ty = TypeOf?.Invoke(card) ?? ""; }
                <span class="c-ty" role="gridcell">
                    @* Icon and label. The icon is the fast read; the word is unambiguous, scannable
                       and the only thing a screen reader has if the SVG is missed. Trainer kinds
                       have pips too, drawn as outlined rings so they never read as an energy. *@
                    @if (HasPip(ty))
                    {
                        <EnergyPip Type="@ty" />
                    }
                    <span class="ty-name">@ty</span>
                </span>
                <span class="c-st" role="gridcell">@(StageOf?.Invoke(card) ?? "")</span>
                <span class="c-rr" role="gridcell">
                    @if (rung is not null)
                    {
                        <span class="glyphs @rung.GlyphClass" title="@rung.Symbol">@rung.Glyphs</span>
                    }
                </span>
                <span class="c-hp" role="gridcell">@(fact?.Health?.ToString() ?? "")</span>

                @* Two attack columns, because two is the maximum a card can have. Fixed columns
                   rather than a run of items keep the second attack aligned down the whole list
                   instead of starting wherever the first one ended. *@
                @for (var slot = 0; slot < 2; slot++)
                {
                    var atk = fact is not null && fact.AttackList.Count > slot ? fact.AttackList[slot] : null;
                    <span class="@(slot == 0 ? "c-a1" : "c-a2")">
                        @if (atk is not null)
                        {
                            @* No hover tip in roomy: the row already shows what the tip
                               would say, and a tooltip repeating visible text is noise. *@
                            <span class="atk-item" data-tip="@(Roomy ? null : AttackTip(atk))"
                                  aria-label="@AttackTip(atk)">
                                <span class="atk-line">
                                    @foreach (var sym in atk.CostSymbols)
                                    {
                                        <EnergyPip Type="@sym" />
                                    }
                                    <span class="atk-name">@atk.Name</span>
                                        @* Printed damage, so a multiplier or bonus is not lost. *@
                                    @if (atk.DamageLabel is { Length: > 0 } dmg)
                                    {
                                        <span class="atk-dmg">@dmg</span>
                                    }
                                </span>
                                @* Always rendered, hidden by CSS when compact: one code path, and
                                   the roomy toggle then costs no re-render of the tree. *@
                                @if (!string.IsNullOrWhiteSpace(atk.Effect))
                                {
                                    <span class="atk-effect">@atk.Effect</span>
                                }
                            </span>
                        }
                    </span>
                }

                <span class="c-ab" role="gridcell">
                    @if (fact?.HasAbility == true)
                    {
                        <span class="atk-item ability" data-tip="@(Roomy ? null : AbilityTip(fact))"
                              aria-label="@AbilityTip(fact)">
                            <span class="atk-line"><span class="atk-name">@fact.Ability!.Name</span></span>
                            @if (!string.IsNullOrWhiteSpace(fact.Ability.Effect))
                            {
                                <span class="atk-effect">@fact.Ability.Effect</span>
                            }
                        </span>
                    }
                </span>

                <span class="c-pick" role="gridcell">
                    @if (picked > 0)
                    {
                        <span class="pick">+@picked</span>
                    }
                </span>

                @* Typeable where the page supports setting an absolute count, which is what makes
                   entering an existing collection bearable: click the field, then "9 ⏎ 12 ⏎ 2 ⏎"
                   straight down the list. Enter commits and moves to the row below. Falls back to
                   plain text where only relative changes make sense, as on the log-a-pack screen,
                   where a count is what you own rather than what you set. *@
                <span class="c-ct" role="gridcell">
                    @if (OnSet.HasDelegate)
                    {
                        <input class="c-count" data-count-input type="text" inputmode="numeric"
                               value="@(count > 0 ? count.ToString() : "")" placeholder="—"
                               @onchange="e => SetFrom(card, e)" @onclick:stopPropagation="true"
                               aria-label="Copies of @card.Name owned" />
                    }
                    else
                    {
                        <span>@(count > 0 ? count.ToString() : "—")</span>
                    }
                </span>
                <span class="c-acts" role="gridcell">
                    <button class="step" @onclick="() => Bump(card, -1)" @onclick:stopPropagation="true"
                            disabled="@(count == 0 && PickedOf is null)" aria-label="Remove one">&minus;</button>
                    <button class="step" @onclick="() => Bump(card, +1)" @onclick:stopPropagation="true"
                            aria-label="Add one">+</button>
                </span>
            </div>
        </Virtualize>
    }
    else
    {
        @* ItemSize is measured, not guessed — see the note on RowHeight and js/gridmetrics.js. *@
        <Virtualize Items="_rows" ItemSize="@RowHeight" Context="row" OverscanCount="3">
            @* The row's group is its FIRST card's. A row can straddle two sets, and the reader
               is asking "where am I", which the card at the left edge answers. *@

            @* Keyed on the row, not just on the tiles inside it, and that is what stops the whole
               grid blinking on a fast scroll.
               ==============================================================================
               Blazor matches keys only among siblings. With the key one level down, on the tiles,
               the row <div>s were matched POSITIONALLY: after a scroll of one row, item 0 is a
               different row of cards, so its div was reused and every keyed tile in it was a new
               key — destroy, rebuild — and the same again for item 1, item 2, all the way down.
               Every visible tile's DOM was thrown away on every window change.

               The <img> elements went with it. Their src is set by js/imgloader.js rather than by
               the renderer, so a fresh element comes back with data-src and nothing else: hidden,
               pending, waiting on the loader. All of them at once. Art that had been on screen for
               a minute vanished for a frame or two and came back, which is the flash.

               With the key here, a row still on screen is matched by identity and MOVED, DOM and
               loaded images intact. Only rows genuinely scrolling into view are built, which is
               what should have been happening all along. *@
            @* Guarded like the attributes below it: a row is never empty by construction, and
               the key must not be the thing that discovers otherwise. *@
            <div @key="@(row.Count > 0 ? (object)row[0].Card.Key : row)"
                 class="card-row" style="grid-template-columns:repeat(@Columns,1fr)" role="row"
                 data-group="@(row.Count > 0 ? GroupLabelOf(row[0].Card) : null)"
                 data-group-art="@(row.Count > 0 ? GroupArtFor(row[0].Card) : null)">
                @foreach (var (card, idx) in row)
                {
                    <CardTile @key="card.Key" Card="card" Index="idx"
                              DomId="@($"{_gridId}-tile-{idx}")"
                              Label="@Describe(card, CountOf(card))"
                              Count="CountOf(card)"
                              Gold="@Gold(card, CountOf(card))"
                              Picked="@(PickedOf?.Invoke(card) ?? 0)"
                              Wanted="@(WantedOf?.Invoke(card) ?? 0)"
                              OnWant="OnWant"
                              ShowInfo="@(!Sweeping)"
                              OnHold="OpenDetail"
                              OnActivate="Activate" />
                }
            </div>
        </Virtualize>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<PocketCard> Cards { get; set; } = [];
    [Parameter, EditorRequired] public Func<PocketCard, int> CountOf { get; set; } = _ => 0;

    /// <summary>Called with (card, delta). Sweeps report each card once with +1.</summary>
    [Parameter] public EventCallback<(PocketCard Card, int Delta)> OnAdjust { get; set; }

    /// <summary>
    /// Called with the cards a drag-sweep covered and the delta to apply, so the whole sweep
    /// is a single undo step.
    /// </summary>
    [Parameter] public EventCallback<(IReadOnlyList<PocketCard> Cards, int Delta)> OnSweep { get; set; }

    /// <summary>Whether this grid offers a remove mode. False where tapping means something else.</summary>
    [Parameter] public bool AllowRemove { get; set; } = true;

    /// <summary>
    /// Copies picked in the current action, shown on the tile separately from the owned
    /// count. Used when logging a pack, where a tap means "I pulled this" rather than
    /// "I own this".
    /// </summary>
    [Parameter] public Func<PocketCard, int>? PickedOf { get; set; }

    /// <summary>Compact rows instead of image tiles. Persisted, so the choice sticks.</summary>
    [Parameter] public bool ListView { get; set; }

    [Parameter] public EventCallback<bool> ListViewChanged { get; set; }

    /// <summary>Taller list rows carrying attack and ability text inline. List view only.</summary>
    [Parameter] public bool Roomy { get; set; }

    [Parameter] public EventCallback<bool> RoomyChanged { get; set; }

    /// <summary>
    /// What to call the group a card belongs to — in practice its set, named as the page names it.
    /// Optional: a grid holding one pack has nothing to group, and passing nothing turns the strip
    /// off entirely rather than showing one that never changes.
    /// </summary>
    [Parameter] public Func<PocketCard, string>? GroupOf { get; set; }

    /// <summary>
    /// Copies of a card wanted on the wishlist the page is currently pointing at. Optional: where
    /// it is absent no heart is drawn, which is right on a grid whose taps mean something other
    /// than owning — logging a pack.
    /// </summary>
    [Parameter] public Func<PocketCard, int>? WantedOf { get; set; }

    /// <summary>Toggle a card on that wishlist. The page owns which list "that" is.</summary>
    [Parameter] public EventCallback<PocketCard> OnWant { get; set; }

    /// <summary>
    /// Art to stand for the group a card belongs to — in practice a wrapper from its set, which is
    /// what the set picker uses for the same reason: nobody recognises "B2b", everybody recognises
    /// the pack. Optional, and null per card is fine: a promo set has no wrapper, and the strip
    /// then shows the name on its own rather than a gap where a picture should be.
    /// </summary>
    [Parameter] public Func<PocketCard, string?>? GroupArtOf { get; set; }

    /// <summary>Rarity rung, for drawing the game's own symbols instead of a code.</summary>
    [Parameter] public Func<PocketCard, RarityRung?>? RungOf { get; set; }

    /// <summary>
    /// Canonical set-then-number ordering, from the set catalogue. Without it this component
    /// sorted the "set" column by card NUMBER alone, which interleaved every set: A1-1, A2-1,
    /// A3-1. Falls back to the card's own set code so the grid still works unwired.
    /// </summary>
    [Parameter] public Func<PocketCard, string>? SortKeyOf { get; set; }

    private string OrderKey(PocketCard card) =>
        SortKeyOf?.Invoke(card) ?? $"{card.Set}{card.Number:D5}";

    /// <summary>
    /// Set an absolute owned count. Optional: where it is absent the list shows the count as
    /// text, because a page whose taps mean "one more came out of this pack" has no sensible
    /// answer to "set this to 12".
    /// </summary>
    [Parameter] public EventCallback<(PocketCard Card, int Count)> OnSet { get; set; }

    /// <summary>
    /// Reads a typed count. An empty field means zero — clearing it is how you say "none" — and
    /// anything unparseable is ignored rather than treated as zero, so a stray keystroke cannot
    /// silently wipe a row.
    /// </summary>
    private Task SetFrom(PocketCard card, ChangeEventArgs e)
    {
        var text = (e.Value?.ToString() ?? "").Trim();
        if (text.Length == 0) return OnSet.InvokeAsync((card, 0));

        return int.TryParse(text, out var n)
            ? OnSet.InvokeAsync((card, Math.Clamp(n, 0, MaxCopies)))
            : Task.CompletedTask;
    }

    /// <summary>The same ceiling the sweep uses, so both paths agree on what a typo looks like.</summary>
    /// <summary>
    /// The most copies a count field or a digit key can set. Public so a test can assert the clamp
    /// against the same number the component uses, rather than repeating 99 and drifting from it.
    /// </summary>
    public const int MaxCopies = 99;

    /// <summary>
    /// Whether a card has earned its gold flair. Derived from the rarity ladder this component
    /// already has rather than from a new delegate on every page: ten copies of a one- to
    /// three-diamond card that is not a promo, and nothing else.
    /// </summary>
    private bool Gold(PocketCard card, int count) =>
        RungOf?.Invoke(card) is { } rung
        && GameRules.EarnsGoldFlair(rung.Group, rung.Count, count, card.IsPromo);

    /// <summary>Energy for a Pokémon, trainer kind otherwise. Blank where data is missing.</summary>
    [Parameter] public Func<PocketCard, string>? TypeOf { get; set; }

    [Parameter] public Func<PocketCard, string>? StageOf { get; set; }

    /// <summary>Printed detail — attacks, ability, HP. Null where upstream has none.</summary>
    [Parameter] public Func<PocketCard, CardFact?>? FactOf { get; set; }

    /// <summary>False while card detail is still downloading, so blanks read as "not yet".</summary>
    [Parameter] public bool FactsReady { get; set; }

    [Parameter] public int Columns { get; set; } = 6;
    [Parameter] public RenderFragment? ToolbarExtras { get; set; }

    /// <summary>
    /// The page's filter controls, rendered at the start of the toolbar. Passed in rather than
    /// rendered by the page above the grid so that filtering and layout share one bar — see the
    /// comment in the markup.
    /// </summary>
    [Parameter] public RenderFragment? Filters { get; set; }

    /// <summary>
    /// Filter toggles for the always-on bar — the one or two states a page is switched between
    /// often enough that a trip into the disclosure is the wrong price. Not a replacement for the
    /// control in <see cref="Filters"/> that sets the same state: a page offering six ownership
    /// filters keeps the select, and promotes only the one that gets used every session.
    /// </summary>
    [Parameter] public RenderFragment? Toggles { get; set; }

    /// <summary>
    /// The search box. Kept out of <see cref="Filters"/> and out of the disclosure: it is the
    /// fastest way to narrow a set and belongs in reach, not behind a summary.
    /// </summary>
    [Parameter] public RenderFragment? Search { get; set; }

    /// <summary>
    /// What the always-on bar says about the content, replacing the card count.
    ///
    /// The count is the right answer where the grid holds a collection and the filters above it
    /// decide what is in scope. It is the wrong one where the scope is fixed and the number never
    /// moves — logging a pack, where "226 cards" is a fact about the pack rather than about what
    /// you are doing — so the page can say what it is actually tracking instead. Everything else in
    /// the bar (the mode warning, failed art) still shows: this replaces the count, not the strip.
    /// </summary>
    [Parameter] public RenderFragment? Summary { get; set; }

    /// <summary>
    /// One chip per filter currently applied. This is the half of filtering that may never hide —
    /// a count means something different with a filter on, so the page says which are on even
    /// while the controls that set them are folded away.
    /// </summary>
    [Parameter] public RenderFragment? FilterChips { get; set; }

    private List<List<(PocketCard Card, int Index)>> _rows = [];

    // Sweep hit-tests by data-idx, so list rows need the same positional index the grid uses.
    private Dictionary<string, int> _indexOf = [];

    // Virtualize needs an ICollection, which IReadOnlyList is not.
    private List<PocketCard> _flat = [];
    private ElementReference _gridEl;
    private ElementReference _spyEl;

    /// <summary>Whether the cards in scope span more than one group, and the strip is worth a row.</summary>
    private bool _multiGroup;

    /// <summary>
    /// The group to mark a row with, or null to mark nothing.
    ///
    /// Marking is the gate on the whole strip: with one set in scope the header two bars up already
    /// names it, and an unmarked grid leaves the script with nothing to read, so the strip stays
    /// empty and the stylesheet drops it. Cheaper than a conditional element, and it means the
    /// script attaches once for the life of the grid rather than appearing and disappearing with
    /// the filters.
    /// </summary>
    private string? GroupLabelOf(PocketCard card) =>
        GroupOf is not null && _multiGroup ? GroupOf(card) : null;

    /// <summary>Gated on the same thing: an unmarked row carries neither the name nor the art.</summary>
    private string? GroupArtFor(PocketCard card) =>
        GroupArtOf is not null && GroupOf is not null && _multiGroup ? GroupArtOf(card) : null;

    private IJSObjectReference? _sweep, _images, _metrics, _spy;
    private string _lastListSignature = "";
    private DotNetObjectReference<CardGrid>? _self;
    private IJSObjectReference? _keys;
    private bool _attached;

    /// <summary>
    /// Set by <see cref="DisposeAsync"/>, read after every await in <see cref="OnAfterRenderAsync"/>.
    /// Navigating away while a dynamic import is still in flight leaves a continuation that would
    /// otherwise go on using <c>_self</c> after it has been disposed, and serialising a disposed
    /// object reference throws out of the render loop.
    /// </summary>
    private bool _disposed;
    private int _imgFailed;
    private System.Threading.Timer? _statsTimer;

    private bool Sweeping { get; set; }

    /// <summary>When set, a tap or sweep removes a copy instead of adding one.</summary>
    private bool Removing { get; set; }

    /// <summary>
    /// What the add/remove mode governs here. In the tile grid it is the tap; in list mode a tap
    /// does nothing and only the sweep reads the mode, so calling it a tap would name a gesture
    /// that has no effect on the thing in front of you.
    /// </summary>
    private string Gesture => ListView ? "drag" : "tap";

    /// <summary>The same distinction as a sentence opener: "Dragging across cards", "Tapping a card".</summary>
    private string GestureVerb => ListView ? "Dragging across cards" : "Tapping a card";

    /// <summary>
    /// Shift-click and right-click are one-off inversions of the current mode, so a single
    /// mistaken count can be fixed without switching the whole grid to remove and back.
    /// </summary>
    private int DeltaFor(bool invert) => Removing ^ invert ? -1 : +1;

    /// <summary>
    /// The height of one row of tiles, as laid out. Measured from the DOM after the first paint
    /// and re-measured whenever the grid changes width or column count.
    ///
    /// It cannot be worked out from the parameters alone. A row is as tall as a tile is wide
    /// divided by the tile's aspect ratio, and the tile's width comes from the grid's, which C#
    /// does not know. A formula stood in for it and assumed a 1,000px grid: on a phone it claimed
    /// a row was two and a half times its real height, so Virtualize rendered a fraction of the
    /// rows the screen had room for, discovered the gap, and rendered again — on every scroll
    /// event. That is the flicker.
    ///
    /// <see cref="EstimatedRowHeight"/> covers the paints before there is a row to measure. Being
    /// wrong for one frame costs nothing; being wrong for every frame is the bug.
    /// </summary>
    private float RowHeight => _rowPx > 0 ? _rowPx : EstimatedRowHeight;

    /// <summary>
    /// A row's height worked out from the grid's width, used until a real row can be measured.
    ///
    /// This is the one place the tile's shape is restated in C#, and it is a fallback rather than
    /// the answer: Virtualize renders nothing until it believes something is visible, so there is
    /// always a first pass with no row in the DOM, and a background tab can hold it there. The
    /// numbers are .card-row's padding and gap and .card-tile's aspect ratio, from app.css. Being
    /// a pixel or two out here is harmless; the measurement replaces it as soon as one lands.
    ///
    /// Falls back again to a whole-window guess only when even the width is unknown, which means
    /// the element is not laid out yet.
    /// </summary>
    private float EstimatedRowHeight
    {
        get
        {
            var cols = Math.Max(1, Columns);
            if (_gridPx <= 0) return 1000f / cols * 1.42f + 8f;

            var tile = (_gridPx - 8f - 4f * (cols - 1)) / cols;
            return tile <= 0 ? 1f : tile * (512f / 367f) + 4f;
        }
    }

    private float _rowPx;
    private float _gridPx;

    /// <summary>The layout the current measurement belongs to, so a change of shape re-measures.</summary>
    private string _measuredFor = "";

    protected override void OnParametersSet()
    {
        // Detect a wholesale change of the card list (a different set, or a new filter) so
        // the image loader can be told to re-check rather than trusting per-element state.
        var signature = $"{Cards.Count}|{(Cards.Count > 0 ? Cards[0].Key : "")}|" +
                        $"{(Cards.Count > 0 ? Cards[^1].Key : "")}|{ListView}|{Roomy}";
        _listChanged = signature != _lastListSignature;
        _lastListSignature = signature;

        // Whether the content changed, as opposed to how it is laid out. Switching sets left the
        // scroll position where it was, so a new set opened halfway down itself; toggling grid and
        // list should keep your place, which is why layout is absent from this signature.
        var content = $"{Cards.Count}|{(Cards.Count > 0 ? Cards[0].Key : "")}|" +
                      $"{(Cards.Count > 0 ? Cards[^1].Key : "")}";
        _contentChanged = content != _lastContentSignature;
        _lastContentSignature = content;

        Rechunk();
    }

    private bool _listChanged;
    private bool _contentChanged;
    private string _lastContentSignature = "";

    /// <summary>
    /// A long press on a tile opens card detail. The tile detects the hold; navigating is this
    /// component's job, since the tile knows nothing about routing.
    /// </summary>
    private void OpenDetail(PocketCard card) => Nav.NavigateTo($"card/{card.Key}");

    /// <summary>
    /// Back to the top of the new list. Both scrollers are reset: the grid has its own, and the
    /// page's main element scrolls too on narrow screens where the bars stack.
    /// </summary>
    private async Task ScrollToTopAsync()
    {
        try { await JS.InvokeVoidAsync("ppScroll.toTop", _gridEl); }
        catch { /* cosmetic; never worth taking the grid down for */ }
    }

    private Task SetList(bool on) => ListViewChanged.InvokeAsync(on);

    private Task SetRoomy(bool on) => RoomyChanged.InvokeAsync(on);

    public enum ListSort { None, Name, Number, Type, Stage, Rarity, Count, Health }

    private ListSort _sort = ListSort.None;
    private bool _descending;

    private void SortBy(ListSort column)
    {
        if (_sort == column) _descending = !_descending;
        else { _sort = column; _descending = false; }
        Rechunk();
    }

    /// <summary>
    /// Hover text for an attack: the name, plus its effect when it has one.
    ///
    /// Not the energy cost or the damage. Both are already on screen — the cost as coloured pips,
    /// the damage as a number — so repeating them as "Lightning + Lightning + Lightning · 90
    /// damage" would bury the one thing the row cannot show. The name is kept because the column
    /// truncates it.
    /// </summary>
    private static string AttackTip(CardAttack atk)
    {
        var name = atk.Name ?? "Attack";
        return string.IsNullOrWhiteSpace(atk.Effect) ? name : $"{name}\n{atk.Effect}";
    }

    private static readonly HashSet<string> PipTypes = new(StringComparer.OrdinalIgnoreCase)
    {
        "Grass", "Fire", "Water", "Lightning", "Psychic", "Fighting", "Darkness", "Metal",
        // Dragon has no energy of its own in Pocket, but appears as a card's type.
        "Dragon", "Colorless",
        // Trainer kinds, drawn as outlined pips.
        "Item", "Supporter", "Tool", "Stadium"
    };

    private static bool HasPip(string? type) => type is not null && PipTypes.Contains(type);

    private static string AbilityTip(CardFact fact)
    {
        var name = fact.Ability?.Name ?? "Ability";
        var effect = fact.Ability?.Effect;
        return string.IsNullOrWhiteSpace(effect) ? name : $"{name}\n{effect}";
    }

    private string Caret(ListSort column) =>
        _sort != column ? "" : _descending ? "\u25be" : "\u25b4";

    /// <summary>
    /// Cards in display order. Sorting happens here rather than in the page so both layouts
    /// and the sweep index stay consistent with what is on screen.
    /// </summary>
    private List<PocketCard> Sorted()
    {
        if (_sort == ListSort.None) return Cards.ToList();

        IEnumerable<PocketCard> q = Cards;
        Func<PocketCard, object> key = _sort switch
        {
            ListSort.Name => c => c.Name,
            // The column is labelled "set", so it sorts by set FIRST and number within it.
            ListSort.Number => OrderKey,
            ListSort.Type => c => TypeOf?.Invoke(c) ?? "",
            ListSort.Stage => c => StageOf?.Invoke(c) ?? "",
            ListSort.Rarity => c => RungOf?.Invoke(c)?.Index ?? -1,
            ListSort.Count => c => CountOf(c),
            ListSort.Health => c => FactOf?.Invoke(c)?.Health ?? -1,
            _ => c => c.Number
        };

        // Set-then-number as the tie-break, so equal keys keep a stable, meaningful order — and
        // the same ordering the "set" column itself uses, rather than a second rule.
        q = _descending
            ? q.OrderByDescending(key).ThenBy(OrderKey, StringComparer.Ordinal)
            : q.OrderBy(key).ThenBy(OrderKey, StringComparer.Ordinal);

        return q.ToList();
    }

    /// <summary>
    /// Unique per instance, because two grids can share a page (the deck builder renders its own)
    /// and aria-activedescendant points at an id — a duplicate would send a screen reader to the
    /// wrong grid's tile.
    /// </summary>
    private readonly string _gridId = $"cg{Guid.NewGuid():N}"[..10];

    /// <summary>
    /// What a screen reader is told about a card, as one sentence: name, where it is from, its
    /// rarity, and how many you hold. The count comes last because it is the part that changes.
    ///
    /// A single label rather than a label plus a separate description, so the cursor announcement
    /// and the tile cannot say different things about the same card.
    /// </summary>
    private string Describe(PocketCard card, int count)
    {
        var rarity = RungOf?.Invoke(card)?.Symbol ?? card.Rarity;
        var held = count switch
        {
            0 => "none owned",
            1 => "1 owned",
            _ => $"{count} owned"
        };
        return $"{card.Name}, {card.Set} {card.Number}, {rarity}, {held}";
    }

    private Task Bump(PocketCard card, int delta) => OnAdjust.InvokeAsync((card, delta));

    private void Rechunk()
    {
        _flat = Sorted();

        // Whether the strip is worth a row at all. Stops at the second distinct value rather than
        // collecting them: the answer is a yes/no, and in the common case -- one set selected --
        // the first mismatch never comes, which is the pass this has to be cheap for.
        _multiGroup = false;
        if (GroupOf is not null && _flat.Count > 1)
        {
            var first = GroupOf(_flat[0]);
            for (var i = 1; i < _flat.Count; i++)
            {
                if (GroupOf(_flat[i]) == first) continue;
                _multiGroup = true;
                break;
            }
        }

        _indexOf = new Dictionary<string, int>(_flat.Count);
        for (var i = 0; i < _flat.Count; i++) _indexOf[_flat[i].Key] = i;

        var cols = Math.Max(1, Columns);
        var rows = new List<List<(PocketCard, int)>>((_flat.Count / cols) + 1);
        for (var i = 0; i < _flat.Count; i += cols)
        {
            var row = new List<(PocketCard, int)>(cols);
            for (var j = i; j < Math.Min(i + cols, _flat.Count); j++) row.Add((_flat[j], j));
            rows.Add(row);
        }
        _rows = rows;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;

        if (_attached)
        {
            if (_contentChanged)
            {
                _contentChanged = false;
                // Before the image work: the loader queues what is near the viewport, so
                // scrolling first means it queues the top of the new list rather than wherever
                // the old one had been left.
                await ScrollToTopAsync();
                if (_disposed) return;
            }

            if (_listChanged)
            {
                _listChanged = false;
                await RefreshImagesAsync();
                if (_disposed) return;
                await PrefetchAsync();
                if (_disposed) return;
            }

            // Cheap, and the column count changes from two places (the picker and the list-view
            // toggle) neither of which is a good place to remember this.
            await SyncKeyColumnsAsync();
            if (_disposed) return;

            // A mode armed in list view must not survive into a grid that hides its button:
            // the state would be unreachable, and .sweeping still changes the cursor and
            // touch-action.
            if (Sweeping && !ShowSweepToggle)
            {
                Sweeping = false;
                if (_sweep is not null) await _sweep.InvokeVoidAsync("setSweep", false);
                StateHasChanged();
            }

            await MeasureRowsAsync();
            if (_disposed) return;

            // A new window of rows is a new answer, and no scroll event follows a re-render. Also
            // the point at which the strip first appears or disappears, since _multiGroup is
            // decided in Rechunk.
            await AttachSpyAsync();
            return;
        }
        _attached = true;

        // Each line below is an await, and the component can be disposed during any of them —
        // navigating off /collection inside the few hundred milliseconds the three dynamic
        // imports take is enough. So check after every one. Continuing past disposal would pass
        // an already-disposed _self to the next call, which throws ObjectDisposedException as
        // Blazor serialises it and comes out of the render loop as an unhandled exception; and
        // the registrations further down would outlive the component that owns them.
        _self = DotNetObjectReference.Create(this);

        _sweep = await JS.InvokeAsync<IJSObjectReference>("import", "./js/gridsweep.js");
        if (_disposed) { await ReleaseModulesAsync(); return; }

        await _sweep.InvokeVoidAsync("attach", _gridEl, _self);
        if (_disposed) { await ReleaseModulesAsync(); return; }

        _touchCapable = await _sweep.InvokeAsync<bool>("hasCoarsePointer");
        if (_disposed) { await ReleaseModulesAsync(); return; }

        _keys = await JS.InvokeAsync<IJSObjectReference>("import", "./js/gridkeys.js");
        if (_disposed) { await ReleaseModulesAsync(); return; }

        await _keys.InvokeVoidAsync("attach", _gridEl, _self, ListView ? 1 : Columns);
        if (_disposed) { await ReleaseModulesAsync(); return; }

        // So the command palette can hand focus here from anywhere on the page.
        Focus.Register(this, () => FocusGridAsync());

        // Coming back from a card's detail page: put the cursor where it was. Only when the memo
        // is there, so arriving any other way does not have focus pulled into the grid.
        if (Focus.TakeReturn() is { Length: > 0 } key)
        {
            var back = IndexOfCard(key);
            if (back >= 0) await FocusGridAsync(back);
            if (_disposed) { await ReleaseModulesAsync(); return; }
        }

        _metrics = await JS.InvokeAsync<IJSObjectReference>("import", "./js/gridmetrics.js");
        if (_disposed) { await ReleaseModulesAsync(); return; }

        await _metrics.InvokeVoidAsync("watch", _gridEl, _self);
        if (_disposed) { await ReleaseModulesAsync(); return; }

        await MeasureRowsAsync();
        if (_disposed) { await ReleaseModulesAsync(); return; }

        _spy = await JS.InvokeAsync<IJSObjectReference>("import", "./js/gridspy.js");
        if (_disposed) { await ReleaseModulesAsync(); return; }

        await AttachSpyAsync();
        if (_disposed) { await ReleaseModulesAsync(); return; }

        _images = await JS.InvokeAsync<IJSObjectReference>("import", "./js/imgloader.js");
        if (_disposed) { await ReleaseModulesAsync(); return; }

        await _images.InvokeVoidAsync("init", _gridEl);
        if (_disposed) { await ReleaseModulesAsync(); return; }

        await PrefetchAsync();
        if (_disposed) { await ReleaseModulesAsync(); return; }

        // Poll for image stats: a callback per image would defeat the point of the loader.
        _statsTimer = new System.Threading.Timer(async _ =>
        {
            try
            {
                var st = await _images.InvokeAsync<ImgStats>("stats");
                if (st.failed != _imgFailed) { _imgFailed = st.failed; await InvokeAsync(StateHasChanged); }
            }
            catch { /* page torn down */ }
        }, null, 1000, 1500);

        // The timer is the one thing here that keeps running on its own, so if disposal landed
        // between the last check and this line it has to be stopped by hand: DisposeAsync has
        // already been past the field and found it null.
        if (_disposed)
        {
            await _statsTimer.DisposeAsync();
            _statsTimer = null;
            await ReleaseModulesAsync();
            Focus.Release(this);
        }
    }

    /// <summary>
    /// Where a card sits in the current list, or -1 if the filters no longer include it — which is
    /// ordinary rather than exceptional: the count may have changed while you were reading about it,
    /// and "missing only" would then have dropped it.
    /// </summary>
    private int IndexOfCard(string cardKey)
    {
        for (var i = 0; i < Cards.Count; i++)
            if (Cards[i].Key == cardKey) return i;

        return -1;
    }

    /// <summary>
    /// Keep the cursor's row width in step with the layout. A stale column count is not cosmetic:
    /// ArrowDown would move by the old width and land on a different row than the one below.
    /// </summary>
    /// <summary>
    /// Give the grid keyboard focus and put the cursor somewhere sensible. Reached from the skip
    /// button above and from the command palette.
    /// </summary>
    public async Task FocusGridAsync(int index = -1)
    {
        if (_keys is null) return;
        try { await _keys.InvokeVoidAsync("focusGrid", _gridEl, index, Cards.Count); }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
    }

    /// <summary>
    /// Point the scroll spy at the strip, or bring it up to date if it is already watching.
    ///
    /// Unconditional, even where there is no grouping to report: the same pass measures where the
    /// sticky bars above the grid end and publishes it as --bars-h, which is what stops the list
    /// view's column headers from parking underneath the toolbar. A grid with nothing to group
    /// still has that problem.
    /// </summary>
    private async Task AttachSpyAsync()
    {
        if (_spy is null) return;

        try
        {
            await _spy.InvokeVoidAsync("watch", _gridEl, _spyEl);
            await _spy.InvokeVoidAsync("refresh", _gridEl, _spyEl);
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
    }

    private async Task SyncKeyColumnsAsync()
    {
        if (_keys is null) return;
        try { await _keys.InvokeVoidAsync("setColumns", _gridEl, ListView ? 1 : Columns); }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
    }

    /// <summary>
    /// Read the real height of a row and hand it to Virtualize. Cheap enough to do after every
    /// render: it is one getBoundingClientRect, and it re-renders only when the answer moved.
    ///
    /// Grid layout only. A list row is a fixed 50px plus its border in app.css, so there the
    /// constant is the truth rather than a guess at it.
    /// </summary>
    private async Task MeasureRowsAsync()
    {
        if (_metrics is null || ListView || Cards.Count == 0) return;

        GridMetrics? m;
        try { m = await _metrics.InvokeAsync<GridMetrics?>("metrics", _gridEl, ".card-row"); }
        catch (JSDisconnectedException) { return; }
        catch (JSException) { return; }

        // Null where there is no browser to answer — a bUnit render, or interop stubbed out.
        if (m is null || _disposed) return;

        var shape = $"{Columns}";
        var was = RowHeight;

        _gridPx = m.width;

        // A measurement is kept once made, and zero is not a measurement: Virtualize can go back
        // to rendering no rows at all, and letting that drop the height back to the estimate would
        // have the two take turns, each change of ItemSize prompting the render that undoes it.
        if (m.row > 0) _rowPx = m.row;

        if (_measuredFor == shape && Math.Abs(RowHeight - was) < 0.5f) return;

        _measuredFor = shape;
        StateHasChanged();
    }

    /// <summary>
    /// The grid changed width — a rotation, a window drag, the toolbar disclosure opening — so the
    /// tiles are a different size and the measurement is stale. Called from js/gridmetrics.js.
    /// </summary>
    [JSInvokable]
    public async Task RemeasureRows()
    {
        if (_disposed) return;   // the observer is disconnected on the way out, but a call can be in flight

        _measuredFor = "";
        await MeasureRowsAsync();
    }

    private async Task RefreshImagesAsync()
    {
        if (_images is null) return;
        try { await _images.InvokeVoidAsync("refresh"); }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
    }

    /// <summary>
    /// Warm the cache for the whole visible list, so scrolling a set never waits on the network.
    /// Capped: "all sets" is 3,700+ cards at roughly 45 KB each, so eagerly pulling ~170 MB is not
    /// worth the scrolling latency it saves, especially on mobile data. Below the cap (any single
    /// set) the entire thing is fetched.
    /// </summary>
    private async Task PrefetchAsync()
    {
        if (_images is null) return;

        var urls = _flat.Count <= PrefetchLimit
            ? _flat.Select(c => c.ArtUrl).ToArray()
            : [];

        try
        {
            if (urls.Length == 0) await _images.InvokeVoidAsync("cancelPrefetch");
            else await _images.InvokeVoidAsync("prefetch", urls);
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
    }

    private const int PrefetchLimit = 700;

    /// <summary>
    /// True until the device tells us otherwise, so the button does not flicker into existence on
    /// a touchscreen: the check needs JS and cannot run before the first render.
    /// </summary>
    private bool _touchCapable = true;

    private bool ShowSweepToggle => ListView || _touchCapable;

    private async Task ToggleSweep()
    {
        Sweeping = !Sweeping;
        if (_sweep is not null) await _sweep.InvokeVoidAsync("setSweep", Sweeping);
    }

    private Task Activate((int Index, bool Invert) a) =>
        a.Index >= 0 && a.Index < Cards.Count
            ? OnAdjust.InvokeAsync((Cards[a.Index], DeltaFor(a.Invert)))
            : Task.CompletedTask;

    // ---- keyboard, from js/gridkeys.js ---------------------------------------------
    // The cursor lives in JS so moving it costs no renders; these are the points where a key
    // changes something, and each is the same call the pointer path makes.

    [JSInvokable]
    public Task KeyAdjust(int index, int delta) =>
        index >= 0 && index < Cards.Count
            ? OnAdjust.InvokeAsync((Cards[index], delta))
            : Task.CompletedTask;

    /// <summary>
    /// A digit sets the count outright. Without it, entering an existing collection means nine
    /// presses of + per card. Falls back to relative adjustment where the page only accepts that —
    /// the log screen, where a count is what came out of a pack rather than what you hold.
    /// </summary>
    [JSInvokable]
    public Task KeySet(int index, int count)
    {
        if (index < 0 || index >= Cards.Count) return Task.CompletedTask;

        var card = Cards[index];
        if (OnSet.HasDelegate) return OnSet.InvokeAsync((card, Math.Clamp(count, 0, MaxCopies)));

        var delta = Math.Clamp(count, 0, MaxCopies) - CountOf(card);
        return delta == 0 ? Task.CompletedTask : OnAdjust.InvokeAsync((card, delta));
    }

    [JSInvokable]
    public Task KeyOpen(int index)
    {
        if (index < 0 || index >= Cards.Count) return Task.CompletedTask;

        // Noted before navigating, so Escape on the detail page comes back to this card with the
        // cursor still on it.
        Focus.ReturnTo(Cards[index].Key);
        OpenDetail(Cards[index]);
        return Task.CompletedTask;
    }

    /// <summary>
    /// Toggle the cursor card on the want list, from the keyboard.
    ///
    /// The heart is <c>tabindex="-1"</c> like the rest of a tile's furniture, so this is the only
    /// route to it without a pointer. Silent where the page passes no handler -- the log screen has
    /// no list to write to, and a key that does nothing is better than one that throws.
    /// </summary>
    [JSInvokable]
    public Task KeyWant(int index) =>
        index >= 0 && index < Cards.Count && OnWant.HasDelegate
            ? OnWant.InvokeAsync(Cards[index])
            : Task.CompletedTask;

    /// <summary>Called once by gridsweep.js when a drag is released.</summary>
    [JSInvokable]
    public async Task ApplySweep(int lo, int hi)
    {
        lo = Math.Max(0, lo);
        hi = Math.Min(Cards.Count - 1, hi);
        if (hi < lo) return;

        var swept = new List<PocketCard>(hi - lo + 1);
        for (var i = lo; i <= hi; i++) swept.Add(Cards[i]);

        await OnSweep.InvokeAsync((swept, DeltaFor(false)));
        StateHasChanged();   // interop callback runs outside the render loop
    }

    /// <summary>
    /// The keyboard equivalent of a drag sweep: Shift+Arrow extends a range from the cursor,
    /// then Enter or minus applies one delta to the whole range as a single undo step — the
    /// same one <see cref="ApplySweep"/> gives a pointer drag. Unordered, since gridkeys.js
    /// tracks an anchor and a cursor rather than a lo/hi pair.
    /// </summary>
    [JSInvokable]
    public async Task KeyRangeAdjust(int a, int b, int delta)
    {
        var lo = Math.Max(0, Math.Min(a, b));
        var hi = Math.Min(Cards.Count - 1, Math.Max(a, b));
        if (hi < lo) return;

        var swept = new List<PocketCard>(hi - lo + 1);
        for (var i = lo; i <= hi; i++) swept.Add(Cards[i]);

        await OnSweep.InvokeAsync((swept, delta));
        StateHasChanged();   // interop callback runs outside the render loop
    }

    private sealed record ImgStats(int loaded, int failed, int queued, int inflight);

    /// <summary>What js/gridmetrics.js reports: a measured row, and the grid's width to fall back on.</summary>
    private sealed record GridMetrics(float row, float width);

    public async ValueTask DisposeAsync()
    {
        _disposed = true;

        if (_statsTimer is not null) await _statsTimer.DisposeAsync();
        _statsTimer = null;
        Focus.Release(this);

        await ReleaseModulesAsync();
        _self?.Dispose();
    }

    /// <summary>
    /// Hand the JS modules back and clear the fields. Called from <see cref="DisposeAsync"/> and
    /// from the setup in <see cref="OnAfterRenderAsync"/> when disposal beat one of its imports —
    /// whichever runs second finds the fields already null, so a module imported after DisposeAsync
    /// walked past it is still released rather than left registered on the JS side.
    /// </summary>
    private async Task ReleaseModulesAsync()
    {
        if (_keys is not null)
        {
            try { await _keys.InvokeVoidAsync("dispose", _gridEl); }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
        }

        // Takes the element, since what it disconnects is an observer of this grid.
        if (_metrics is not null)
        {
            try { await _metrics.InvokeVoidAsync("dispose", _gridEl); await _metrics.DisposeAsync(); }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
        }

        // Also element-scoped: what it removes is a scroll listener watching this grid.
        if (_spy is not null)
        {
            try { await _spy.InvokeVoidAsync("dispose", _gridEl); await _spy.DisposeAsync(); }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
        }

        foreach (var m in new[] { _sweep, _images, _keys })
        {
            if (m is null) continue;
            try { await m.InvokeVoidAsync("dispose"); await m.DisposeAsync(); }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
        }
        _sweep = _images = _keys = _metrics = _spy = null;
    }
}
