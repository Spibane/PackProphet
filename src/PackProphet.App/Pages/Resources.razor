@page "/resources"
@implements IDisposable
@inject AppSession Session

<PageTitle>Resources · PackProphet</PageTitle>

@if (!Session.Ready)
{
    <Loading />
}
else
{
    <div class="page-head">
        <h1 class="title">Resources</h1>
    </div>

    <PageShell Measure="PageShell.Width.Wide" Class="sections">
        @* Three panels, never a total. Pack, Wonder and Trade each have their own hourglass and
           their own pool, and nothing in the game exchanges between them. *@

        @* One button for both currencies: it is one day's income, and two buttons would have to be
           pressed together to mean anything. Refuses a second go on the same day -- a double tap
           is otherwise invisible, and it moves every timeline on the page. *@
        <div class="d-flex align-items-center gap-2 flex-wrap mb-3">
            <button class="btn btn-sm btn-primary" @onclick="Session.AddDailyHourglasses"
                    disabled="@Session.DailyHourglassesAdded">
                @(Session.DailyHourglassesAdded ? "Today's Dailies Added" : "Add Today's Dailies")
            </button>
        </div>

        <div class="pools">
            @* ---- packs ------------------------------------------------------------------- *@
            <div class="pool">
                <div class="pool-head">
                    <span class="nm">Packs</span>
                    <span class="rate">@_pack.PerDay.ToString("0.#") a day</span>
                </div>

                <div class="pool-figures">
                    <div class="fig">
                        <span class="v">@_pack.FromHourglasses</span>
                        <span class="l">Packs From Hourglasses</span>
                    </div>
                    <div class="fig">
                        <span class="v">@(_pack.UntilNextFree is { } t ? Short(t) : "Ready")</span>
                        <span class="l">Next Free Pack</span>
                    </div>
                </div>

                @* Premium is a +50% rate, and every timeline in the app respects it. *@
                <label class="form-check form-switch small mt-2">
                    <input class="form-check-input" type="checkbox" checked="@_premium"
                           @onchange="OnPremium" />
                    Premium Membership
                </label>

                <div class="pool-entry">
                    <label class="small">
                        Pack Hourglasses
                        <input type="number" min="0" class="form-control form-control-sm"
                               value="@_packHourglasses" @onchange="OnPackHourglasses" />
                    </label>
                    <label class="small">
                        Shinedust
                        <input type="number" min="0" class="form-control form-control-sm"
                               value="@_dust" @onchange="OnDust" />
                    </label>
                    <button class="btn btn-sm btn-primary" @onclick="SavePack">Save</button>
                </div>
            </div>

            @* ---- wonder and trade, structurally identical -------------------------------- *@
            <PoolPanel Title="Wonder Stamina"
                       Outlook="Session.WonderOutlook"
                       HourglassesPerUnit="GameRules.WonderHourglassesPerStamina"
                       Note=""
                       OnSave="@((v) => Session.SetPool(trade: false, v.Balance, v.Hourglasses))" />

            <PoolPanel Title="Trade Stamina"
                       Outlook="Session.TradeOutlook"
                       HourglassesPerUnit="GameRules.TradeHourglassesPerStamina"
                       Note=""
                       OnSave="@((v) => Session.SetPool(trade: true, v.Balance, v.Hourglasses))" />
        </div>

        @* ---- pack points, the fourth economy --------------------------------------------
           Not a pool and not a currency you hold: points accrue as a byproduct of opening, five a
           pack, and can only be spent inside the set that earned them. There is nothing to
           regenerate and nothing to time — only a cap that stops paying you. *@
        <h2>Pack Points</h2>
        <p class="small text-body-secondary">
            Capped at @GameRules.PackPointsCap.ToString("N0") per set. <strong>Packs opened at
            the cap earn nothing.</strong> Correct balances from the in-game shop.
        </p>

        @if (_pointRows.Count == 0)
        {
            <p class="small text-body-secondary">
                No balances yet.
            </p>
        }
        else
        {
            <DataTable Label="Pack points per set" Fit="true">
                <thead>
                    <tr>
                        <th scope="col">Set</th>
                        <th scope="col" class="num">Points</th>
                        <th scope="col" class="num">Packs Until Capped</th>
                        @* The goal per set: points are only spendable inside the set that earned
                           them, so "how far off" is a per-set question with a per-set answer. *@
                        <th scope="col">Rarest Still Wanted</th>
                        <th scope="col" class="num">Packs to Afford It</th>
                        <th scope="col" class="num" title="Wanted cards the balance covers">Can Buy Now</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _pointRows)
                    {
                        <tr class="@(row.AtCap ? "pts-capped" : "")">
                            <td>@row.Set</td>
                            <td class="num">
                                @* Stepped in fives, because that is the only way a balance moves:
                                   five earned a pack, and every shop price a multiple of five. *@
                                <input type="number" min="0" max="@GameRules.PackPointsCap"
                                       step="@GameRules.PackPointsPerPack"
                                       class="form-control form-control-sm pts-in"
                                       value="@row.Balance" @key="(row.Set, _snapped)"
                                       @onchange="e => OnPoints(row.Set, e)" />
                            </td>
                            <td class="num">
                                @if (row.AtCap)
                                {
                                    <span class="text-warning-emphasis fw-semibold">Capped</span>
                                }
                                else
                                {
                                    @row.PacksUntilCap
                                }
                            </td>
                            <td class="small">
                                @if (row.RarestWanted is { } goal)
                                {
                                    <a href="card/@goal.Key">@goal.Name</a>
                                    <span class="text-body-secondary ms-1">
                                        @RarityOf(goal) &middot; @row.RarestPoints.ToString("N0")
                                    </span>
                                    @* The plan is finished and the balance is stranded in this
                                       set, so the column shows what the points can still buy. It
                                       has to say so, or it reads as a card you are short of. *@
                                    @if (row.BeyondTarget)
                                    {
                                        <span class="d-block text-body-tertiary">Outside Your Plan</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-body-secondary">Set Complete</span>
                                }
                            </td>
                            <td class="num">
                                @if (row.RarestWanted is null)
                                {
                                    <span class="text-body-secondary">&mdash;</span>
                                }
                                else if (row.PacksToAfford == 0)
                                {
                                    <span class="text-success-emphasis fw-semibold">Buy It</span>
                                }
                                else
                                {
                                    @row.PacksToAfford
                                }
                            </td>
                            <td class="num small text-body-secondary">
                                @(row.AffordableNow.Count > 0 ? $"{row.AffordableNow.Count}" : "—")
                            </td>
                        </tr>
                    }
                </tbody>
            </DataTable>
        }

        @* A series at a time rather than a set at a time. Correcting balances means opening the
           game's shop and walking down it, so one tap per series beats nineteen selections. *@
        @if (_pointsAddable.Count > 0)
        {
            <div class="d-flex align-items-center gap-2 flex-wrap mb-2">
                <span class="small text-body-secondary">Add Rows For</span>
                @foreach (var series in _pointsAddable
                    .GroupBy(Session.Sets.SeriesOf)
                    .OrderBy(g => g.Key, StringComparer.Ordinal))
                {
                    <button class="btn btn-sm btn-outline-primary py-0"
                            @onclick="() => AddSeries(series.Key)">
                        All @series.Key (@series.Count())
                    </button>
                }
                @if (_pointsAddable.Count > 1)
                {
                    <button class="btn btn-sm btn-outline-secondary py-0" @onclick="AddEverySet">
                        Every Set (@_pointsAddable.Count)
                    </button>
                }
            </div>
        }

        @* The dust runway sits next to trade stamina, and usually says dust is not the
           constraint: if it funds far more trades than stamina allows, it is not a cost. *@
        @if (_dustSaved > 0)
        {
            <h2>Shinedust</h2>
            <DataTable Label="Shinedust costs" Fit="true">
                <thead>
                    <tr><th scope="col">Rarity</th><th scope="col" class="num">Dust Each</th><th scope="col" class="num">Trades Funded</th></tr>
                </thead>
                <tbody>
                    @foreach (var (rung, price) in TradePrices())
                    {
                        <tr>
                            <td><span class="glyphs @rung.GlyphClass">@rung.Symbol</span></td>
                            <td class="num">@price.ToString("N0")</td>
                            <td class="num">@ResourcePlan.DustRunway(_dustSaved, price)</td>
                        </tr>
                    }
                </tbody>
            </DataTable>
            <p class="small text-body-secondary">
                Stamina covers @Session.TradeOutlook.Reachable @Fmt.S(Session.TradeOutlook.Reachable, "trade") now.
            </p>
        }
    </PageShell>
}

@code {
    private PackOutlook _pack = new(0, 0, null, false);

    private bool _premium;
    private string _packHourglasses = "";
    private string _dust = "";
    private int _dustSaved;

    private bool _touched;

    private IReadOnlyList<SetPoints> _pointRows = [];

    /// <summary>Sets with no balance yet, so one can be added without listing all nineteen.</summary>
    private IReadOnlyList<string> _pointsAddable = [];

    /// <summary>
    /// Sets added by hand this visit. Held separately because a balance of zero is not stored -
    /// zero is how a balance is cleared - so without this the new row would vanish on the next
    /// Changed, before there was anything to type into it.
    /// </summary>
    private readonly HashSet<string> _pointsShown = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnChanged;
        await Session.InitAsync();
        Load();
    }

    private void OnChanged()
    {
        Load();
        InvokeAsync(StateHasChanged);
    }

    private void Load()
    {
        if (!Session.Ready) return;

        var r = Session.Profile.Resources;
        _pack = Session.PackOutlook;
        _premium = r.Premium;
        _dustSaved = r.Shinedust;
        LoadPoints();

        // Prefilled from saved state, but not once the fields have been touched: Load runs on
        // every Changed, and Changed fires for edits made anywhere in the app — including the
        // save from this very page — so re-seeding unconditionally would overwrite what is being
        // typed.
        if (_touched) return;

        _packHourglasses = r.PackHourglasses > 0 ? r.PackHourglasses.ToString() : "";
        _dust = r.Shinedust > 0 ? r.Shinedust.ToString() : "";
    }

    /// <summary>
    /// Point rows for the sets that have a balance, worst-first: a capped set is losing value on
    /// every pack, so it belongs above a set with forty points in it.
    /// </summary>
    private void LoadPoints()
    {
        if (Session.Points is null) { _pointRows = []; _pointsAddable = []; return; }

        var balances = Session.PointsBySet;

        // The plan for THAT set, since targets are per set: a card on a rung the user does not
        // collect is not "still wanted" however much it costs.

        // Release order, deliberately, even though a capped set is the urgent one: these rows are
        // typed into while reading down the game's own shop list, and a table that reorders itself
        // as values are entered would lose the reader's place. Capped rows are tinted instead, so
        // the warning survives without moving.
        _pointRows = balances.Keys
            .Union(_pointsShown, StringComparer.OrdinalIgnoreCase)
            .Select(set => Session.Points.Describe(
                set, balances.GetValueOrDefault(set), Session.Owned,
                Session.Profile.Targets.PlanFor(set)))
            .OrderBy(r => Session.Sets.SortKey(r.Set), StringComparer.Ordinal)
            .ToArray();

        // Promo sets are excluded: their packs award no points at all, so a balance there could
        // only ever be a mistake.
        _pointsAddable = Session.Index.OpenableSets
            .Where(set => !balances.ContainsKey(set) && !_pointsShown.Contains(set))
            .Where(set => !CardIndex.IsPromoSet(set))
            .OrderBy(Session.Sets.SortKey, StringComparer.Ordinal)
            .ToArray();
    }

    /// <summary>
    /// Bumped whenever a typed figure had to be rounded to a multiple of five, and part of the
    /// input's @key so the field is rebuilt with the figure that was actually stored.
    ///
    /// Without it the correction is invisible: Blazor compares the new value attribute against the
    /// one it last rendered, not against what is in the box, so typing 43 over a stored 40 leaves
    /// 43 on screen against a balance of 40 -- and the next pack logged makes it 45.
    /// </summary>
    private int _snapped;

    private void OnPoints(string set, ChangeEventArgs e)
    {
        if (!Num.TryCount(e.Value?.ToString(), out var n)) return;

        var held = GameRules.SnapPackPoints(n);
        if (held != n) _snapped++;

        Session.SetPackPoints(set, held);
    }

    /// <summary>
    /// Show every point-earning set of a series. Nothing is saved by this - a row exists so it can
    /// be typed into, and a balance of zero is stored as no balance at all.
    /// </summary>
    private void AddSeries(string series)
    {
        foreach (var set in _pointsAddable.Where(s => Session.Sets.SeriesOf(s) == series))
            _pointsShown.Add(set);

        LoadPoints();
    }

    private void AddEverySet()
    {
        foreach (var set in _pointsAddable) _pointsShown.Add(set);
        LoadPoints();
    }

    private void OnPremium(ChangeEventArgs e)
    {
        _premium = e.Value is bool b && b;
        SavePack();
    }

    private void OnPackHourglasses(ChangeEventArgs e)
    {
        _touched = true;
        _packHourglasses = e.Value?.ToString() ?? "";
    }

    private void OnDust(ChangeEventArgs e)
    {
        _touched = true;
        _dust = e.Value?.ToString() ?? "";
    }

    private void SavePack()
    {
        Session.SetPackResources(
            Num.Count(_packHourglasses),
            Num.Count(_dust),
            _premium);

        // Released so the fields follow saved state again, which now matches what was typed.
        _touched = false;
    }

    /// <summary>
    /// Dust prices per rarity, read from the data. The ladder is steeply non-monotonic — a 1-star
    /// costs less than a 4-diamond, and a Shiny undercuts a 2-star by 15,000 — so the whole table
    /// is shown rather than one representative price.
    /// </summary>
    private IEnumerable<(RarityRung Rung, int Price)> TradePrices() =>
        Session.Index.Ladder.Rungs
            .Select(rung => (
                Rung: rung,
                Price: rung.Codes
                    .Select(code => Session.Data!.Rarities.GetValueOrDefault(code)?.TradePrice)
                    .FirstOrDefault(p => p is > 0) ?? 0))
            .Where(x => x.Price > 0);

    /// <summary>The rarity as the game draws it, which is how a collector recognises the card.</summary>
    private string RarityOf(PocketCard card) =>
        Session.Index.Ladder.Rungs.FirstOrDefault(r => r.Codes.Contains(card.Rarity))?.Symbol
            ?? card.Rarity;

    private static string Short(TimeSpan t) => Fmt.Span(t);

    public void Dispose() => Session.Changed -= OnChanged;
}
