@page "/not-found"
@layout MainLayout

@* The only route in the app that had no page shell at all: a bare h3 and a paragraph, sitting
   flush against the nav with no header and no padding. It looked unfinished because it was. *@

<div class="page-head">
    <h1 class="title">Page Not Found</h1>
</div>

<PageShell Measure="PageShell.Width.Text">
    <p>That address does not match anything in the app.</p>
    <BackLink To="collection" Label="Collection" />
</PageShell>
