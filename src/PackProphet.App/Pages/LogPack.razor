@page "/log"
@implements IDisposable
@implements IAsyncDisposable
@inject AppSession Session
@inject UiBusy Busy
@inject IJSRuntime JS

<PageTitle>Log a Pack · PackProphet</PageTitle>

@if (!Session.Ready)
{
    <Loading />
}
else if (_pack is null)
{
    <div class="page-head folded">
        <RailToggle />
        <h1 class="title">Log a Pack</h1>
    </div>



    <PageShell Class="railed">

    @* Choosing a pack is browsing -- a grid of every pack ever sold, narrowed by series -- so it
       gets the shell browsing gets. It was two bars for three controls: the series above, the
       column count below, and the availability chips sharing the first one with a select they have
       nothing to do with.

       The screen after this one, where the cards are picked, is a Record screen and has the strip
       instead. Same route, two jobs, and the shell says which one you are in. *@
    <PageRail Id="log-rail" OpenLabel="Packs">
        <div class="rail-group">
            <span class="ttl">Series</span>
            @* Grouped by series, then by set. A flat list of every pack ever sold is already long
               and only grows, and a set heading answers "which set is this pack from", which a pack
               name like "Mewtwo" does not. Defaults to the newest series, where packs are usually
               being opened. *@
            <select class="form-select form-select-sm" aria-label="Series" @onchange="OnSeries">
                @foreach (var series in Session.Sets.Series)
                {
                    <option value="@series" selected="@(_series == series)">Series @series</option>
                }
            </select>

        </div>

        <div class="rail-group">
            <span class="ttl">Limited-time</span>
            @* The same setting as on the Packs page — one answer to "is Deluxe on sale", for every
               Deluxe set — and it is repeated here because this is the page you are on when you
               find out. It never filters the picker: you can log a pack you opened whatever the
               app assumed about the shelf. *@
            @if (Session.LimitedPacks.Count > 0)
            {
                <span class="avail">
                    @foreach (var pack in Session.LimitedPackNames)
                    {
                        var on = Session.IsLimitedPackNameAvailable(pack);
                        <button class="avail-chip @(on ? "on" : "off")"
                                @onclick="() => Session.SetLimitedPackNameAvailable(pack, !on)"
                                title="Affects recommendations only.">
                            <span class="nm">@pack</span>
                            <span class="st">@(on ? "On Sale" : "Off Sale")</span>
                        </button>
                    }
                </span>
            }
        </div>

        <div class="rail-group">
            <span class="ttl">Layout</span>
            <select class="form-select form-select-sm" aria-label="Columns in the grid" @onchange="OnCols">
                @foreach (var n in new[] { 2, 3, 4, 5, 6, 8 })
                {
                    <option value="@n" selected="@(n == Session.PackColumns)">@n Cols</option>
                }
            </select>
        </div>
    </PageRail>

    <div class="chooser-main">

        @* Reading the pack off a screenshot, before the picker, because it is the faster route when
           it works: the game has just shown you the five cards, and the cards themselves say which
           pack they came out of — so neither the pack nor the five taps are needed.

           A button rather than a disclosure. It is folded away for the same reason it always was —
           picking a pack by hand always works and this does not, since a set released since the
           last fingerprint refresh cannot be recognised — but a summary in secondary text reads as
           a footnote about the page, and this is the fastest way to use it. The panel is the same
           panel; only the thing that opens it changed.

           Still not the whole screen, and still not the default: the grid under it has to be the
           first thing on the page for anyone whose set is too new to be read. *@
        <button type="button" class="shot-open @(_shotsOpen ? "on" : "")"
                aria-expanded="@Aria.Flag(_shotsOpen)" aria-controls="log-shots"
                @onclick="ToggleShots">
            @* A camera, because the thing being asked for is a picture. Drawn here rather than in
               NavIcon, which holds the marks the two navs share and nothing else. *@
            <span class="ico" aria-hidden="true">
                <svg viewBox="0 0 16 16" width="17" height="17" focusable="false">
                    <path d="M1.6 4.8h2.6l1.1-1.6h5.4l1.1 1.6h2.6v8H1.6z" fill="none"
                          stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
                    <circle cx="8" cy="8.6" r="2.5" fill="none" stroke="currentColor"
                            stroke-width="1.5" />
                </svg>
            </span>
            Read It Off a Screenshot
        </button>

        @* Hidden rather than unmounted. The readings are expensive -- twenty pictures is a minute
           of work -- and a panel that is torn down when it folds away would lose every one of them
           to a mis-tap on the button that folded it. `hidden` takes the whole panel out of the
           tab order and out of the accessibility tree, which is the part that matters; keeping the
           markup is what makes closing it survivable. *@
        <div class="shot-panel" id="log-shots" hidden="@(!_shotsOpen)">
            <ShotImport @ref="_shots" Group="pack" Choices="@ShotChoices">
                <Intro>
                    Screenshot the <strong>Opening Results</strong> screen, all five cards
                    showing.
                </Intro>
                <Actions Context="reading">
                    @{
                        var guess = PackIdentifier.Identify(Session.Index, reading);
                    }

                    @if (guess.Note is not null)
                    {
                        <Notice Severity="Notice.Level.Warning">@guess.Note</Notice>
                    }

                    @* Already logged, by the only evidence there is: same pack, same cards.
                       Said next to the buttons rather than only at the commit, because the two
                       routes out of this block skip the batch gate -- opening the pack in the
                       picker goes on to the picker's own commit, and the one-picture button is
                       a single press away from a row in the log. *@
                    @if (guess.PackKey is { } identified
                         && RepeatNote(reading, identified) is { } repeat)
                    {
                        <Notice Severity="Notice.Level.Warning">@repeat</Notice>
                    }

                    @if (guess.PackKey is not null)
                    {
                        <div class="d-flex gap-2 flex-wrap">
                            <button class="btn btn-primary" aria-live="polite"
                                    title="@AdoptWarning"
                                    @onclick="() => AdoptShot(reading, guess.PackKey)">
                                @if (Confirming(reading, guess.PackKey))
                                {
                                    <text>Really? Other screenshots will be deleted.</text>
                                }
                                else
                                {
                                    <text>
                                        Open @Session.PackLabel(guess.PackKey) with these
                                        @reading.NamedCount @Fmt.S(reading.NamedCount, "card")
                                    </text>
                                }
                            </button>

                            @* The batch button's counterpart for one picture: log it where it
                               stands, without the trip through the picker. The button above is
                               the one that opens the pack in the grid so the cards can be
                               checked first, which is worth offering and not worth forcing —
                               one pack was the case that had no way to skip it.

                               Only while this is the only picture. Over a batch it would log
                               one reading and clear the rest with it, which is what the
                               All-Pictures button exists to avoid. *@
                            @if (OnlyPicture)
                            {
                                <button id="log-one" class="btn btn-outline-primary"
                                        disabled="@Busy.IsBusy"
                                        @onclick="() => LogOne(reading)">
                                    Log It Now
                                </button>
                            }
                        </div>

                        @if (OnlyPicture && _bulkQuery is { } query)
                        {
                            <Notice Severity="Notice.Level.Warning" Dense="true" Class="mt-2">
                                @query
                                <button class="btn btn-sm btn-warning ms-2 py-0"
                                        disabled="@Busy.IsBusy" @onclick="LogAllAnyway">
                                    Log It Anyway
                                </button>
                            </Notice>
                        }
                    }
                    else if (guess.Candidates.Count > 1)
                    {
                        @* The cards narrowed it and could not finish. Offering the shortlist is
                           the whole of what is left to ask, and it is a tap rather than a hunt
                           through the picker. *@
                        <p class="small mb-2">Which pack was it?</p>
                        <div class="d-flex gap-2 flex-wrap">
                            @foreach (var candidate in guess.Candidates)
                            {
                                var pack = candidate;
                                <button class="btn btn-sm btn-outline-primary" aria-live="polite"
                                        title="@AdoptWarning"
                                        @onclick="() => AdoptShot(reading, pack)">
                                    @(Confirming(reading, pack)
                                        ? "Really? Other screenshots will be deleted."
                                        : Session.PackLabel(pack))
                                </button>
                            }
                        </div>
                    }
                </Actions>

                @* Every picture at once, which is how packs are actually opened: in a run of
                   ten, screenshotted as you go, imported in one sitting. Without this the only
                   route was the per-picture button above, and that one takes you into the
                   picker for a single pack — which unmounts this whole control and loses the
                   other nine readings with it. Ten packs meant ten uploads.

                   Only offered from two pictures up. Over a single reading it would be a second
                   button saying the same thing as the one above it, minus the chance to check
                   the cards in the picker first. *@
                <Together Context="readings">
                    @if (readings.Count > 1)
                    {
                        var plan = Plan(readings);

                        @* Padded below as well as above. This block ends in a button, and its
                           bottom edge was sitting against whatever the page put next -- the
                           logged notice, or the pack grid once the disclosure closes -- so the
                           button read as belonging to the thing under it. *@
                        <section class="mt-3 border-top pt-3 pb-2">
                            <h2 class="sub-head">All @readings.Count Pictures</h2>

                            @if (plan.Unidentified > 0)
                            {
                                <Notice Severity="Notice.Level.Warning" Dense="true">
                                    @plan.Unidentified of these pictures
                                    @(plan.Unidentified == 1 ? "does" : "do") not say which pack
                                    @(plan.Unidentified == 1 ? "it is" : "they are"). Use that
                                    picture's own button above, or name its slots first.
                                </Notice>
                            }

                            @if (_bulkQuery is { } query)
                            {
                                <Notice Severity="Notice.Level.Warning" Dense="true">
                                    @query

                                    @if (_bulkSkips)
                                    {
                                        <button class="btn btn-sm btn-warning ms-2 py-0"
                                                disabled="@Busy.IsBusy" @onclick="LogOnlyNew">
                                            Log @(plan.Ready.Count - plan.Repeats) Anyway
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-warning ms-2 py-0"
                                                disabled="@Busy.IsBusy" @onclick="LogAllAnyway">
                                            Log @plan.Ready.Count Anyway
                                        </button>
                                    }
                                </Notice>
                            }

                            @* The usual shape of the problem: nine packs opened in a sitting and
                               one picture from yesterday's still in the folder. Offered up front,
                               beside the button that logs everything, rather than behind a press
                               of it: a button reading "Log 10 packs" is the one press nobody makes
                               when they already know one of the ten is a repeat.

                               Only when dropping the repeats still leaves something to log. Over
                               a batch that is entirely repeats it would log nothing, and over one
                               with none it says the same as the button beside it. Primary, because
                               a picture that repeats an opening is usually one that should not be
                               logged; the other stays, because a match is not proof. *@
                            @if (plan.Repeats > 0 && plan.Repeats < plan.Ready.Count)
                            {
                                var kept = plan.Ready.Count - plan.Repeats;

                                <div class="d-flex gap-2 flex-wrap">
                                    <button id="log-new" class="btn btn-primary"
                                            disabled="@Busy.IsBusy" @onclick="() => LogNew(plan)">
                                        Log @kept New, Skip @plan.Repeats
                                        @Fmt.S(plan.Repeats, "Repeat")
                                    </button>
                                    <button id="log-all" class="btn btn-outline-secondary"
                                            disabled="@Busy.IsBusy" @onclick="() => LogAll(plan)">
                                        Log All @plan.Ready.Count
                                    </button>
                                </div>
                            }
                            else if (plan.Ready.Count > 0)
                            {
                                <button id="log-all" class="btn btn-primary" disabled="@Busy.IsBusy"
                                        @onclick="() => LogAll(plan)">
                                    Log @plan.Ready.Count @Fmt.S(plan.Ready.Count, "pack")
                                    (@plan.Cards @Fmt.S(plan.Cards, "card") in all)
                                </button>
                            }

                            @if (plan.Ready.Count > 0)
                            {
                                @* Named so it can be checked before it is pressed. Twelve packs
                                   logged in one press is twelve events and sixty cards, and
                                   "which packs" is the thing you would want to have seen. *@
                                <p class="small text-body-secondary mb-0 mt-2">
                                    @string.Join(", ", plan.Ready
                                        .GroupBy(r => Session.PackLabel(r.Pack))
                                        .OrderBy(g => g.Key, StringComparer.CurrentCultureIgnoreCase)
                                        .Select(g => g.Count() > 1 ? $"{g.Key} ×{g.Count()}" : g.Key))
                                </p>
                            }
                        </section>
                    }
                </Together>
            </ShotImport>

            @* Outside the import, because logging a batch clears it: the readings are spent and
               the button that consumed them must not still be there, so the one thing that has
               to outlive them is the account of what happened. *@
            @if (_bulkLogged is { } done)
            {
                <Notice Severity="Notice.Level.Success" Class="mt-3">
                    Logged @done.Packs @Fmt.S(done.Packs, "pack")
                    and @done.Cards @Fmt.S(done.Cards, "card").
                    @* Said, because the count is short of the pictures that were on screen and
                       nothing else on the page explains the difference. A summary reading
                       "logged 9 packs" over a folder of ten is what makes someone count them. *@
                    @if (done.Skipped > 0)
                    {
                        <span>
                            @done.Skipped @Fmt.S(done.Skipped, "repeat") left out.
                        </span>
                    }
                    @if (_paid.Hourglasses > 0)
                    {
                        <span>
                            @_paid.Hourglasses pack @Fmt.S(_paid.Hourglasses, "hourglass") spent
                            on @_paid.FromHourglasses of them.
                        </span>
                    }
                    @if (done.Capped.Count > 0)
                    {
                        <span class="text-danger-emphasis">
                            @string.Join(", ", done.Capped) hit the @GameRules.PackPointsCap
                            pack-point cap. Spend before opening more.
                        </span>
                    }
                </Notice>
            }
        </div>

        @* The other thing a player acquires, which is not a pack and was not logged anywhere.
           ==================================================================================
           A promo arrives one at a time -- a Wonder Pick event, a mission, a campaign -- so there
           is no pack to log and a screenshot saves nothing: the finding IS the work. Recording one
           meant the collection, filtered to the promo set, scrolled past ninety cards you already
           have, for one tap.

           A button rather than tiles in the picker below. The picker is packs you decide to open
           and a promo is not one of those, so a promo sitting among the boosters would be offering
           a choice the game does not have.

           See RecentPromos for why this is the ten newest rather than the ones currently on offer:
           nothing in either dataset carries an event calendar, and card numbers are issued in
           release order, so recency is exact where availability is not knowable at all. *@
        @if (_promoSet is not null)
        {
            <button type="button" class="shot-open @(_promosOpen ? "on" : "")"
                    aria-expanded="@Aria.Flag(_promosOpen)" aria-controls="log-promos"
                    @onclick="TogglePromos">
                @* A ticket, because a promo is handed to you rather than opened. *@
                <span class="ico" aria-hidden="true">
                    <svg viewBox="0 0 16 16" width="17" height="17" focusable="false">
                        <path d="M1.7 4.2h12.6v2.4a1.4 1.4 0 0 0 0 2.8v2.4H1.7V9.4a1.4 1.4 0 0 0 0-2.8z"
                              fill="none" stroke="currentColor" stroke-width="1.5"
                              stroke-linejoin="round" />
                        <path d="M9.4 4.2v1.3M9.4 7.3v1.4M9.4 10.5v1.3" fill="none"
                              stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                    </svg>
                </span>
                Log a Promo
            </button>

            <div class="shot-panel promo-panel" id="log-promos" hidden="@(!_promosOpen)">
                @* Said plainly, because the list looks like a list of what is on offer and is not
                   one. The game publishes no event calendar and neither dataset carries one, so
                   the honest claim is the one about order. *@
                <p class="small text-body-secondary">
                    The @RecentPromos.Window newest in
                    @Session.Sets.DisplayName(_promoSet), newest first.
                </p>

                <ul class="promo-list">
                    @foreach (var card in _promos)
                    {
                        var promo = card;
                        var held = Session.CountOf(promo);

                        <li class="promo-row @(held > 0 ? "held" : "")">
                            @* One tap is one copy. Not a checkbox and not a toggle: a promo can be
                               earned again -- a repeatable mission, an event run twice -- so the
                               act is "add one", and pressing it four times is four copies. *@
                            <button class="take" @onclick="() => TakePromo(promo)"
                                    aria-label="@AddLabel(promo, held)">
                                <span class="thumb" style="@promo.ArtVars" aria-hidden="true"></span>
                                <span class="nm">
                                    <strong>@promo.Name</strong>
                                    <span class="sub">@promo.Set @promo.Number</span>
                                </span>
                                <span class="have" aria-hidden="true">@held</span>
                            </button>

                            @* The way back from a mis-tap. Ctrl+Z undoes it too, and this page is
                               used on a phone beside the game, where there is no Ctrl+Z. Only once
                               there is a copy to take back. *@
                            @if (held > 0)
                            {
                                <button class="drop" @onclick="() => DropPromo(promo)"
                                        aria-label="@($"Remove a copy of {promo.Name}")">&minus;</button>
                            }
                        </li>
                    }
                </ul>

                @* The escape, for a promo older than the window. Not a failure of the window --
                   ten is a guess about how often events run -- so it is offered rather than
                   apologised for. *@
                <a class="small" href="collection?set=@_promoSet">
                    Every @Session.Index.BySet[_promoSet].Count in
                    @Session.Sets.DisplayName(_promoSet)
                </a>
            </div>
        }

        @* One flat grid rather than a group per set. The per-set headings cost more vertical space
           than the tiles they labelled — eleven sets meant roughly thirty rem of headings and
           margins — so the set code lives on the tile instead. *@
        <div class="pack-picker" style="grid-template-columns:repeat(@Session.PackColumns,minmax(0,1fr))">
            @foreach (var pack in PacksShown())
            {
                var name = pack.Split(':')[1];
                var label = Session.PackLabel(pack);
                var set = pack.Split(':')[0];
                var pinned = Session.IsPackPinned(pack);

                @* A cell rather than a bare button, because the pin has to be a control of its
                   own: nesting a button inside a button is invalid, and the browser resolves it
                   by dropping one of them. *@
                <div class="pack-cell @(pinned ? "pinned" : "")">
                    <button class="pack-choice" @onclick="() => Choose(pack)" disabled="@Busy.IsBusy"
                            title="@label, @Session.PackSetLabel(pack)">
                        @* Stacked, not layered. Set logo above, booster below. Layering them in
                           one box looked wrong because the art is sized to `contain`, so the logo
                           bled out around its edges.

                           The booster is a `cover` background over a drawn placeholder: when the
                           art exists it fills the box completely and the placeholder is invisible;
                           when it does not (Paradox Drive has none) the placeholder shows. No
                           error handling and no state to get stuck in, unlike an <img> with
                           onerror, which hid a tile permanently after one aborted request. *@
                        @* An <img> rather than a background, alone on this tile, because it is the
                           one picture here that has something to say when it does not arrive: the
                           set's name, which is what the logo spells. A background cannot report a
                           failure and text under one would show through the transparent parts of
                           every logo that DID load, so the name is drawn by the image's own
                           pseudo-element -- which a browser renders only once the image is
                           broken. No script, and nothing to get stuck in: a spurious error costs
                           the name in place of the logo for one render, not a hidden tile. *@
                        <img class="logo" src="@PocketCard.SetLogoUrl(set)" alt=""
                             data-name="@Session.Sets.DisplayName(set)"
                             decoding="async" draggable="false" aria-hidden="true" />
                        <span class="art">
                            <span class="art-img"
                                  style="background-image:url('@Session.PackArtUrl(pack)')"></span>
                        </span>
                        <span class="nm">@label</span>
                        <span class="st">@set</span>
                        @if (GameRules.IsLimitedTimePack(name))
                        {
                            <span class="ltd">Ltd</span>
                        }
                    </button>

                    @* Always on the tile rather than revealed on hover: this page is used on a
                       phone beside the game, where there is no hover, and a control you can only
                       find with a mouse is no control at all. *@
                    <button class="pin-pack @(pinned ? "on" : "")" aria-pressed="@Aria.Flag(pinned)"
                            @onclick="() => Session.SetPackPinned(pack, !pinned)"
                            aria-label="@(pinned ? $"Unpin {label}" : $"Pin {label}")"
                            title="@(pinned ? $"Unpin {label}" : $"Pin {label} to the front")">
                        @(pinned ? "\u2605" : "\u2606")
                    </button>
                </div>
            }
        </div>
    </div>
    </PageShell>
}
else
{
    @* Pinned to the top for the whole task. The one control that finishes the job — "add N to
       collection" — was at the top of a grid of several hundred cards, so tapping the last card of
       a pack meant scrolling back up past everything you had just tapped to press it. The count
       beside it is the running total, which is the other thing worth having on screen throughout. *@
    <div class="page-head sticky-head">
        @* The words collapse to the arrow on a phone. This bar carries four things and only one of
           them says WHICH pack you are logging, so that is the one that must survive: with the
           full label here and "picked N" beside the button, a 375px header left the title about
           ten pixels and "Mega Altaria" rendered as "M.". The arrow is still the same control and
           still the same size to tap -- the aria-label carries the wording the eye loses. *@
        <BackLink Label="Change Pack" OnBack="Reset" Compact="true"
                  Title="Nothing typed here is kept." />
        <h1 class="title">@Session.PackLabel(_pack)</h1>
        @* The instruction has to match the view. In the tile grid a tap on a card picks it; in
           list mode a tap on a row does nothing and the row's own + is what picks. Telling
           someone to tap in a view where tapping does nothing is worse than saying nothing. *@
        <span class="subtitle">
            @_pack.Split(':')[0] &middot;
            @(Session.ListView ? "add each card that came out" : "tap each card that came out")
        </span>
        <span class="actions">
            @* Progress against what a pack holds, rather than a bare count. "Picked 3" is a fact
               about your typing; "3 of 5 named" is how far through the job you are, which is what
               a Record page's bar is for. Dropped on a phone, where the strip below says the same
               thing in the words that matter. *@
            <span class="small wide-only">@ProgressLabel</span>
            <button class="btn btn-sm btn-success" disabled="@(_picked.Count == 0 || Busy.IsBusy)" @onclick="Commit">
                Add to Collection
            </button>
        </span>
    </div>

    @* What is still to do, which is what a Record page leads with. Nothing on this page is true
       until the commit, so there is no figure to headline -- what there is instead is the gap
       between what you have typed and what a pack holds.

       ONE ELEMENT, TWO STATES, and the second state is the only one that warns.
       ==================================================================================
       The repo's existing finding stands and this keeps it: a live warning about the count is
       wrong for the whole time you are tapping, because one card into a five-card pack it is
       already "not five". So while you are picking this states progress and nothing else -- "one
       more card" is a fact about the job, not an alarm about it.

       It turns accent and names the consequence only when you press commit on a short pack, which
       is the moment the question is actually being asked. That was a separate warning strip that
       appeared then; making it the same element means the place you look for "how am I doing"
       is the place that answers "and what happens if I stop here".

       Not a block either way. A partial log is sometimes what you meant, so the second press goes
       through. *@
    @if (_miscount is { } warning)
    {
        <div class="todo-strip short">
            <span class="micro">Still to Do</span>
            <span class="say">
                @warning
            </span>
            <button class="btn btn-sm btn-warning" @onclick="CommitAnyway">
                Log @_picked.Count Anyway
            </button>
        </div>
    }
    else if (!PackFull)
    {
        <div class="todo-strip">
            <span class="micro">Still to Do</span>
            <span class="say">@TodoSay</span>
            @if (_picked.Count == 0)
            {
                @* Back to this page's own reader, not the collection's. The collection one records
                   cards and nothing else, so a pack read through it never reaches the pack log --
                   which is the whole of what someone on the Log page is here to write. Nothing has
                   been typed yet (that is the condition above), so dropping the picked pack costs
                   nothing: the picture names its own pack anyway. *@
                <button type="button" class="btn btn-link btn-sm p-0 align-baseline escape"
                        @onclick="ToShots">
                    Read It Off a Screenshot
                </button>
            }
        </div>
    }

    @* The pack's cards, as the pack's cards.
       ==================================================================================
       This was a row of name chips, which is a list of what you have typed. Five slots is a
       picture of the pack: how many came out, how many you have named, and which one is next --
       the same shape as the thing on the table in front of you, which is what you are copying
       from.

       The set is literal, which is the precondition: a pack holds five or six cards and the number
       is published. One empty slot is accented, because it is the next action; the rest are plain,
       because a row where every gap shouts says "five things to do" and the truth is "do this one
       next".

       Tapping a filled slot takes that card back out -- the chips' one job, kept. *@
    <div class="pack-slots">
        <BoxStrip Label="@($"The {SlotCount} cards")"
                  Clause="@(_picked.Count > 0 ? "tap one to remove it" : null)"
                  Columns="@SlotCount">
            @for (var i = 0; i < SlotCount; i++)
            {
                var slot = i;
                if (slot < _picked.Count)
                {
                    var card = _picked[slot];
                    <Box State="Box.Kind.Live" Label="@((slot + 1).ToString())">
                        <button class="slot-card" @onclick="() => Unpick(card)"
                                title="Remove @card.Name"
                                style="@card.ArtVars"></button>
                        <span class="slot-cap">
                            <span class="nm">@card.Name</span>
                            <span class="rr glyphs @Session.Index.GlyphClass(card)">@Session.Index.Symbol(card)</span>
                        </span>
                    </Box>
                }
                else
                {
                    <Box State="@(slot == _picked.Count ? Box.Kind.Todo : Box.Kind.Dead)"
                         Label="@((slot + 1).ToString())"
                         Note="@(slot == _picked.Count ? "next" : null)" />
                }
            }
        </BoxStrip>
    </div>

    @if (_justLogged is not null)
    {
        <PageShell Class="py-2">
        <Notice Severity="Notice.Level.Success" Class="mb-0">
            Logged @_justLogged.Value.cards cards.
            Pack points for @_justLogged.Value.set: <strong>@_justLogged.Value.points</strong>
            @* Only when it spent something. The setting is off by default and most packs are free
               ones, so this line is the exception rather than a permanent postscript. *@
            @if (_paid.Hourglasses > 0)
            {
                <span>&middot; @_paid.Hourglasses pack @Fmt.S(_paid.Hourglasses, "hourglass") spent.</span>
            }
            @if (_justLogged.Value.capped)
            {
                <span class="text-danger-emphasis">
                    (at the @GameRules.PackPointsCap cap). Spend before opening more.
                </span>
            }

            @* Having just opened one is good evidence that it is on the shelf, and the app assumes
               otherwise by default, so it asks rather than leaving the ranking excluding a pack
               you can buy. *@
            @if (_pack is not null && GameRules.IsLimitedTimePack(_pack.Split(':')[1])
                 && !Session.IsLimitedPackAvailable(_pack))
            {
                <div class="mt-1">
                    <button class="btn btn-sm btn-outline-success py-0"
                            @onclick="MarkPackOnSale">Mark @Session.PackLabel(_pack) on Sale</button>
                </div>
            }
        </Notice>
        </PageShell>
    }

    @* No remove mode here: a tap means "this came out of the pack", and the picked strip above is
       how you take one back. *@
    <CardGrid Cards="Shown" CountOf="Session.CountOf" Columns="Session.GridColumns"
              OnAdjust="OnTap" OnSweep="OnSweep" AllowRemove="false"
              PickedOf="PickedCount"
              ListView="Session.ListView" ListViewChanged="Session.SetListView"
              Roomy="Session.ListRoomy" RoomyChanged="Session.SetListRoomy"
              RungOf="Session.Index.Rung" TypeOf="Session.TypesOf" StageOf="Session.StageLabel"
              SortKeyOf="Session.Sets.SortKey"
              Summary="@PickedSummary"
              FactOf="Session.FactFor" FactsReady="Session.FactsReady">
        @* The screen where speed matters most was the one screen with no way to type. A pack holds
           up to two hundred and thirty cards and you are looking for five specific ones, so finding
           them meant scanning the whole grid five times. Names, not counts: the counts here are
           what you pulled, and those go in with a tap.

           The picked strip above is unfiltered, so narrowing the grid never hides what you have
           already logged -- which is what makes it safe to type a name, tap, and type the next. *@
        <Search>
            <input class="form-control form-control-sm grid-search"
                   placeholder="Find a card in this pack" aria-label="Find a card in this pack"
                   value="@_find" @oninput="OnFind" />
        </Search>

        <FilterChips>
            @if (_find is { Length: > 0 })
            {
                <button class="chip-filter" @onclick="ClearFind"
                        aria-label="Clear the name search">Name: @_find &times;</button>
            }
        </FilterChips>
    </CardGrid>

    @* What committing will do, at the bottom, where you are when you decide to.
       ==================================================================================
       Everything above this is about getting the five cards right. This is the only thing on the
       page about the act of saving them, and all three parts of it are things a user would
       otherwise find out afterwards: what the pack points become, that there is exactly one undo,
       and that logging another pack is a click rather than a journey back through the picker.

       A Record page cannot headline a figure -- nothing here is true until the commit -- but it
       can say what the figure will BE, which is a statement about the future rather than a reading
       of the present. *@
    <div class="commit-foot">
        <span>@PointsAfter</span>
        <span>One undo step, <kbd>Ctrl</kbd>+<kbd>Z</kbd>.</span>
        <button class="btn btn-sm btn-link again" @onclick="Reset">Log Another After This</button>
    </div>
}

@code {
    private string[] _packs = [];
    private string _series = "";
    private string? _pack;
    private IReadOnlyList<PocketCard> _inPack = [];

    /// <summary>Name search over the pack in front of you. Never touches what has been picked.</summary>
    private string _find = "";

    /// <summary>
    /// How many slots the strip draws: what this pack holds, or what has been picked if that is
    /// somehow more.
    ///
    /// The smallest published size where a set has two. A five-slot strip that grows a sixth when
    /// you name a sixth card is honest about both: five is what you expect, and the strip does not
    /// pretend the sixth has nowhere to go.
    /// </summary>
    private int SlotCount
    {
        get
        {
            var sizes = PackSizes;
            var target = sizes.Count == 0 ? 5 : sizes.Min();
            return Math.Max(target, _picked.Count);
        }
    }

    private readonly List<PocketCard> _picked = [];
    private (int cards, string set, int points, bool capped)? _justLogged;

    /// <summary>
    /// What the last logging drew from the hourglass balance. Reported rather than left silent: a
    /// setting that spends a stored resource has to say so on the occasion it spends it.
    /// </summary>
    private PackSpend _paid = PackSpend.None;

    /// <summary>
    /// A pack to open on arrival, so the Packs page can hand off the pack it just recommended
    /// instead of making you find it again in the picker.
    /// </summary>
    [Parameter, SupplyParameterFromQuery(Name = "pack")]
    public string? FromQuery { get; set; }

    /// <summary>
    /// The query value already acted on. Without this, choosing "a different pack" would be
    /// undone by the next render: the URL still carries the parameter, and re-applying it would
    /// silently drag you back to the pack you had just left.
    /// </summary>
    private string? _applied;

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnChanged;
        Busy.Changed += OnChanged;   // buttons disable while work is in flight
        await Session.InitAsync();
        if (Session.Ready)
        {
            // Openable packs only. Promo "Vol. N" groupings describe how a promo was given
            // away, not something you can decide to open.
            _packs = Session.Index.OpenablePackKeys.OrderBy(k => k, StringComparer.Ordinal).ToArray();
            // Newest series first: that is where packs are actually being opened.
            _series = Session.Sets.Series.LastOrDefault() ?? "A";

            // Resolved once. The set is a fact about the data rather than about the page, and
            // the list under it is ten cards that only change when a snapshot does -- so
            // recomputing either on render would be sorting a promo set on every tap.
            _promoSet = RecentPromos.CurrentSet(Session.Index, Session.Sets);
            _promos = _promoSet is null ? [] : RecentPromos.Newest(Session.Index, _promoSet);
        }

        ApplyQuery();
    }

    protected override void OnParametersSet() => ApplyQuery();

    /// <summary>
    /// The grid stays where it is when the slots above it grow.
    ///
    /// Tapping the first card of a pack fills a box that was empty with the card's art and a
    /// caption, so the strip goes from a row of outlines to a row of pictures and everything under
    /// it drops by about the height of one. What is under it is the grid you are tapping in, so
    /// the card you were aiming at next moves out from under your thumb at the exact moment you
    /// are looking at the slot rather than at the grid.
    ///
    /// The pack key is the token: choosing a different pack rebuilds the screen, and a position
    /// remembered from the pack before is not a change in height.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) _anchor = await ScrollAnchor.LoadAsync(JS);
        if (_anchor is not null) await _anchor.KeepAsync(".grid-wrap", _pack ?? "");
    }

    private ScrollAnchor? _anchor;

    /// <summary>
    /// Open the pack named in the URL, once. An unknown key is IGNORED rather than reported:
    /// a stale bookmark should land on the picker, which is where you were going anyway.
    /// </summary>
    private void ApplyQuery()
    {
        if (!Session.Ready || FromQuery is null || FromQuery == _applied) return;

        _applied = FromQuery;
        if (_packs.Contains(FromQuery, StringComparer.Ordinal))
        {
            // The series follows the pack, so backing out of it lands on the list that contains
            // it rather than on whichever series happened to be newest.
            _series = Session.Sets.SeriesOf(FromQuery.Split(':')[0]);
            ChooseCore(FromQuery);
        }
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    /// <summary>Packs of the chosen series, in set release order.</summary>
    private IReadOnlyList<string> PacksInSeries()
    {
        var order = Session.Sets.SetsIn(_series)
            .Select((code, i) => (code, i))
            .ToDictionary(x => x.code, x => x.i, StringComparer.OrdinalIgnoreCase);

        return _packs
            .Where(p => order.ContainsKey(p.Split(':')[0]))
            .OrderBy(p => order[p.Split(':')[0]])
            .ThenBy(p => p, StringComparer.Ordinal)
            .ToArray();
    }

    /// <summary>
    /// What the picker shows: pinned packs first, then the chosen series.
    ///
    /// Pins ignore the series filter deliberately — a pack you open every day is the one you want
    /// under your thumb whatever the dropdown says, and it is the trip through that dropdown the
    /// pin exists to remove. A pinned pack is still labelled with its set, and drawn with a filled
    /// star, so a pack from elsewhere never reads as part of the series below it.
    ///
    /// A pin for a pack that no longer exists is skipped rather than cleaned up: card data can
    /// load short, and silently discarding a pin because a snapshot was thin would lose it.
    /// </summary>
    private IReadOnlyList<string> PacksShown()
    {
        var pinned = Session.PinnedPacks
            .Where(p => _packs.Contains(p, StringComparer.Ordinal))
            .ToList();

        return pinned.Count == 0
            ? PacksInSeries()
            : [.. pinned, .. PacksInSeries().Where(p => !pinned.Contains(p, StringComparer.Ordinal))];
    }

    private void OnSeries(ChangeEventArgs e) => _series = e.Value?.ToString() ?? _series;

    private void OnCols(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var n)) Session.SetPackColumns(n);
    }

    private Task Choose(string pack) =>
        Busy.RunAsync($"Loading {Session.PackLabel(pack)}\u2026", () => ChooseCore(pack));

    private void ChooseCore(string pack)
    {
        _pack = pack;
        _justLogged = null;
        _paid = PackSpend.None;
        _miscount = null;
        _picked.Clear();
        // A name typed while looking for a card in the last pack would otherwise hide most of the
        // next one, with only a chip on the bar to explain why.
        _find = "";
        // Set then number, not number alone: a Deluxe pack contains reprints from earlier sets,
        // so ordering by number interleaves them.
        _inPack = Session.Index.ByPack.TryGetValue(pack, out var cards)
            ? cards.OrderBy(Session.Sets.SortKey, StringComparer.Ordinal).ToArray()
            : [];
    }

    private void Reset()
    {
        _pack = null;
        _picked.Clear();
        _justLogged = null;
        _paid = PackSpend.None;
        _miscount = null;
        _find = "";
    }

    /// <summary>
    /// Whether the screenshot reader on the picker screen starts open.
    ///
    /// Only ever set by the way in from the pack screen, and never read back: the disclosure is the
    /// user's to close after that, and a field that followed their toggling would reopen it on the
    /// next render for no reason they could see.
    /// </summary>
    private bool _shotsOpen;

    /// <summary>The promo set being filled, or null where the data has none. See <see cref="RecentPromos"/>.</summary>
    private string? _promoSet;

    /// <summary>The newest promos in it, newest first. Fixed for the life of the page.</summary>
    private IReadOnlyList<PocketCard> _promos = [];

    private bool _promosOpen;

    /// <summary>The counterpart of <see cref="TogglePromos"/>, and the same rule.</summary>
    private void ToggleShots()
    {
        _shotsOpen = !_shotsOpen;
        if (_shotsOpen) _promosOpen = false;
    }

    /// <summary>
    /// Opens the promo list, and shuts the screenshot reader if it was open.
    ///
    /// One at a time, because both sit above the pack grid and both are tall: two open panels put
    /// the grid off the bottom of a phone, and they are alternatives rather than steps — you are
    /// logging a pack or you are logging a promo. Shutting the reader does not cost its readings,
    /// which are hidden rather than unmounted.
    /// </summary>
    private void TogglePromos()
    {
        _promosOpen = !_promosOpen;
        if (_promosOpen) _shotsOpen = false;
    }

    /// <summary>One more copy of a promo. Not a pack, so nothing else moves.</summary>
    /// <remarks>
    /// No <see cref="PackOpenEvent"/>, no pack points, no hourglass. A promo is handed over by an
    /// event rather than opened, so a row in the pack log would be a pack that was never bought,
    /// and it would land in the odds check on History as a pack the model has no rates for.
    /// The collection is the whole of what changes.
    /// </remarks>
    private void TakePromo(PocketCard card) =>
        Session.SetCount(card, Session.CountOf(card) + 1);

    private void DropPromo(PocketCard card) =>
        Session.SetCount(card, Math.Max(0, Session.CountOf(card) - 1));

    /// <summary>
    /// What pressing a promo row does, said in full for a screen reader.
    ///
    /// The row's own text is the name, the number and a bare figure, which read aloud in order is
    /// "Absol PROMO-B 94 2" — three facts and no verb. The count is marked aria-hidden and said
    /// here instead, where it can be a sentence.
    /// </summary>
    private static string AddLabel(PocketCard card, int held) =>
        $"Add a copy of {card.Name}, {card.Set} {card.Number}. "
        + (held == 0 ? "You have none." : $"You have {held}.");

    /// <summary>
    /// The way from a picked pack to this page's own screenshot reader, which lives on the picker
    /// screen. Drops the pack on the way, because the picture names its own pack -- and because a
    /// pack picked by hand cannot be carried into a reading that may say a different one.
    /// </summary>
    private void ToShots()
    {
        _shotsOpen = true;
        Reset();
    }

    /// <summary>
    /// One choice, so <see cref="ShotImport"/> renders no picker: on this page the picture is a
    /// pack's reveal by definition. A Wonder Pick line-up looks identical and belongs on its own
    /// page, where it means something different.
    /// </summary>
    private static readonly (CardScreen? Value, string Label, string Hint)[] ShotChoices =
    [
        (CardScreen.PackReveal, "The cards from a pack", ""),
    ];

    /// <summary>
    /// Takes a reading and sets the page up as if the pack had been picked and the cards tapped.
    ///
    /// Deliberately stops there rather than committing. The screenshot has filled in the two
    /// tedious steps and the user still confirms with the same button they would have used anyway,
    /// against the same grid showing what was picked — so a card read wrongly is visible and
    /// fixable before anything reaches the collection.
    /// </summary>
    /// <summary>
    /// The picture and pack whose button has been pressed once, while pressing it costs the others.
    ///
    /// Keyed by both, because a picture can offer a shortlist of packs and pressing a different one
    /// is a different decision — it moves the question rather than answering it. Keyed by the
    /// reading's identity, which <see cref="ShotImport"/> holds steady between renders for this.
    /// </summary>
    private (ShotReading Reading, string Pack)? _confirmAdopt;

    /// <summary>
    /// Whether taking one picture into the workspace would throw the rest away. It does: the
    /// workspace holds one pack, so the page renders its other branch and the import goes with it.
    /// Nothing to warn about over a single picture, which is the case this page was built around.
    /// </summary>
    private bool AdoptCostsTheRest => (_shots?.Readings.Count ?? 0) > 1;

    /// <summary>
    /// Whether one picture is on screen, so logging it costs nothing else.
    /// </summary>
    private bool OnlyPicture => (_shots?.Readings.Count ?? 0) == 1;

    private bool Confirming(ShotReading reading, string pack) =>
        _confirmAdopt is { } c && ReferenceEquals(c.Reading, reading) && c.Pack == pack;

    private string AdoptWarning =>
        AdoptCostsTheRest
            ? "Clears the other pictures. To keep them, log them all below."
            : "";

    private void AdoptShot(ShotReading reading, string pack)
    {
        // Asked once, the way a delete is. Losing nineteen readings to a mis-tap is not undoable —
        // nothing was written, so there is nothing to undo, and the files have to be chosen again.
        if (AdoptCostsTheRest && !Confirming(reading, pack))
        {
            _confirmAdopt = (reading, pack);
            return;
        }

        _confirmAdopt = null;

        // Sets the pack and clears the picks, so the cards have to go in afterwards.
        ChooseCore(pack);

        // Everything except a card placed by its position in a list. Nothing on a reveal screen is
        // placed that way, but the reading type is shared with the card lists, where things are.
        // A slot the user named by hand counts: they were shown the card and said what it is, which
        // is a better answer than the fingerprint managed and the reason they were asked.
        foreach (var match in reading.Matches.Where(m => m.Source != MatchSource.GridPosition))
            _picked.Add(match.Card);
    }

    /// <summary>
    /// The pack, narrowed by the name box. Not cached: a pack is at most a few hundred cards and
    /// the filter runs on a keystroke, where the collection grid's cache exists because that one
    /// re-filters thousands on every tap.
    /// </summary>
    private IReadOnlyList<PocketCard> Shown
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_find)) return _inPack;

            // Folded once for the whole pass rather than per card. See SearchKey: "poke ball"
            // has to reach Poké Ball.
            var find = SearchKey.Fold(_find);
            return _inPack.Where(c => SearchKey.Has(c.Name, find)).ToArray();
        }
    }

    private void OnFind(ChangeEventArgs e) => _find = e.Value?.ToString() ?? "";

    private void ClearFind() => _find = "";

    // Tapping a card in this view means "this came out of the pack", not "+1 owned" — the
    // collection is only touched once the pack is committed, so a mis-tap costs nothing.
    private void OnTap((PocketCard Card, int Delta) e)
    {
        _miscount = null;
        if (e.Delta < 0) { Unpick(e.Card); return; }
        _picked.Add(e.Card);
    }

    private void OnSweep((IReadOnlyList<PocketCard> Cards, int Delta) e)
    {
        _miscount = null;
        if (e.Delta < 0) { foreach (var c in e.Cards) Unpick(c); return; }
        _picked.AddRange(e.Cards);
    }

    private int PickedCount(PocketCard card) => _picked.Count(c => c.Key == card.Key);

    /// <summary>
    /// What the grid's own bar reports here. It is the one strip that stays on screen, and its
    /// default -- how many cards are in scope -- answers a question nobody has on this page: the
    /// scope is one pack, and its size is fixed. How many you have picked out of how many the pack
    /// holds is the figure you are actually tracking, and it is the one that says when you are
    /// done.
    /// </summary>
    private RenderFragment PickedSummary => @<span class="@(PackFull ? "fw-semibold text-success-emphasis" : "")">
        @PickedLabel
    </span>;

    /// <summary>Pack sizes this set's published rates allow. Empty where the set has no rates.</summary>
    private IReadOnlyCollection<int> PackSizes =>
        _pack is null || Session.Odds is null
            ? []
            : Session.Odds.Rates.CardCounts(_pack.Split(':')[0]);

    /// <summary>Whether the picked count is a full pack, so the bar can say so without a warning.</summary>
    private bool PackFull => _picked.Count > 0 && PackSizes.Contains(_picked.Count);

    /// <summary>
    /// "picked 3 of 5", or just "picked 3" where the set has no published rates to say what a pack
    /// holds. A set with two pack sizes says both rather than picking one, since either is right.
    /// </summary>
    /// <summary>
    /// How far through the job you are, for the page bar. "3 of 5 named" rather than "picked 3":
    /// the second is a fact about your typing and the first is a fact about the pack, and a Record
    /// page's bar reports the job.
    /// </summary>
    private string ProgressLabel
    {
        get
        {
            var sizes = PackSizes;
            return sizes.Count == 0
                ? $"{_picked.Count} named"
                : $"{_picked.Count} of {string.Join(" or ", sizes.OrderBy(n => n))} named";
        }
    }

    /// <summary>
    /// What is left, in words, while the pack is still being typed.
    ///
    /// Deliberately not a warning. It is on screen for the whole of the task, so it says what
    /// remains rather than what is wrong -- "one more card" is a fact about the job and "you have
    /// picked four of five" is an accusation about it. The consequence of stopping early belongs
    /// to the moment you try to stop, which is the strip's other state.
    ///
    /// A set with no published rates has nothing to count toward, so it gets the instruction
    /// instead of a figure.
    /// </summary>
    private string TodoSay
    {
        get
        {
            var sizes = PackSizes;
            if (sizes.Count == 0)
                return _picked.Count == 0
                    ? "Name each card."
                    : "Name the rest.";

            var target = sizes.Min();
            var left = target - _picked.Count;

            if (_picked.Count == 0)
                return sizes.Count == 1
                    ? $"Name the {Words(target)} cards."
                    : "Name the cards.";

            return left <= 0
                ? "Name the rest."
                : left == 1 ? "One more card." : $"{Words(left)} more cards.";
        }
    }

    private static string Words(int n) => n switch
    {
        1 => "one", 2 => "two", 3 => "three", 4 => "four", 5 => "five", _ => n.ToString()
    };

    /// <summary>
    /// Where this set's pack points land once the pack is logged, and whether that matters.
    ///
    /// Points accrue per set and stop dead at the cap, so a pack opened while capped earns
    /// nothing at all -- which is worth knowing BEFORE the commit rather than discovering as a
    /// figure that did not move. Said as a destination rather than as a delta: "takes A4 to 1,175"
    /// is what you check against a price, where "+5" is arithmetic you then have to do.
    /// </summary>
    private string PointsAfter
    {
        get
        {
            if (_pack is null) return "";

            var set = _pack.Split(':')[0];
            var before = Session.Profile.Resources.PackPointsBySet.TryGetValue(set, out var p) ? p : 0;
            var after = Math.Min(GameRules.PackPointsCap, before + GameRules.PackPointsPerPack);

            return after == before
                ? $"{set} is at the {GameRules.PackPointsCap:N0}-point cap, so this pack earns none."
                : $"Takes {set} points to {after:N0} of {GameRules.PackPointsCap:N0}.";
        }
    }

    private string PickedLabel
    {
        get
        {
            var sizes = PackSizes;
            return sizes.Count == 0
                ? $"picked {_picked.Count}"
                : $"picked {_picked.Count} of {string.Join(" or ", sizes.OrderBy(n => n))}";
        }
    }

    /// <summary>
    /// Says so when the number of cards picked is not a number this pack can hold. Null while the
    /// count is plausible, or while the set has no published rates to check against.
    /// </summary>
    private string? MiscountHint
    {
        get
        {
            if (_pack is null || _picked.Count == 0) return null;

            var counts = PackSizes;
            if (counts.Count == 0 || PackFull) return null;

            var set = _pack.Split(':')[0];
            var sizes = counts.Count == 1
                ? $"{counts.First()} cards"
                : string.Join(" or ", counts.OrderBy(n => n)) + " cards";

            return $"A {set} pack holds {sizes}. You picked {_picked.Count}.";
        }
    }

    private void Unpick(PocketCard card)
    {
        _miscount = null;
        var i = _picked.FindLastIndex(c => c.Key == card.Key);
        if (i >= 0) _picked.RemoveAt(i);
    }

    /// <summary>
    /// The miscount question, once it has been asked. Null while there is nothing to ask or while
    /// the count is plausible; cleared whenever the selection changes, so answering it for four
    /// cards does not silently answer it for six.
    /// </summary>
    private string? _miscount;

    private Task Commit()
    {
        if (_pack is null || _picked.Count == 0) return Task.CompletedTask;

        // Asked once. The second press is CommitAnyway, which arrives with the answer.
        if (_miscount is null && MiscountHint is { } hint)
        {
            _miscount = hint;
            return Task.CompletedTask;
        }
        return CommitAnyway();
    }

    private Task CommitAnyway() =>
        _pack is null || _picked.Count == 0 ? Task.CompletedTask
        : Busy.RunAsync($"Adding {_picked.Count} cards\u2026", CommitCore);

    private void CommitCore()
    {
        if (_pack is null || _picked.Count == 0) return;

        var parts = _pack.Split(':');
        var set = parts[0];
        var keys = _picked.Select(c => c.OwnershipKey).ToList();
        var count = _picked.Count;

        var paid = PackSpend.None;

        Session.Mutate(p =>
        {
            var collection = new Dictionary<string, int>(p.Collection);
            foreach (var key in keys)
                collection[key] = (collection.TryGetValue(key, out var c) ? c : 0) + 1;

            // Pack points accrue per set and stop dead at the cap: packs opened while capped
            // earn nothing at all, which is worth telling the user about.
            var points = new Dictionary<string, int>(p.Resources.PackPointsBySet);
            var before = points.TryGetValue(set, out var pts) ? pts : 0;
            var after = Math.Min(GameRules.PackPointsCap, before + GameRules.PackPointsPerPack);
            points[set] = after;

            // What the pack cost, if it was past the day's free ones and the setting is on. Read
            // from p before the log below is appended, so this pack is not counted against its
            // own allowance.
            paid = Session.PayForPacks(p, 1);

            var log = new List<PackOpenEvent>(p.PackLog)
            {
                // Variant is unknown from the user's point of view; they just opened "a pack".
                // The cost rides on the row, so deleting it can give the hourglasses back.
                new(DateTimeOffset.Now, set, parts[1], "unknown", keys)
                {
                    Id = LogId.New(),
                    Hourglasses = paid.Hourglasses
                }
            };

            return p with
            {
                Collection = collection,
                Resources = p.Resources with
                {
                    PackPointsBySet = points,
                    PackHourglasses = p.Resources.PackHourglasses - paid.Hourglasses
                },
                PackLog = log
            };
        });

        var nowPoints = Session.Profile.Resources.PackPointsBySet.GetValueOrDefault(set);
        _justLogged = (count, set, nowPoints, nowPoints >= GameRules.PackPointsCap);
        _paid = paid;
        _miscount = null;
        _picked.Clear();
    }

    private void MarkPackOnSale()
    {
        if (_pack is not null) Session.SetLimitedPackAvailable(_pack, true);
    }

    // ---- logging a whole batch of pictures -------------------------------------------------

    /// <summary>The import control, so a batch that has been logged can be taken off the screen.</summary>
    private ShotImport? _shots;

    /// <summary>What the last batch came to, once one has been logged.</summary>
    private (int Packs, int Cards, IReadOnlyList<string> Capped, int Skipped)? _bulkLogged;

    /// <summary>
    /// The question raised by pressing Log, once it has been asked. Same one-press-then-confirm
    /// as a single pack.
    ///
    /// One field for both questions the batch can raise — a picture holding a count its pack
    /// cannot, and a picture repeating an opening already recorded. Two gates would mean two
    /// presses to get past two problems with one batch, which is a dialog to click through
    /// rather than a thing to read.
    /// </summary>
    private string? _bulkQuery;

    /// <summary>
    /// Whether <see cref="_bulkQuery"/> was raised by the skip-the-repeats button rather than the
    /// log-everything one, so its Anyway logs what was asked for. A pending question from the skip
    /// path also said nothing about repeats, so it must not wave Log All straight through.
    /// </summary>
    private bool _bulkSkips;

    /// <summary>
    /// One picture's worth of a batch: the pack its cards say it is, those cards, and what is
    /// wrong with it.
    ///
    /// The two faults ride on the picture rather than being counted over the batch, which is what
    /// makes <see cref="Batch.WithoutRepeats"/> possible: a batch with three of its twelve dropped
    /// has to recount how many of the REST are short, and a batch-level total cannot.
    /// </summary>
    /// <param name="Repeat">
    /// This opening is already recorded -- in the pack log, or earlier in this same batch. See
    /// <see cref="RepeatOpenings"/> for why that is a warning and not a refusal.
    /// </param>
    /// <param name="Miscount">This picture holds a number of cards its pack cannot.</param>
    private readonly record struct Opened(
        string Pack, IReadOnlyList<PocketCard> Cards, bool Repeat, bool Miscount);

    /// <param name="Ready">Pictures that name a pack, in the order they were read.</param>
    /// <param name="Unidentified">Pictures whose cards do not settle on one pack. Left for the per-picture buttons.</param>
    private readonly record struct Batch(IReadOnlyList<Opened> Ready, int Unidentified)
    {
        public int Cards => Ready.Sum(r => r.Cards.Count);

        /// <summary>Of the ready ones, how many repeat an opening that is already recorded.</summary>
        public int Repeats => Ready.Count(r => r.Repeat);

        /// <summary>Of the ready ones, how many hold a number of cards their pack cannot.</summary>
        public int Short => Ready.Count(r => r.Miscount);

        /// <summary>
        /// The same batch with the repeats dropped.
        ///
        /// The case this is for: nine packs opened in a sitting, screenshotted as you go, and one
        /// picture from yesterday's sitting still in the folder. Without this the choice was to
        /// log the duplicate along with the nine or to throw all ten away and re-choose the files
        /// -- and the readings are gone either way, since logging clears them.
        /// </summary>
        public Batch WithoutRepeats() =>
            this with { Ready = Ready.Where(r => !r.Repeat).ToArray() };
    }

    /// <summary>
    /// What a batch of pictures would log, worked out before anything is written.
    ///
    /// A picture that does not settle on one pack is left out rather than guessed at, and counted
    /// so the page can say how many were left. That is the same call <see cref="PackIdentifier"/>
    /// makes for a single picture — the difference is only that here the answer must not stop the
    /// other eleven.
    /// </summary>
    private Batch Plan(IReadOnlyList<ShotReading> readings)
    {
        var ready = new List<Opened>();
        var unidentified = 0;

        // Pictures already accounted for in THIS batch, so the second copy of one picture is
        // caught as well as a picture that repeats the log. Choosing the same folder twice puts
        // both cases on screen at once, and only the log knows about one of them.
        var seen = new HashSet<string>(StringComparer.Ordinal);

        foreach (var reading in readings)
        {
            // Recognised or named by hand, never placed by position -- see AdoptShot.
            var cards = reading.Matches
                .Where(m => m.Source != MatchSource.GridPosition)
                .Select(m => m.Card)
                .ToArray();

            var pack = PackIdentifier.Identify(Session.Index, reading).PackKey;
            if (pack is null || cards.Length == 0) { unidentified++; continue; }

            var parts = pack.Split(':');
            var keys = cards.Select(c => c.OwnershipKey).ToArray();

            var repeat = !seen.Add(RepeatOpenings.Fingerprint(parts[0], parts[1], keys))
                         || RepeatOpenings.Match(Session.Profile.PackLog, pack, keys) is not null;

            var sizes = Session.Odds is null
                ? (IReadOnlySet<int>)new HashSet<int>()
                : Session.Odds.Rates.CardCounts(parts[0]);

            var miscount = sizes.Count > 0 && !sizes.Contains(cards.Length);

            ready.Add(new Opened(pack, cards, repeat, miscount));
        }

        return new Batch(ready, unidentified);
    }

    /// <summary>
    /// Asked once, like the single-pack commit. Two things are worth a second press and both go
    /// through this one gate.
    ///
    /// A picture holding a count its pack cannot, because the odds check on History compares what
    /// was recorded against what the model predicted and a miscount there reads as the model being
    /// wrong. And a picture repeating an opening already recorded, which is what importing the
    /// same screenshot twice looks like from here.
    ///
    /// Asked once for the batch rather than once per picture — twelve identical questions is a
    /// dialog to click through rather than a question to answer.
    /// </summary>
    private Task LogAll(Batch plan)
    {
        if (plan.Ready.Count == 0) return Task.CompletedTask;

        if ((_bulkQuery is null || _bulkSkips) && Query(plan) is { } question)
        {
            _bulkQuery = question;
            _bulkSkips = false;
            return Task.CompletedTask;
        }

        return LogAllCore(plan);
    }

    /// <summary>
    /// The batch with its repeats left out, pressed before anything was asked.
    ///
    /// Choosing it answers the repeat question, so only a miscount among the ones kept can still
    /// stop it. Any question already on screen covers that: the batch's own names every short
    /// picture, kept or not.
    /// </summary>
    private Task LogNew(Batch plan)
    {
        var kept = plan.WithoutRepeats();

        if (_bulkQuery is null && Query(kept) is { } question)
        {
            _bulkQuery = question;
            _bulkSkips = true;
            return Task.CompletedTask;
        }

        return LogAllCore(kept, skipped: plan.Repeats);
    }

    /// <summary>
    /// What to ask before logging this batch, or null when there is nothing to ask.
    ///
    /// Repeats first when both apply. A batch that is already recorded is a batch that should
    /// probably not be logged at all, where a miscount is a batch that should be logged after a
    /// second look — so the stronger reason to stop leads.
    /// </summary>
    private string? Query(Batch plan)
    {
        var said = new List<string>();

        if (plan.Repeats > 0)
        {
            said.Add(
                $"{plan.Repeats} of these pictures "
                + $"{(plan.Repeats == 1 ? "records a pack" : "record packs")} already in your "
                + "history: same pack, same cards.");
        }

        if (plan.Short > 0)
        {
            said.Add(
                $"{plan.Short} of these {Fmt.S(plan.Short, "picture")} "
                + $"{(plan.Short == 1 ? "holds" : "hold")} a number of cards that pack cannot.");
        }

        return said.Count == 0 ? null : string.Join(" ", said);
    }

    /// <summary>
    /// The sentence to put beside one picture's own buttons, or null where that picture is not a
    /// repeat of anything.
    ///
    /// Said here as well as at the commit, because this is where the two routes that bypass the
    /// batch button are: opening the pack in the picker, and logging this one picture where it
    /// stands. It names the date, which is the part that settles it — a match from four minutes
    /// ago and a match from March are the same arithmetic and very different news.
    /// </summary>
    private string? RepeatNote(ShotReading reading, string pack)
    {
        var keys = reading.Matches
            .Where(m => m.Source != MatchSource.GridPosition)
            .Select(m => m.Card.OwnershipKey)
            .ToArray();

        if (keys.Length == 0) return null;

        var earlier = RepeatOpenings.Match(Session.Profile.PackLog, pack, keys);
        if (earlier is null) return null;

        return $"You already logged a {Session.PackLabel(pack)} pack with exactly these cards on "
               + $"{earlier.At.ToLocalTime():d MMM yyyy}.";
    }

    /// <summary>
    /// One picture, logged as a batch of one. The miscount question, the pack-point arithmetic and
    /// the account of what happened are the batch's, and none of them cares how many there were.
    /// </summary>
    private Task LogOne(ShotReading reading) => LogAll(Plan([reading]));

    /// <summary>The second press, which arrives with the answer.</summary>
    private Task LogAllAnyway()
    {
        var readings = _shots?.Readings ?? [];
        return readings.Count == 0 ? Task.CompletedTask : LogAllCore(Plan(readings));
    }

    /// <summary>
    /// The second press after <see cref="LogNew"/>: the repeats left out, the miscount answered.
    ///
    /// Re-planned from the readings rather than from the plan the first press computed, as
    /// <see cref="LogAllAnyway"/> does and for the same reason -- a confirm arrives without it.
    /// </summary>
    private Task LogOnlyNew()
    {
        var readings = _shots?.Readings ?? [];
        if (readings.Count == 0) return Task.CompletedTask;

        var plan = Plan(readings);
        return LogAllCore(plan.WithoutRepeats(), skipped: plan.Repeats);
    }

    /// <param name="skipped">
    /// Repeats dropped before this plan was built, for the account afterwards. The commit cannot
    /// work it out for itself -- it is handed the packs that survived and nothing about the ones
    /// that did not -- and a summary reading "logged 9 packs" over a folder of ten is the kind of
    /// silence that makes someone count them by hand.
    /// </param>
    private Task LogAllCore(Batch plan, int skipped = 0) =>
        plan.Ready.Count == 0
            ? Task.CompletedTask
            : Busy.RunAsync(
                $"Logging {plan.Ready.Count} {Fmt.S(plan.Ready.Count, "pack")}…",
                () => CommitBatch(plan, skipped));

    /// <summary>
    /// Every pack in the batch, in one mutation.
    ///
    /// One mutation rather than one per picture, for the reason the collection import gives: the
    /// undo history should hold "logged twelve packs" rather than twelve steps to walk back one at
    /// a time. It is also the only way the pack-point cap comes out right — points accrue per set
    /// and stop dead at the cap, so twelve packs of one set have to be added in sequence against a
    /// running total rather than each against the total as it was before any of them.
    /// </summary>
    private void CommitBatch(Batch plan, int skipped)
    {
        var opened = plan.Ready;
        if (opened.Count == 0) return;

        var capped = new List<string>();
        var paid = PackSpend.None;

        Session.Mutate(p =>
        {
            var collection = new Dictionary<string, int>(p.Collection);
            var points = new Dictionary<string, int>(p.Resources.PackPointsBySet);
            var log = new List<PackOpenEvent>(p.PackLog);
            var now = DateTimeOffset.Now;

            // The whole batch against the day's allowance in one go, before any of it is logged:
            // priced pack by pack it would charge the first free pack to the first picture and
            // then the allowance to the rest of them.
            paid = Session.PayForPacks(p, opened.Count);

            // Which packs of the batch the hourglasses paid for: the day's free ones are used up
            // first, so it is the next `paid.FromHourglasses` of them, in order. Spread per row
            // rather than held as a batch total, because rows are deleted one at a time.
            var free = paid.Free;
            var bought = paid.FromHourglasses;

            foreach (var (pack, cards, _, _) in opened)
            {
                var parts = pack.Split(':');
                var set = parts[0];
                var keys = cards.Select(c => c.OwnershipKey).ToList();

                var cost = 0;
                if (free > 0) free--;
                else if (bought > 0) { bought--; cost = GameRules.PackHourglassesPerPack; }

                foreach (var key in keys)
                    collection[key] = collection.GetValueOrDefault(key) + 1;

                var before = points.GetValueOrDefault(set);
                var after = Math.Min(GameRules.PackPointsCap, before + GameRules.PackPointsPerPack);
                points[set] = after;

                if (after >= GameRules.PackPointsCap && !capped.Contains(set)) capped.Add(set);

                // Variant is unknown from the user's point of view; they just opened "a pack".
                log.Add(new PackOpenEvent(now, set, parts[1], "unknown", keys)
                {
                    Id = LogId.New(),
                    Hourglasses = cost
                });
            }

            return p with
            {
                Collection = collection,
                Resources = p.Resources with
                {
                    PackPointsBySet = points,
                    PackHourglasses = p.Resources.PackHourglasses - paid.Hourglasses
                },
                PackLog = log,
            };
        });

        _bulkLogged = (opened.Count, plan.Cards, capped, skipped);
        _paid = paid;
        _bulkQuery = null;
        _bulkSkips = false;

        // The batch is spent. Left on screen it is a button that opens every one of these packs a
        // second time, and the summary above says what happened without it.
        _shots?.Clear();
    }

    public void Dispose()
    {
        Session.Changed -= OnChanged;
        Busy.Changed -= OnChanged;
    }

    public async ValueTask DisposeAsync()
    {
        if (_anchor is not null) await _anchor.DisposeAsync();
        _anchor = null;
    }
}
