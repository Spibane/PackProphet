@page "/card/{Key}"
@inject AppSession Session
@inject NavigationManager Nav
@inject NavHistory History
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>@(_card?.Name ?? "Card") · PackProphet</PageTitle>

@if (!Session.Ready)
{
    <Loading />
}
else if (_card is null)
{
    <PageShell Measure="PageShell.Width.Text">
        <p>No card with the code <code>@Key</code>.</p>
        <a class="btn btn-sm btn-primary" href="collection">Back to Collection</a>
    </PageShell>
}
else
{
    @* Focused on arrival and listening for Escape, which is the keyboard route back. Without it,
       returning meant hunting for the back button: it is early in the tab order, but nothing says
       so, and after reading a card focus is hard to place.

       tabindex -1 so it can take focus without joining the tab order, and no focus ring: it is
       plumbing for the key handler rather than somewhere anyone chose to be. *@
    <div class="detail-keys" tabindex="-1" @ref="_root" @onkeydown="OnKey">

    <div class="page-head">
        <BackLink Label="Back" OnBack="Back"
                  Title="Back (Escape)" />
        <h1 class="title">@_card.Name</h1>
        <span class="subtitle">@_card.Set&thinsp;@_card.Number</span>
        <span class="actions">
            @if (_rung is not null)
            {
                <span class="glyphs @_rung.GlyphClass" title="@_rung.Symbol">@_rung.Glyphs</span>
            }
            @if (_card.IsPromo)
            {
                <span class="badge text-bg-secondary">Promo</span>
            }
        </span>
    </div>

    <PageShell>
    <div class="card-detail">
        <div class="art">
            @* Background rather than <img>: a failed load leaves the placeholder instead of a
               broken-image gap, with no error handling needed.

               A button rather than an image, because it opens the art larger and a thing you press
               has to be reachable by something other than a mouse. Its label says what pressing it
               does rather than naming the card again -- the page's own h1 is the card's name, two
               lines above, and role="img" with the same text made a screen reader read it twice. *@
            <button type="button"
                    class="big-art @(Session.HasGoldFlair(_card) ? "gold-flair" : "")"
                    style="@_card.ArtVars" data-type="@TypeSlug"
                    popovertarget="card-zoom"
                    aria-label="Enlarge art"
                    title="Enlarge"></button>

            @* Said in words as well as drawn: the ring alone does not explain itself, and being
               two copies away is worth knowing. *@
            @if (Session.HasGoldFlair(_card))
            {
                <p class="small mb-0 flair-note">
                    Gold flair: @_owned copies.
                </p>
            }
            @* Same rule as the flair itself, so the hint does not promise gold to a four-diamond
               card that can never earn it. *@
            else if (_rung is { GlyphClass: "diamond" } r && !_card.IsPromo
                     && r.Count <= GameRules.GoldFlairMaxDiamonds && _owned > 0)
            {
                <p class="small text-body-secondary mb-0">
                    @(GameRules.GoldFlairCopies - _owned) more for gold flair.
                </p>
            }

            @* A box, with the label at one end and the stepper at the other. It was four items in a
               row that sized themselves, so the count floated wherever the label left it and the
               control had no edge of its own. *@
            <div class="own-row">
                <span class="label">Owned</span>
                <span class="steps">
                    <button class="step" @onclick="() => Bump(-1)"
                            disabled="@(_owned == 0)" aria-label="Remove one">&minus;</button>
                    <span class="count">@_owned</span>
                    <button class="step" @onclick="() => Bump(1)" aria-label="Add one">+</button>
                </span>
            </div>

            @* Wanting a card is a separate fact from owning it, and this is the screen that has
               the card in hand, so the chase lists live here rather than requiring another search
               from the list side. *@
            @* Stacked and full width, each the width of the card above them. They were an inline
               row that wrapped: "Want It", the heart, one list, then the next list alone on a
               second line at whatever width its name happened to be.

               No "Want It" label either. The button under it says Want it -- the label was the
               same two words again, in front of them. *@
            <div class="want-row">
                @* The same heart the collection grid has, on the same list, doing the same one
                   thing. It comes first and it is always here, whether or not that list exists yet
                   -- on a phone the tile hearts are hidden, so this is the only route to wanting a
                   card, and "no chase lists yet" must not be the reason there is no way to say so.
                   The curated lists follow it, where they can carry counts. *@
                @{ var hearted = Session.WantedOnHeartList(_card.OwnershipKey) > 0; }
                <button class="btn btn-sm want-heart @(hearted ? "on" : "")"
                        @onclick="() => Session.ToggleWanted(_card.OwnershipKey)"
                        aria-pressed="@Aria.Flag(hearted)">
                    <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" focusable="false">
                        <path d="M8 14S1.6 9.8 1.6 5.9A3.4 3.4 0 0 1 8 4.3a3.4 3.4 0 0 1 6.4 1.6C14.4 9.8 8 14 8 14z"
                              fill="@(hearted ? "currentColor" : "none")"
                              stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                    </svg>
                    @AppSession.WantListName
                </button>

                @{
                    // The hearts' own list is the button above, not one of the rows below: two
                    // controls for one list, disagreeing about whether a tap means "on" or "one
                    // more", is how you get a heart that appears to do nothing.
                    var curated = Session.ChaseLists.Where(w => w.Id != Session.Profile.WantListId).ToArray();
                }
                @if (curated.Length > 0)
                {
                    @foreach (var list in curated)
                    {
                        var wanted = list.Wanted.GetValueOrDefault(_card.OwnershipKey);
                        @* Each tap adds a copy, so wanting four is four taps. The separate remove
                           exists because there is no ceiling to cycle past. *@
                        <span class="want-pair">
                            <button class="btn btn-sm @(wanted > 0 ? "btn-primary" : "btn-outline-secondary")"
                                    @onclick="() => Session.BumpWanted(list.Id, _card.OwnershipKey, 1)"
                                    title="One more per tap.">
                                @list.Name@(wanted > 0 ? $" ×{wanted}" : "")
                            </button>
                            @if (wanted > 0)
                            {
                                <button class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => Session.BumpWanted(list.Id, _card.OwnershipKey, -1)"
                                        aria-label="One fewer on @list.Name">&minus;</button>
                            }
                        </span>
                    }
                }
            </div>

            @* Owning one copy counts for every set it appears in, so a reprint is not a second card
               to chase. Stated here because the number above would otherwise look wrong on a card
               listed in two sets. *@
            @if (_reprints.Count > 1)
            {
                <p class="small text-body-secondary mb-0">
                    Also listed as
                    @string.Join(", ", _reprints.Where(c => c.Key != _card.Key).Select(c => $"{c.Set} {c.Number}"));
                    one copy counts for all.
                </p>
            }
        </div>

        <div class="detail-main">
        @* THE ANSWER, first and in the shape every other Answer page uses.
           ==================================================================================
           "How to get it" was a heading two thirds of the way across a three-column page, over a
           strip of four boxes you had to read and compare to find the cheapest -- while the page
           led with a table of printed statistics nobody came here for.

           The cheapest route is the answer, so it is the display line, and the strip underneath is
           where it came from. Same lead, same micro label, same box strip as Which pack. *@
        <div class="verdict-lead">
            <span class="micro">How to Get It</span>

            <div class="lead-head">
                <div class="lead-text">
                    <h2 class="name @(_routes?.Cheapest is null ? "skip" : null)">@LeadFigure()</h2>
                    <p class="from">@LeadFrom()</p>

                    @if (LeadSays() is { Length: > 0 } says)
                    {
                        <p class="says">@says</p>
                    }

                    @* Only pull and pack points are priced in packs. Shinedust and stamina are
                       separate currencies with no exchange rate. *@
                </div>
            </div>

            @* Inside the lead, not after it. Both carry a rule -- the lead a border-bottom, the
               strip a border-top -- so as siblings they drew two hairlines 22px apart with the
               caveat stranded between them. Which pack nests it the same way, and for the better
               reason: the strip is where the figure above it came from, so it belongs to the
               answer rather than following it. *@

            @* Every route, including the ones that do not exist for this rarity, because the absence
           of a route is the answer as often as a price is: "you cannot trade for this" is what you
           came to find out when the card is a crown.

           A strip rather than the table this was, for exactly the reason BoxStrip exists. A table
           cell for an impossible route is blank, and blank reads as a figure that failed to load;
           a dashed box with the reason under it reads as the fact it is. The set is literal -- the
           game has these routes and no others -- which is the precondition.

           No bars. The four are priced in three currencies that do not exchange, and drawing them
           at one scale would invent a rate the game does not have. *@
            <BoxStrip Columns="@(_routes?.Options.Count ?? 4)">
                @foreach (var option in _routes?.Options ?? [])
                {
                @* Only the closed routes carry a note in the box, and it is the short one this
                   page writes. The engine's own notes are whole sentences -- they have to be, they
                   are explaining a price -- and five of them inside five boxes is a wall of prose
                   in the one place on the page that exists to be compared at a glance. They are
                   kept, under the strip, where they read as prose. *@
                    <Box Label="@RouteName(option.Route)"
                         State="@(!option.Available ? Box.Kind.Dead
                                  : option == _routes?.Cheapest ? Box.Kind.Best
                                  : Box.Kind.Live)"
                         Figure="@RouteFigure(option)"
                         Unit="@RouteUnit(option)"
                         Note="@(option.Available ? null : BlockReason(option.Block))" />
            }
            </BoxStrip>
        </div>

        @* The prose the boxes gave up, in full. Every word the table carried, and they are worth
           keeping: "points accrue while you open, so this is what you give up from a shared
           per-set budget, not extra packs" is the difference between a figure that means something
           and one that does not.

           The cheapest route's own note is not repeated here: it is the sentence in the lead. *@
        @if (OtherNotes().Count > 0)
        {
            <dl class="route-notes">
                @foreach (var option in OtherNotes())
                {
                    <dt>@RouteName(option.Route)</dt>
                    <dd>@option.Note</dd>
                }
            </dl>
        }

        <h2 class="sub-head">Packs</h2>
        @if (_packs.Count == 0)
        {
            <p class="small text-body-secondary">
                None.
            </p>
        }
        else
        {
            <div class="pack-links">
                @foreach (var packKey in _packs)
                {
                    <span class="pack-link">
                        <span class="pack-thumb"
                              style="--art:url('@Session.PackArtUrl(packKey)')"></span>
                        <span>
                            @Session.PackLabel(packKey)
                            <span class="small text-body-secondary">@packKey.Split(':')[0]</span>
                            @if (Session.UnavailablePacks.Contains(packKey))
                            {
                                <span class="badge text-bg-warning">Not on Sale</span>
                            }
                        </span>
                    </span>
                }
            </div>
        }

        @if (_printingPoints is int printPoints)
        {
            <p class="small text-body-secondary mt-2 mb-0">
                @* Per printing: alternate arts are priced far above their base card. *@
                This printing costs <strong>@printPoints.ToString("N0")</strong> pack points.
            </p>
        }

        @* THE CARD, second.
           ==================================================================================
           It was first, beside the routes in a column of its own: a six-row table of type, stage,
           HP, weakness, retreat and illustrator, taking a third of the page above the thing
           someone opened this page to find out.

           Printed facts are reference. They do not change, they are on the card itself, and the
           art is right there. So they read as one line under the answer -- and a line is what they
           are, rather than six rows of two cells where the left cell is always a label. *@
        <span class="micro">The Card</span>

        @if (_fact is null)
        {
            <p class="text-body-secondary">
                @if (!Session.FactsReady)
                {
                    <span>Loading card detail&hellip;</span>
                }
                else
                {
                    @* Not a dead end: art, rarity, packs and routes are all still shown. *@
                    <span>No card detail yet.</span>
                }
            </p>
        }
        else
        {
            <p class="fact-row">
                @* One item however many types the card has. A dual-typed Pokemon gets a pip and a
                   word each, which is the one place in the app with room to spell both out. *@
                @foreach (var sub in _fact.Subtypes)
                {
                    <span class="f">
                        @if (HasPip(sub))
                        {
                            <EnergyPip Type="@sub" />
                        }
                        @sub
                    </span>
                }

                @if (_fact.Stage is { Length: > 0 } stage)
                {
                    <span class="f">
                        @stage
                        @if (_fact.EvolvesFrom is { Length: > 0 } from)
                        {
                            <text>, from @from</text>
                            @* An evolution you cannot evolve is dead weight in a deck, and nothing
                               else on the page would say so. *@
                            @if (!OwnsAnyNamed(from))
                            {
                                @* Any printing will do: the game evolves on the printed name. *@
                                <span class="badge text-bg-warning ms-1">None Owned</span>
                            }
                        }
                    </span>
                }

                @if (_fact.Health is int hp)
                {
                    <span class="f">@hp HP</span>
                }
                @if (_fact.Weakness is { Length: > 0 } weak)
                {
                    <span class="f">Weak to @weak</span>
                }
                @if (_fact.Retreat is int retreat)
                {
                    <span class="f">Retreat @retreat</span>
                }
                @if (_fact.Artist is { Length: > 0 } artist)
                {
                    <span class="f">Art by @artist</span>
                }
            </p>

            @if (_fact.HasAbility)
            {
                <h2 class="sub-head">Ability: @_fact.Ability!.Name</h2>
                <p class="small">@(_fact.Ability.Effect ?? "")</p>
            }

            @if (_fact.AttackList.Count > 0)
            {
                <h2 class="sub-head">Attacks</h2>
                @foreach (var atk in _fact.AttackList)
                {
                    <div class="attack">
                        <span class="cost">
                            @foreach (var sym in atk.CostSymbols)
                            {
                                <EnergyPip Type="@sym" />
                            }
                        </span>
                        <strong>@atk.Name</strong>
                        @* Printed damage, so a multiplier or bonus is not lost. *@
                        @if (atk.DamageLabel is { Length: > 0 } dmg)
                        {
                            <span class="dmg">@dmg</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(atk.Effect))
                        {
                            <div class="effect small text-body-secondary">@atk.Effect</div>
                        }
                    </div>
                }
            }

            @if (_fact.CardText is { Length: > 0 } text)
            {
                <h2 class="sub-head">Card Text</h2>
                <p class="small">@text</p>
            }
        }
        </div>
    </div>
    </PageShell>

    </div>@* .detail-keys *@

    @* The art at twice the size, over the page.

       OUTSIDE .detail-keys, deliberately. That div answers Escape by navigating back, and while
       this is open Escape means "close this" -- inside it, one key would do both and you would
       land on the previous page. Out here the keydown never reaches it, because the popover takes
       focus when it opens.

       Twice the size the page draws it, which is twice the 15rem column above 760px and twice the
       width of the shell below it -- the breakpoint .card-detail itself switches on, so the two
       cannot disagree about which layout the art is in. On a phone that comes out wider than the
       screen and the box scrolls, which is the point: a card you are looking at closely is one
       whose printed text you are trying to read.

       Three ways out, none of them a glyph in a corner: the picture itself, the backdrop around
       it, and Escape. An X would be a 24px target over a surface that is entirely a target. *@
    <div class="art-zoom" popover id="card-zoom">
        <button type="button" class="zoom-art @(Session.HasGoldFlair(_card) ? "gold-flair" : "")"
                style="@_card.ArtVars" data-type="@TypeSlug"
                popovertarget="card-zoom" popovertargetaction="hide"
                aria-label="Close art" autofocus></button>
    </div>
}

@code {
    [Parameter] public string Key { get; set; } = "";

    /// <summary>The card's type, or its first of two, for the placeholder outline's colour.</summary>
    private string? TypeSlug => _card is null ? null
        : Session.TypesOf(_card) is [var type, ..] ? type.ToLowerInvariant() : null;

    private PocketCard? _card;
    private CardFact? _fact;
    private CardRoutes? _routes;
    private RarityRung? _rung;
    private IReadOnlyList<string> _packs = [];
    private IReadOnlyList<PocketCard> _reprints = [];
    private int? _printingPoints;
    private int _owned;

    /// <summary>
    /// Everything EnergyPip can draw: the energies, plus the trainer kinds it renders as
    /// outlined rings.
    /// </summary>
    private static readonly HashSet<string> PipTypes = new(StringComparer.OrdinalIgnoreCase)
    {
        "Grass", "Fire", "Water", "Lightning", "Psychic", "Fighting", "Darkness", "Metal",
        "Dragon", "Colorless", "Item", "Supporter", "Tool", "Stadium"
    };

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnChanged;
        await Session.InitAsync();
        Load();
    }

    protected override void OnParametersSet() => Load();

    public void Dispose() => Session.Changed -= OnChanged;

    private void OnChanged()
    {
        Load();
        InvokeAsync(StateHasChanged);
    }

    private void Load()
    {
        if (!Session.Ready) return;

        _card = Session.Index.ByKey.GetValueOrDefault(Key);
        if (_card is null) return;

        _owned = Session.CountOf(_card);
        _fact = Session.FactFor(_card);
        _rung = Session.Index.Rung(_card);
        _routes = Session.Routes?.For(_card, Session.Owned);

        // Only openable packs: a promo's "Vol. 3" grouping records how it was handed out at an
        // event, not something anyone can choose to open.
        var openable = Session.Index.OpenablePackKeys.ToHashSet(StringComparer.Ordinal);
        _packs = Session.Index.PacksYielding(_card.OwnershipKey)
            .Where(openable.Contains)
            .OrderBy(p => p, StringComparer.Ordinal)
            .ToArray();

        _reprints = Session.Index.ByOwnershipKey.GetValueOrDefault(_card.OwnershipKey) ?? [];

        // Per PRINTING, not per identity: an art rare and its base card share attacks and stage
        // but not price, so an identity lookup would report the base card's.
        _printingPoints = Session.Facts.ForPrinting(_card)?.PackPoints;
    }

    private void Bump(int delta)
    {
        if (_card is null) return;
        Session.SetCount(_card, Math.Max(0, _owned + delta));
    }

    /// <summary>
    /// Returns to whichever page opened this one — the collection, a deck, the pack ranking, or
    /// History. Falls back to the collection on a deep link, where there is nothing to return to.
    /// </summary>
    private void Back() => Nav.NavigateTo(History.LastListPage);

    private ElementReference _root;
    private bool _focused;

    /// <summary>
    /// Focus the page once on arrival, so Escape works without clicking first. Also the right thing
    /// for a screen reader after a client-side navigation, which otherwise leaves the cursor parked
    /// on whatever was clicked on the previous page.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await TopAsync();

        if (_focused || _card is null) return;

        _focused = true;
        try { await _root.FocusAsync(); }
        catch { /* the element is gone, or the browser refused; Escape simply needs a click first */ }
    }

    /// <summary>The card this page has already put the window at the top for.</summary>
    private string? _toppedFor;

    /// <summary>
    /// Start a card at the top of it.
    ///
    /// Blazor routes in place and nothing resets the scroll, so this page inherited whatever
    /// offset the page before it was at -- and coming from a scrolled card grid, which is far
    /// taller than one card, the browser clamped that offset to this page's own maximum and
    /// opened it at its bottom. A phone problem only: above the desk breakpoint the grid scrolls
    /// itself and the window was never moved.
    ///
    /// Keyed by the card rather than by first render, because this page navigates to itself --
    /// the reprints and the evolution line are links to other cards -- and those arrive as a
    /// parameter change with no new render cycle to hang "first" on. Not folded in with
    /// <see cref="_focused"/> for the same reason: that one is deliberately once per visit.
    /// </summary>
    private async Task TopAsync()
    {
        if (_card is null || _toppedFor == Key) return;

        _toppedFor = Key;

        try { await JS.InvokeVoidAsync("ppScroll.toPageTop"); }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
    }

    /// <summary>
    /// Escape goes back, which is the only keyboard route out that does not involve hunting. The
    /// grid it returns to puts the cursor back on this card, so reading about one costs nothing.
    /// </summary>
    private void OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") Back();
    }

    private static bool HasPip(string subtype) => PipTypes.Contains(subtype);

    /// <summary>
    /// Whether any printing with this name is owned. By NAME rather than identity, and that is
    /// correct rather than a shortcut: the game evolves on the printed name, so every Charmeleon
    /// is as good as every other. The ambiguity that killed name-based decklist import does not
    /// apply to a question phrased this way.
    ///
    /// Through CardName, because the name being looked up came from the facts dataset and the
    /// names being searched come from the card index, and the two write an apostrophe with
    /// different characters — which badged every Team Rocket evolution "You own none".
    /// </summary>
    private bool OwnsAnyNamed(string name) =>
        Session.Index.All.Any(c => CardName.Same(c.Name, name) && Session.CountOf(c) > 0);

    /// <summary>
    /// The figure for a route, in whichever currency prices it.
    ///
    /// One figure per box, because a box has one. Where a route costs two things -- a trade is
    /// shinedust AND a stamina -- the dust leads and the stamina goes in the note: they are not
    /// addable, so putting both on the figure line would read as a sum.
    /// </summary>
    /// <summary>
    /// The display line: what the cheapest way in costs, figure and unit together.
    ///
    /// The strip below prices every route, and the one someone is here for is the cheapest of
    /// them. Reading that off four boxes is work the page can do.
    /// </summary>
    private string LeadFigure()
    {
        if (_routes?.Cheapest is not { } best) return "No way in";

        var unit = RouteUnit(best);
        var figure = RouteFigure(best);

        // "free" already reads as a price, so pinning a unit to it produces "free but 1 a day" as
        // a headline. The clause belongs in the line under it.
        return figure == "free" ? "Free" : $"{figure} {unit}";
    }

    /// <summary>Which route that figure is, and -- for a pull -- which packs it comes out of.</summary>
    private string LeadFrom()
    {
        if (_routes?.Cheapest is not { } best)
            return "No route gives this card.";

        var route = RouteName(best.Route);
        if (best.Route != AcquisitionRoute.Pull || _packs.Count == 0) return route;

        var names = _packs.Select(Session.PackLabel).Distinct().ToArray();
        return names.Length switch
        {
            1 => $"{route} · {names[0]}",
            2 => $"{route} · {names[0]} or {names[1]}",
            _ => $"{route} · {names.Length} packs",
        };
    }

    /// <summary>
    /// The engine's own sentence for the cheapest route, which is the one explaining the figure
    /// above it. Written by the engine rather than here because it is the arithmetic talking:
    /// "points accrue while you open, so this is what you give up from a shared per-set budget".
    /// </summary>
    private string LeadSays() => _routes?.Cheapest?.Note ?? "";

    /// <summary>
    /// The notes for every OTHER route. The cheapest one's is in the lead, and printing it twice
    /// on one page reads as two different facts about one price.
    /// </summary>
    private IReadOnlyList<RouteOption> OtherNotes() =>
        (_routes?.Options ?? [])
            .Where(o => o.Available && o.Note is { Length: > 0 } && o != _routes?.Cheapest)
            .ToList();

    private static string RouteFigure(RouteOption option) => option switch
    {
        { Available: false } => "",
        { PacksEquivalent: double packs } => Fmt(packs),
        { Dust: int dust } => dust.ToString("N0"),
        { Stamina: int stamina } => stamina.ToString("N0"),
        { Points: int points } => points.ToString("N0"),
        // Available and priced in nothing at all, which is Share: no card back, no dust, no
        // stamina. It still needs a figure -- a live box with a blank where its number goes is the
        // exact failure the dashed box exists to avoid, and "free" is what the note already says.
        _ => "free",
    };

    private static string RouteUnit(RouteOption option) => option switch
    {
        { Available: false } => "",
        { PacksEquivalent: not null } => "packs",
        { Dust: not null } => "shinedust",
        { Stamina: not null } => "stamina",
        { Points: not null } => "pack points",
        // "free" is its own unit. What it actually costs is a day's allowance, and that is in the
        // note rather than here, because a day is not a currency the other boxes are counted in.
        _ => "but 1 a day",
    };

    /// <summary>
    /// Why a route is closed, in the words a player would use.
    ///
    /// The engine names the reason rather than just refusing, and this is the whole point of
    /// spending a box on an unavailable route: "not tradeable" is an answer, and an empty cell is
    /// not. A trade's stamina rides along here too, since it is a second cost rather than a
    /// second price.
    /// </summary>
    private static string BlockReason(RouteBlock block) => block switch
    {
        RouteBlock.NotSoldInPacks => "not sold in packs",
        RouteBlock.NoPullRates => "no published pull rates",
        RouteBlock.NotTradeable => "not tradeable at this rarity",
        RouteBlock.NotShareable => "not shareable at this rarity",
        RouteBlock.NotInWonderPick => "never offered in a Wonder Pick",
        RouteBlock.NoDustPrice => "no shinedust price",
        _ => "unavailable",
    };

    private static string RouteName(AcquisitionRoute route) => route switch
    {
        AcquisitionRoute.Pull => "Open Packs",
        AcquisitionRoute.PackPoints => "Pack Points",
        AcquisitionRoute.Trade => "Trade",
        AcquisitionRoute.Share => "Share",
        _ => "Wonder Pick"
    };

    private static string Fmt(double packs) => Text.Fmt.Packs(packs);
}
