@* One regenerating stamina pool. Wonder and Trade are structurally identical — cap 5, one unit per
   12 hours, 12 hourglasses for one unit — and differ only in what spending them costs, so they
   share this component. *@

@* A pool at its cap is the one state on this page that is costing you something, so the panel
   says so before the prose inside it does. Every other panel looks the same as it did: this is a
   mark on the one that needs reading, not a status colour on all of them. *@
<div class="pool @(Outlook.AtCap ? "at-cap" : "")">
    <div class="pool-head">
        <span class="nm">@Title</span>
        <span class="rate">@Outlook.Balance of @Outlook.Cap</span>
    </div>

    @* At the cap the advice inverts: a full pool has stopped regenerating, so waiting is a loss
       rather than thrift. Below it, the slack is stated instead — a pool three days from full does
       not need checking twice a day. *@
    @if (Outlook.AtCap)
    {
        <Notice Severity="Notice.Level.Warning" Dense="true" Class="mb-2">
            <strong>Full, so nothing is regenerating.</strong>
            @if (Outlook.WastedSinceFull > 0)
            {
                <span>
                    About @Outlook.WastedSinceFull more would have arrived by now if you had spent
                    some. That is gone, and the meter stays stopped until you do.
                </span>
            }
            else
            {
                <span>Every 12 hours from here is one you will not get back.</span>
            }
        </Notice>
    }
    else
    {
        <p class="small text-body-secondary mb-2">
            Next in @Short(Outlook.UntilNext) &middot; full in @Short(Outlook.UntilFull).
            @if (Outlook.UntilFull is { TotalHours: > 24 })
            {
                <span>No hurry until then. Nothing is being wasted yet.</span>
            }
        </p>
    }

    <div class="pool-figures">
        <div class="fig">
            <span class="v">@Outlook.Balance</span>
            <span class="l">Available Now</span>
        </div>
        <div class="fig">
            <span class="v">@Outlook.FromHourglasses</span>
            <span class="l">More from Hourglasses</span>
        </div>
        <div class="fig">
            <span class="v">@Outlook.Reachable</span>
            <span class="l">Spendable if you cash them</span>
        </div>
    </div>

    @* Only when there is one. Rendered unconditionally it left an empty paragraph -- a blank
       line and its margin -- under the two pools whose notes have been dropped. *@
    @if (!string.IsNullOrWhiteSpace(Note))
    {
        <p class="small text-body-secondary">@Note</p>
    }

    @* What was entered, and when, so a projected balance is never mistaken for a measured one. *@
    @if (Outlook.Balance != Outlook.Entered)
    {
        <p class="small text-body-tertiary mb-1">
            You told us @Outlook.Entered; the rest is regeneration since. Re-enter it if the game
            disagrees.
        </p>
    }

    <div class="pool-entry">
        <label class="small">
            Balance
            <select class="form-select form-select-sm" @onchange="OnBalance">
                @for (var n = 0; n <= Outlook.Cap; n++)
                {
                    <option value="@n" selected="@(n == _balance)">@n</option>
                }
            </select>
        </label>
        <label class="small">
            Hourglasses
            <input type="number" min="0" class="form-control form-control-sm"
                   value="@_hourglasses" @onchange="OnHourglasses" />
        </label>
        <button class="btn btn-sm btn-primary" @onclick="Save">Save</button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    [Parameter, EditorRequired] public PoolOutlook Outlook { get; set; } = default!;

    [Parameter] public int HourglassesPerUnit { get; set; } = GameRules.WonderHourglassesPerStamina;

    /// <summary>What spending this pool costs, which is the only thing that differs between them.</summary>
    [Parameter] public string Note { get; set; } = "";

    [Parameter] public EventCallback<(int Balance, int Hourglasses)> OnSave { get; set; }

    private int _balance;
    private string _hourglasses = "";
    private bool _touched;

    protected override void OnParametersSet()
    {
        // The projected balance is the sensible starting point for a correction, but only until
        // the user touches the control: re-seeding it afterwards would fight their typing every
        // time the session raised Changed.
        if (_touched) return;

        _balance = Outlook.Balance;

        // The raw balance, never FromHourglasses times twelve: that division floors, so seeding
        // the field from it silently rounded 1,751 down to 1,740 and the next save stored the
        // rounded figure.
        _hourglasses = Outlook.Hourglasses > 0 ? Outlook.Hourglasses.ToString() : "";
    }

    private void OnBalance(ChangeEventArgs e)
    {
        _touched = true;
        if (int.TryParse(e.Value?.ToString(), out var n)) _balance = Math.Clamp(n, 0, Outlook.Cap);
    }

    private void OnHourglasses(ChangeEventArgs e)
    {
        _touched = true;
        _hourglasses = e.Value?.ToString() ?? "";
    }

    private async Task Save()
    {
        await OnSave.InvokeAsync((_balance, Num.Count(_hourglasses)));
        // Released so the panel follows the saved figure again, which is now also the projection.
        _touched = false;
    }

    private static string Short(TimeSpan? t) => Fmt.Span(t);
}
