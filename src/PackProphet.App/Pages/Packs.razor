@page "/packs"
@implements IAsyncDisposable
@inject AppSession Session
@inject UiBusy Busy

<PageTitle>Which Pack · PackProphet</PageTitle>

@if (!Session.Ready)
{
    <Loading />
}
else
{
    <div class="page-head folded">
        <h1 class="title">Which Pack</h1>
        @* What the ranking is OF, said in words, because every figure below means something
           different once it changes. It was "Ranked for <scope>" with the plan itself a line
           further down inside the bar that set it -- so the page named half of its own premise and
           kept the other half folded away under the control that changes it.

           Led by the word on the button that changes it, so the reading and its control are named
           the same thing. *@
        <span class="subtitle">
            <span class="seg"><span class="lbl">Target:</span> @Session.ScopeLabel(Scope)</span>
            @if (!IsChaseScope)
            {
                <span class="seg">
                    <PlanSummary Plan="Draft" Foils="@(ScopeHasFoils ? Session.FoilCopies : 0)" />
                    @if (PlanScope is not null)
                    {
                        <text>, </text><span>@ScopedSet only</span>
                    }
                </span>
            }
            @if (OnSaleNow is { Length: > 0 } onSale)
            {
                <span class="seg">@onSale on sale</span>
            }
            @if (_pending)
            {
                <span class="chip-pending">
                    Updating&hellip;
                </span>
            }
        </span>

        <span class="actions">
            @* An Answer page gets no rail -- it leads with a verdict, not with content to browse --
               so its controls fold behind a button rather than standing up a second bar. *@
            <SheetOpener For="target-sheet" Label="Target" />
        </span>
    </div>

    @* What the ranking is of: the scope, the rarity plan, and which limited packs are on sale.
       Three controls of one kind -- each changes what is being ranked, so each changes every
       figure on the page -- and between them they were a bar plus a disclosure inside it. *@
    <PageSheet Id="target-sheet" Label="Target">
        @* Everything that sets what the ranking is OF, and nothing else. Scope, target and
           availability are one kind of control -- each changes what is being ranked, so each
           changes every figure on the page -- and between them they were a bar plus a disclosure
           folded inside it. Eleven chips alone wrapped to three lines at 375px, which is what put
           them behind that fold; a fold inside a sheet would be two doors on one room, so the
           sheet is the only one now. What the settings ARE is said in the page bar, so opening
           this is for changing them.

           No premium switch. It is a subscription -- set once, changed almost never -- and a
           control that permanent does not earn a place in something you pass through every time
           you ask which pack to open. It lives on Resources, beside the pack rate it modifies and
           the hourglass balance it is read against, which is where the arithmetic it changes is. *@

        @* Grouped by series so this stays usable as sets accumulate. *@
        <div class="rail-group">
            <span class="ttl">Ranking For</span>
            <ScopePicker Label="Target"
                         Grouped="true" Merged="true" Scope="@Scope" OnScope="OnScope" />
        </div>

        @* One chip per rarity, carrying its own copy count. Selection and quantity are the same
           fact — a rarity you want zero of is one you ignore — so a single control says both, and
           "two of each diamond, one of the stars" is a few taps. Tap to cycle none / 1 / 2.

           The chips edit the completion plan, which a chase list target does not consult, so under
           a chase list scope they are hidden rather than shown doing nothing. *@
        @if (!IsChaseScope)
        {
            <div class="rail-group">
            <span class="ttl">Copies Wanted</span>
            <span class="rarity-chips">
                <RarityChips Plan="Draft" OnCycle="CycleTier"
                             ShowFoils="ScopeHasFoils" OnCycleFoils="CycleFoils" />
            </span>

            @* Which plan the chips are editing, and how to reach the other one. This used to be
               a label reading "default" with no route to a per-set plan unless a single set was
               already scoped — so the word promised a distinction the page never offered. It
               now says what to do at every scope. Every other set follows the default; the
               override starts as a copy of it. *@
            <p class="plan-scope">
                @if (PlanScope is not null)
                {
                    <span><strong>@ScopedSet</strong> only.</span>
                    <button class="chip-link" @onclick="ClearOverride">Use the Default Here</button>
                }
                else if (ScopedSet is not null)
                {
                    <span>The <strong>default</strong> plan.</span>
                    <button class="chip-link" @onclick="StartOverride">
                        Give @ScopedSet Its Own
                    </button>
                }
                else
                {
                    <span>The <strong>default</strong> plan. Pick one set above to give it its own.</span>
                }
            </p>
            </div>
        }

        @* Availability is a live fact no dataset records. The app assumes off sale, and a
           Deluxe pack is otherwise the standout pick for a 4-diamond target, so the assumption
           changes every figure on the page — which is why it is a labelled control saying
           which way it is set rather than a bare switch. In here with the plan because it is
           the same kind of thing: what the ranking is allowed to consider. *@
        @if (Session.LimitedPacks.Count > 0)
        {
            <div class="rail-group">
            <span class="ttl">On Sale Now</span>
            <span class="avail">
                @* One chip per pack name, so every Deluxe set shares one switch. *@
                @foreach (var pack in Session.LimitedPackNames)
                {
                    var on = Session.IsLimitedPackNameAvailable(pack);
                    <button class="avail-chip @(on ? "on" : "off")"
                            @onclick="() => ToggleLimited(pack, !on)"
                            title="@(on ? null : "Left out of the ranking.")">
                        <span class="nm">@pack</span>
                        <span class="st">@(on ? "On Sale" : "Off Sale")</span>
                    </button>
                }
            </span>
            </div>
        }
    </PageSheet>

    <PageShell>

    @if (_outstanding == 0)
    {
        @* An empty, not a success. It was a green alert, which is the app's voice for "something
           you did worked" -- and nothing was done here; the ranking simply has nothing to rank. *@
        <EmptyState>
            <ChildContent>Nothing outstanding for this target.</ChildContent>
            <Action>
                <SheetOpener For="target-sheet" Label="Aim Higher" />
            </Action>
        </EmptyState>
    }
    else
    {

        @* The answer, before anything that supports it.
           ==================================================================================
           This page ranks packs, and a ranking's first row IS the answer -- but it was arriving as
           a tinted row in a table of a dozen, with the figure that matters in a column headed
           "Chance of a hit" and the arithmetic left for the reader to do. An Answer page leads
           with the verdict and spends the arithmetic in words.

           Which pack the block is about follows the ranking by default and follows your finger
           after that: tapping any row in the table below promotes that pack up here, so comparing
           two is reading one sentence twice rather than reading across five columns.

           Everything under it is unchanged and still says what it always said. This is a heading
           for a page that had none, not a replacement for what it heads. *@
        @* Two columns on a wide screen: the answer on the left, everything else ranked on the
           right.
           ==================================================================================
           The ranking is not supporting material -- it is the second half of the answer. "Open
           Charizard" means one thing on its own and another beside "and the next one is 4% behind",
           and reading the two as one thought is what the pair of columns is for. Below the desk
           width they stack, verdict first, because on a phone you are asking one question. *@
        <div class="answer-cols">
        <div class="answer-lead">
        @if (Verdict is { Standing: not null } lead)
        {
            var st = lead.Standing!;
            var chance = ChanceWords(st.ChanceUseful);
            <div class="verdict-lead">
                <span class="micro">@LeadLabel(lead)</span>

                <div class="lead-head">
                    @* Background rather than <img>, as the table's thumbnails are: a failed load
                       shows the placeholder instead of a broken-image gap, with nothing to
                       handle. *@
                    <span class="art" style="--art:url('@Session.PackArtUrl(lead.PackKey)')"
                          aria-hidden="true"></span>

                    <div class="lead-text">
                        <h2 class="name">@Session.PackLabel(lead.PackKey)</h2>
                        <p class="from">@Session.PackSetLabel(lead.PackKey)</p>

                        @* The figure in words, then the two that follow from it. "34.2%" is a
                           number you have to convert before you can act on it; "about 1 pack in 3"
                           is the same fact already converted. *@
                        <p class="says">
                            @chance.Lead<strong class="key">@chance.Figure</strong> gives you a
                            card you still need &mdash; roughly
                            <strong>@PackCount(st.PacksToNextUseful)</strong> between new cards,
                            <strong>@MorePacks(st.PacksToFinishItsShare)</strong> to finish its
                            share.
                        </p>

                        @* The same figure as calendar time, which is the one that changes a
                           decision: nobody plans in packs, they plan in days. *@
                        <p class="then">
                            At @GameRules.PacksPerDay(Premium) free packs a day, about
                            <strong>@Days(st.PacksToFinishItsShare, Premium)</strong>@if (!Premium)
                            {
                                <text>, or @Days(st.PacksToFinishItsShare, true) with premium</text>
                            }.
                        </p>
                    </div>
                </div>

                @* Where in the pack the chance actually is.
                   ==========================================================================
                   Five positions, and they are not alike: the first three come from the common
                   pool, so once you have finished the commons they can only ever give you a
                   duplicate. A single "chance of a hit" hides that entirely, and it is the whole
                   reason one pack beats another once a set is half done.

                   A dashed box says that position is dead, which an empty cell cannot -- blank
                   reads as missing data rather than as a fact.

                   The strip is legal here because the set of boxes is literal: a pack has five
                   cards, always, and they are on screen because the page has to explain itself
                   rather than because a chart seemed nice. *@
                @if (SlotStrip(lead.PackKey) is { Count: > 0 } slots)
                {
                    @* The set is literal -- a pack has five cards -- which is the precondition
                       BoxStrip documents. Bars, because these five figures are one quantity and
                       comparing them across the row is the point. *@
                    <BoxStrip Label="Where the Chance Is" Clause="@SlotClause(slots)"
                              Columns="@slots.Count">
                        @* The number and its sign as separate rows, which is what Box is for.
                           "P1" hands over "4.1 %" as one string, and at six columns on a phone
                           each box is about 53px wide -- so some of them wrapped between the
                           figure and the % and some did not, which staggered the bars. *@
                        @foreach (var slot in slots)
                        {
                            <Box State="@(slot.Chance > 0 ? Box.Kind.Live : Box.Kind.Dead)"
                                 Label="@Ordinal(slot.Position)"
                                 Figure="@((slot.Chance * 100).ToString("0.0"))" Unit="%"
                                 Bar="@slot.Chance" />
                        }
                    </BoxStrip>
                }

                <div class="lead-actions">
                    <a class="btn btn-sm btn-primary" href="log?pack=@Uri.EscapeDataString(lead.PackKey)">
                        Log a @Session.PackLabel(lead.PackKey) Pack
                    </a>
                    <span class="served">@CardCount(st.DemandsServed) it can give</span>
                </div>
            </div>
        }
        </div>

        @* The ranked list, as a summary rather than as the table. One row per pack: the picture,
           the name, what it can give, a bar and the chance. The table below keeps every column it
           had -- this is the shape you read the shortlist in, and that is the shape you read one
           pack's detail in. *@
        <div class="answer-ranked">
            <span class="micro">Everything Else, Ranked</span>
            <div class="ranked-rows">
                @foreach (var row in _rows.Where(r => r.Standing is not null).Take(RankedShown))
                {
                    var rs = row.Standing!;
                    <button class="ranked-row @(row.PackKey == Verdict?.PackKey ? "current" : "")"
                            @onclick="() => SelectPack(row.PackKey)">
                        <span class="art" aria-hidden="true"
                              style="--art:url('@Session.PackArtUrl(row.PackKey)')"></span>
                        <span class="nm">
                            <strong>@Session.PackLabel(row.PackKey)</strong>
                            <span class="sub">@row.Set &middot; @CardCount(rs.DemandsServed) it can give</span>
                        </span>
                        <span class="bar" aria-hidden="true">
                            <span style="inline-size:@((Math.Clamp(rs.ChanceUseful, 0, 1) * 100).ToString("F0"))%"></span>
                        </span>
                        <span class="pct">@rs.ChanceUseful.ToString("P1")</span>
                    </button>
                }
            </div>
            <p class="note">Tap a pack to read its verdict.</p>
        </div>
        </div>

        @* Every extra breakdown lives behind a tab here, at the top of the page, rather than below
           the ranking table &mdash; that table runs to dozens of rows across every priceable pack,
           and a control only reachable by scrolling past all of them may as well not exist.

           Tabs in one box, framed like the screenshot and promo boxes on the log screen. One open
           at a time: each is a separate question, and four stacked answers pushed the ranking off
           the screen. Tapping the open tab folds the box again. *@
        @* Labelled, and the table below it too. Folded, the bar sat on the table's header row and
           read as that table's own tabs. *@
        <div class="tool-box @(ToolOpen ? "on" : "")">
            <span class="micro" id="tool-box-label">Breakdowns</span>
            <div class="tool-tabs" role="tablist" aria-labelledby="tool-box-label">
                @if (!IsChaseScope)
                {
                    <button type="button" role="tab" class="tool-tab" id="tool-tab-advisor"
                            aria-selected="@Aria.Flag(_advisorOpen)" aria-controls="packs-tool"
                            @onclick="() => SelectTool(Tool.Advisor)">Cost per Rarity</button>
                }
                <button type="button" role="tab" class="tool-tab" id="tool-tab-batch"
                        aria-selected="@Aria.Flag(_batchOpen)" aria-controls="packs-tool"
                        @onclick="() => SelectTool(Tool.Batch)">Buying @GameRules.PacksPerBatch at Once</button>
                <button type="button" role="tab" class="tool-tab" id="tool-tab-allocate"
                        aria-selected="@Aria.Flag(_allocateOpen)" aria-controls="packs-tool"
                        @onclick="() => SelectTool(Tool.Allocate)">Splitting a Budget</button>
                <button type="button" role="tab" class="tool-tab" id="tool-tab-points"
                        aria-selected="@Aria.Flag(_pointsOpen)" aria-controls="packs-tool"
                        @onclick="() => SelectTool(Tool.Points)">Pack Points</button>
            </div>

            <div class="tool-panel" id="packs-tool" role="tabpanel" hidden="@(!ToolOpen)"
                 aria-labelledby="@TabId">
                @if (_advisorOpen && !IsChaseScope)
                {
                    <div class="mb-3">
                        <DataTable Label="Cost per rarity, at one copy and two" Fit="true">
                            <thead>
                                <tr><th scope="col">Rarity</th><th scope="col" class="num">1 Copy</th><th scope="col" class="num">2 Copies</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var (rung, one, two) in _advisor)
                                {
                                    <tr class="@(Draft.Wants(rung.Index) ? "table-active" : "")">
                                        <td><span class="glyphs @rung.GlyphClass">@rung.Symbol</span> @(Draft.Wants(rung.Index) ? $"(x{Draft.Copies(rung.Index)})" : "")</td>
                                        <td class="num">@Fmt(one)</td>
                                        <td class="num">@Fmt(two)</td>
                                    </tr>
                                }
                            </tbody>
                        </DataTable>
                        <p class="small text-body-secondary mb-0">
                            Packs to finish <em>that rarity alone</em>.
                        </p>
                    </div>
                }

                @if (_batchOpen)
                {
                    <div class="mb-3">
                        @* The game sells ten of a set in one action, so the batch gets a real answer
                           rather than being left to intuition. *@
                        @* Two clauses on why a batch cannot beat ten singles went with the copy cut.
                           The reader came here to pick a set, not to be talked out of the button. The
                           figures cover the whole batch, which the first column heading says. *@

                        @if (_batches.Count == 0)
                        {
                            <p class="small text-body-secondary mb-0">Nothing a pack can supply.</p>
                        }
                        else
                        {
                            <DataTable Label="Expected result per batch of packs" Fit="true">
                                <thead>
                                    <tr>
                                        <th scope="col">@GameRules.PacksPerBatch Packs Of</th>
                                        <th scope="col" class="num">New Cards Expected</th>
                                        <th scope="col" class="num">Chance of Nothing New</th>
                                        <th scope="col" class="num">Against the Best</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var b in _batches.Take(10))
                                    {
                                        var best = _batches[0].ExpectedNewCards;
                                        <tr class="@(b == _batches[0] ? "row-best" : "")">
                                            <td>
                                                <span class="pack-thumb"
                                                      style="--art:url('@Session.PackArtUrl(b.PackKey)')"></span>
                                                <strong>@Session.PackLabel(b.PackKey)</strong>
                                                <span class="text-body-secondary small">@b.PackKey.Split(':')[0]</span>
                                            </td>
                                            <td class="num">@b.ExpectedNewCards.ToString("N1")</td>
                                            @* The figure a per-pack probability hides: ten packs that
                                               advance nothing. *@
                                            <td class="num">
                                                @(b.ChanceOfNothing < 0.001 ? "—" : b.ChanceOfNothing.ToString("P1"))
                                            </td>
                                            <td class="num">
                                                @if (b == _batches[0])
                                                {
                                                    <span class="fw-semibold">Best</span>
                                                }
                                                else
                                                {
                                                    <span>&minus;@((best - b.ExpectedNewCards).ToString("N1"))</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </DataTable>
                            @* The "not priced here" caveat is gone: a note on what the figures do not
                               model is an answer to a question the table never raises. *@
                        }
                    </div>
                }

                @if (_allocateOpen)
                {
                    <div class="mb-3">
                        @* No single pack can complete a multi-set target, so a fixed budget is worth
                           splitting rather than sinking into whichever pack currently ranks first. *@

                        <div class="d-flex align-items-center gap-2 mb-2">
                            <label for="allocate-budget" class="small text-body-secondary">Packs</label>
                            <input id="allocate-budget" type="number" min="1" max="1000"
                                   class="form-control form-control-sm w-auto"
                                   @bind="_allocateBudget" @bind:after="BuildAllocation" />
                        </div>

                        @if (_allocation is null || _allocation.Rows.Count == 0)
                        {
                            <p class="small text-body-secondary mb-0">Nothing a pack can supply.</p>
                        }
                        else
                        {
                            <DataTable Label="Packs to buy" Fit="true">
                                <thead>
                                    <tr>
                                        <th scope="col">Pack</th>
                                        <th scope="col" class="num">Packs to Buy</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in _allocation.Rows)
                                    {
                                        <tr>
                                            <td>
                                                <span class="pack-thumb"
                                                      style="--art:url('@Session.PackArtUrl(row.PackKey)')"></span>
                                                <strong>@Session.PackLabel(row.PackKey)</strong>
                                                <span class="text-body-secondary small">@row.Set</span>
                                            </td>
                                            <td class="num">@row.Packs</td>
                                        </tr>
                                    }
                                </tbody>
                            </DataTable>
                            <p class="small text-body-secondary mb-0">
                                Expected: @_allocation.ExpectedNewCards.ToString("N1") of @_outstanding cards,
                                @_allocation.ChanceOfFinishing.ToString("P1") chance of all.
                            </p>
                        }
                    </div>
                }

                @if (_pointsOpen)
                {
                    <div class="mb-3">
                        @* Pack points are a byproduct of opening rather than an alternative to it: you
                           earn five per pack whatever you do. So this panel asks which cards deserve a
                           limited, per-set budget rather than "buy or pull?". The earn rate, the cap and
                           the per-set rule are the game's, and the game states them. *@
                        <p class="small text-body-secondary">
                            Logging a pack adds its points. Enter any balance you already had.
                        </p>

                        @if (_capWarnings.Count > 0)
                        {
                            <Notice Severity="Notice.Level.Warning">
                                @foreach (var warning in _capWarnings)
                                {
                                    <div>
                                        <strong>@warning.Set</strong>
                                        @if (warning.AtCap)
                                        {
                                            <span>is at the cap. Spend before you open.</span>
                                        }
                                        else
                                        {
                                            <span>reaches the cap in @warning.PacksUntilCap more @Text.Fmt.S(warning.PacksUntilCap, "pack").</span>
                                        }
                                    </div>
                                }
                            </Notice>
                        }

                        <DataTable Label="Pack point balances per set" Fit="true">
                            <thead>
                                <tr>
                                    <th scope="col">Set</th>
                                    <th scope="col" class="num">Balance</th>
                                    <th scope="col" class="num">Packs to Cap</th>
                                    <th scope="col">Could Buy Now</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in _pointRows)
                                {
                                    <tr class="@(row.AtCap ? "table-warning" : "")">
                                        <td>
                                            <strong>@row.Set</strong>
                                            <span class="small text-body-secondary ms-1">@Session.Sets.DisplayName(row.Set)</span>
                                        </td>
                                        <td class="num">
                                            <input class="form-control form-control-sm text-end" style="width:5.5rem"
                                                   type="number" min="0" max="@GameRules.PackPointsCap"
                                                   step="@GameRules.PackPointsPerPack"
                                                   value="@row.Balance" @key="(row.Set, _snapped)"
                                                   @onchange="e => SetBalance(row.Set, e)"
                                                   aria-label="@($"Pack points in {row.Set}")" />
                                        </td>
                                        <td class="num">@(row.AtCap ? "—" : row.PacksUntilCap.ToString())</td>
                                        <td class="small">
                                            @if (row.AffordableNow.Count == 0)
                                            {
                                                <span class="text-body-tertiary">Nothing Needed</span>
                                            }
                                            else
                                            {
                                                <span>@row.AffordableNow.Count @Text.Fmt.S(row.AffordableNow.Count, "card")</span>
                                                <span class="text-body-secondary">
                                                    (dearest: @row.AffordableNow[0].Name)
                                                </span>
                                                @* The plan is finished here and the balance can only be
                                                   spent in this set, so these are cards from outside it. *@
                                                @if (row.BeyondTarget)
                                                {
                                                    <span class="d-block text-body-tertiary">Outside the Plan</span>
                                                }
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </DataTable>

                        <h2 class="sub-head">Where Points Are Worth Spending</h2>
                        @if (_pointsShop.Count == 0)
                        {
                            <p class="small text-body-secondary mb-0">Nothing worth buying with points.</p>
                        }
                        else
                        {
                            @* Ranked by packs saved per pack's worth of points, not by price: a Crown
                               returns about 2.5, an Immersive 0.3. Anything at or below 1.0 is left out. *@
                            <DataTable Label="Where Points Are Worth Spending" Fit="true">
                                <thead>
                                    <tr>
                                        <th scope="col">Card</th>
                                        <th scope="col" class="num">Pull</th>
                                        <th scope="col" class="num">Points</th>
                                        <th scope="col" class="num">Packs Saved per Pack of Points</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in _pointsShop.Take(12))
                                    {
                                        <tr>
                                            <td>
                                                <span class="pack-thumb deck-thumb"
                                                      data-tip-img="@row.Card.ArtUrl" data-tip="@row.Card.Name"
                                                      style="@row.Card.ArtVars"></span>
                                                <strong>@row.Card.Name</strong>
                                                <span class="small text-body-secondary ms-1">@row.Card.Set&thinsp;@row.Card.Number</span>
                                            </td>
                                            <td class="num">@Fmt(row.PullPacks)</td>
                                            <td class="num">@Fmt(row.PointsPacks)</td>
                                            <td class="num fw-semibold">@row.Value.ToString("0.0")&times;</td>
                                        </tr>
                                    }
                                </tbody>
                            </DataTable>
                        }
                    </div>
                }

            </div>
        </div>

        <span class="micro table-label">All Packs</span>
        <DataTable Label="Packs ranked for your target" Class="pack-table" Bleed="true">
            <thead>
                <tr>
                    <th scope="col" data-pri="1">Pack</th>
                    <th scope="col" class="num" data-pri="1">Chance of a Hit</th>
                    <th scope="col" class="num" data-pri="2">Packs per New Card</th>
                    <th scope="col" class="num" data-pri="3">To Finish Its Share</th>
                    <th scope="col" class="num" data-pri="3">Cards It Can Give</th>
                    @* The action, in its own column rather than among the badges in the name cell:
                       it sits in the same place on every row, and the name cell already carries up
                       to four badges. *@
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @* Every pack that could serve the target, including the ones that cannot be bought
                   or priced today. Those sit in the table like any other pack, marked, rather than
                   off in a warning: a pack you are waiting on is still part of the answer, and its
                   numbers belong beside its rivals. They are excluded from the estimate rather
                   than from the list. *@
                @foreach (var row in _rows)
                {
                    var s = row.Standing;
                    @* Compared by KEY, not by value. PackStanding is a record, so two packs
                       with identical odds — which happens, since the three A1 packs share most
                       of their contents — would both compare equal to the winner and both light
                       up as "the best". *@
                    <tr class="@(row.Best ? "row-best" : "") @(row.Mark is null ? "" : "pack-row-muted") pack-row-click"
                        @onclick="() => SelectPack(row.PackKey)">
                        @* Three inline things in one cell is fine until the cell is 190px wide,
                           which is what a phone leaves after the three figures beside it. Then a
                           long name wraps back under the expander and the thumbnail, and its set
                           code lands on a third line, so the row is 130px tall and the code no
                           longer reads as belonging to the name above it.

                           Marker and text as two flex items instead, the text free to wrap inside
                           its own column. Inside the cell rather than on it, because a `td` told
                           to be a flex container leaves the table formatting context and takes
                           the column alignment with it. *@
                        <td>
                          <span class="pack-cell">
                            <span class="expander" aria-hidden="true">@(_expanded == row.PackKey ? "▾" : "▸")</span>
                            @* Background, not <img>: a failed load reveals the placeholder
                               instead of leaving a broken-image gap, with no error handling. *@
                            <span class="pack-thumb"
                                  style="--art:url('@Session.PackArtUrl(row.PackKey)')"></span>
                            <span class="pack-name">
                            <strong>@Session.PackLabel(row.PackKey)</strong>
                            <span class="text-body-secondary small">@row.Set</span>
                            @* The top row is tinted, and a tint with nothing to explain it reads
                               as a stray selection rather than as the answer to the page's
                               question. *@
                            @if (row.Best)
                            {
                                <span class="badge text-bg-primary ms-1">Open This</span>
                            }
                            @if (row.Mark is { Length: > 0 } mark)
                            {
                                <span class="badge text-bg-warning ms-1" title="@row.MarkTitle">@mark</span>
                            }
                            @* A borrowed distribution is an estimate rather than measured data, so
                               every row it prices says so. *@
                            @if (Session.AssumedRates.TryGetValue(row.Set, out var donor))
                            {
                                @* The donor's distributions applied to this set's own contents. *@
                                <span class="badge text-bg-secondary ms-1">
                                    Rates Assumed from @donor
                                </span>
                            }
                            @* Offered where the problem is visible. A released set with no
                               published rates is otherwise reported as unpullable, which is true
                               and unhelpful: the cards drop, and the standard five-card
                               distribution has barely changed in two years. A Deluxe set borrows
                               from another Deluxe set, or is not offered a donor at all. *@
                            @if (row.CanAssume && Session.RateDonorFor(row.Set) is { } standard)
                            {
                                <button class="btn btn-sm btn-outline-primary py-0 ms-2"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => Assume(row.Set, standard)">
                                    Estimate with @standard's Rates
                                </button>
                            }
                            @if (GameRules.IsDeluxePack(row.PackName))
                            {
                                <span class="badge text-bg-info ms-1">Guaranteed 4&#9670;</span>
                            }
                            </span>
                          </span>
                        </td>
                        @* Dashes rather than zeroes where a pack has no published rates. A zero
                           would say "this pack cannot help", when the truth is that nobody knows
                           the odds yet. *@
                        <td class="num" data-pri="1">@(s is null ? "—" : s.ChanceUseful.ToString("P1"))</td>
                        <td class="num" data-pri="2">@(s is null ? "—" : Fmt(s.PacksToNextUseful))</td>
                        <td class="num" data-pri="3">@(s is null ? "—" : Fmt(s.PacksToFinishItsShare))</td>
                        <td class="num" data-pri="3">@(s?.DemandsServed ?? row.CardsServed)</td>
                        @* Straight to logging this pack. Offered on every row, including the ones
                           marked unavailable or unpriceable: what you actually opened is a fact,
                           and the app's assumption about the shelf should not stop it being
                           recorded. *@
                        <td class="act">
                            @* `py-0` made this the one control in the app with no vertical
                               padding: a 20px target in a 44px row, which both undershot the
                               touch minimum and sat visibly low against the text beside it. *@
                            <a class="btn btn-sm btn-outline-secondary"
                               href="@LogHref(row.PackKey)"
                               @onclick:stopPropagation="true"
                               title="Log a @Session.PackLabel(row.PackKey) pack">Log</a>
                        </td>
                    </tr>

                    @* Which cards, not just how many. The count alone cannot tell you whether a
                       pack is worth opening: five commons and one Crown rank the same. *@
                    @if (_expanded == row.PackKey)
                    {
                        <tr class="pack-detail">
                            <td colspan="6">
                                @{ var supplied = SuppliedBy(row.PackKey); }
                                @if (supplied.Count == 0)
                                {
                                    <p class="small text-body-secondary mb-0">
                                        Nothing outstanding. Reopen the page.
                                    </p>
                                }
                                else
                                {
                                    @* Trade and Wonder Pick are priced in their own currencies and
                                       never converted into packs. *@
                                    <div class="small text-body-secondary mb-1">
                                        @supplied.Count @Text.Fmt.S(supplied.Count, "card") still needed.
                                    </div>

                                    @* Where in the pack the chance actually is. The column above
                                       says whether a pack helps; this says which card in it will
                                       do the helping, and the two are not the same story -- the
                                       first three cards of a five-card pack are commons, so a
                                       collection that has finished the commons has all of its
                                       chance in the last two. It is also why the same percentage
                                       means different things in two sets. *@
                                    var slots = SlotOddsFor(row.PackKey);
                                    @if (slots.Count > 1)
                                    {
                                        <div class="slot-odds">
                                            <span class="ttl">Where the Chance Is</span>
                                            @foreach (var slot in slots)
                                            {
                                                <span class="slot @(slot.Chance <= 0 ? "none" : "")">
                                                    <span class="pos">@slot.Label</span>
                                                    <span class="pct">
                                                        @(slot.Chance <= 0 ? "None" : slot.Chance.ToString("P2"))
                                                    </span>
                                                </span>
                                            }
                                        </div>
                                    }
                                    <div class="supplied">
                                        @foreach (var (card, remaining) in supplied.Take(40))
                                        {
                                            <SuppliedRow Card="card" Remaining="remaining"
                                                         Route="@RouteNote(card)" />
                                        }
                                    </div>
                                    @if (supplied.Count > 40)
                                    {
                                        <div class="small text-body-secondary mt-1">
                                            &hellip; and @(supplied.Count - 40) more.
                                        </div>
                                    }
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </DataTable>

        @* The figures behind the answer, and the caveats on them, sit under the ranking rather
           than over it. This page exists to answer one question, and a summary of an answer is
           not a substitute for the answer: on a phone the table used to start 855px down, just
           past a full screen, so the first thing the page showed was an accounting of a result
           you could not yet see.

           Assumptions belong here for the same reason. You check what an estimate covers after
           it surprises you, not before you have read it.

           The buttons above the table stay above it: that table runs to dozens of rows, and a
           control only reachable by scrolling past all of them may as well not exist. *@
        <div class="summary">
            <div class="stat">
                <span class="label">Cards Needed</span>
                <span class="value">@_outstanding</span>
            </div>
            <div class="stat">
                <span class="label">Expected Packs</span>
                <span class="value">@Fmt(_bestCase)</span>
                <span class="sub">
                    @* Always say what the number covers. When a pack is unavailable its exclusive
                       cards leave the estimate, so the figure can fall even though the situation
                       got worse — shown bare, that reads as "cheaper". *@
                    to finish @_priceable of @_outstanding
                </span>
            </div>
            @if (Session.AssumedRates.Count > 0)
            {
                <div class="stat">
                    <span class="label">Assumed Rates</span>
                    <span class="value">@Session.AssumedRates.Count @Text.Fmt.S(Session.AssumedRates.Count, "set")</span>
                    <span class="sub">
                        @foreach (var (set, donor) in Session.AssumedRates.OrderBy(kv => kv.Key))
                        {
                            <span class="d-block">
                                @set priced from @donor
                                <button class="btn btn-sm btn-link p-0 align-baseline"
                                        @onclick="() => StopAssuming(set)">Stop</button>
                            </span>
                        }
                    </span>
                </div>
            }

            <div class="stat">
                <span class="label">Time</span>
                <span class="value">@Days(_bestCase, Premium)</span>
                <span class="sub">@RateNote()</span>
            </div>
        </div>

        @if (_unreachable.Count > 0)
        {
            var stuck = _unreachable.Sum(d => d.Remaining);
            <Notice Severity="Notice.Level.Warning">
                <strong>@stuck @Text.Fmt.S(stuck, "card") cannot be obtained right now.</strong>
            </Notice>
        }

        @if (_neverInPack.Count > 0)
        {
            @* These have no pack row to appear in, because no pack has ever sold them. The only
               routes are a trade or another event, so they are called out rather than left to be
               inferred from an empty ranking. *@
            <Notice Severity="Notice.Level.Info">
                <strong>@_neverInPack.Count @Text.Fmt.S(_neverInPack.Count, "card") never came from a pack.</strong>
                <div class="supplied mt-2">
                    @foreach (var (card, remaining) in _neverInPack.Take(UnreachableShown))
                    {
                        <SuppliedRow Card="card" Remaining="remaining" Route="trade only" Linked="true" />
                    }
                </div>
                @if (_neverInPack.Count > UnreachableShown)
                {
                    <div class="small mt-1">&hellip; and @(_neverInPack.Count - UnreachableShown) more.</div>
                }
            </Notice>
        }

    }

    </PageShell>
}

@code {
    /// <summary>
    /// What this page works toward, for as long as you are on it.
    ///
    /// It was one saved target shared by all four Answer pages, and a link could write it: "Which
    /// Pack" on a Progress panel carries ?scope=, so following one repointed the trade queue and
    /// the Wonder Pick threshold at that panel's set, for good, on pages the reader had not
    /// opened. Nothing is stored now and nothing is shared -- a scope lives as long as the visit
    /// it was chosen in, which is as long as the answer is worth anything.
    ///
    /// A link is the one thing that can seed it, because that is the redirect asking the
    /// question. See <see cref="ScopeParam"/>.
    /// </summary>
    private string Scope => Session.NormalizeScope(_scope);

    private string _scope = "everything";
    private string[] _sets = [];

    /// <summary>
    /// Arriving from a chase list's "rank packs for this list" button. A query parameter rather
    /// than page state so the link is shareable and survives a reload.
    /// </summary>
    [SupplyParameterFromQuery(Name = "chase")] public string? Chase { get; set; }

    /// <summary>
    /// Arriving from a Progress panel's "Which Pack" button, naming one set. Same shape and same
    /// reasoning as <see cref="Chase"/>: a query parameter so the link survives a reload.
    /// </summary>
    [SupplyParameterFromQuery(Name = "scope")] public string? ScopeParam { get; set; }

    private IReadOnlyList<PackStanding> _ranked = [];

    /// <summary>
    /// One row of the ranking table. A row is not the same thing as a standing: a pack with no
    /// published rates has no standing at all and still deserves a row, because the cards are
    /// demonstrably in it and the user is entitled to know that.
    /// </summary>
    /// <param name="Standing">Null when the pack cannot be priced, which is what draws dashes.</param>
    /// <param name="Mark">Badge text, or null for an ordinary available pack.</param>
    /// <param name="CardsServed">Used only when there is no standing to take the count from.</param>
    /// <param name="CanAssume">
    /// True for a released set with no published rates: the one case where borrowing another
    /// set's distributions is a reasonable offer rather than a fiction.
    /// </param>
    private sealed record PackRow(
        string PackKey, PackStanding? Standing, bool Best,
        string? Mark, string? MarkTitle, int CardsServed, bool CanAssume = false)
    {
        public string Set => PackKey.Split(':')[0];
        public string PackName => PackKey.Split(':')[1];
    }

    private IReadOnlyList<PackRow> _rows = [];

    private IReadOnlyList<(PocketCard Card, int Remaining)> _neverInPack = [];
    private IReadOnlyList<Demand> _unreachable = [];
    private int _outstanding;
    private int _priceable;
    private double _bestCase;
    private List<(RarityRung Rung, double One, double Two)> _advisor = [];
    private enum Tool { None, Advisor, Batch, Allocate, Points }

    /// <summary>The open breakdown tab, or None with the box folded.</summary>
    private Tool _tool;

    private bool _advisorOpen => _tool == Tool.Advisor && !IsChaseScope;

    /// <summary>
    /// Whether a panel is showing. Not just "a tab is set": Cost per Rarity has no tab on a chase
    /// list, so switching to one with it open leaves nothing to show and the box folds.
    /// </summary>
    private bool ToolOpen => _advisorOpen || _batchOpen || _allocateOpen || _pointsOpen;

    private string? _expanded;

    /// <summary>
    /// Outstanding demand for the current scope, kept so the expander can name the cards
    /// rather than recompute the whole target per row.
    /// </summary>
    private IReadOnlyList<Demand> _outstandingDemands = [];

    private bool _batchOpen => _tool == Tool.Batch;
    private IReadOnlyList<PackRanker.BatchOutcome> _batches = [];

    private bool _pointsOpen => _tool == Tool.Points;
    private IReadOnlyList<SetPoints> _pointRows = [];
    private IReadOnlyList<SetPoints> _capWarnings = [];
    private IReadOnlyList<RouteCost.PointsValue> _pointsShop = [];

    /// <summary>
    /// Any chase list scope, one list or all of them. The rarity chips and the rarity advisor are
    /// hidden under it: both talk about rungs, which a hand-picked list of cards does not.
    /// </summary>
    private bool IsChaseScope =>
        Scope == "chases" || Scope.StartsWith("chase:", StringComparison.Ordinal);

    /// <summary>
    /// Which plan the chips edit: one set's, or the default that the rest follow. A set only
    /// gets its own once the user asks for one, so scoping to a set does not by itself create
    /// an override — that would fork every set the moment it was looked at.
    /// </summary>
    /// <summary>The scoped set, if the scope is one at all. Null for "everything" and chase lists.</summary>
    private string? ScopedSet => !IsChaseScope && _sets.Contains(Scope) ? Scope : null;

    /// <summary>
    /// What the verdict block is introducing, which depends on what was ranked.
    ///
    /// "Open this next" is a claim about every pack in the game, and it is only true at the
    /// "everything" scope. Ranked against one set, one series or one chase list, the top row is
    /// the best pack FOR THAT -- the best pack overall may well be in a set this ranking never
    /// looked at. Someone who scoped to A3 to find out what finishing it costs is not being told
    /// to go and open A3 next, and the label said they were.
    ///
    /// The narrowed form does not name the scope, because the page bar directly above already
    /// does -- "Target: Celestial Guardians" -- and it uses the bar's own word for it, so the
    /// reading and the control that sets it are named the same thing. Naming it twice would also
    /// put an arbitrary chase-list name into a micro-label that has no room for one.
    /// </summary>
    private string LeadLabel(PackRow lead) =>
        !lead.Best ? "If you open this"
        : Scope == "everything" ? "Open this next"
        : "Best for this target";

    private string? PlanScope =>
        ScopedSet is { } set && Session.HasPlanOverride(set) ? set : null;

    private RarityPlan Plan => Session.Plan(PlanScope);

    /// <summary>
    /// The chips edit a local draft, not the saved plan. Re-ranking on every tap made
    /// adjusting several rarities miserable, so taps are collected and applied once the user
    /// stops — instant visual feedback, one recompute.
    /// </summary>
    private RarityPlan? _draft;
    private RarityPlan Draft => _draft ?? Plan;

    /// <summary>
    /// The limited-time packs currently marked on sale, for the folded summary. Empty when they
    /// are all at the app's assumption, which is the case that needs no words.
    /// </summary>
    private string OnSaleNow =>
        string.Join(", ", Session.LimitedPackNames.Where(Session.IsLimitedPackNameAvailable));

    /// <summary>Filled while its panel is open, outlined while it is not.</summary>

    private bool _pending;
    private CancellationTokenSource? _debounce;

    private static readonly TimeSpan SettleDelay = TimeSpan.FromMilliseconds(700);
    private bool Premium => Session.Profile.Resources.Premium;

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnChanged;
        Busy.Changed += OnBusyChanged;

        await Session.InitAsync();
        if (!Session.Ready) return;

        _sets = Session.Index.OpenableSets.ToArray();
        // Arriving from a chase list's own "Rank Packs" button, or from a Progress panel's "Which
        // Pack". Either names what to rank on arrival and is forgotten with the visit -- see
        // Scope. Checked against what exists first: a link naming a chase list since deleted, or
        // a set this build has never heard of, ranks against everything rather than nothing.
        if (Chase is { Length: > 0 } id && Session.ChaseListById(id) is not null)
            _scope = $"chase:{id}";
        else if (ScopeParam is { Length: > 0 } scope && KnownScope(scope))
            _scope = scope;

        // Arriving from another page still costs a full ranking, so it needs the same
        // indicator as changing a filter does — otherwise navigation looks like a hang.
        await Busy.RunAsync("Ranking packs\u2026", Recompute);
    }

    private void OnBusyChanged() => InvokeAsync(StateHasChanged);

    // The ranking must refresh when the collection or target changes, but NOT for unrelated
    // settings. The premium flag only affects how packs are converted to calendar time, so
    // re-ranking for it would burn a second or two to produce an identical table.
    private void OnChanged()
    {
        if (RankSignature() != _rankedFor) Recompute();
        InvokeAsync(StateHasChanged);
    }

    private string _rankedFor = "";

    private string RankSignature() =>
        $"{Scope}|{PlanScope}|{string.Join('.', Plan.CopiesByTier.OrderBy(kv => kv.Key).Select(kv => $"{kv.Key}:{kv.Value}"))}|" +
        $"{Session.CollectionRevision}|{string.Join(',', Session.UnavailablePacks)}|" +
        // Borrowed rates change every number, so they belong in the signature — otherwise
        // arriving back on the page after assuming a set's rates would show the old ranking.
        $"{string.Join(',', Session.AssumedRates.OrderBy(kv => kv.Key).Select(kv => $"{kv.Key}<{kv.Value}"))}|" +
        $"foils:{Session.FoilCopies}";

    /// <summary>Opens a tab, or folds the box when the tab tapped is the one already open.</summary>
    private Task SelectTool(Tool tool)
    {
        _tool = _tool == tool ? Tool.None : tool;
        return _tool switch
        {
            Tool.Advisor => OpenAdvisor(),
            Tool.Batch => OpenBatch(),
            Tool.Allocate => BuildAllocation(),
            Tool.Points => OpenPoints(),
            _ => Task.CompletedTask,
        };
    }

    private string? TabId => !ToolOpen ? null : _tool switch
    {
        Tool.Advisor => "tool-tab-advisor",
        Tool.Batch => "tool-tab-batch",
        Tool.Allocate => "tool-tab-allocate",
        Tool.Points => "tool-tab-points",
        _ => null,
    };

    private async Task OpenAdvisor()
    {
        if (_advisorFor == Signature() && _advisor.Count > 0) return;

        await Busy.RunAsync("Pricing every rarity\u2026", BuildAdvisor);
    }

    /// <summary>
    /// Cache key for the target advisor. It priced every rarity from the collection, the foil
    /// choice and the rate table, while keying on the scope alone - so logging two hundred packs
    /// and reopening the panel showed the prices from before, and assuming a set's rates left it
    /// contradicting the ranking directly above it on the same page.
    ///
    /// The rarity PLAN is deliberately absent: each row prices its own rung with a plan it builds
    /// itself, so what the user currently collects cannot change these numbers.
    /// </summary>
    private string Signature() =>
        $"{Scope}|{string.Join(',', Session.UnavailablePacks)}|{Session.CollectionRevision}|" +
        $"foils:{Session.FoilCopies}|" +
        $"{string.Join(',', Session.AssumedRates.OrderBy(kv => kv.Key).Select(kv => $"{kv.Key}<{kv.Value}"))}";

    private async Task OpenBatch()
    {
        if (_batchFor == RankSignature() && _batches.Count > 0) return;

        // Every purchasable pack against the whole target, so it is priced on demand rather than
        // on every filter change — same reasoning as the advisor.
        await Busy.RunAsync($"Pricing batches of {GameRules.PacksPerBatch}\u2026", BuildBatches);
    }

    private string _batchFor = "";

    private void BuildBatches()
    {
        if (Session.Ranker is null) return;

        _batchFor = RankSignature();
        _batches = Session.Ranker.Batches(
            CurrentTarget(), Session.Owned, GameRules.PacksPerBatch, Session.UnavailablePacks);
    }

    private bool _allocateOpen => _tool == Tool.Allocate;
    private int _allocateBudget = GameRules.PacksPerBatch;
    private string _allocateFor = "";
    private PackAllocator.AllocationPlan? _allocation;

    private async Task BuildAllocation()
    {
        var signature = $"{RankSignature()}|{_allocateBudget}";
        if (_allocateFor == signature && _allocation is not null) return;

        await Busy.RunAsync($"Splitting {_allocateBudget} packs…", BuildAllocationCore);
    }

    private void BuildAllocationCore()
    {
        if (Session.Allocator is null) return;

        _allocateFor = $"{RankSignature()}|{_allocateBudget}";
        _allocation = Session.Allocator.Allocate(
            CurrentTarget(), Session.Owned, _allocateBudget, Session.UnavailablePacks);
    }

    private async Task OpenPoints()
    {

        // Same reasoning as the advisor: pricing every outstanding card by two routes is not
        // something to run on every filter change.
        await Busy.RunAsync("Pricing the point shop…", BuildPoints);
    }

    private void BuildPoints()
    {
        if (Session.Points is null || Session.Routes is null) return;

        var balances = Session.Profile.Resources.PackPointsBySet;

        // Per set, because targets are per set. Reading one set's plan for all of them was the
        // bug that had the shop recommending a Crown to someone collecting diamonds.
        RarityPlan PlanFor(string set) => Session.Profile.Targets.PlanFor(set);

        _pointRows = _sets
            .Select(set => Session.Points.Describe(
                set, balances.GetValueOrDefault(set), Session.Owned, PlanFor(set)))
            .OrderByDescending(r => r.Balance)
            .ThenBy(r => r.Set, StringComparer.Ordinal)
            .ToArray();

        _capWarnings = Session.Points.Warnings(balances, Session.Owned, PlanFor);

        var outstanding = CurrentTarget().Outstanding(Session.Index, Session.Owned);
        _pointsShop = Session.Routes.PointsShopRanking(outstanding, Session.Owned);
    }

    /// <summary>
    /// A tap on a ranked row: promote that pack into the verdict block, and open its detail.
    ///
    /// Both, from one tap, because they are the same intent said at two levels of detail --
    /// "tell me about this one". Comparing two packs is then reading one sentence twice rather
    /// than reading across five columns, which is the whole reason the verdict block is worth
    /// having on a page that already ranks them.
    ///
    /// The promotion is not undone by tapping again. Collapsing the detail of the pack the verdict
    /// is about should not also throw the verdict back to a different pack -- the reading you were
    /// left looking at would change under a gesture that meant "I am done with the detail".
    /// </summary>
    private void SelectPack(string packKey)
    {
        _verdictPack = packKey;
        ToggleExpanded(packKey);
    }

    /// <summary>One row open at a time: two open expanders push the ranking off the screen.</summary>
    private void ToggleExpanded(string packKey) =>
        _expanded = _expanded == packKey ? null : packKey;

    /// <summary>
    /// The outstanding cards this pack can actually give, with copies still needed.
    /// Computed on expand rather than for every row: it is a scan of the pack's ~80 cards
    /// against outstanding demand, which is wasted work for the 20-odd rows nobody opens.
    /// </summary>
    /// <summary>
    /// Per-position odds for one pack, against the same outstanding demands the ranking used.
    ///
    /// Computed on expansion rather than for every row: it walks each variant's slots, and the
    /// table can hold forty packs of which one is open.
    /// </summary>
    private IReadOnlyList<SlotOdds> SlotOddsFor(string packKey) =>
        Session.Odds is null || _outstandingDemands.Count == 0
            ? []
            : Session.Odds.ChanceOfUsefulBySlot(packKey, _outstandingDemands);

    private IReadOnlyList<(PocketCard Card, int Remaining)> SuppliedBy(string packKey)
    {
        if (!Session.Index.ByPack.TryGetValue(packKey, out var inPack)) return [];

        var keys = inPack.Select(c => c.OwnershipKey).ToHashSet(StringComparer.Ordinal);

        return _outstandingDemands
            .Select(d => (Card: d.SuppliedBy.FirstOrDefault(c => keys.Contains(c.OwnershipKey)), d.Remaining))
            .Where(x => x.Card is not null)
            .Select(x => (x.Card!, x.Remaining))
            .OrderByDescending(x => Session.Index.Rung(x.Item1)?.Index ?? -1)
            .ThenBy(x => x.Item1.Name, StringComparer.CurrentCultureIgnoreCase)
            .ToArray();
    }

    private const int UnreachableShown = 24;

    /// <summary>
    /// Wanted cards that no pack has ever sold — event and promo cards. They have no pack row to
    /// appear in, so they are the one thing that still has to be called out separately; a trade
    /// is the only route and no amount of opening changes that.
    ///
    /// Only chase lists reach this: a rarity target is built from pack-obtainable cards only.
    /// </summary>
    private IReadOnlyList<(PocketCard Card, int Remaining)> NeverInAPack()
    {
        var result = new List<(PocketCard, int)>();

        foreach (var demand in _unreachable)
        {
            var card = demand.SuppliedBy.FirstOrDefault();
            if (card is null) continue;
            if (Session.Index.PacksYielding(card.OwnershipKey).Any()) continue;

            result.Add((card, demand.Remaining));
        }

        return result
            .OrderByDescending(x => Session.Index.Rung(x.Item1)?.Index ?? -1)
            .ThenBy(x => x.Item1.Name, StringComparer.CurrentCultureIgnoreCase)
            .ToArray();
    }

    /// <summary>
    /// Cheapest route in words. Never a bare number: "cheaper by points" is true of almost
    /// every card and misleading on its own, so the pull cost is always stated beside it.
    /// </summary>
    private string RouteNote(PocketCard card)
    {
        if (Session.Routes is null) return "";

        var routes = Session.Routes.For(card, Session.Owned);
        var pull = routes.Options.FirstOrDefault(o => o.Route == AcquisitionRoute.Pull);
        var points = routes.Options.FirstOrDefault(o => o.Route == AcquisitionRoute.PackPoints);

        var parts = new List<string>();

        if (pull is { Available: true, PacksEquivalent: { } p })
            parts.Add($"~{Fmt(p)} packs to pull");
        else
            parts.Add("not pullable");

        if (points is { Available: true, Points: { } cost, PacksEquivalent: { } q })
            parts.Add($"{cost} points (~{Fmt(q)} packs' worth)");

        var trade = routes.Options.FirstOrDefault(o => o.Route == AcquisitionRoute.Trade);
        if (trade is { Available: true })
            parts.Add(trade.Dust is > 0 ? $"trade: {trade.Dust:N0} dust + 1 stamina" : "trade: free + 1 stamina");

        return string.Join(" · ", parts);
    }

    /// <summary>
    /// Bumped when a typed figure was rounded to a multiple of five, and part of the input's @key
    /// so the box shows the figure that was stored. See the same field on the Resources page for
    /// why the value attribute alone does not do it.
    /// </summary>
    private int _snapped;

    private void SetBalance(string set, ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var value)) return;

        // Snapped rather than clamped: a balance the game cannot produce is a typo.
        var held = GameRules.SnapPackPoints(value);
        if (held != value) _snapped++;

        Session.Mutate(p =>
        {
            var next = new Dictionary<string, int>(p.Resources.PackPointsBySet);
            if (held > 0) next[set] = held; else next.Remove(set);
            return p with { Resources = p.Resources with { PackPointsBySet = next } };
        });

        // Balances only change what the panel says, so it is repriced without touching the
        // ranking — which the collection-revision check would skip anyway.
        BuildPoints();
    }

    private string _advisorFor = "";

    /// <summary>
    /// The target the ranking runs against. Normalised on the way through, unlike the other
    /// pickers: this page keeps the choice, so a scope naming something deleted has to stop being
    /// the selected option as well as stop being ranked.
    /// </summary>
    private ICompletionTarget CurrentTarget()
    {
        // No normalising here any more: Session.Target does it on the way out, so the picker and
        // the figures read the same string.
        return Session.TargetForScope(Scope);
    }

    /// <summary>
    /// The sets the current scope covers. Used by the rarity advisor, which prices rungs and so
    /// only means anything over sets — a chase list scope has no sets of its own and falls back to
    /// all of them.
    /// </summary>
    private string[] ScopeSets() =>
        Scope.StartsWith("series:", StringComparison.Ordinal) ? Session.SetsInSeries(Scope[7..])
        : _sets.Contains(Scope) ? [Scope]
        : _sets;

    /// <summary>
    /// Whether a scope from the query string names something this build can rank against. Chase
    /// lists are excluded deliberately — they have their own parameter, which also checks that the
    /// list still exists.
    /// </summary>
    private bool KnownScope(string scope) =>
        scope == "everything"
        || _sets.Contains(scope)
        || (scope.StartsWith("series:", StringComparison.Ordinal)
            && Session.SetsInSeries(scope[7..]).Length > 0);

    private void Recompute()
    {
        if (!Session.Ready || Session.Ranker is null) return;
        _rankedFor = RankSignature();

        var target = CurrentTarget();
        var outstanding = target.Outstanding(Session.Index, Session.Owned);
        _outstandingDemands = outstanding;
        _outstanding = outstanding.Sum(d => d.Remaining);
        if (_outstanding == 0)
        {
            _ranked = [];
            _rows = [];
            _neverInPack = [];
            _advisor = [];
            _expanded = null;
            return;
        }

        var unavailable = Session.UnavailablePacks;

        // Ranked WITHOUT the availability filter, then split. Each standing is computed from its
        // own pack's rates alone, so an off-sale pack's numbers are the same either way — and
        // one ranking pass is half the work of two.
        var all = Session.Ranker.Rank(target, Session.Owned);
        _ranked = all.Where(s => !unavailable.Contains(s.PackKey)).ToArray();

        // The estimate still respects availability. That is the whole distinction the user asked
        // for: excluded from the arithmetic, present in the list.
        _unreachable = Session.Ranker.Unreachable(target, Session.Owned, unavailable);
        _bestCase = Session.Ranker.BestCasePacksToFinish(target, Session.Owned, unavailable);
        _priceable = _outstanding - _unreachable.Sum(d => d.Remaining);

        _neverInPack = NeverInAPack();

        _rows =
        [
            .. _ranked.Select((s, i) => new PackRow(s.PackKey, s, Best: i == 0, null, null, 0)),

            // Off sale: real numbers, because we know its rates — it just cannot be bought today.
            .. all.Where(s => unavailable.Contains(s.PackKey))
                  .Select(s => new PackRow(s.PackKey, s, false, "Off Sale",
                      "Left out of the estimate", 0)),

            // No published rates — but WHY matters, so the badge distinguishes a set that is out
            // and simply unpriced from one that is not out yet. Both were previously reported the
            // same way, which told the user their B4 cards were unobtainable when they were only
            // unpriced.
            .. UnratedPacksServing(outstanding).Select(x => new PackRow(
                x.PackKey, null, false,
                x.Released ? "Rates Unknown" : "Not Out Yet",
                x.Released
                    ? "No published pull rates, so left out of the estimate"
                    : x.ReleasesOn is { } d ? $"Due {d:d MMM yyyy}" : null,
                x.Cards, CanAssume: x.Released)),
        ];

    }

    /// <summary>
    /// Openable packs with no published pull rates that nonetheless contain cards the target
    /// still wants. The ranker skips them because it has nothing to compute; the page shows them
    /// because "we do not know the odds" and "this pack is no help" are different statements.
    /// </summary>
    private IReadOnlyList<(string PackKey, int Cards, bool Released, DateOnly? ReleasesOn)> UnratedPacksServing(
        IReadOnlyList<Demand> outstanding)
    {
        if (Session.Odds is null || outstanding.Count == 0) return [];

        // Local date, matching how a player thinks about a release. The set list carries dates,
        // not times, so the day is the finest distinction available anyway.
        var today = DateOnly.FromDateTime(DateTime.Now);

        var priceable = Session.Odds.PriceablePacks.ToHashSet(StringComparer.Ordinal);
        var rows = new List<(string, int, bool, DateOnly?)>();

        // Openable only: promo "Vol. N" groupings record how a card was handed out at an event,
        // not something anyone can choose to open, so listing them as packs would offer a route
        // that does not exist.
        foreach (var pack in Session.Index.OpenablePackKeys)
        {
            if (priceable.Contains(pack)) continue;
            if (!Session.Index.ByPack.TryGetValue(pack, out var inPack)) continue;

            var keys = inPack.Select(c => c.OwnershipKey).ToHashSet(StringComparer.Ordinal);
            var served = outstanding.Count(d => d.SuppliedBy.Any(c => keys.Contains(c.OwnershipKey)));
            if (served == 0) continue;

            var set = pack.Split(':')[0];
            rows.Add((pack, served, Session.Sets.IsReleased(set, today), Session.Sets.ReleaseDateOf(set)));
        }

        // Out-but-unpriced first: those cards are droppable today, so they are the ones worth
        // knowing about. An unreleased set is information, not an option.
        return rows
            .OrderByDescending(x => x.Item3)
            .ThenByDescending(x => x.Item2)
            .ThenBy(x => x.Item1, StringComparer.Ordinal)
            .ToArray();
    }

    private void BuildAdvisor()
    {
        if (!Session.Ready || Session.Ranker is null) return;

        _advisorFor = Signature();
        // The advisor prices rarity rungs, which only means something over sets — so a series
        // scope prices that series, and a chase list scope falls back to everything rather than
        // inventing a "chase:xyz" set.
        var sets = ScopeSets();

        _advisor = Session.Index.Ladder.Rungs.Select(rung =>
        {
            double Price(int copies)
            {
                // Each row prices "just this rung", so the table reads as the marginal cost
                // of adding that rarity rather than a running total.
                // Session.TargetForSet applies the foil choice; building the target here has to
                // as well, or the advisor would price a rarity over cards the ranking ignores.
                var parts = sets.Select(s => (ICompletionTarget)new RarityLadderTarget(
                    s, RarityPlan.Uniform([rung.Index], copies), Session.FoilRule)).ToArray();
                return Session.Ranker!.BestCasePacksToFinish(
                    new CompositeTarget(parts), Session.Owned, Session.UnavailablePacks);
            }
            return (rung, Price(1), Price(2));
        }).ToList();
    }

    /// <summary>
    /// Deep link to the log screen with this pack already chosen. A pack key is "SET:Name" and
    /// the name can hold spaces and punctuation, so it is escaped rather than interpolated -
    /// "Mewtwo" survives either way, but "Charizard ex" and the Deluxe packs do not.
    /// </summary>
    private static string LogHref(string packKey) => $"log?pack={Uri.EscapeDataString(packKey)}";

    private static string Fmt(double packs) => Text.Fmt.Packs(packs);

    /// <summary>
    /// A pack count with its noun agreed. Fmt formats the number and knows nothing about the word
    /// after it, which is how the sentence came out reading "roughly 1 packs between new cards".
    /// </summary>
    private static string PackCount(double packs) =>
        Fmt(packs) == "1" ? "1 pack" : $"{Fmt(packs)} packs";

    /// <summary>The same agreement for the card count beside the action.</summary>
    private static string CardCount(int cards) => cards == 1 ? "1 card" : $"{cards} cards";

    /// <summary>
    /// "149 more packs", with the adjective inside the phrase rather than bolted onto the end of
    /// it. Built separately from <see cref="PackCount"/> because "149 packs more" is what you get
    /// when the count and the word after it are assembled in the markup.
    /// </summary>
    private static string MorePacks(double packs) =>
        Fmt(packs) == "1" ? "1 more pack" : $"{Fmt(packs)} more packs";

    /// <summary>
    /// The chance as the phrase that opens the sentence, split from the words that lead into it.
    ///
    /// Two parts because only one of them is the answer: the accent ink goes on the figure, and
    /// "About" is a hedge rather than a figure. Splitting it also settles the case that reads
    /// worst -- a pack every card of which can serve the target is "Every pack", and "About every
    /// pack" is not a sentence anyone would write.
    /// </summary>
    private static (string Lead, string Figure) ChanceWords(double chance) =>
        chance >= .995 ? ("", "Every pack") : ("About ", InWords(chance));

    /// <summary>
    /// Which pack the verdict block is about. The ranking's own answer until you point at another.
    ///
    /// Held as a key rather than as a row, because the rows are rebuilt whenever the scope or the
    /// plan changes and a held row would go stale pointing at a ranking that no longer exists.
    /// Falling back to the best one also means a pack that drops out of the ranking entirely --
    /// a set left out by a new scope -- resolves to the new answer rather than to nothing.
    /// </summary>
    /// <summary>
    /// How many packs the shortlist beside the verdict shows.
    ///
    /// A shortlist, not the ranking: the table below is the ranking and runs to every priceable
    /// pack. This is the handful you would actually weigh against the one being recommended, and
    /// past about six the column is taller than the verdict it sits beside.
    /// </summary>
    private const int RankedShown = 6;

    private string? _verdictPack;

    private PackRow? Verdict =>
        _rows.FirstOrDefault(r => r.PackKey == _verdictPack && r.Standing is not null)
        ?? _rows.FirstOrDefault(r => r.Best && r.Standing is not null)
        ?? _rows.FirstOrDefault(r => r.Standing is not null);

    /// <summary>
    /// A probability as the phrase a player would use. "About 1 pack in 3" is the same fact as
    /// "34.2%" with the division already done, and the division is the part that decides whether
    /// to open one.
    ///
    /// Only down to one in twenty; below that "1 in 34" is not a number anyone holds in their head
    /// and the percentage reads better. Above a half it inverts -- "2 packs in 3" rather than
    /// "1 pack in 1.5" -- because a fraction with a decimal in it is not a phrase.
    /// </summary>
    private static string InWords(double chance)
    {
        if (chance <= 0) return "no pack";

        // The near-certain case is ChanceWords' -- it needs the whole phrase, not just the figure,
        // because "About every pack" is not a sentence. The guard stays here so this is safe to
        // call on its own: without it a .99998 chance comes out as "1 pack in 1".
        if (chance >= .995) return "every pack";

        var one = 1 / chance;
        if (one > 20) return chance.ToString("P1");

        // Near a whole number, say it as one in N.
        var rounded = Math.Round(one);
        if (Math.Abs(one - rounded) < .12) return $"1 pack in {rounded:N0}";

        // Otherwise the other way up, in thirds, quarters or fifths -- whichever lands closest.
        //
        // Pluralised, because the numerator reaches this branch at one: a chance of .233 rounds to
        // a quarter here rather than to "1 in 4" above, and the verdict on the pack ranking read
        // "About 1 packs in 4".
        foreach (var den in new[] { 3, 4, 5 })
        {
            var num = (int)Math.Round(chance * den);
            if (num >= 1 && num < den && Math.Abs(chance - (double)num / den) < .04)
                return $"{num:N0} {Text.Fmt.S(num, "pack")} in {den}";
        }

        return chance.ToString("P1");
    }

    /// <summary>One box per card position in the pack, expanded from the grouped odds.</summary>
    private sealed record Slot(int Position, double Chance);

    /// <summary>
    /// The five positions, each carrying its group's chance.
    ///
    /// The engine groups adjacent positions that share a distribution -- "1st-3rd card" is one
    /// entry -- because that is how the rates are published. The strip shows five boxes anyway:
    /// the set being literal is the whole precondition for a strip, and a pack has five cards
    /// whatever the arithmetic groups them into.
    /// </summary>
    private IReadOnlyList<Slot> SlotStrip(string packKey)
    {
        var groups = SlotOddsFor(packKey);
        if (groups.Count == 0) return [];

        // Sized from the groups rather than from a constant: the engine's last position is what a
        // pack of this set actually holds, and there is no rule in GameRules claiming otherwise.
        var slots = new List<Slot>(groups[^1].Last);
        foreach (var g in groups)
            for (var i = g.First; i <= g.Last; i++)
                slots.Add(new Slot(i, g.Chance));

        return slots.OrderBy(s => s.Position).ToList();
    }

    /// <summary>
    /// Why the dead boxes are dead, said once rather than per box.
    ///
    /// Only where there is something to explain. A strip with a live figure in every box needs no
    /// clause, and a sentence appearing and disappearing is less confusing than one that is
    /// sometimes vacuous.
    /// </summary>
    private static string? SlotClause(IReadOnlyList<Slot> slots)
    {
        var dead = slots.Where(s => s.Chance <= 0).Select(s => s.Position).ToList();
        if (dead.Count == 0 || dead.Count == slots.Count) return null;

        // Contiguous from the first card is the common case by far: the first three come from the
        // common pool, and a collection past its commons kills exactly those.
        var run = dead.Count == dead[^1] && dead[0] == 1;
        return run
            ? $"first {Words(dead.Count)}: commons, all owned"
            : "dashed ones give duplicates only";
    }

    private static string Words(int n) => n switch
    {
        1 => "one", 2 => "two", 3 => "three", 4 => "four", 5 => "five", _ => n.ToString()
    };

    private static string Ordinal(int n) => n switch
    {
        1 => "1st", 2 => "2nd", 3 => "3rd", 4 => "4th", 5 => "5th", _ => $"{n}th"
    };

    /// <summary>
    /// Expected packs as calendar time, which is the number that changes decisions. Lives in
    /// <see cref="Text.Fmt.Days"/> now that the Progress page states the same thing per set.
    ///
    /// Qualified, like the Fmt() helper above it: this page has its own static Fmt, which shadows
    /// the class of that name for every unqualified use in the file.
    /// </summary>
    private static string Days(double packs, bool premium) => Text.Fmt.Days(packs, premium);

    /// <summary>
    /// When premium is off, price the alternative too. A +50% pack rate is a real tradeoff
    /// and the user deserves to see it costed — stated as a fact, not a nudge.
    /// </summary>
    private string RateNote() => Premium
        ? $"{GameRules.PacksPerDay(true)} packs/day"
        : $"{Days(_bestCase, true)} with premium";

    private Task OnScope(ChangeEventArgs e)
    {
        var scope = e.Value?.ToString() ?? "everything";
        return Busy.RunAsync("Ranking packs\u2026", () =>
        {
            _advisor = [];      // stale for the new scope; repriced only if reopened

            _scope = scope;

            // Nothing raises Changed now that the scope is the page's own, so the recompute is
            // this method's to do. It used to come back through OnChanged, because setting the
            // shared target was a state edit.
            Recompute();
        });
    }

    private void CycleTier(int tier)
    {
        var next = Draft.Cycle(tier);
        // Refuse to leave nothing selected: every screen would read "complete", which looks
        // like a bug rather than a choice.
        if (next.IsEmpty) return;

        _draft = next;
        _pending = true;
        StateHasChanged();          // the chip updates immediately; the ranking waits

        _debounce?.Cancel();
        _debounce = new CancellationTokenSource();
        var token = _debounce.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(SettleDelay, token);
                await InvokeAsync(ApplyDraftAsync);
            }
            catch (OperationCanceledException) { /* superseded by a later tap */ }
        }, token);
    }

    private async Task ApplyDraftAsync()
    {
        if (_draft is null) return;

        var plan = _draft;
        _pending = false;

        await Busy.RunAsync("Ranking packs\u2026", () =>
        {
            _advisor = [];
            _batches = [];
            Session.SetPlan(plan, PlanScope);
            _draft = null;          // saved plan is now the source of truth again
        });
    }

    /// <summary>
    /// Seeded from the default rather than from nothing: an override almost always starts as
    /// "the usual, but…", and an empty plan would read as a finished set.
    /// </summary>
    /// <summary>
    /// Whether the current scope contains a set with foil printings, so the chip is offered only
    /// where it can change anything.
    /// </summary>
    private bool ScopeHasFoils
    {
        get
        {
            var foilSets = Session.FoilSets;
            if (foilSets.Count == 0) return false;

            if (IsChaseScope) return false;
            if (Scope == "everything") return true;
            if (ScopedSet is { } set) return foilSets.Contains(set);

            return ScopeSets().Any(foilSets.Contains);
        }
    }

    /// <summary>
    /// Changes what the target DEMANDS, not how it is displayed, so it re-ranks — 139 cards
    /// entering, leaving, or doubling moves every figure on the page.
    /// </summary>
    private Task CycleFoils()
    {
        var next = Session.NextFoilCopies;
        var label = next == 0 ? "Excluding parallel foils\u2026" : $"Counting {next} of each parallel foil\u2026";

        return Busy.RunAsync(label, () =>
        {
            Session.SetFoilCopies(next);
            _advisor = [];
            _batches = [];
            Recompute();
        });
    }

    private Task StartOverride()
    {
        if (IsChaseScope || !_sets.Contains(Scope)) return Task.CompletedTask;

        var seed = Session.Plan();
        return Busy.RunAsync($"Giving {Scope} its own plan\u2026", () =>
        {
            _draft = null;
            Session.SetPlan(seed, Scope);
            _advisor = [];
            Recompute();
        });
    }

    private Task ClearOverride()
    {
        if (IsChaseScope || !_sets.Contains(Scope)) return Task.CompletedTask;

        var set = Scope;
        return Busy.RunAsync($"Returning {set} to the default plan\u2026", () =>
        {
            _draft = null;
            Session.ClearPlanOverride(set);
            _advisor = [];
            Recompute();
        });
    }

    /// <summary>
    /// Borrowing rates changes the rate table itself, so this is not a filter — every figure on
    /// the page is recomputed, and the busy indicator says so.
    /// </summary>
    private Task Assume(string set, string donor) =>
        Busy.RunAsync($"Estimating {set} from {donor}\u2026", () =>
        {
            Session.SetAssumedRates(set, donor);
            _advisor = [];
            Recompute();
        });

    private Task StopAssuming(string set) =>
        Busy.RunAsync($"Dropping assumed rates for {set}\u2026", () =>
        {
            Session.SetAssumedRates(set, null);
            _advisor = [];
            Recompute();
        });

    private Task ToggleLimited(string name, bool on)
    {
        var label = on ? $"Including {name}\u2026" : $"Excluding {name}\u2026";
        return Busy.RunAsync(label, () =>
            {
                Session.SetLimitedPackNameAvailable(name, on);
                _advisor = [];   // stale for the new availability; repriced only if reopened
                Recompute();
            });
    }

    public async ValueTask DisposeAsync()
    {
        Session.Changed -= OnChanged;
        Busy.Changed -= OnBusyChanged;

        // Leaving mid-edit must not silently discard the change.
        _debounce?.Cancel();
        if (_draft is not null) await InvokeAsync(ApplyDraftAsync);
        _debounce?.Dispose();
    }
}
