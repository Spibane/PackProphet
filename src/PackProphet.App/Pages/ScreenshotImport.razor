@page "/collection/screenshot"
@inject AppSession Session
@implements IDisposable

<PageTitle>Import from a Screenshot · PackProphet</PageTitle>

@if (!Session.Ready)
{
    <Loading />
}
else
{
    <div class="page-head">
        <BackLink To="collection" Label="Collection" />
        <h1 class="title">Import from a Screenshot</h1>
        <span class="subtitle">Read your cards straight off the game</span>
    </div>

    <PageShell Measure="PageShell.Width.Form">

        @* Only the two card lists here. A pack's five cards belong on the log screen, where the
           pack gets logged as well as the cards, and a Wonder Pick's line-up belongs on the Wonder
           Pick screen, where it is an offer to weigh up rather than anything to record. *@
        <ShotImport Group="cards" Choices="@Layouts" ChoiceLegend="Which Card List">
            <Intro>
                In the game: the <strong>My Cards</strong> screen, in either layout. The list runs
                past one screenful, so scroll and shoot it in several goes. They are read
                separately and applied as one.
            </Intro>
            @* Together rather than Actions: the collection is one thing, not one thing per picture.
               Applying picture by picture would make several undo steps out of a single import, and
               would get overlapping shots wrong — a card blank on the screenful before you scrolled
               and recognised on the one after must not come out as not owned. *@
            <Together Context="readings">
                @* Worked out once for the whole block. Both sides walk every match in every
                   picture and Missing walks them twice, so calling them inline where each count is
                   printed meant ten passes over a batch that can be twenty screenshots — on every
                   tick of a checkbox. *@
                @{
                    var found = Found(readings);
                    var missing = Missing(readings);
                }

                @if (found.Count > 0)
                {
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="apply-found"
                               checked="@_applyFound" @onchange="@(e => _applyFound = Checked(e))" />
                        <label class="form-check-label" for="apply-found">
                            <strong>
                                Record @found.Count.ToString("N0") @Fmt.S(found.Count, "card") as owned
                            </strong>
                            <span class="d-block small text-body-secondary">
                                Never lowers a count you already have.
                            </span>
                        </label>
                    </div>
                }

                @if (missing.Count > 0)
                {
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="apply-missing"
                               checked="@_applyMissing" @onchange="@(e => _applyMissing = Checked(e))" />
                        <label class="form-check-label" for="apply-missing">
                            <strong>
                                Mark @missing.Count.ToString("N0") @Fmt.S(missing.Count, "card") as not owned
                            </strong>
                            @* Off unless asked for. This is the only half of the reading that can
                               destroy something: every other outcome adds a card, and this one
                               removes counts the user typed in by hand. *@
                            <span class="d-block small text-body-secondary">
                                Off by default: it deletes counts. A card that could not be
                                read looks missing too.
                            </span>
                        </label>
                    </div>
                }

                @* Disabled on what is actually there, not just on the boxes. Both halves can be
                   ticked and still have nothing behind them — a reading where every card is
                   already owned offers no removals — and a live button that does nothing when
                   pressed reads as a broken button rather than an empty result. *@
                <button class="btn btn-primary" @onclick="@(() => Apply(found, missing))"
                        disabled="@(!(_applyFound && found.Count > 0) && !(_applyMissing && missing.Count > 0))">
                    Apply to @Session.Profile.Name
                </button>
            </Together>
        </ShotImport>

        @* Clear of the apply button above it: the two were flush, so the confirmation read as part
           of the control rather than as the answer to pressing it. *@
        @if (_applied is not null)
        {
            <Notice Severity="Notice.Level.Success" Class="mt-3">
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span>@_applied</span>
                    @* A button, not a keystroke. This is the page you use on a phone beside the
                       game, where Ctrl+Z is not a thing you can press. *@
                    @if (Session.CanUndo)
                    {
                        <button class="btn btn-sm btn-outline-primary py-0" @onclick="UndoApply">
                            Undo That
                        </button>
                    }
                    <a href="collection">Back to the Collection</a>
                </div>
            </Notice>
        }

        @* Folded away, and short even so. Someone who opens this wants to know whether to trust
           the reading, not how the reading is done. *@
        <details class="mt-4">
            <summary class="small text-body-secondary">How This Works, and Where It Fails</summary>
            <div class="pt-2 small text-body-secondary">
                <p>
                    Each card's artwork was reduced to 128 bits offline, and those fingerprints ship
                    with the app. A screenshot is read by finding the card-sized slots in it and
                    taking the nearest match to each. Nothing is uploaded.
                </p>
                <p class="mb-0">
                    It gives up rather than guessing: artwork too alike to choose between, a slot
                    matching nothing, a list out of number order. Those are the slots counted above
                    as not recognised, and they are left out of what gets applied.
                </p>
            </div>
        </details>
    </PageShell>
}

@code {
    /// <summary>
    /// The two layouts the My Cards screen offers, plus letting the app tell them apart — which it
    /// can, since one fits five cards across and the other three.
    /// </summary>
    private static readonly (CardScreen? Value, string Label, string Hint)[] Layouts =
    [
        (null, "Work it out from the picture",
         "Told apart by how many cards fit across a row."),
        (CardScreen.OwnershipGrid, "Five across, with blanks",
         "The whole set, blanks for what you are missing."),
        (CardScreen.CopiesGrid, "Three across, with copy counts",
         "Only cards you own, with copy counts."),
    ];

    private bool _applyFound = true;
    private bool _applyMissing;
    private string? _applied;

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnChanged;
        await Session.InitAsync();
    }

    public void Dispose() => Session.Changed -= OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private static bool Checked(ChangeEventArgs e) => e.Value is true;

    /// <summary>
    /// Every card the pictures between them say is held, once each. Overlapping screenshots repeat
    /// cards, so the same card read twice is one card here; where a copy count was read the largest
    /// wins, on the same reasoning the apply itself uses — a screenshot is evidence of at least that
    /// many, never of fewer.
    /// </summary>
    private static IReadOnlyList<ShotMatch> Found(IReadOnlyList<ShotReading> readings) =>
        readings.SelectMany(r => r.Matches)
                .Where(m => m.Owned)
                .GroupBy(m => m.Card.OwnershipKey)
                .Select(g => g.MaxBy(m => m.Copies ?? 1)!)
                .ToArray();

    /// <summary>
    /// Cards the pictures say are not held &mdash; minus anything any other picture found.
    ///
    /// The subtraction is the whole reason this is computed across the batch rather than per
    /// picture. Two shots of the same list overlap, and a card can be a blank slot in the screenful
    /// taken before you scrolled and a recognised card in the one taken after. Read on its own that
    /// first picture says "delete it". Read beside the second it says nothing of the kind, and this
    /// is the destructive half of the import, so the benefit of the doubt goes to keeping the card.
    /// </summary>
    private static IReadOnlyList<ShotMatch> Missing(IReadOnlyList<ShotReading> readings)
    {
        var found = Found(readings).Select(m => m.Card.OwnershipKey).ToHashSet();

        return readings.SelectMany(r => r.Matches)
                       .Where(m => !m.Owned && !found.Contains(m.Card.OwnershipKey))
                       .DistinctBy(m => m.Card.OwnershipKey)
                       .ToArray();
    }

    /// <summary>
    /// One mutation for the whole batch, so the undo history holds "imported a screenshot" rather
    /// than forty separate card edits — or, now that a batch can be eight pictures, rather than
    /// eight separate imports to undo one at a time.
    /// </summary>
    private void Apply(IReadOnlyList<ShotMatch> found, IReadOnlyList<ShotMatch> missing)
    {
        var add = _applyFound ? found : [];
        var remove = _applyMissing ? missing : [];
        if (add.Count == 0 && remove.Count == 0) return;

        Session.Mutate(p =>
        {
            var next = new Dictionary<string, int>(p.Collection);

            // A card list says a card is held, not how many are — so it only ever raises a zero to
            // one, and never overwrites a count the user typed in. The three-across list does print
            // a copy count, and once that is read this is where it will be used.
            foreach (var match in add)
            {
                var key = match.Card.OwnershipKey;
                next[key] = Math.Max(next.GetValueOrDefault(key), match.Copies ?? 1);
            }

            foreach (var match in remove) next.Remove(match.Card.OwnershipKey);

            return p with { Collection = next };
        });

        _applied = Describe(add.Count, remove.Count);
    }

    private void UndoApply()
    {
        Session.Undo();
        _applied = null;
    }

    private static string Describe(int added, int removed) => (added, removed) switch
    {
        (0, _) => $"Marked {removed:N0} {Fmt.S(removed, "card")} as not owned.",
        (_, 0) => $"Recorded {added:N0} {Fmt.S(added, "card")} as owned.",
        _ => $"Recorded {added:N0} {Fmt.S(added, "card")} as owned. "
             + $"Marked {removed:N0} {Fmt.S(removed, "card")} as not owned.",
    };
}
