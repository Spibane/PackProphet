<Project Sdk="Microsoft.NET.Sdk">

  <!-- Domain + engine. Deliberately a plain library with NO Blazor or UI reference, so
       "the engine is pure C#" is enforced by the compiler rather than by discipline.
       Everything here must be unit-testable without a browser. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>


  <!-- PoissonTail is an implementation detail, but it is worth asserting directly against
       hand-computed values. Exposing internals to the test project beats widening the
       public API purely for testability. -->
  <ItemGroup>
    <InternalsVisibleTo Include="PackProphet.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

</Project>
