@page "/chase"
@page "/chase/{Id}"
@implements IDisposable
@inject AppSession Session
@inject UiBusy Busy
@inject NavigationManager Nav

<PageTitle>@(_list?.Name ?? "Chase lists") · PackProphet</PageTitle>

@if (!Session.Ready)
{
    <Loading />
}
else if (Id is null)
{
    <div class="page-head">
        <h1 class="title">Chase lists</h1>
        @* The useful count rather than the saved one, as on the decks shelf beside it: how many
           are finished is what you came to find out, and it is the figure that moves when you open
           a pack. *@
        <span class="subtitle">
            @Session.ChaseLists.Count saved
            @if (_lists.Count > 0)
            {
                <text>&middot; </text>
                <strong>@Complete complete</strong>
            }
        </span>
        <span class="actions">
            <button class="btn btn-sm btn-primary" @onclick="NewList">New chase list</button>
        </span>
    </div>

    <PageShell Measure="PageShell.Width.Wide" Class="@(_lists.Count > 0 ? "railed" : null)">

    @if (_lists.Count > 0)
    {
        @* The same two groups the decks shelf has, in the same order, because they are the same
           shelf with different things on it. *@
        <PageRail Id="chase-rail" OpenLabel="View" Count="@(_order == ListOrder.Closest ? 0 : 1)">
            <div class="rail-group">
                <span class="ttl" id="chase-layout">Layout</span>
                @* Two views because they answer different questions: the table compares lists
                   against each other, the grid is how you recognise one. *@
                <div class="rail-seg" role="group" aria-labelledby="chase-layout">
                    <button class="btn btn-sm @(Session.ChaseGrid ? "btn-outline-secondary" : "btn-secondary")"
                            @onclick="() => Session.SetChaseGrid(false)"
                            aria-pressed="@Aria.Flag(!Session.ChaseGrid)"
                            title="A table, for comparing">List</button>
                    <button class="btn btn-sm @(Session.ChaseGrid ? "btn-secondary" : "btn-outline-secondary")"
                            @onclick="() => Session.SetChaseGrid(true)"
                            aria-pressed="@Aria.Flag(Session.ChaseGrid)"
                            title="Cards, for recognising">Grid</button>
                </div>
            </div>

            <div class="rail-group">
                <span class="ttl">Order</span>
                <select class="form-select form-select-sm" aria-label="Order the chase lists"
                        @onchange="OnOrder">
                    <option value="@ListOrder.Closest" selected="@(_order == ListOrder.Closest)">
                        Closest to complete
                    </option>
                    <option value="@ListOrder.Name" selected="@(_order == ListOrder.Name)">
                        By name
                    </option>
                    <option value="@ListOrder.Size" selected="@(_order == ListOrder.Size)">
                        Biggest first
                    </option>
                </select>
            </div>
        </PageRail>
    }

    <div class="shelf-main">

        @* A chase list is the one target the app cannot derive, so the empty state says what it is
           for rather than only that there is nothing here. *@
        <p class="text-body-secondary small mb-3">
            Any set of cards you want, for any reason. The pack ranking prices a chase list exactly
            as it prices a rarity target. Unlike a deck, a chase list wants a particular
            <strong>printing</strong>: the alternate art is not satisfied by the plain
            one.
        </p>

        @* The action as well as the fact. The decks page next door answers both questions an
           empty list raises -- what is missing, and what fills it -- and this one answered only
           the first, leaving the way out to a button in the header that a reader who has just
           been told there is nothing here has no particular reason to look back up at. *@
        @if (_lists.Count == 0)
        {
            <EmptyState>
                <ChildContent>No chase lists yet.</ChildContent>
                <Action>
                    <button class="btn btn-sm btn-primary" @onclick="NewList">
                        Start your first list
                    </button>
                </Action>
            </EmptyState>
        }
        else if (Session.ChaseGrid)
        {
            <div class="showcase-grid">
                @foreach (var list in _lists)
                {
                    <div class="showcase @(list.Missing == 0 && list.Wanted > 0 ? "ready" : "")">
                        @* The face is the rarest card still missing — a chase list is a chase, so the
                           card you have not got yet represents it. A finished list falls back to
                           its rarest card. *@
                        <a class="face" href="chase/@list.Id"
                           style="@(list.Face?.ArtVars)"
                           aria-label="Open @list.Name">
                            @if (list.Face is null)
                            {
                                <span class="empty">Nothing on this list</span>
                            }
                        </a>

                        <div class="body">
                            <a class="nm" href="chase/@list.Id">@list.Name</a>

                            <div class="meta">
                                <span class="small text-body-secondary">
                                    @list.Wanted card(s) wanted
                                </span>
                            </div>

                            <div class="badges">
                                @* Which list the grid's hearts fill. Said here because it is the
                                   one list in here that fills itself, and someone deleting lists
                                   should know which one that is before it goes. *@
                                @if (list.Id == Session.Profile.WantListId)
                                {
                                    <span class="badge text-bg-info"
                                          title="The heart on a card in the collection grid adds it to this list">
                                        Hearts
                                    </span>
                                }
                                @if (list.Wanted == 0)
                                {
                                    <span class="badge text-bg-secondary">Empty</span>
                                }
                                else if (list.Missing == 0)
                                {
                                    <span class="badge text-bg-success">Complete</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-warning">@list.Missing missing</span>
                                }

                                @if (list.Unobtainable > 0)
                                {
                                    <span class="badge text-bg-secondary"
                                          title="No pack on sale can give these: a promo, or a set with no published pull rates">
                                        @list.Unobtainable unobtainable
                                    </span>
                                }
                            </div>

                            @* The next few cards still wanted, rarest first: enough to recognise
                               the list by rather than a contents listing. *@
                            @if (list.Strip.Count > 0)
                            {
                                <div class="strip">
                                    @foreach (var card in list.Strip)
                                    {
                                        <span class="thumb" style="@card.ArtVars"
                                              data-tip="@card.Name"></span>
                                    }
                                </div>
                            }

                            <div class="actions">
                                <a class="btn btn-sm btn-outline-secondary" href="chase/@list.Id">Open</a>
                                <a class="btn btn-sm btn-outline-primary" href="packs?chase=@list.Id">Rank</a>
                                <button class="btn btn-sm @(_confirming == list.Id ? "btn-danger" : "btn-outline-danger")"
                                        @onclick="() => ConfirmDelete(list.Id)" aria-live="polite"
                                        title="@(_confirming == list.Id ? "Tap again to delete" : "Delete this chase list")">
                                    @(_confirming == list.Id ? "Really?" : "Delete")
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <DataTable Label="Your chase lists">
                <thead>
                    <tr>
                        <th scope="col">Chase List</th>
                        <th scope="col" class="num">Cards Wanted</th>
                        <th scope="col" class="num">Still Missing</th>
                        <th scope="col">Rarest Still Wanted</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var list in _lists)
                    {
                        <tr>
                            <td>
                                <a href="chase/@list.Id"><strong>@list.Name</strong></a>
                                @if (list.Id == Session.Profile.WantListId)
                                {
                                    <span class="badge text-bg-info ms-1"
                                          title="The heart on a card in the collection grid adds it to this list">
                                        Hearts
                                    </span>
                                }
                            </td>
                            <td class="num">@list.Wanted</td>
                            <td class="num">
                                @if (list.Wanted == 0)
                                {
                                    <span class="text-body-tertiary">&mdash;</span>
                                }
                                else if (list.Missing == 0)
                                {
                                    <span class="text-success-emphasis fw-semibold">Complete</span>
                                }
                                else
                                {
                                    <span>@list.Missing</span>
                                }
                            </td>
                            <td>
                                @* The chase card, named. A count of missing cards says how far
                                   there is to go; this says what you are going after. *@
                                @if (list.Face is null)
                                {
                                    <span class="text-body-tertiary small">&mdash;</span>
                                }
                                else
                                {
                                    <span class="pack-thumb deck-thumb"
                                          data-tip-img="@list.Face.ArtUrl" data-tip="@list.Face.Name"
                                          style="@list.Face.ArtVars"></span>
                                    <span>@list.Face.Name</span>
                                    <span class="small text-body-secondary ms-1">@list.Face.Set</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-secondary" href="chase/@list.Id">Open</a>
                                <a class="btn btn-sm btn-outline-primary" href="packs?chase=@list.Id">Rank</a>
                                @* Two taps, and the confirmation is scoped to this row: a shared
                                   flag would arm every delete button at once. *@
                                <button class="btn btn-sm @(_confirming == list.Id ? "btn-danger" : "btn-outline-danger")"
                                        @onclick="() => ConfirmDelete(list.Id)" aria-live="polite"
                                        title="@(_confirming == list.Id ? "Tap again to delete" : "Delete this chase list")">
                                    @(_confirming == list.Id ? "Really?" : "Delete")
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </DataTable>
        }
    </div>
    </PageShell>
}
else if (_list is null)
{
    <PageShell Measure="PageShell.Width.Text">
        <p>That chase list no longer exists.</p>
        <a class="btn btn-sm btn-outline-secondary" href="chase">&larr; all chase lists</a>
    </PageShell>
}
else
{
    <div class="page-head">
        <a class="btn btn-sm btn-outline-secondary" href="chase">&larr; chase lists</a>

        @* Renaming in place, saved on blur rather than per keystroke: the name is persisted state,
           and a save per character would serialise the whole profile as you type. The input is this
           page's title, so it sits where every other page's title is. *@
        <input class="form-control form-control-sm" style="max-width:16rem"
               value="@_list.Name" @onchange="Rename" aria-label="Chase list name" />

        <span class="actions">
            <a class="btn btn-sm btn-outline-primary" href="packs?chase=@_list.Id">
                Rank packs for this list
            </a>
            <button class="btn btn-sm btn-outline-secondary" @onclick="MakeShareLink">
                Share this list
            </button>
            @* The link is the better artefact and the wrong shape for where these trades actually
               happen. A Discord thread or a subreddit comment takes a few lines of text: nobody
               opens a stranger's link, and a reader on a phone with the game open cannot follow
               one and come back. Same list, in the form the conversation is already in. *@
            <button class="btn btn-sm btn-outline-secondary" @onclick="MakeTradeText">
                Copy as text
            </button>
            @* Two taps, like the deck editor's delete: the list took work to build and there
               is no undo prompt after the fact. *@
            <button class="btn btn-sm @(_confirming == _list.Id ? "btn-danger" : "btn-outline-danger")"
                    @onclick="() => ConfirmDelete(_list.Id)" aria-live="polite">
                @(_confirming == _list.Id ? "Really delete?" : "Delete")
            </button>
        </span>
    </div>

    @if (_shareLink is not null)
    {
        <PageShell>
            <input class="form-control form-control-sm" readonly value="@_shareLink"
                   onfocus="this.select()" aria-label="Shareable read-only link for this chase list" />
            <p class="small text-body-secondary mt-1 mb-0">
                Tap the field to select it, then copy. Shows only what is wanted, not what you
                already own. Nothing is uploaded, the whole list travels inside the link.
            </p>
            @* A want-list nobody can act on is half a share: the reader learns exactly what to
               send and has no way to find you. Said here, where the link is made, rather than
               left to be discovered by whoever opens it. *@
            @if (string.IsNullOrWhiteSpace(Session.Profile.InGameName))
            {
                <Notice Severity="Notice.Level.Warning" Dense="true" Class="mt-2 mb-0">
                    No in-game name on this collection, so the link says what you want without
                    saying who to send it to.
                    <a href="settings">Add one in Settings</a> and share the link again.
                </Notice>
            }
            else
            {
                <p class="small text-body-secondary mt-1 mb-0">
                    The link says to find you in-game as
                    <strong>@Session.Profile.InGameName</strong>.
                </p>
            }
        </PageShell>
    }

    @if (_tradeText is not null)
    {
        <PageShell>
            @* A textarea rather than the clipboard API: it needs no permission prompt, works in
               every browser this app supports, and shows what is about to be pasted instead of
               claiming to have copied something. Rows are capped so a long list scrolls rather
               than pushing the page it belongs to off the screen. *@
            <textarea class="form-control form-control-sm trade-text" readonly rows="8"
                      onfocus="this.select()"
                      aria-label="Your wanted cards as plain text">@_tradeText</textarea>
            <p class="small text-body-secondary mt-1 mb-0">
                Tap the box to select it all, then copy. Only what is still missing, with the
                rarity beside each card, which is what decides whether a trade is allowed.
            </p>
            @if (string.IsNullOrWhiteSpace(Session.Profile.InGameName))
            {
                <Notice Severity="Notice.Level.Warning" Dense="true" Class="mt-2 mb-0">
                    No in-game name on this collection, so the message says what you want without
                    saying who to send it to.
                    <a href="settings">Add one in Settings</a> and copy it again.
                </Notice>
            }
        </PageShell>
    }

    <PageShell>
    <div class="summary">
        <div class="stat">
            <span class="label">Cards Wanted</span>
            <span class="value">@Session.WantedTotal(_list)</span>
        </div>
        <div class="stat">
            <span class="label">Still Missing</span>
            <span class="value">@_missing</span>
        </div>
        <div class="stat">
            <span class="label">Expected Packs</span>
            <span class="value">@Fmt(_packs)</span>
            @* As on the Packs page, an estimate never appears without saying what it covers, since
               a card no pack sells changes the scope. *@
            <span class="sub">
                @if (_unreachable > 0)
                {
                    <span>
                        Covers @(_missing - _unreachable) of @_missing, and @_unreachable
                        cannot be pulled right now
                    </span>
                }
                else
                {
                    <span>Opening the best pack each time</span>
                }
            </span>
        </div>
    </div>

    @* Two columns on desktop, list left and search right — the same shape as the deck builder.
       With the search below the list, adding a card grew the list and pushed the search down, so
       adding a second copy meant hunting for the row that had just moved. *@
    <div class="edit-cols chase-edit">
        <div class="list-col">
        @if (_cards.Count == 0)
        {
            <EmptyState>Nothing on this list yet. Search below and tap a card to want it.</EmptyState>
        }
        else
        {
            @* A real table rather than a grid of divs. The columns had no headings at all, so a
               bare "×2" next to a stepper had to be guessed at, and nothing told a screen
               reader what any cell was. As a table each column is named once and the browser
               carries that to every cell under it. *@
            <DataTable Label="Cards on this chase list" Class="chase-list mb-3">
                <thead>
                    <tr>
                        <th scope="col" colspan="2">Card</th>
                        <th scope="col" data-pri="3">Type</th>
                        <th scope="col" data-pri="2">Rarity</th>
                        <th scope="col" data-pri="3">Set</th>
                        <th scope="col" data-pri="3">What It Costs</th>
                        <th scope="col" class="num" data-pri="2">Owned</th>
                        <th scope="col" class="num">Want</th>
                        <th scope="col"><span class="visually-hidden">Remove</span></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var (card, wanted, owned) in _cards)
                {
                    var rung = Session.Index.Rung(card);
                    var fact = Session.FactFor(card);
                    <tr class="chase-row @(owned >= wanted ? "got" : "")">
                        <td class="thumb"><a class="pack-thumb deck-thumb @(Session.HasGoldFlair(card) ? "gold-flair" : "")"
                           href="card/@card.Key"
                           data-tip-img="@card.ArtUrl" data-tip="@card.Name"
                           style="@card.ArtVars"
                           aria-label="@card.Name"></a></td>

                        <td class="nm">@card.Name</td>

                        @* The element, or a Trainer's kind. Cheap to draw and it is what tells
                           two cards of the same name apart at a glance. *@
                        <td class="ty" data-pri="3">
                            @foreach (var subtype in fact?.Subtypes ?? [])
                            {
                                <EnergyPip Type="@subtype" />
                            }
                        </td>

                        <td class="rr" data-pri="2">
                            @if (rung is not null)
                            {
                                <span class="glyphs @rung.GlyphClass" title="@rung.Symbol">@rung.Glyphs</span>
                            }
                        </td>

                        <td class="id" data-pri="3">@card.Set&thinsp;@card.Number</td>

                        @* What it will cost, which is the reason to keep a chase list in a tracker
                           rather than in a notes app, so it is on the row itself and carries the
                           flexible column — a flexible name column left a hole across the middle
                           of a wide screen. *@
                        <td class="rt" data-pri="3">@_routes.GetValueOrDefault(card.OwnershipKey)</td>

                        @* Owned copies only. The wanted number is already in the stepper to the
                           right, so a "1 of 2" here would say the same thing twice. *@
                        <td class="own num" data-pri="2">
                            @if (owned >= wanted)
                            {
                                <span class="done" title="You have all @wanted">&check; @owned</span>
                            }
                            else
                            {
                                <span>@(owned > 0 ? $"\u00d7{owned}" : "\u2014")</span>
                            }
                        </td>

                        @* Stepper rather than a cycler: there is no small ceiling to wrap around.
                           Extra copies are ordinary — trade fodder and flair material. *@
                        <td class="want-n num">
                            @* The stepper is wrapped rather than laid out on the cell: a td given
                               a flex display leaves the table row, and its bottom border then
                               draws at its own height instead of the row's. *@
                            <span class="stepper">
                                <button class="step" @onclick="() => Bump(card, -1)"
                                        aria-label="Want one fewer @card.Name">&minus;</button>
                                <span class="n">@wanted</span>
                                <button class="step" @onclick="() => Bump(card, 1)"
                                        disabled="@(wanted >= ChaseListEdit.MaxCopies)"
                                        aria-label="Want one more @card.Name">+</button>
                            </span>
                        </td>

                        <td class="acts"><button class="step remove" @onclick="() => Remove(card)"
                                title="Remove @card.Name from this list"
                                aria-label="Remove @card.Name from this list">&times;</button></td>
                    </tr>
                }
                </tbody>
            </DataTable>
        }

        </div>

        <div class="picker-col">
            @* A bulk add of two hundred cards says what it did; otherwise the only feedback is a
               number changing in a summary box further up the page. *@
            @if (_added > 0)
            {
                <Notice Severity="Notice.Level.Success">
                    Added @_added card(s) to <strong>@_list.Name</strong>.
                    <button class="btn btn-sm btn-link p-0 align-baseline"
                            @onclick="UndoAdd">Undo</button>
                </Notice>
            }
            @* All cards by default here, the opposite of the deck builder: a chase list is mostly
               made of things you do not have yet. *@
            <CardPicker Level="2" ByPrinting="true" AllCardsDefault="true"
                        Heading="Add cards to this list" PickedLabel="wanted"
                        PickedOf="WantedOf" OnPick="Add" OnPickAll="AddAll" />
        </div>
    </div>
    </PageShell>
}

@code {
    [Parameter] public string? Id { get; set; }

    private const int StripSize = 5;

    /// <summary>
    /// One chase list as the list page needs it. Built once per change rather than per render:
    /// both views walk every card on every list, and the grid reads each figure twice.
    /// </summary>
    private sealed record Row(
        string Id, string Name, int Wanted, int Missing, int Unobtainable,
        PocketCard? Face, IReadOnlyList<PocketCard> Strip);

    /// <summary>
    /// How the shelf is ordered. Closest-to-complete answers "what am I nearly done with"; it
    /// cannot answer "where is the one I made last week", and a shelf nobody can sort is fine at
    /// six lists and useless at thirty.
    /// </summary>
    private enum ListOrder { Closest, Name, Size }

    private ListOrder _order = ListOrder.Closest;

    private void OnOrder(ChangeEventArgs e)
    {
        if (Enum.TryParse<ListOrder>(e.Value?.ToString(), out var order)) _order = order;
        BuildRows();
    }

    /// <summary>Lists with nothing outstanding, for the bar.</summary>
    private int Complete => _lists.Count(l => l.Wanted > 0 && l.Missing == 0);

    private IReadOnlyList<Row> _lists = [];

    /// <summary>Which list's delete button is armed, if any.</summary>
    private string? _confirming;

    private ChaseList? _list;
    private IReadOnlyList<(PocketCard Card, int Wanted, int Owned)> _cards = [];
    private int _missing;
    private int _unreachable;
    private double _packs;
    private string? _shareLink;
    private string? _shareLinkFor;
    private string? _tradeText;

    private void MakeShareLink()
    {
        if (_list is null) return;

        var code = ChaseListCodec.Encode(Session.Profile.Name, _list, Session.Profile.InGameName);
        // After a `#`, not in the query string, on the same reasoning as everywhere else a
        // payload travels inside a link: a fragment is never sent to a server, so it cannot 414
        // no matter how the list grows.
        _shareLink = $"{Nav.BaseUri}share#{code}";
    }

    /// <summary>
    /// The list as a few lines anyone can paste into a chat.
    ///
    /// Only what is still short: a chase list keeps its rows once you own them, and asking for a card
    /// you already have wastes the reader's time and your own credibility. The rarity is on every
    /// line because the game's trade rules turn on it -- a reader can see at a glance which of
    /// these they are even allowed to send.
    ///
    /// The set and number lead each line rather than the name: two cards share a name often enough
    /// that a name alone is ambiguous, and the in-game list is ordered by number.
    /// </summary>
    private void MakeTradeText()
    {
        if (_list is null) return;

        var lines = new List<string> { $"Looking for: {_list.Name}" };

        if (Session.Profile.InGameName is { Length: > 0 } ign)
            lines.Add($"Find me in-game as {ign}");

        lines.Add("");

        var short_ = _cards.Where(c => c.Owned < c.Wanted).ToArray();
        foreach (var (card, wanted, owned) in short_)
        {
            var need = wanted - owned;
            var rarity = Session.Index.Rung(card)?.Symbol ?? card.Rarity;
            lines.Add($"{card.Set}-{card.Number} {card.Name} ({rarity})"
                      + (need > 1 ? $" x{need}" : ""));
        }

        if (short_.Length == 0) lines.Add("(nothing outstanding, this list is complete)");

        // Named rather than anonymous, so anyone who wants the same list can find the tool. One
        // line, at the end, where it does not get in the way of the part being read.
        lines.Add("");
        lines.Add("Made with PackProphet");

        _tradeText = string.Join('\n', lines);
    }

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnChanged;
        await Session.InitAsync();
        Reload();
    }

    protected override void OnParametersSet() => Reload();

    private void OnChanged()
    {
        Reload();
        InvokeAsync(StateHasChanged);
    }

    private void Reload()
    {
        if (!Session.Ready) return;

        BuildRows();

        _list = Id is null ? null : Session.ChaseListById(Id);
        if (_list is null) { _cards = []; return; }

        // A stale link for a list you have navigated away from is worse than none: it would go
        // on showing the previous list's name and contents if left in place.
        if (_shareLinkFor != _list.Id) { _shareLink = null; _tradeText = null; _shareLinkFor = _list.Id; }

        _cards = Session.ChaseListCards(_list);
        _missing = Session.MissingInChaseList(_list);
        BuildRoutes();

        // Only about the list in front of you: switching lists must not carry the notice across.
        if (_addedFor != _list.Id) { _added = 0; _addedFor = _list.Id; }

        // Re-priced only when the demand actually changed. Tapping through copy counts on a
        // long list would otherwise run the completion integral on every tap.
        var signature = $"{_list.Id}|{string.Join(',', _list.Wanted.OrderBy(kv => kv.Key).Select(kv => $"{kv.Key}:{kv.Value}"))}|{Session.CollectionRevision}|{string.Join(',', Session.UnavailablePacks)}";
        if (signature == _pricedFor) return;

        _pricedFor = signature;
        Price();
    }

    private string _pricedFor = "";

    private Dictionary<string, string> _routes = [];

    /// <summary>
    /// Cheapest-route notes, built once per reload rather than per render: pricing a card walks
    /// every pack that sells it, and the rows re-render on every tap of a stepper.
    /// </summary>
    private void BuildRoutes()
    {
        if (Session.Routes is null) { _routes = []; return; }

        _routes = _cards.ToDictionary(
            x => x.Card.OwnershipKey,
            x => RouteNote(x.Card),
            StringComparer.Ordinal);
    }

    /// <summary>
    /// Short by design. The Packs page spells every route out; here the row only has to answer
    /// "roughly what does this one cost me", and the card's own page has the full verdict.
    /// </summary>
    private string RouteNote(PocketCard card)
    {
        var routes = Session.Routes!.For(card, Session.Owned);

        var pull = routes.Options.FirstOrDefault(o => o.Route == AcquisitionRoute.Pull);
        var points = routes.Options.FirstOrDefault(o => o.Route == AcquisitionRoute.PackPoints);

        var parts = new List<string>();

        if (pull is { Available: true, PacksEquivalent: { } packs })
            parts.Add($"~{Fmt(packs)} packs");
        else
            // Said plainly rather than left blank: a promo or a rate-less set is not a cheap
            // card, it is one no pack can give you.
            parts.Add("no pack sells it");

        if (points is { Available: true, Points: { } cost })
            parts.Add($"{cost:N0} pts");

        return string.Join(" · ", parts);
    }

    private void Price()
    {
        if (_list is null || Session.Ranker is null) { _packs = 0; _unreachable = 0; return; }

        var target = Session.TargetForChaseList(_list);
        var unavailable = Session.UnavailablePacks;

        _unreachable = Session.Ranker.Unreachable(target, Session.Owned, unavailable).Sum(d => d.Remaining);
        _packs = Session.Ranker.BestCasePacksToFinish(target, Session.Owned, unavailable);
    }

    private void BuildRows()
    {
        // Fetched once for the whole page. It is cached inside PackOdds, but the lookup still
        // builds a key from every priceable pack, so calling it per card would do that work a
        // few hundred times over.
        var rates = Session.Odds?.BestRatesByCard(Session.UnavailablePacks);

        _lists = Session.ChaseLists.Select(list =>
        {
            var cards = Session.ChaseListCards(list);        // already rarest-first

            // Still short of what is wanted. The face and the strip are drawn from these
            // because a chase list is a chase: the card you have not got is the one that
            // represents it, and a card you already own is not what you are looking at it for.
            var outstanding = cards.Where(c => c.Owned < c.Wanted).Select(c => c.Card).ToArray();

            // A finished list still needs a face, so it falls back to its rarest card outright.
            var pool = outstanding.Length > 0
                ? outstanding
                : cards.Select(c => c.Card).ToArray();

            return new Row(
                list.Id, list.Name,
                Session.WantedTotal(list),
                Session.MissingInChaseList(list),
                // Named separately from "missing" because it is a different problem: no amount
                // of opening packs will move it.
                outstanding.Count(c => !Priceable(c, rates)),
                pool.FirstOrDefault(),
                pool.Skip(1).Take(StripSize).ToArray());
        }).ToArray();

        @* Sorted after building rather than before: two of the three keys -- how much is missing,
           and how big the list is -- are computed above, so ordering the sources first would mean
           computing them twice. *@
        _lists = _order switch
        {
            ListOrder.Name => _lists
                .OrderBy(l => l.Name, StringComparer.CurrentCultureIgnoreCase)
                .ToArray(),
            ListOrder.Size => _lists
                .OrderByDescending(l => l.Wanted)
                .ThenBy(l => l.Name, StringComparer.CurrentCultureIgnoreCase)
                .ToArray(),
            _ => _lists
                .OrderBy(l => l.Missing)
                .ThenBy(l => l.Name, StringComparer.CurrentCultureIgnoreCase)
                .ToArray(),
        };
    }

    /// <summary>
    /// Whether any pack currently on sale can yield this card. False for promos, for sets with
    /// no published pull rates, and for anything sold only in a limited-time pack marked
    /// unavailable.
    ///
    /// Checked across every ENTRY sharing the card's ownership key, not just the one being
    /// displayed: the same card can be listed in two sets, and a Deluxe reprint of a promo is
    /// obtainable even though the promo entry is not.
    /// </summary>
    private bool Priceable(PocketCard card, IReadOnlyDictionary<string, double>? rates)
    {
        if (rates is null) return false;
        if (!Session.Index.ByOwnershipKey.TryGetValue(card.OwnershipKey, out var entries))
            return rates.GetValueOrDefault(card.Key) > 0;

        return entries.Any(e => rates.GetValueOrDefault(e.Key) > 0);
    }

    private void ConfirmDelete(string id)
    {
        if (_confirming != id) { _confirming = id; return; }

        _confirming = null;
        Delete(id);
    }

    private void NewList() => Nav.NavigateTo($"chase/{Session.CreateChaseList()}");

    private void Delete(string id)
    {
        Session.DeleteChaseList(id);
        if (Id == id) Nav.NavigateTo("chase");
    }

    private void Rename(ChangeEventArgs e)
    {
        if (_list is null) return;
        Session.RenameChaseList(_list.Id, e.Value?.ToString() ?? "");
    }

    private int WantedOf(PocketCard card) => _list?.Wanted.GetValueOrDefault(card.OwnershipKey) ?? 0;

    /// <summary>
    /// Tapping a card already on the list adds another copy rather than doing nothing, so the
    /// search is also how you ask for a second — and, unlike a cycler, tapping repeatedly can
    /// never wrap round and empty it.
    /// </summary>
    private void Add(PocketCard card) => Bump(card, 1);

    /// <summary>
    /// Everything matching the current filters — "all diamonds in A1", "every Grass card in this
    /// set". One change, so one undo press takes it all back.
    /// </summary>
    private void AddAll(IReadOnlyList<PocketCard> cards)
    {
        if (_list is null || cards.Count == 0) return;

        Session.AddToChaseList(_list.Id, cards.Select(c => c.OwnershipKey));
        _added = cards.Count;
    }

    /// <summary>How many the last bulk add covered, so the action is not silent.</summary>
    private int _added;

    private string? _addedFor;

    private void Bump(PocketCard card, int delta)
    {
        if (_list is null) return;
        Session.BumpWanted(_list.Id, card.OwnershipKey, delta);
    }

    private void Remove(PocketCard card)
    {
        if (_list is null) return;
        Session.SetWanted(_list.Id, card.OwnershipKey, 0);
    }

    private void UndoAdd()
    {
        Session.Undo();
        _added = 0;
    }

    private static string Fmt(double packs) => Text.Fmt.Packs(packs);

    public void Dispose() => Session.Changed -= OnChanged;
}
