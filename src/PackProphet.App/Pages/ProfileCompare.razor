@page "/compare"
@implements IDisposable
@inject AppSession Session

<PageTitle>Compare Collections · PackProphet</PageTitle>

@if (!Session.Ready)
{
    <Loading />
}
else if (!Session.MultipleProfiles)
{
    <div class="page-head">
        <h1 class="title">Compare Collections</h1>
        <span class="subtitle">Trades you could make with yourself</span>
    </div>
    <PageShell Measure="PageShell.Width.Wide">
        <p>Only one collection. Add another to compare.</p>
        <a class="btn btn-sm btn-primary" href="settings">Add a Collection</a>
    </PageShell>
}
else
{
    <div class="page-head folded">
        <h1 class="title">Compare Collections</h1>
        @* Which two, and what is currently narrowing the answer. The page compares one pair at a
           time and the filter changes which rows exist, so a reader who cannot see either is
           reading a list that means something other than what it says. *@
        <span class="subtitle">
            <span class="seg">@Session.Profile.Name against @(Others.FirstOrDefault(o => o.Id == _otherId)?.Name ?? "your other collections")</span>
            @if (_readyOnly)
            {
                <span class="seg filters">affordable today only</span>
            }
        </span>

        <span class="actions">
            <SheetOpener For="compare-target" Label="Pairing" />
        </span>
    </div>

    @* The pairing and the filter, behind the button rather than on a bar of their own. Two
       controls do not earn a strip across a page whose answer is two verdicts and two lists. *@
    <PageSheet Id="compare-target" Label="Pairing">
        <div class="rail-group">
            <span class="ttl">Compare With</span>
            <select class="form-select form-select-sm" aria-label="Collection to compare with" @onchange="OnPick">
                @foreach (var profile in Others)
                {
                    <option value="@profile.Id" selected="@(profile.Id == _otherId)">@profile.Name</option>
                }
            </select>
        </div>

        <div class="rail-group">
            <span class="ttl">Show</span>
            <label class="small">
                <input type="checkbox" class="form-check-input me-1" checked="@_readyOnly"
                       @onchange="e => _readyOnly = (bool)(e.Value ?? false)" />
                Affordable Today Only
            </label>
        </div>
    </PageSheet>


    @* Two mechanics, and the split between them is what the page is for. A Share is one-way and
       free but stops at 4 diamonds; a trade is a same-rarity swap that costs both accounts dust
       and a stamina. So "what does my alt have that my main needs" is not one list. *@
    @* One shell for the page. Four of them stacked here, the first wearing `pb-0` to close the
       seam its own padding opened between it and the next -- which is the shell being used as a
       wrapper for a paragraph rather than as the page's body. *@
    <PageShell Measure="PageShell.Width.Wide" Class="sections">
    @* How Shares and trades work is the game's to explain. What stays is where the balances
       come from, which the game cannot say. *@
    <p class="small text-body-secondary">
        Balances come from each collection's Resources page.
    </p>

    @if (_swaps is null)
    {
        <Loading />
    }
    else if (_swaps.Nothing)
    {
        @* Neither collection holds a spare the other still wants at a rarity that can be shared
           or traded. *@
        <EmptyState>Nothing to move.</EmptyState>
    }
    else
    {
            @* Shares first: one costs nothing, so there is no reason to trade before taking one.
               Both directions are listed because each account has its own daily allowance, so they
               do not compete. *@
            @if (_swaps.IncomingShares.Count > 0 || _swaps.OutgoingShares.Count > 0)
            {
                <div class="verdict-lead" aria-live="polite">
                    <span class="micro">The Call</span>

                    <div class="lead-head">
                      <div class="lead-text">
                        <h2 class="name take">@ShareTotal @Card(ShareTotal) Can Just Be Sent</h2>
                        <p class="says">
                        @if (_swaps.IncomingShares.Count > 0)
                        {
                            <span>
                                Start with <strong>@_swaps.IncomingShares[0].Card.Name</strong> from
                                @_swaps.Theirs.Name, worth about
                                @Fmt.PacksPhrase(_swaps.IncomingShares[0].PacksSaved) here.
                            </span>
                        }
                        @* One a day per account, and the two directions run at the same time. *@
                        <span>
                            About @_swaps.AllSharesDays @Day(_swaps.AllSharesDays) to move them all.
                        </span>
                        </p>
                      </div>
                    </div>
                </div>

                <h2>Free to Send</h2>

                <div class="share-cols">
                    <div>
                        <p class="small fw-semibold mb-1">
                            @_swaps.Theirs.Name sends &rarr; @_swaps.Mine.Name
                            <span class="text-body-secondary fw-normal">
                                (@_swaps.ShareDays @Day(_swaps.ShareDays))
                            </span>
                        </p>
                        @ShareList(_swaps.IncomingShares)
                    </div>
                    <div>
                        <p class="small fw-semibold mb-1">
                            @_swaps.Mine.Name sends &rarr; @_swaps.Theirs.Name
                        </p>
                        @ShareList(_swaps.OutgoingShares)
                    </div>
                </div>

                @if (_swaps.Swaps.Count > 0 || _swaps.Unpayable.Count > 0)
                {
                    <h2>Trades</h2>
                }
            }

            @if (_swaps.Swaps.Count == 0 && _swaps.Unpayable.Count > 0)
            {
                <div class="verdict-lead" aria-live="polite">
                    <div class="lead-head">
                      <div class="lead-text">
                        <h2 class="name skip">No Trade Is Possible Yet</h2>
                        <p class="says">
                            @_swaps.Unpayable.Count @Card(_swaps.Unpayable.Count) in
                            @_swaps.Theirs.Name would fill a gap here, but @_swaps.Mine.Name has
                            no spare at those rarities to trade back.
                        </p>
                      </div>
                    </div>
                </div>
            }
            @* Explicit rather than a bare else. Narrowing the branch above to "no trade and
               something stuck" left the else as the catch-all, so a shares-only comparison — no
               trades and nothing unpayable, the ordinary case now that diamonds are routed to
               Shares — fell through it and indexed an empty list. *@
            else if (_swaps.Swaps.Count > 0)
            {
                var best = _swaps.Swaps[0];
                <div class="verdict-lead" aria-live="polite">
                    <div class="lead-head">
                      <div class="lead-text">
                        <h2 class="name @(best.Ready ? "take" : "skip")">
                            @(best.Ready ? "Swap" : "Best swap once you can pay for it:")
                            @best.Incoming.Name for @best.Outgoing.Name
                        </h2>
                        <p class="then">
                            1 stamina each side &middot;
                            @(best.Dust > 0 ? $"{best.Dust:N0} dust each side" : "no dust")
                        </p>
                        <p class="says">
                        @if (best.Mutual)
                        {
                            <span>
                                About @Fmt.PacksPhrase(best.IncomingSaves) saved here and
                                @Fmt.PacksPhrase(best.OutgoingSaves) there.
                            </span>
                        }
                        else
                        {
                            <span>
                                Saves about @Fmt.PacksPhrase(best.IncomingSaves) here.
                                @_swaps.Theirs.Name gets @best.Outgoing.Name as payment.
                            </span>
                        }
                        @if (!best.Ready)
                        {
                            <span>@Blocked(best)</span>
                        }
                        </p>
                      </div>
                    </div>
                </div>

                <p class="small text-body-secondary">
                    @_swaps.Swaps.Count @Swap(_swaps.Swaps.Count), @_swaps.Mutual wanted by both
                    sides. <strong>@_swaps.ReadyNow</strong> can be done today.
                </p>

                <DataTable Label="Possible swaps">
                    <thead>
                        <tr>
                            <th scope="col">@_swaps.Mine.Name Gets</th>
                            <th scope="col">@_swaps.Theirs.Name Gets</th>
                            <th scope="col">Rarity</th>
                            <th scope="col" class="num">Packs Saved</th>
                            <th scope="col" class="num">Dust Each</th>
                            <th scope="col">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var swap in Rows)
                        {
                            <tr class="@(swap.Ready ? "" : "trade-blocked")">
                                <td>
                                    <a href="card/@swap.Incoming.Key">@swap.Incoming.Name</a>
                                    <span class="small text-body-secondary ms-1">@swap.Incoming.Set</span>
                                </td>
                                <td>
                                    <a href="card/@swap.Outgoing.Key">@swap.Outgoing.Name</a>
                                    <span class="small text-body-secondary ms-1">@swap.Outgoing.Set</span>
                                    @if (swap.Mutual)
                                    {
                                        <span class="badge text-bg-success ms-2">Wanted</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary ms-2">Payment</span>
                                    }
                                </td>
                                <td>
                                    <span class="glyphs @Session.Index.GlyphClass(swap.Incoming)" title="@Session.Index.Symbol(swap.Incoming)">
                                        @Session.Index.Glyphs(swap.Incoming)
                                    </span>
                                </td>
                                <td class="num">
                                    @Fmt.Packs(swap.IncomingSaves, Fmt.NoPackRoute)@(swap.Mutual ? $" + {Fmt.Packs(swap.OutgoingSaves, Fmt.NoPackRoute)}" : "")
                                </td>
                                <td class="num">@(swap.Dust > 0 ? swap.Dust.ToString("N0") : "—")</td>
                                <td>
                                    @if (swap.Ready)
                                    {
                                        <span class="text-success-emphasis">Ready</span>
                                    }
                                    else
                                    {
                                        <span>@Blocked(swap)</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </DataTable>

                @if (_readyOnly && Rows.Count == 0)
                {
                    <p class="text-body-secondary">
                        None of the @_swaps.Swaps.Count swaps is affordable today.
                    </p>
                }
            }

            @* Reported rather than dropped: a card visible in the other collection and absent here
               reads as a bug rather than as a rule. *@
            @if (_swaps.Unpayable.Count > 0)
            {
                <h2>Wanted, but Nothing to Pay With</h2>
                <p class="small text-body-secondary">
                    Any spare at the same rarity unlocks the swap.
                </p>
                <DataTable Label="Wanted, with nothing to pay with" Fit="true">
                    <thead>
                        <tr><th scope="col">Card</th><th scope="col">Rarity</th><th scope="col" class="num">Packs Saved</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var gift in _swaps.Unpayable)
                        {
                            <tr>
                                <td>
                                    <a href="card/@gift.Card.Key">@gift.Card.Name</a>
                                    <span class="small text-body-secondary ms-1">@gift.Card.Set</span>
                                </td>
                                <td>
                                    <span class="glyphs @Session.Index.GlyphClass(gift.Card)" title="@Session.Index.Symbol(gift.Card)">
                                        @Session.Index.Glyphs(gift.Card)
                                    </span>
                                </td>
                                <td class="num">@Fmt.Packs(gift.PacksSaved, Fmt.NoPackRoute)</td>
                            </tr>
                        }
                    </tbody>
                </DataTable>
            }

            @if (_swaps.Unwanted.Count > 0)
            {
                @* Wanted over there and spare here, but every swap at those rarities is already
                   paired above. *@
                <h2>Yours to Send, Once Something Comes Back</h2>
                <ul class="small mb-0">
                    @foreach (var gift in _swaps.Unwanted.Take(30))
                    {
                        <li>
                            <a href="card/@gift.Card.Key">@gift.Card.Name</a>
                            <span class="text-body-secondary">
                                @gift.Card.Set &middot; @Session.Index.Symbol(gift.Card)
                                @(gift.Copies > 1 ? $" · {gift.Copies} spare" : "")
                            </span>
                        </li>
                    }
                </ul>
                @if (_swaps.Unwanted.Count > 30)
                {
                    <p class="small text-body-tertiary">
                        And @(_swaps.Unwanted.Count - 30) more.
                    </p>
                }
            }
    }
    </PageShell>
}

@code {
    @*  Both columns of the Free-to-send grid render the same list of gifts and differ only in
        which way it points. Written out twice, they had already drifted once: a change to how a
        multiple-copy gift is labelled landed on the incoming side only. *@
    private RenderFragment<IReadOnlyList<DiffGift>> ShareList => gifts =>
        @<text>
            @if (gifts.Count == 0)
            {
                <EmptyState>Nothing this way.</EmptyState>
            }
            else
            {
                <ol class="small mb-0">
                    @foreach (var gift in gifts)
                    {
                        <li>
                            <a href="card/@gift.Card.Key">@gift.Card.Name</a>
                            <span class="text-body-secondary">
                                @gift.Card.Set &middot; @Session.Index.Symbol(gift.Card) &middot;
                                @Fmt.PacksPhrase(gift.PacksSaved)
                                @(gift.Copies > 1 ? $" · ×{gift.Copies}" : "")
                            </span>
                        </li>
                    }
                </ol>
            }
        </text>;

    private string? _otherId;
    private bool _readyOnly;
    private ProfileSwaps? _swaps;

    private IReadOnlyList<Profile> Others =>
        Session.Profiles.Where(p => p.Id != Session.ActiveProfileId).ToArray();

    private IReadOnlyList<SelfSwap> Rows =>
        _swaps is null ? []
        : _readyOnly ? _swaps.Swaps.Where(s => s.Ready).ToArray()
        : _swaps.Swaps;

    protected override void OnInitialized() => Session.Changed += OnChanged;

    protected override async Task OnInitializedAsync()
    {
        await Session.InitAsync();
        Rebuild();
    }

    private void OnChanged()
    {
        // The active collection can change from the top bar while this page is open, which
        // reverses the direction of every row — so the comparison is rebuilt, not just redrawn.
        Rebuild();
        InvokeAsync(StateHasChanged);
    }

    private void OnPick(ChangeEventArgs e)
    {
        _otherId = e.Value?.ToString();
        Rebuild();
    }

    private void Rebuild()
    {
        if (!Session.Ready || !Session.MultipleProfiles)
        {
            _swaps = null;
            return;
        }

        // Falls back whenever the chosen collection is gone or has become the active one, which
        // happens the moment someone switches to it from the top bar.
        if (_otherId is null || Others.All(p => p.Id != _otherId)) _otherId = Others[0].Id;

        _swaps = Session.CompareWith(_otherId!);
    }

    private string Blocked(SelfSwap swap)
    {
        // Named per side, because the fix is on one specific account and a combined verdict could
        // not point at it.
        var mine = Reason(swap.MineBlocking, _swaps!.Mine.Name);
        var theirs = Reason(swap.TheirsBlocking, _swaps!.Theirs.Name);

        return (mine, theirs) switch
        {
            (null, null) => "ready",
            (not null, null) => mine!,
            (null, not null) => theirs!,
            _ => $"{mine}, and {theirs}"
        };
    }

    private static string? Reason(TradeGate gate, string who) => gate switch
    {
        TradeGate.NotEnoughDust => $"{who} is short of dust",
        TradeGate.NoStamina => $"{who} has no trade stamina",
        _ => null
    };

    private static string Card(int n) => n == 1 ? "card" : "cards";

    private static string Swap(int n) => n == 1 ? "swap" : "swaps";

    private static string Day(int n) => n == 1 ? "day" : "days";

    private int ShareTotal =>
        _swaps is null ? 0
        : _swaps.IncomingShares.Sum(g => g.Copies) + _swaps.OutgoingShares.Sum(g => g.Copies);

    public void Dispose() => Session.Changed -= OnChanged;
}
