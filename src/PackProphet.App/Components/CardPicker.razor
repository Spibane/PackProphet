@inject AppSession Session
@implements IDisposable

@* The card picker, as its own component.

   Every keystroke re-renders the component that owns the text field. When that was the whole deck
   page, one keypress also re-rendered the deck list, the linter output, the missing-cards table (a
   RouteCost lookup per row) and the pack ranking, so typing dragged no matter how fast the search
   itself got. Owning the query state here means a keystroke re-renders this subtree and nothing
   else.

   The deck-dependent bits arrive as delegates rather than as data, so the parent does not have to
   hand over a copy of the deck on every edit. *@

@* The level is the caller's to set, because this component appears at three different depths:
   directly under the page title on Wonder Pick and Chase lists, and inside a section on a deck. It
   was a hard-coded h6, which meant Wonder Pick's outline went h1 straight to h6 and a screen
   reader navigating by heading skipped four levels on the way in. Size is set by .h6 either way,
   so the two decisions are now separate. *@
@switch (Level)
{
    case 2: <h2 class="sub-head">@Heading</h2>; break;
    case 4: <h4 class="sub-head">@Heading</h4>; break;
    default: <h3 class="sub-head">@Heading</h3>; break;
}

@* Name search alone cannot build a deck. "What puts something to Sleep", "show me the Supporters"
   and "which Basics do I own" are the real questions, and the last two need no typing at all, so
   the dropdowns work on their own.

   Every control binds the select's value rather than marking an option `selected`. Blazor tracks
   the element's value property, but a `selected` attribute inside a re-rendered option list is not
   reliably reapplied to the DOM's selectedIndex, so the visible choice can snap back to the first
   option even though the filter did change. *@
<div class="search-grid mb-2">
    <input class="form-control form-control-sm" placeholder="Name, or words from the card text" aria-label="Search cards by name or rules text"
           @bind="_text" @bind:event="oninput" @bind:after="OnTyped" />

    <div class="btn-group btn-group-sm" role="group" aria-label="Card pool">
        <button class="btn @(_ownedOnly ? "btn-secondary" : "btn-outline-secondary")"
                @onclick="() => SetPool(!_ownedOnly)" aria-pressed="@Aria.Flag(_ownedOnly)"
                title="Only cards you already own">
            I own
        </button>
        <button class="btn @(_ownedOnly ? "btn-outline-secondary" : "btn-secondary")"
                @onclick="() => SetPool(!_ownedOnly)" aria-pressed="@Aria.Flag(!_ownedOnly)"
                title="Every card in the game">
            All
        </button>
    </div>

    @* Card type is the hinge: everything to its right narrows to what that choice can be.
       Supporter under Pokémon, or a stage for a Trainer, is a filter combination that matches
       nothing. *@
    <select class="form-select form-select-sm" @bind="_kind" @bind:after="OnKindChanged"
            aria-label="Card type">
        <option value="">Any Card Type</option>
        <option value="Pokémon">Pokémon</option>
        <option value="Trainer">Trainer</option>
    </select>

    <select class="form-select form-select-sm" @bind="_subtype" @bind:after="OnFilterChanged"
            aria-label="@SubtypeLabel">
        <option value="">@("any " + SubtypeLabel.ToLowerInvariant())</option>
        @* Built from the data rather than hardcoded, so a new element or trainer kind becomes
           filterable on its own. Grouped only when both kinds are in play — with one chosen, the
           group heading repeats the dropdown to the left. *@
        @if (Subtypes.Count == 1)
        {
            @foreach (var value in Subtypes[0].Value)
            {
                <option value="@value">@value</option>
            }
        }
        else
        {
            @foreach (var group in Subtypes)
            {
                <optgroup label="@group.Key">
                    @foreach (var value in group.Value)
                    {
                        <option value="@value">@value</option>
                    }
                </optgroup>
            }
        }
    </select>

    @* Set and rarity. Both read straight off the card rather than from printed detail, so they
       work while card detail is still downloading — "every diamond in A1" is something people do
       on a first visit. *@
    <select class="form-select form-select-sm" @bind="_set" @bind:after="OnFilterChanged"
            aria-label="Set">
        <option value="">Any Set</option>
        @foreach (var series in Session.Sets.Series)
        {
            <optgroup label="Series @series">
                @* Not named `code`: @code is a Razor directive, so a variable of that name is
                   parsed as one and the file stops compiling. *@
                @foreach (var setCode in Session.Sets.SetsIn(series))
                {
                    <option value="@setCode">@setCode: @Session.Sets.DisplayName(setCode)</option>
                }
            </optgroup>
        }
    </select>

    <select class="form-select form-select-sm" @bind="_rarity" @bind:after="OnFilterChanged"
            aria-label="Rarity">
        <option value="">Any Rarity</option>
        @* Families first — "all diamonds" is four rungs — then the individual rungs for a precise
           pick. *@
        <optgroup label="Families">
            @foreach (var family in Families)
            {
                <option value="@("g:" + family)">All @family</option>
            }
        </optgroup>
        <optgroup label="Exactly">
            @foreach (var rung in Session.Index.Ladder.Rungs)
            {
                <option value="@("r:" + rung.Index)">@rung.Symbol</option>
            }
        </optgroup>
    </select>

    @* Trainers have no evolution stage, so under Trainer this control is removed rather than
       disabled: a greyed-out box invites a click that can never do anything. *@
    @if (StageApplies)
    {
        <select class="form-select form-select-sm" @bind="_stage" @bind:after="OnFilterChanged"
                aria-label="Evolution stage">
            <option value="">Any Stage</option>
            @foreach (var stage in Stages)
            {
                <option value="@stage">@stage</option>
            }
        </select>
    }

    @if (HasFilters)
    {
        <button class="btn btn-sm btn-outline-secondary" @onclick="ClearFilters">Clear</button>
    }
</div>

@if (!Session.FactsReady && (_kind.Length > 0 || _subtype.Length > 0 || _stage.Length > 0))
{
    <Notice Severity="Notice.Level.Info" Dense="true">
        Card detail is still downloading, so type and stage filters have nothing to
        match yet. Name search works now.
    </Notice>
}

@* What is being filtered on, spelled out. A row of dropdowns does not make its own state obvious,
   especially the pool, which is a pair of buttons rather than a labelled control. *@
@if (!Query.IsEmpty)
{
    <p class="small text-body-secondary mb-1">
        Showing
        <strong>@(_ownedOnly ? "cards you own" : "all cards")</strong>
        @if (_set.Length > 0) { <span>&middot; @_set</span> }
        @if (_rarity.Length > 0) { <span>&middot; @RarityLabel</span> }
        @if (_kind.Length > 0) { <span>&middot; @_kind</span> }
        @if (_subtype.Length > 0) { <span>&middot; @_subtype</span> }
        @if (ShowStageInSummary) { <span>&middot; @_stage</span> }
        @if (_text.Length > 0) { <span>&middot; matching &ldquo;@_text&rdquo;</span> }
    </p>
}

@if (Query.IsEmpty)
{
    <p class="small text-body-secondary">
        Browse with the dropdowns, or search by name or card text: try
        <em>asleep</em>, <em>poisoned</em> or <em>draw</em>.
    </p>
}
else if (_results.Count == 0)
{
    @* A dead end here is nearly always the pool rather than the filter: the default is "cards I
       own", so a narrow filter can come back empty while the same filter over all cards has
       plenty. Saying how many exist makes that one tap. *@
    @if (_ownedOnly && _elsewhere > 0)
    {
        <Notice Severity="Notice.Level.Info">
            None of the cards <strong>you own</strong> match, but
            <strong>@_elsewhere</strong> card(s) in the game do.
            <button class="btn btn-sm btn-outline-primary ms-1 py-0"
                    @onclick="() => SetPool(false)">Search all cards</button>
        </Notice>
    }
    else
    {
        <p class="small text-body-secondary">
            No card matches those filters.
        </p>
    }
}
else
{
    @* A CSS grid, not flex: with flex the cells size from their content, so the columns drifted
       from row to row.

       The columns carry what the dropdowns cannot say — rarity, HP, attack costs and damage,
       whether there is an ability, and how many you own — so a row is readable without hovering
       it. Element and stage are omitted because they are already filters. *@
    @* Bulk add, where the parent supports it. It is how "all diamonds from this set" — 226 cards —
       gets entered, and it applies to every match rather than only the ones on screen. *@
    @if (OnPickAll.HasDelegate && _matches.Count > 0)
    {
        <div class="d-flex align-items-center gap-2 mb-2">
            <button class="btn btn-sm btn-primary" @onclick="PickAll">
                Add all @_matches.Count
            </button>
            <span class="small text-body-secondary">
                Everything matching these filters, in one step
            </span>
        </div>
    }

    <div class="pick-list">
        @foreach (var card in _results)
        {
            var nr = Session.Index.DeckNrOf(card)!.Value;
            var fact = Session.FactFor(card);
            @* Owned copies mean different things in the two modes, and the row says the one that
               matches what a click does: picking a printing is about that printing, while filling
               a deck slot pools every printing of the identity. *@
            var owned = ByPrinting ? Session.CountOf(card) : Session.OwnedCopiesOfIdentity(nr);
            var picked = ByPrinting ? PickedOf(card) : InDeck(nr);
            var enabled = ByPrinting ? CanPick(card) : CanAdd(nr);
            var rung = RungOf(card);
            <button class="pick-row @(owned == 0 ? "unowned" : "") @(picked > 0 ? "in-deck" : "")"
                    @onclick="() => Pick(card, nr)" disabled="@(!enabled)"
                    data-tip-img="@card.ArtUrl" data-tip="@card.Name">
                <span class="pack-thumb deck-thumb @(Session.HasGoldFlair(card) ? "gold-flair" : "")"
                      style="@card.ArtVars"></span>

                <span class="nm">@card.Name</span>

                <span class="rr">
                    @if (rung is not null)
                    {
                        <span class="glyphs @rung.GlyphClass" title="@rung.Symbol">@rung.Glyphs</span>
                    }
                </span>

                @* Unit shown because these rows have no header to label the column, and an
                   unlabelled number next to attack damage reads as part of it. *@
                <span class="hp">
                    @if (fact?.Health is int hp)
                    {
                        <span class="v">@hp</span><span class="u">HP</span>
                    }
                    else if (fact is { IsPokemon: false, Subtype: { Length: > 0 } pipKind })
                    {
                        @* A Trainer has no HP, so its kind goes in the space that would otherwise
                           sit empty. Drawn as an outlined pip, which is how a trainer is told
                           apart from an energy at a glance. *@
                        <EnergyPip Type="@pipKind" />
                    }
                </span>

                <span class="mv">
                    @* A Trainer has no attacks, so its kind is spelled out here. The pip beside HP
                       carries the same fact as a shape, but a word is unambiguous and is what a
                       screen reader reads — and this column would otherwise be blank on every
                       Trainer row. *@
                    @if (fact is { IsPokemon: false, Subtype: { Length: > 0 } kind })
                    {
                        <span class="kind">@kind</span>
                    }

                    @* Ability first and as a word: "has an ability" changes how a card plays more
                       than its damage does.

                       The tip fires on pointer events only, so the same text is the accessible
                       name as well. Without it the row announces the word "Ability", or a bare
                       damage number, and what either means is reachable by mouse alone. *@
                    @if (fact?.HasAbility == true)
                    {
                        <span class="abl" data-tip="@AbilityTip(fact)"
                              aria-label="@AbilityLabel(fact)">Ability</span>
                    }
                    @foreach (var atk in fact?.AttackList ?? [])
                    {
                        <span class="atk" data-tip="@AttackTip(atk)" aria-label="@AttackLabel(atk)">
                            @foreach (var sym in atk.CostSymbols)
                            {
                                <EnergyPip Type="@sym" />
                            }
                            @* The printed damage rather than the raw number: "50×" and "30+" are
                               a large difference in what the attack does. *@
                            @if (atk.DamageLabel is { Length: > 0 } dmg)
                            {
                                <span class="dmg">@dmg</span>
                            }
                        </span>
                    }
                </span>

                @* Set only. The number within a set says nothing about the card and is not what
                   anyone recognises it by. *@
                <span class="id">@card.Set</span>

                @* Owned and in-deck are different facts and both matter here: the pool can be "all
                   cards", so a row may be one you do not have. *@
                @{
                    var spread = Spread(owned, nr);
                }
                <span class="own" title="@OwnedTip(owned, spread)">
                    @* The count is wrapped rather than left as bare text so it can hold its own
                       fixed column: as an anonymous grid item it cannot be aligned, and the
                       numbers drifted out of line on every row that gained a chip. *@
                    <span class="n">@(owned > 0 ? $"×{owned}" : "—")</span>
                    @* A deck slot is filled by the card rather than by one printing of it, so this
                       count pools every art. The row shows a single set and number, so a bare "x3"
                       beside it would read as three copies of that printing. *@
                    @if (spread.Count > 1)
                    {
                        <span class="arts" data-tip="@SpreadTip(spread)"
                              aria-label="@SpreadTip(spread)">@spread.Count arts</span>
                    }
                </span>
                <span class="ind">
                    @if (picked > 0)
                    {
                        <span class="badge text-bg-primary">@picked @PickedLabel</span>
                    }
                </span>
            </button>
        }
    </div>
    @if (_more > 0)
    {
        <p class="small text-body-secondary mt-1 mb-0">
            &hellip; and @_more more. Narrow the search to see them.
        </p>
    }
}

@code {
    /// <summary>Whether another copy of this identity may be added, per the deck's own rules.</summary>
    [Parameter] public Func<int, bool> CanAdd { get; set; } = _ => false;

    /// <summary>
    /// The owned printings behind an identity's pooled count, most-owned first. Empty in the
    /// by-printing pool, where the count already refers to exactly the row you are looking at,
    /// and for rows owned none of, so the lookup runs for a handful of rows rather than all.
    /// </summary>
    private IReadOnlyList<(PocketCard Card, int Count)> Spread(int owned, int nr)
    {
        if (ByPrinting || owned <= 0) return [];
        if (!Session.Index.ByDeckBuilderNr.TryGetValue(nr, out var printings)) return [];

        return printings
            .DistinctBy(c => c.OwnershipKey)
            .Select(c => (Card: c, Count: Session.CountOf(c)))
            .Where(x => x.Count > 0)
            .OrderByDescending(x => x.Count)
            .ToArray();
    }

    private static string OwnedTip(int owned, IReadOnlyList<(PocketCard Card, int Count)> spread) =>
        owned == 0 ? "you own none of this card"
        : spread.Count > 1
            ? $"you own {owned} copies across {spread.Count} different arts, and any of them " +
              "fills the deck slot"
            : owned == 1 ? "you own 1 copy" : $"you own {owned} copies";

    private static string SpreadTip(IReadOnlyList<(PocketCard Card, int Count)> spread) =>
        string.Join("\n", spread.Select(x => $"{x.Card.Set} {x.Card.Number} ×{x.Count}"));

    /// <summary>Copies of this identity already in the deck.</summary>
    [Parameter] public Func<int, int> InDeck { get; set; } = _ => 0;

    [Parameter] public EventCallback<int> OnAdd { get; set; }

    /// <summary>
    /// Pick particular PRINTINGS rather than card identities: one row per artwork, and the
    /// chosen card is handed back whole.
    ///
    /// The two modes exist because the two consumers mean different things by "a card". A deck
    /// slot is filled by any printing, so rows collapse to one per identity. A chase list is a
    /// statement about artwork, so collapsing them would make the alternate art unpickable.
    /// </summary>
    [Parameter] public bool ByPrinting { get; set; }

    [Parameter] public EventCallback<PocketCard> OnPick { get; set; }

    /// <summary>Copies of this printing already chosen. Only used when <see cref="ByPrinting"/>.</summary>
    [Parameter] public Func<PocketCard, int> PickedOf { get; set; } = _ => 0;

    [Parameter] public Func<PocketCard, bool> CanPick { get; set; } = _ => true;

    /// <summary>
    /// Narrows what is SEARCHABLE, where <see cref="CanPick"/> decides whether a row that was
    /// found is enabled. Wonder Pick uses it: after the first card the offer can only hold cards
    /// from the same pack, and a search answering with forty greyed-out rows is a worse answer
    /// than one answering with the four that qualify.
    /// </summary>
    [Parameter] public Func<PocketCard, bool>? Only { get; set; }

    /// <summary>
    /// What <see cref="Only"/> is currently restricting to, as a value that can be compared.
    /// A delegate cannot be: the parent builds a fresh closure every render, so equality is
    /// always false and the search would re-run on every keystroke of the page around it. When
    /// this changes the results are stale by definition, so the search runs again.
    /// </summary>
    [Parameter] public string? OnlyKey { get; set; }

    /// <summary>Word after the count on a chosen row: "in deck", "wanted".</summary>
    [Parameter] public string PickedLabel { get; set; } = "in deck";

    [Parameter] public string Heading { get; set; } = "Add cards";

    /// <summary>
    /// Heading level for the title above, matching where this sits in the page's outline. Two
    /// when it follows the page title directly, three inside a section.
    /// </summary>
    [Parameter] public int Level { get; set; } = 3;

    /// <summary>
    /// Add every match at once. Optional: the deck builder does not offer it, because a 20-card
    /// deck has no use for "add all 226", while a chase list is exactly where that is wanted.
    /// </summary>
    [Parameter] public EventCallback<IReadOnlyList<PocketCard>> OnPickAll { get; set; }

    /// <summary>
    /// Start the pool at every card rather than only owned ones. A deck is usually built from
    /// what you have; a chase list is by definition mostly what you have not.
    /// </summary>
    [Parameter] public bool AllCardsDefault { get; set; }

    private Task Pick(PocketCard card, int nr) =>
        ByPrinting ? OnPick.InvokeAsync(card) : OnAdd.InvokeAsync(nr);

    private const int MaxResults = 60;

    private static readonly string[] Stages = ["Basic", "Stage 1", "Stage 2"];

    private bool _ownedOnly = true;
    private string _text = "";
    private string _kind = "";
    private string _subtype = "";
    private string _stage = "";
    private string _set = "";
    private string _rarity = "";
    private int _more;
    private int _elsewhere;

    private IReadOnlyList<PocketCard> _results = [];

    /// <summary>
    /// Every match, not just the page of them being shown. The bulk action operates on this, so
    /// "add all 226" adds 226.
    /// </summary>
    private IReadOnlyList<PocketCard> _matches = [];

    protected override void OnInitialized()
    {
        _ownedOnly = !AllCardsDefault;
        Session.Changed += OnSessionChanged;
    }

    private string? _onlyKey;
    private bool _onlySeen;

    protected override void OnParametersSet()
    {
        if (_onlySeen && _onlyKey == OnlyKey) return;

        _onlySeen = true;
        _onlyKey = OnlyKey;
        RunSearch();
    }

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        _typing?.Cancel();
        _typing?.Dispose();
    }

    private void OnSessionChanged()
    {
        // Only card detail arriving matters here: it changes what the search can match, so
        // results computed before it landed are stale. A collection edit must NOT trigger a
        // full re-scan.
        if (_poolFacts == Session.Facts.Count) return;

        BuildPool();
        RunSearch();
        InvokeAsync(StateHasChanged);
    }

    // ---- the searchable pool -----------------------------------------------------------

    /// <summary>
    /// Cards worth searching, paired with everything the search needs, built ONCE. Resolving the
    /// identity and the printed detail per card per keystroke was most of the original lag: two
    /// dictionary lookups across 3,700 cards, and the WebAssembly interpreter is an order of
    /// magnitude slower than desktop .NET at exactly that kind of work.
    /// </summary>
    private (PocketCard Card, int Nr, CardFact? Fact)[] _pool = [];

    private int _poolFacts = -1;

    /// <summary>
    /// Lowercased rules text per pool entry, built lazily. Only a text search of three or more
    /// characters needs it — which is exactly when typing started to drag — and building it for
    /// 3,700 cards is a visible one-off cost in the WebAssembly interpreter, so it is not paid
    /// by someone who only ever uses the dropdowns.
    /// </summary>
    private string[]? _blobs;

    private void BuildPool()
    {
        if (!Session.Ready) return;
        if (_pool.Length > 0 && _poolFacts == Session.Facts.Count) return;

        _poolFacts = Session.Facts.Count;
        _blobs = null;                  // card detail changed, so the text is stale
        _pool = Session.Index.All
            .Select(c => (Card: c, Nr: Session.Index.DeckNrOf(c) ?? 0))
            .Where(x => x.Nr != 0)
            .Select(x => (x.Card, x.Nr, Fact: Session.Facts.For(x.Nr)))
            .ToArray();
    }

    private string[] Blobs()
    {
        if (_blobs is not null && _blobs.Length == _pool.Length) return _blobs;

        var blobs = new string[_pool.Length];
        for (var i = 0; i < _pool.Length; i++) blobs[i] = CardSearch.RulesBlob(_pool[i].Fact);

        return _blobs = blobs;
    }

    // ---- searching ---------------------------------------------------------------------

    private CardQuery Query => new(
        _text, Blank(_kind), Blank(_subtype), Blank(_stage), _ownedOnly,
        Blank(_set), RarityCodes());

    /// <summary>
    /// Rarity codes for the current selection. A family covers several rungs and a rung can
    /// cover several codes, so both collapse to one flat set of codes here rather than the
    /// search needing to know about the ladder.
    /// </summary>
    private IReadOnlySet<string>? RarityCodes()
    {
        if (!Session.Ready || _rarity.Length == 0) return null;

        var rungs = Session.Index.Ladder.Rungs;

        if (_rarity.StartsWith("g:", StringComparison.Ordinal))
        {
            var family = _rarity[2..];
            return rungs.Where(r => r.Group.Equals(family, StringComparison.OrdinalIgnoreCase))
                        .SelectMany(r => r.Codes)
                        .ToHashSet(StringComparer.OrdinalIgnoreCase);
        }

        if (_rarity.StartsWith("r:", StringComparison.Ordinal)
            && int.TryParse(_rarity[2..], out var index))
            return rungs.Where(r => r.Index == index)
                        .SelectMany(r => r.Codes)
                        .ToHashSet(StringComparer.OrdinalIgnoreCase);

        return null;
    }

    /// <summary>Rarity families in ladder order, deduplicated — Diamond, Star, Shiny, Crown.</summary>
    private IReadOnlyList<string> Families =>
        !Session.Ready ? []
        : Session.Index.Ladder.Rungs.Select(r => r.Group)
              .Distinct(StringComparer.OrdinalIgnoreCase).ToArray();

    private string RarityLabel
    {
        get
        {
            if (!Session.Ready || _rarity.Length == 0) return "";
            if (_rarity.StartsWith("g:", StringComparison.Ordinal))
                return $"all {_rarity[2..].ToLowerInvariant()}";

            return _rarity.StartsWith("r:", StringComparison.Ordinal)
                   && int.TryParse(_rarity[2..], out var i)
                   && Session.Index.Ladder.Rungs.FirstOrDefault(r => r.Index == i) is { } rung
                ? rung.Symbol
                : "";
        }
    }

    private Task PickAll() => OnPickAll.InvokeAsync(_matches);

    private static string? Blank(string value) => value.Length == 0 ? null : value;

    /// <summary>
    /// Computed once per change rather than during render: as a property it ran twice per
    /// render, once for the empty check and once for the loop.
    /// </summary>
    private void RunSearch()
    {
        _more = 0;
        _elsewhere = 0;

        var query = Query;
        if (!Session.Ready || query.IsEmpty) { _results = []; _matches = []; return; }

        BuildPool();

        // Only a three-character-or-longer term reaches rules text, so the blobs are only built
        // when one does.
        var blobs = (query.Text?.Trim().Length ?? 0) >= 3 ? Blobs() : null;

        var hits = new List<(PocketCard Card, int Nr, CardSearch.Hit Rank, int Owned)>();
        for (var i = 0; i < _pool.Length; i++)
        {
            var (card, nr, fact) = _pool[i];

            if (Only is not null && !Only(card)) continue;

            var owned = Session.CountOf(card);
            if (query.OwnedOnly && owned == 0) continue;

            var rank = CardSearch.Rank(card, fact, query, blobs?[i]);
            if (rank == CardSearch.Hit.None) continue;

            hits.Add((card, nr, rank, owned));
        }

        // One row per identity, keeping the copy the user owns most of so the art shown is
        // theirs — unless printings are what is being picked, in which case collapsing them
        // would hide the very thing being chosen.
        var ranked = (ByPrinting
                ? hits.DistinctBy(h => h.Card.OwnershipKey)
                : hits.GroupBy(h => h.Nr).Select(g => g.OrderByDescending(h => h.Owned).First()))
            .OrderByDescending(h => h.Rank)
            .ThenBy(h => h.Card.Name, StringComparer.CurrentCultureIgnoreCase)
            .ToArray();

        _more = Math.Max(0, ranked.Length - MaxResults);
        _matches = ranked.Select(h => h.Card).ToArray();
        _results = _matches.Take(MaxResults).ToArray();

        // A second full scan, so it only runs when the owned pool actually came up empty.
        if (_results.Count == 0 && query.OwnedOnly)
        {
            var wider = query with { OwnedOnly = false };
            var count = 0;
            for (var i = 0; i < _pool.Length; i++)
            {
                // Same restriction as the scan above. "None owned, 12 elsewhere" has to mean 12
                // you could actually pick, or the offer to widen leads to an empty list.
                if (Only is not null && !Only(_pool[i].Card)) continue;

                if (CardSearch.Rank(_pool[i].Card, _pool[i].Fact, wider, blobs?[i]) != CardSearch.Hit.None)
                    count++;
            }

            _elsewhere = count;
        }
    }

    // ---- input handling ----------------------------------------------------------------

    /// <summary>A facet change is one deliberate action, so it searches at once.</summary>
    private void OnFilterChanged()
    {
        _typing?.Cancel();
        RunSearch();
    }

    private CancellationTokenSource? _typing;

    /// <summary>
    /// Long enough that a search does not start mid-word. A scan still costs real time in the
    /// WebAssembly interpreter, and because it runs on the same single thread as the UI, a scan
    /// started between two keystrokes delays the second one — which is why a short debounce
    /// still felt like the keyboard was lagging even though the keystroke itself was cheap.
    /// </summary>
    private static readonly TimeSpan TypingSettle = TimeSpan.FromMilliseconds(400);

    /// <summary>
    /// Typing never waits for the search. The keystroke renders immediately — this component is
    /// small, so that is cheap — and the scan happens once the burst has settled.
    /// </summary>
    private async Task OnTyped()
    {
        _typing?.Cancel();
        _typing = new CancellationTokenSource();
        var token = _typing.Token;

        try
        {
            await Task.Delay(TypingSettle, token);
        }
        catch (TaskCanceledException)
        {
            return;             // superseded by a later keystroke
        }

        RunSearch();
        StateHasChanged();
    }

    /// <summary>
    /// Card type changed, so anything downstream it cannot have is dropped. A stale element or
    /// stage would silently filter to nothing and look like a broken search.
    /// </summary>
    private void OnKindChanged()
    {
        if (_subtype.Length > 0 && !SubtypeValues.Contains(_subtype)) _subtype = "";
        if (!StageApplies) _stage = "";

        OnFilterChanged();
    }

    private void SetPool(bool ownedOnly)
    {
        _ownedOnly = ownedOnly;
        OnFilterChanged();
    }

    private bool HasFilters =>
        _text.Length > 0 || _kind.Length > 0 || _subtype.Length > 0 || _stage.Length > 0
        || _set.Length > 0 || _rarity.Length > 0;

    private void ClearFilters()
    {
        _text = _kind = _subtype = _stage = _set = _rarity = "";
        OnFilterChanged();
    }

    // ---- facets ------------------------------------------------------------------------

    /// <summary>Only Pokémon have an evolution stage.</summary>
    private bool StageApplies => _kind != "Trainer";

    private string SubtypeLabel => _kind switch
    {
        "Trainer" => "Trainer kind",
        "Pokémon" => "Element",
        _ => "Element or kind"
    };

    private IReadOnlySet<string> SubtypeValues =>
        Subtypes.SelectMany(g => g.Value).ToHashSet(StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// The stage filter is hidden under Trainer, so it must not linger in the summary line either:
    /// a filter the user cannot see or remove cannot be undone.
    /// </summary>
    private bool ShowStageInSummary => StageApplies && _stage.Length > 0;

    /// <summary>
    /// Facet values taken from the loaded data, so a new element or trainer kind becomes
    /// filterable without a code change. Cached, because it walks every known card and the
    /// dropdown is rebuilt on every render of this component.
    /// </summary>
    private IReadOnlyList<KeyValuePair<string, IReadOnlyList<string>>> Subtypes
    {
        get
        {
            if (_subtypesFor == (_kind, Session.Facts.Count)) return _subtypesCache;

            _subtypesFor = (_kind, Session.Facts.Count);
            _subtypesCache = !Session.FactsReady
                ? []
                : Session.Facts.All
                    .Where(f => f.Subtype is { Length: > 0 })
                    .GroupBy(f => f.IsPokemon ? "Pokémon" : "Trainer")
                    // Narrowed by the card-type choice, so the list can only ever offer a
                    // combination that exists.
                    .Where(g => _kind.Length == 0 || g.Key == _kind)
                    .OrderBy(g => g.Key, StringComparer.Ordinal)
                    .Select(g => new KeyValuePair<string, IReadOnlyList<string>>(
                        g.Key,
                        // SelectMany, so a dual-typed Pokémon puts BOTH of its types in the list
                        // rather than adding "Grass/Water" beside them as a third thing to pick.
                        // CardSearch matches on membership, so either one finds the card.
                        g.SelectMany(f => f.Subtypes).Distinct(StringComparer.OrdinalIgnoreCase)
                         .OrderBy(s => s, StringComparer.CurrentCultureIgnoreCase).ToArray()))
                    .ToArray();

            return _subtypesCache;
        }
    }

    private (string Kind, int Facts) _subtypesFor = ("\u0000", -1);
    private IReadOnlyList<KeyValuePair<string, IReadOnlyList<string>>> _subtypesCache = [];

    // ---- row detail --------------------------------------------------------------------

    /// <summary>
    /// Rarity rungs by code. The ladder is a short list, but looking a rung up per row per
    /// render is work with no upside.
    /// </summary>
    private RarityRung? RungOf(PocketCard card)
    {
        if (_rungs.Count == 0 && Session.Ready)
            foreach (var rung in Session.Index.Ladder.Rungs)
                foreach (var code in rung.Codes)
                    _rungs[code] = rung;

        return _rungs.GetValueOrDefault(card.Rarity);
    }

    private readonly Dictionary<string, RarityRung> _rungs = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// Hover text for an attack. The cost is not repeated — it is drawn as pips right there — so
    /// this carries only the name and any special effect.
    /// </summary>
    private static string AttackTip(CardAttack atk)
    {
        var name = atk.Name ?? "Attack";
        return string.IsNullOrWhiteSpace(atk.Effect) ? name : $"{name}\n{atk.Effect}";
    }

    private static string AbilityTip(CardFact fact)
    {
        var name = fact.Ability?.Name ?? "Ability";
        var effect = fact.Ability?.Effect;
        return string.IsNullOrWhiteSpace(effect) ? name : $"{name}\n{effect}";
    }

    /// <summary>
    /// The same facts the hover tip carries, written as an accessible name.
    ///
    /// A name is heard once, out of the context the tip has: no column, no position in the row,
    /// and no second chance to look. So it says which kind of thing it is, and it restates what
    /// the visible content shows, because a name on a container replaces its children rather than
    /// adding to them. Leaving the pips and the damage out of these strings would silence the
    /// only two parts of the attack a screen reader could already reach.
    /// </summary>
    private static string AbilityLabel(CardFact fact) => $"Ability. {AbilityTip(fact)}";

    private static string AttackLabel(CardAttack atk)
    {
        var cost = atk.CostSymbols.Count > 0
            ? $" Costs {string.Join(", ", atk.CostSymbols)}."
            : "";
        var damage = atk.DamageLabel is { Length: > 0 } d ? $" {d} damage." : "";
        return $"Attack. {AttackTip(atk)}{damage}{cost}";
    }
}
