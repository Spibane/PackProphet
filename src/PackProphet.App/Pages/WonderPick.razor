@page "/wonder"
@implements IDisposable
@implements IAsyncDisposable
@inject AppSession Session
@inject IJSRuntime JS

<PageTitle>Wonder Pick · PackProphet</PageTitle>

@if (!Session.Ready)
{
    <Loading />
}
else
{
    <div class="page-head folded">
        <h1 class="title">Wonder Pick</h1>
        @* What the verdict is worked out against. This said "Is this offer worth a stamina, or is
           a better one coming?" -- which is what the page is FOR, and belongs where someone
           arriving with no offer typed will read it. That reader gets it from the lead below,
           which is on screen exactly when there is nothing else to show. The bar's job is the
           setting: what counts as wanted decides every figure here, and it is folded away. *@
        <span class="subtitle">
            <span class="lbl">Target:</span> @Session.ScopeLabel(Scope)
        </span>

        <span class="actions">
            @* One control group, so it folds behind a button rather than standing up a bar --
               the same sheet the other Answer pages open. *@
            <SheetOpener For="wonder-target" Label="Target" />

            @* The pool the whole decision turns on, entered here rather than on a settings page:
               the threshold changes with it, and at the cap the advice inverts. It stays ON the bar
               rather than in the sheet for the same reason -- it is the page's only live input, and
               the verdict above is wrong the moment it is stale. *@
            <label class="small text-body-secondary" for="stamina">Stamina</label>
            <select id="stamina" class="form-select form-select-sm" style="width:5rem"
                    @onchange="OnStamina">
                @for (var n = 0; n <= GameRules.StaminaCap; n++)
                {
                    <option value="@n" selected="@(n == Session.WonderStamina)">@n</option>
                }
            </select>
        </span>
    </div>

    <PageSheet Id="wonder-target" Label="Target">
        <div class="rail-group">
            <span class="ttl">What Counts as Wanted</span>
            <ScopePicker Label="What Counts as Wanted"
                         Grouped="true" Scope="@Scope" OnScope="OnScope" />
        </div>
    </PageSheet>

    <PageShell Measure="PageShell.Width.Wide">
        @if (_offer.Count == 0)
        {
            @* The lead, and it has to be here rather than in the subtitle: the subtitle is
               hidden below 600px by design, and this is exactly the page whose purpose is easy to
               mistake for something the game already does. The offer screen shows the five cards
               and how many of each you hold; the thing it cannot show is the bar. *@
            @* Dismissible and persisted, like the collection's gap strip. It is a thing you need
               told once; after that it is six lines above the control you came here to use, and it
               would never go away on its own because it is a standing fact rather than a state
               that resolves. Dismissing hides the paragraph, not the page. *@
            @if (Session.ShowWonderIntro)
            {
                <p class="lead-note">
                    The game shows the cards. What it cannot show is <strong>the bar</strong>:
                    how good an offer has to be to be worth a stamina. That comes from the offers
                    you have been getting, so log every one, taken or skipped.
                    <button class="x" @onclick="() => Session.SetShowWonderIntro(false)"
                            title="Hide this for good. Settings brings it back."
                            aria-label="Hide the explanation">&times;</button>
                </p>
            }
            <p class="text-body-secondary">
                Tap the @GameRules.WonderPickCardsShown cards you were offered. You get
                <strong>one at random</strong>, so the only question is whether to spend at all.
            </p>
            <p class="text-body-secondary small">
                Stamina caps at @GameRules.StaminaCap, one back every
                @GameRules.StaminaRegen.TotalHours hours.
                3&#9733;, Crown and Shiny never appear, so the price stops at 4.
            </p>
        }
        else
        {
            @* The strip comes BEFORE the verdict here, which is the reverse of every other Answer
               page, and it is the one place that reversal is right: you fill these five boxes, and
               filling them is what produces the verdict. They are an input first and an
               explanation second, so they go where an input goes.

               The set is as literal as it gets -- the game shows five cards. *@
            <BoxStrip Label="The five cards you were offered"
                      Clause="you receive one at random, so the only choice is whether to spend at all"
                      Columns="@GameRules.WonderPickCardsShown">
                @for (var i = 0; i < GameRules.WonderPickCardsShown; i++)
                {
                    var card = i < _offer.Count ? _offer[i] : null;

                    <Box State="@(card is null ? Box.Kind.Dead : Box.Kind.Live)"
                         Label="@((i + 1).ToString())"
                         Note="@(card is null ? "tap a card below" : null)">
                        @if (card is not null)
                        {
                            @* A card you already hold cannot make this offer worth taking, so it
                               recedes and says what it is instead: the count is the reason it is
                               dim. A rarity mark on a card you need, a holding on one you do not
                               -- one line, saying the thing that decides. *@
                            <button class="offer-card @(Held(card) > 0 ? "have" : "")"
                                    @onclick="() => Remove(card)"
                                    title="Remove @card.Name from the offer"
                                    style="@card.ArtVars">
                                <span class="x" aria-hidden="true">&times;</span>
                            </button>
                            <span class="visually-hidden">@card.Name</span>

                            <span class="offer-say">
                                @if (Held(card) is var held && held > 0)
                                {
                                    <span class="have">have @held</span>
                                }
                                else if (Session.Index.Rung(card) is { } rung)
                                {
                                    <span class="glyphs @rung.GlyphClass" title="@rung.Symbol">@rung.Glyphs</span>
                                }
                            </span>
                        }
                    </Box>
                }
            </BoxStrip>

            @* With the strip, not with the commit row. Clearing empties the five boxes above it --
               it is an edit to the input rather than a third way the decision can go, and beside
               the two outcomes it read as one, on the row where every target has to be a full
               phone-width row. Which also put the commit row 40px under the tab bar. *@
            <button class="btn btn-sm btn-link offer-clear" @onclick="Clear">Clear These Five</button>

        }

        @* Reading the offer off a screenshot, above the picker, because it replaces the slow part:
           the game has the five cards on screen and entering them by hand is five searches.

           A button rather than a disclosure, and the same button the log screen uses, because it
           is the same offer made in the same place in the same job. A summary in secondary text
           reads as a footnote about the page; this is the fast way to do the thing the page is
           for.

           Still folded, and still not the whole screen: the picker always works and this does not,
           since a set released since the last fingerprint refresh cannot be recognised. *@
        @if (_offer.Count == 0)
        {
            <button type="button" class="shot-open mt-3 @(_shotsOpen ? "on" : "")"
                    aria-expanded="@Aria.Flag(_shotsOpen)" aria-controls="wonder-shots"
                    @onclick="() => _shotsOpen = !_shotsOpen">
                @* The same camera as the log screen's. Drawn twice rather than shared, for now:
                   two inline SVGs is less machinery than a component for one glyph, and NavIcon
                   holds the marks the two navs share and nothing else. *@
                <span class="ico" aria-hidden="true">
                    <svg viewBox="0 0 16 16" width="17" height="17" focusable="false">
                        <path d="M1.6 4.8h2.6l1.1-1.6h5.4l1.1 1.6h2.6v8H1.6z" fill="none"
                              stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
                        <circle cx="8" cy="8.6" r="2.5" fill="none" stroke="currentColor"
                                stroke-width="1.5" />
                    </svg>
                </span>
                Read the Offer Off a Screenshot
            </button>

            @* Hidden rather than unmounted, as on the log screen. Adopting a reading fills the
               offer and unmounts this whole block anyway, so what this protects is narrower: the
               readings survive the button being tapped shut and opened again. *@
            <div class="shot-panel" id="wonder-shots" hidden="@(!_shotsOpen)">
                <ShotImport @ref="_shots" Group="wonder" Choices="@ShotChoices">
                    <Intro>
                        Screenshot the <strong>Wonder Pick</strong> screen. One offer per picture
                        (@GameRules.WonderPickCardsShown cards).
                    </Intro>
                    <Actions Context="reading">
                        <button class="btn btn-primary" aria-live="polite"
                                title="@AdoptWarning"
                                @onclick="() => AdoptShot(reading)">
                            @if (Confirming(reading))
                            {
                                <text>Really? Other screenshots will be deleted.</text>
                            }
                            else
                            {
                                @* NamedCount rather than RecognisedCount: a slot the user named
                                   by hand is appraised with the rest, so it has to be counted
                                   with the rest. *@
                                <text>
                                    Appraise these @reading.NamedCount
                                    @Text.Fmt.S(reading.NamedCount, "card")
                                </text>
                            }
                        </button>
                        @if (reading.NamedCount > GameRules.WonderPickCardsShown)
                        {
                            @* More than one offer in frame. Taking the first five would appraise
                               a mixture of two offers, which is worse than saying so. *@
                            <p class="small text-warning-emphasis mt-2 mb-0">
                                More than @GameRules.WonderPickCardsShown cards, so this is
                                probably two offers. Crop to one and try again &mdash; only the
                                first @GameRules.WonderPickCardsShown would be used.
                            </p>
                        }
                    </Actions>
                </ShotImport>
            </div>
        }

        @if (_offer.Count < GameRules.WonderPickCardsShown)
        {
            <div class="mt-3">
                @* Only what could have come out of the same pack, once one card says which pack
                   that is. Restricting the SEARCH rather than only the tap: a list of cards the
                   page will refuse is a worse answer than a short list of the ones it will take,
                   and the heading says which pack so an empty search reads as the rule rather
                   than as a fault. *@
                <CardPicker Level="2" ByPrinting="true" AllCardsDefault="true"
                            Heading="@PickHeading"
                            PickedLabel="in offer" PickedOf="InOffer"
                            CanPick="CanPick" Only="FromSamePack" OnlyKey="@OfferPackKey"
                            OnPick="Add" />
            </div>
        }

        @* THE ANSWER COMES AFTER THE WORK, UNTIL THE WORK IS DONE.
           ==================================================================================
           This block sat directly under the strip, above the screenshot reader and the picker.
           So naming the first card pushed the second search about a screen and a half down: the
           verdict, the commit row and the per-card table all stood between the five boxes and the
           control the boxes tell you to use. "Tap a card below" was true and useless.

           A verdict over a two-card offer is provisional by definition -- it is an average over
           cards not yet named -- so while the offer is incomplete the page leads with filling it
           in. Once all five are in, the picker and the screenshot reader stop rendering and this
           follows the strip directly, which is the ordinary Answer shape reached by finishing
           rather than by a second layout.

           It stays live throughout: the figures update as each card lands, so the answer is
           there to scroll to, just not in front of the work. *@
        @if (_appraisal is { } a)
        {
            <div class="verdict-lead" aria-live="polite">
                <span class="micro">The call</span>

                <div class="lead-head">
                    <div class="lead-text">
                        <h2 class="name @VerdictClass(a.Verdict)">@Call(a.Verdict)</h2>

                        <p class="says">@Why(a)</p>

                        @* Where the bar came from, and why it is where it is.
                           ==================================================================
                           The threshold is the page's whole contribution and it is computed
                           from the user's own logged offers, so a verdict that states it
                           without sourcing it is asking to be trusted about the one number
                           nobody else could check. It also moves at the cap, which looks like
                           a bug unless the page says so first. *@
                        <p class="then">
                            @if (_history.Count >= MinSamplesForThreshold)
                            {
                                <text>
                                    That bar comes from your own @_history.Count logged offers.
                                </text>
                                @if (Session.WonderStamina >= GameRules.StaminaCap)
                                {
                                    @* Was three clauses on why the cap lowers the bar. The
                                       reader needs to know that it did, not the arithmetic. *@
                                    <text>
                                        Lowered right now because you are at the cap: holding out
                                        costs you the next one.
                                    </text>
                                }
                            }
                            else
                            {
                                <text>
                                    @_history.Count of @MinSamplesForThreshold logged offers, so
                                    this takes anything useful for now. Log every offer, taken or
                                    skipped &mdash; the bar is only as good as what is behind it.
                                </text>
                            }
                        </p>

                        <p class="then">
                            Costs @a.StaminaCost of @GameRules.StaminaCap stamina.
                            @if (a.StaminaCost > Session.WonderStamina)
                            {
                                <strong class="key">You have @Session.WonderStamina.</strong>
                            }
                        </p>
                    </div>

                    @Histogram(a)
                </div>
            </div>

            @* The action, directly under the answer.

               Everything below this is working: what the offer is worth, how that was arrived
               at, what each card contributed. It is all worth keeping and none of it is worth
               putting between a verdict and the button that acts on it -- this is a
               five-second decision made with the game in the other hand, and on a phone the
               stat grid and the contributions table pushed the commit row 1,378px down a
               812px screen. *@
            @* The two outcomes, and they get equal weight.
               ==================================================================================
               Taking and skipping are equally likely and equally consequential -- the bar is
               built from BOTH, and an offer skipped and not logged is a sample the threshold
               never sees. The old bar made "Skipped" a small outline button at the end of a row
               and "Took it" a green one behind a dropdown, which quietly says one of them is
               the real answer.

               On a phone they become full-width rows rather than a side-by-side pair, for the
               same reason: neither gets the smaller target. *@
            <div class="offer-commit">
                <span class="took">
                    <select class="form-select form-select-sm" @bind="_received"
                            aria-label="Which card you received">
                        <option value="">Which card did you get?</option>
                        @foreach (var c in _offer)
                        {
                            <option value="@c.OwnershipKey">@c.Name</option>
                        }
                    </select>
                    <button class="btn btn-primary" disabled="@(_received.Length == 0)"
                            @onclick="LogTaken">
                        Took It &mdash; Spend a Stamina
                    </button>
                </span>

                <button class="btn btn-outline-secondary" @onclick="LogSkipped">
                    Skipped It
                </button>
            </div>

            <p class="commit-note">
                Log every offer, taken or skipped. The bar is only as good as the distribution
                behind it.
            </p>

            <div class="summary">
                <div class="stat">
                    <span class="label">Expected Value</span>
                    <span class="value">@Fmt(a.ExpectedValue) packs</span>
                    @* Averaged over the 1-in-5 rather than the best card in the offer. *@
                    <span class="sub">Averaged over the 1-in-@GameRules.WonderPickCardsShown</span>
                </div>
                <div class="stat">
                    <span class="label">Per Stamina</span>
                    <span class="value">@Fmt(a.ValuePerStamina)</span>
                    @* Never called a price. Wonder Stamina and Pack Hourglasses are separate
                       currencies with no exchange rate, so packs-per-stamina only ranks one
                       offer against another. *@
                    <span class="sub">For comparing offers, not a price</span>
                </div>
                <div class="stat">
                    <span class="label">The Price Is Set By</span>
                    <span class="value">@(a.CostDriver.Length > 0 ? a.CostDriver : "—")</span>
                    <span class="sub">
                        @(a.CostDriverWanted ? "which you still want" : "which you do not need")
                    </span>
                </div>
            </div>

            @* The two count columns are inputs to the last one, not the point of the table.
               Named as what they do to the figure beside them, and dropped first on a phone,
               so the column that is this page's own answer is the one that survives. *@
            <h2 class="sub-head">What Each Card Contributes</h2>
            <DataTable Label="What each card in the offer contributes to its value">
                <thead>
                    <tr>
                        <th scope="col">Card</th>
                        <th scope="col" class="num" data-pri="3">You Hold</th>
                        <th scope="col" class="num" data-pri="3">Still Want</th>
                        <th scope="col" class="num">Worth to You</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in a.Cards.OrderByDescending(c => c.Value))
                    {
                        <tr class="@(c.Value <= 0 ? "text-body-secondary" : "")">
                            <td>
                                <span class="pack-thumb deck-thumb"
                                      data-tip-img="@c.Card.ArtUrl" data-tip="@c.Card.Name"
                                      style="@c.Card.ArtVars"></span>
                                <strong>@c.Card.Name</strong>
                                <span class="small text-body-secondary ms-1">@c.Card.Set</span>
                                @if (Session.Index.Rung(c.Card) is { } rung)
                                {
                                    <span class="glyphs @rung.GlyphClass ms-1" title="@rung.Symbol">@rung.Glyphs</span>
                                }
                            </td>
                            <td class="num" data-pri="3">@(c.Owned > 0 ? c.Owned.ToString() : "—")</td>
                            <td class="num" data-pri="3">@(c.Wanted > 0 ? c.Wanted.ToString() : "—")</td>
                            <td class="num">
                                @if (c.Value > 0)
                                {
                                    <span>@Fmt(c.Value) packs</span>
                                }
                                else
                                {
                                    <span>Nothing</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </DataTable>

            @* Logging is what makes the threshold work, so it is offered on every offer —
               including the ones skipped. *@

            @if (_logged is not null)
            {
                <Notice Severity="Notice.Level.Success" Class="mt-2 mb-0">@_logged</Notice>
            }
        }

    </PageShell>
}

@code {
    private const int MinSamplesForThreshold = 12;

    /// <summary>Copies of this card already held, which is why a card in the strip recedes.</summary>
    private int Held(PocketCard card) => Session.CountOf(card);

    /// <summary>
    /// Where this offer sits among the offers you have logged.
    ///
    /// THE ONE CHART IN THE APP
    /// ==================================================================================
    /// Everything else here is a figure or a sentence, on the rule that a number you can say is a
    /// number you should say rather than draw. This is the exception, and it earns it: the bar is a
    /// PERCENTILE of the user's own distribution, and a percentile cannot be said in a sentence.
    /// "Worth 31 packs per stamina against a bar of 18" tells you this one clears it; it does not
    /// tell you whether 31 is ordinary or the best offer you have seen in a month, and that is the
    /// difference between spending a stamina and holding it.
    ///
    /// Drawn only once there is a distribution to draw. Ten buckets over four logged offers is not
    /// a shape, it is four bars and some noise, and the verdict already says so in words.
    ///
    /// Inline SVG rather than divs: it is one drawing with a scale, and the threshold line has to
    /// land at the same place along the axis as the bucket boundaries it is measured against.
    /// </summary>
    private RenderFragment? Histogram(OfferAppraisal a) => _history.Count < MinSamplesForThreshold
        ? null
        : builder =>
        {
            const int buckets = 10;
            const double w = 200, h = 64;

            var top = Math.Max(_history.Max(), Math.Max(a.ValuePerStamina, a.Threshold));
            if (top <= 0) return;

            // Counts per bucket, and which bucket this offer falls in. Clamped at the last one so
            // an offer at exactly the maximum lands inside the chart rather than one past its end.
            var counts = new int[buckets];
            foreach (var v in _history)
                counts[Math.Clamp((int)(v / top * buckets), 0, buckets - 1)]++;

            var mine = Math.Clamp((int)(a.ValuePerStamina / top * buckets), 0, buckets - 1);
            var tallest = Math.Max(1, counts.Max());
            var barW = w / buckets;

            builder.OpenElement(0, "figure");
            builder.AddAttribute(1, "class", "offer-hist");

            builder.OpenElement(2, "figcaption");
            builder.AddAttribute(3, "class", "micro");
            builder.AddContent(4, "Against your own offers");
            builder.CloseElement();

            builder.OpenElement(5, "svg");
            builder.AddAttribute(6, "viewBox", $"0 0 {w} {h}");
            builder.AddAttribute(7, "width", w);
            builder.AddAttribute(8, "height", h);
            builder.AddAttribute(9, "role", "img");
            builder.AddAttribute(10, "aria-label",
                $"This offer is worth {Fmt(a.ValuePerStamina)} packs per stamina, against a bar of "
                + $"{Fmt(a.Threshold)} and {_history.Count} logged offers.");

            for (var i = 0; i < buckets; i++)
            {
                if (counts[i] == 0) continue;

                var bh = counts[i] / (double)tallest * (h - 2);
                builder.OpenElement(11, "rect");
                builder.AddAttribute(12, "x", (i * barW + 1).ToString("F1"));
                builder.AddAttribute(13, "y", (h - bh).ToString("F1"));
                builder.AddAttribute(14, "width", (barW - 2).ToString("F1"));
                builder.AddAttribute(15, "height", bh.ToString("F1"));
                builder.AddAttribute(16, "class", i == mine ? "mine" : "");
                builder.CloseElement();
            }

            // The bar itself, across the whole height so it reads as a line rather than as another
            // bucket.
            var tx = Math.Clamp(a.Threshold / top * w, 0, w);
            builder.OpenElement(17, "line");
            builder.AddAttribute(18, "x1", tx.ToString("F1"));
            builder.AddAttribute(19, "x2", tx.ToString("F1"));
            builder.AddAttribute(20, "y1", "0");
            builder.AddAttribute(21, "y2", h);
            builder.AddAttribute(22, "class", "bar-line");
            builder.CloseElement();

            builder.CloseElement();

            builder.OpenElement(23, "div");
            builder.AddAttribute(24, "class", "axis");
            builder.OpenElement(25, "span");
            builder.AddContent(26, $"bar {Fmt(a.Threshold)}");
            builder.CloseElement();
            builder.OpenElement(27, "span");
            builder.AddAttribute(28, "class", "mine");
            builder.AddContent(29, $"this one {Fmt(a.ValuePerStamina)}");
            builder.CloseElement();
            builder.CloseElement();

            builder.CloseElement();
        };

    private readonly List<PocketCard> _offer = [];
    private OfferAppraisal? _appraisal;
    /// <summary>
    /// What this page works toward, for as long as you are on it.
    ///
    /// It was one saved target shared by all four Answer pages, on the argument that "given what I
    /// am collecting, what should I do next" is one question. In use it was a trap: the target
    /// outlived the visit that set it, so a page opened days later ranked against a set chosen
    /// once on a different screen, and the only clue was a picker nobody remembered touching.
    ///
    /// Nothing is stored now. Every page starts at everything and holds a choice for the visit,
    /// which is as long as the answer is worth anything.
    /// </summary>
    private string Scope => Session.NormalizeScope(_scope);

    private string _scope = "everything";
    private string _received = "";
    private string? _logged;

    private IReadOnlyList<double> _history = [];
    private double _threshold;

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnChanged;
        await Session.InitAsync();
        RebuildHistory();
    }

    /// <summary>
    /// The picker stays where it is while the offer is being filled.
    ///
    /// Naming the first card replaces three paragraphs of explanation with the five boxes, which
    /// is the largest single change of height anywhere in the app -- and the control it happens
    /// above is the one you are in the middle of using. Same mechanism as the log screen; the note
    /// there says what it does.
    ///
    /// One token, because this screen never becomes a different screen: it fills up and empties.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) _anchor = await ScrollAnchor.LoadAsync(JS);
        if (_anchor is not null) await _anchor.KeepAsync(".search-grid", "offer");
    }

    private ScrollAnchor? _anchor;

    public void Dispose() => Session.Changed -= OnChanged;

    public async ValueTask DisposeAsync()
    {
        if (_anchor is not null) await _anchor.DisposeAsync();
        _anchor = null;
    }

    private void OnChanged()
    {
        RebuildHistory();
        Appraise();
        InvokeAsync(StateHasChanged);
    }

    private ICompletionTarget Target() => Session.TargetForScope(Scope);

    /// <summary>
    /// Rebuilt from the log rather than kept as a running figure: the value of a past offer
    /// depends on what you owned and wanted, and both move. A stored number would be an
    /// appraisal made under a collection that no longer exists.
    /// </summary>
    private void RebuildHistory()
    {
        if (Session.Wonder is null) { _history = []; _threshold = 0; return; }

        _history = Session.Wonder
            .HistoricalValuePerStamina(Session.Profile.WonderLog, Target(), Session.Owned)
            .ToArray();

        _threshold = WonderPickEval.ReservationThreshold(
            _history, Session.WonderStamina, MinSamplesForThreshold);
    }

    private void Appraise()
    {
        if (Session.Wonder is null || _offer.Count == 0) { _appraisal = null; return; }

        _appraisal = Session.Wonder.Appraise(_offer, Target(), Session.Owned, _threshold);
    }

    private int InOffer(PocketCard card) => _offer.Count(c => c.OwnershipKey == card.OwnershipKey);

    /// <summary>
    /// Five slots, and a card can genuinely appear twice in one offer, so duplicates are
    /// allowed — only the count is capped.
    /// </summary>
    private bool CanPick(PocketCard card) =>
        _offer.Count < GameRules.WonderPickCardsShown && FromSamePack(card);

    /// <summary>
    /// Whether this card could have come out of the same pack as the ones already named.
    ///
    /// A Wonder Pick offer is one pack somebody else opened, so the five cards are five cards
    /// from that pack — not five cards from the game. The picker let you build an offer that
    /// cannot exist, and an appraisal of an impossible offer is a number with nothing behind it.
    ///
    /// Two conditions, because a pack belongs to a set: same set, and some pack in common. Cards
    /// can sit in more than one pack of their set, so what narrows is the INTERSECTION — name a
    /// card in both Charizard and Mewtwo and both stay open until a card names one of them.
    ///
    /// A card whose pack list is empty does not narrow anything. Promos have none, and the data
    /// runs ahead of itself for a new set; treating "no data" as "no packs in common" would lock
    /// the picker to one card with no way to see why.
    /// </summary>
    private bool FromSamePack(PocketCard card)
    {
        if (_offer.Count == 0) return true;

        if (!string.Equals(card.Set, _offer[0].Set, StringComparison.OrdinalIgnoreCase))
            return false;

        var common = OfferPacks();
        return common.Length == 0
            || card.Packs is not { Length: > 0 } packs
            || packs.Any(p => common.Contains(p, StringComparer.OrdinalIgnoreCase));
    }

    /// <summary>
    /// The picker's heading, which has to carry the restriction: a search that comes back empty
    /// because the card is in another pack looks like a broken search unless the page said first.
    /// </summary>
    private string PickHeading =>
        OfferFrom is { Length: > 0 } from
            ? $"Add Card {_offer.Count + 1} of {GameRules.WonderPickCardsShown} \u00b7 {from}"
            : $"Add Card {_offer.Count + 1} of {GameRules.WonderPickCardsShown}";

    /// <summary>Packs every named card appears in. Empty means nothing has narrowed it yet.</summary>
    private string[] OfferPacks()
    {
        string[]? common = null;
        foreach (var card in _offer)
        {
            if (card.Packs is not { Length: > 0 } packs) continue;

            common = common is null
                ? packs
                : common.Intersect(packs, StringComparer.OrdinalIgnoreCase).ToArray();
        }

        return common ?? [];
    }

    /// <summary>
    /// What the restriction currently is, as something comparable. <see cref="CardPicker.Only"/>
    /// is a closure and is rebuilt every render, so the picker cannot tell from the delegate
    /// whether anything actually changed.
    /// </summary>
    private string OfferPackKey =>
        _offer.Count == 0 ? "" : $"{_offer[0].Set}|{string.Join(',', OfferPacks().Order(StringComparer.Ordinal))}";

    /// <summary>The pack the offer is being read as, for the picker's heading. Empty until one set.</summary>
    private string OfferFrom
    {
        get
        {
            if (_offer.Count == 0) return "";

            var packs = OfferPacks();
            return packs.Length == 1 ? PackName(packs[0]) : _offer[0].Set;
        }
    }

    /// <summary>A pack is stored as "SET:Name"; only the name is worth showing beside the set.</summary>
    private static string PackName(string pack)
    {
        var at = pack.IndexOf(':');
        return at >= 0 ? pack[(at + 1)..] : pack;
    }

    private void Add(PocketCard card)
    {
        // Both conditions, not just the count. CanPick governs whether the picker ENABLES a row,
        // and a rule enforced only by a disabled button is a rule the next caller does not have
        // to keep -- this is the one door every tap comes through, so it is where the offer's
        // shape is actually kept. (Reading an offer off a screenshot fills the list directly and
        // is deliberately not checked: that is a real pack, photographed.)
        if (!CanPick(card)) return;

        _offer.Add(card);
        _logged = null;
        Appraise();
    }

    private void Remove(PocketCard card)
    {
        var at = _offer.FindLastIndex(c => c.OwnershipKey == card.OwnershipKey);
        if (at >= 0) _offer.RemoveAt(at);

        _received = "";
        _logged = null;
        Appraise();
    }

    /// <summary>
    /// One choice, so <see cref="ShotImport"/> renders no picker: on this page the picture is a
    /// Wonder Pick line-up by definition. A pack's reveal looks identical and belongs on the log
    /// screen, where it means cards acquired rather than cards on offer.
    /// </summary>
    private static readonly (CardScreen? Value, string Label, string Hint)[] ShotChoices =
    [
        (CardScreen.WonderPick, "A Wonder Pick line-up", ""),
    ];

    /// <summary>
    /// Fills the offer from a reading and appraises it, which is the whole of what this page needed
    /// from a screenshot — the cards were always the tedious part and the judgement was always the
    /// point.
    ///
    /// Capped at the five slots an offer has. A screenshot of the Wonder Pick list can hold several
    /// offers at once, and the page says so rather than quietly appraising a mixture of two.
    /// </summary>
    /// <summary>
    /// The import control, so the page can tell whether taking one offer would cost the others.
    /// </summary>
    private ShotImport? _shots;

    /// <summary>Whether the screenshot reader is unfolded. Shut on arrival: the picker is the route that always works.</summary>
    private bool _shotsOpen;

    /// <summary>
    /// The picture whose button has been pressed once, while pressing it costs the others. One
    /// offer per picture here, so unlike the log screen there is nothing to key but the reading —
    /// whose identity <see cref="ShotImport"/> holds steady between renders for this.
    /// </summary>
    private ShotReading? _confirmAdopt;

    /// <summary>
    /// Whether appraising one picture would throw the rest away. It does: the page shows the import
    /// only while there is no offer on the bench, so filling the bench takes the import with it.
    /// </summary>
    private bool AdoptCostsTheRest => (_shots?.Readings.Count ?? 0) > 1;

    private bool Confirming(ShotReading reading) => ReferenceEquals(_confirmAdopt, reading);

    private string AdoptWarning =>
        AdoptCostsTheRest
            ? "Appraising one offer clears the other pictures. Nothing is recorded either way, but "
              + "you would have to choose them again. Appraise them one at a time from a fresh "
              + "upload, or start with the one you are deciding about."
            : "";

    private void AdoptShot(ShotReading reading)
    {
        // Asked once, the way a delete is. There is nothing to undo afterwards -- no state was
        // written -- so a mis-tap costs the other readings outright and the files have to be
        // chosen again.
        if (AdoptCostsTheRest && !Confirming(reading))
        {
            _confirmAdopt = reading;
            return;
        }

        _confirmAdopt = null;
        _offer.Clear();
        _received = "";
        _logged = null;

        // Recognised or named by hand, but never placed by position -- see LogPack.AdoptShot.
        foreach (var match in reading.Matches.Where(m => m.Source != MatchSource.GridPosition)
                                             .Take(GameRules.WonderPickCardsShown))
            _offer.Add(match.Card);

        Appraise();
    }

    private void Clear()
    {
        _offer.Clear();
        _received = "";
        _logged = null;
        _appraisal = null;
    }

    private void OnScope(ChangeEventArgs e)
    {
        _scope = e.Value?.ToString() ?? "everything";
        RebuildHistory();
        Appraise();
    }

    private void OnStamina(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var n)) return;

        Session.SetWonderStamina(n);
        // The threshold depends on the balance — at the cap it drops, because stamina sitting at
        // the cap is not regenerating and waiting has a strictly negative expected cost.
        RebuildHistory();
        Appraise();
    }

    private void LogSkipped()
    {
        if (_appraisal is null) return;

        Session.LogWonderOffer(_offer, _appraisal.StaminaCost, taken: false, received: null);
        _logged = "Logged as skipped. It still counts towards your threshold.";
        Clear();
    }

    private void LogTaken()
    {
        if (_appraisal is null || _received.Length == 0) return;

        var got = _offer.FirstOrDefault(c => c.OwnershipKey == _received);
        if (got is null) return;

        var cost = _appraisal.StaminaCost;
        var paid = Session.LogWonderOffer(_offer, cost, taken: true, received: got);

        _logged = $"Logged. {got.Name} added to your collection, {cost} stamina spent.";

        // What the balance could not cover came out of the hourglasses, so say which. Silent, it
        // looks like the stamina went further than it did.
        if (paid is { FromHourglasses: > 0 })
            _logged += $" {paid.Hourglasses} hourglasses covered {paid.FromHourglasses} of it.";

        Clear();
    }

    private static string Call(OfferVerdict verdict) => verdict switch
    {
        OfferVerdict.NothingWanted => "Skip: Nothing Here You Need",
        OfferVerdict.Overpriced => "Skip: You Are Paying for the Wrong Card",
        OfferVerdict.BelowThreshold => "Skip: Better Offers Come Along",
        _ => "Take It"
    };

    private static string VerdictClass(OfferVerdict verdict) =>
        verdict == OfferVerdict.Take ? "take" : "skip";

    private string Why(OfferAppraisal a) => a.Verdict switch
    {
        OfferVerdict.NothingWanted =>
            "Every card in this offer is one you already have enough of, so the pick cannot "
            + "advance anything. Skipping costs you nothing at all.",

        OfferVerdict.Overpriced =>
            $"It costs {a.StaminaCost} of your {GameRules.StaminaCap} stamina because it "
            + $"contains {a.CostDriver}, and you do not need {a.CostDriver}. The price is set "
            + "by the offer's highest rarity, not by what it is worth to you, so you would be "
            + $"paying near the maximum for the rest: about {Fmt(a.ExpectedValue)} packs' worth.",

        OfferVerdict.BelowThreshold =>
            $"About {Fmt(a.ValuePerStamina)} packs per stamina, against the "
            + $"{Fmt(a.Threshold)} you have been holding out for. Stamina refills one every "
            + $"{GameRules.StaminaRegen.TotalHours:N0} hours while offers rotate every "
            + $"{GameRules.WonderOfferLifetime.TotalHours:N0}, so spending here costs you a "
            + "better offer later.",

        _ => Session.WonderStamina >= GameRules.StaminaCap
            ? $"About {Fmt(a.ExpectedValue)} packs' worth for {a.StaminaCost} stamina, and you "
              + "are at the cap, so that stamina is not regenerating. Waiting has a cost right "
              + "now, which is why the bar is lower than usual."
            : $"About {Fmt(a.ExpectedValue)} packs' worth for {a.StaminaCost} stamina, above "
              + "the bar you have been holding out for."
    };

    // Forwards to the shared formatter. Five pages each had their own version of this and they
    // disagreed - the same card's cost printed as "16.0" here, "16" on card detail and "1.6k" past
    // ten thousand on two others - so the number appeared to change as you moved between screens.
    private static string Fmt(double packs) => Text.Fmt.Packs(packs);
}
