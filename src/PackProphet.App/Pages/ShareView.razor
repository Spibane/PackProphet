@page "/share"
@implements IDisposable
@inject AppSession Session
@inject NavigationManager Nav

<PageTitle>Shared wishlist · PackProphet</PageTitle>

@if (!Session.Ready)
{
    <p class="p-4">Loading card data&hellip;</p>
}
else if (_shared is null)
{
    <div class="page-head">
        <h1 class="title">Shared wishlist</h1>
    </div>
    <div class="p-3">
        <p>
            This link could not be read. It may be truncated from being copied, edited by hand,
            or made by a version of PackProphet this one no longer understands.
        </p>
    </div>
}
else
{
    <div class="page-head">
        <h1 class="title">@_shared.ListName</h1>
        <span class="subtitle">wanted by @_shared.OwnerName &mdash; shared read-only</span>
    </div>

    @* Said plainly rather than assumed: the whole list arrived inside the link itself, so nothing
       about opening this page sent anything anywhere. What the owner already has is deliberately
       not part of it — this is a want-list, not their collection. *@
    <Notice Severity="Notice.Level.Info" Class="mx-3">
        Nothing here can be edited. This was decoded entirely in your browser &mdash; opening the
        link uploaded nothing and contacted no server. Only the wanted cards travelled in the
        link, not @_shared.OwnerName's collection.
    </Notice>

    @if (_rows.Count == 0)
    {
        <p class="p-3 text-body-secondary">
            Nothing in this list is a card the current card data knows about.
        </p>
    }
    else
    {
        <div class="summary px-3 py-2">
            <div class="stat">
                <span class="label">cards wanted</span>
                <span class="value">@_rows.Count</span>
            </div>
            <div class="stat">
                <span class="label">you could help with</span>
                <span class="value">@_canHelpWith</span>
                <span class="sub">cards you already own at least one of</span>
            </div>
        </div>

        <table class="table table-sm align-middle mx-3">
            <thead>
                <tr>
                    <th scope="col">card</th>
                    <th scope="col" class="num">wants</th>
                    <th scope="col" class="num">you own</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _rows)
                {
                    <tr class="@(row.YouOwn > 0 ? "row-best" : "")">
                        <td>
                            <span class="pack-thumb deck-thumb"
                                  data-tip-img="@row.Card.ArtUrl" data-tip="@row.Card.Name"
                                  style="background-image:url('@row.Card.ArtUrl')"></span>
                            <strong>@row.Card.Name</strong>
                            <span class="text-body-secondary small">
                                @row.Card.Set &middot; @Session.Index.Symbol(row.Card)
                            </span>
                            @if (row.YouOwn > 0)
                            {
                                <span class="badge text-bg-primary ms-1">you can offer this</span>
                            }
                        </td>
                        <td class="num">@row.Wanted</td>
                        <td class="num">
                            @(row.YouOwn > 0 ? row.YouOwn.ToString() : "—")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="small text-body-secondary mx-3">
            Rows you own at least one of are highlighted &mdash; those are what you have to offer.
        </p>
    }
}

@code {
    private PackProphet.State.SharedWishlist? _shared;
    private sealed record Row(PocketCard Card, int Wanted, int YouOwn);
    private List<Row> _rows = [];
    private int _canHelpWith;

    /// <summary>
    /// The code sits after a `#`, not in the query string, because a link should never risk a
    /// 414 no matter how it grows — a fragment is never sent to a server at all.
    /// <see cref="SupplyParameterFromQueryAttribute"/> only ever sees the query string, so the
    /// fragment has to be read from the browser's own URL.
    /// </summary>
    private string? CodeFromFragment()
    {
        var fragment = new Uri(Nav.Uri).Fragment;
        return fragment.Length > 1 ? Uri.UnescapeDataString(fragment[1..]) : null;
    }

    protected override async Task OnInitializedAsync()
    {
        // A fragment-only URL change is a same-document navigation in every browser, so clicking
        // a second share link while this page is already open would otherwise go on showing the
        // first one's decoded content forever — Blazor still reports it through LocationChanged
        // even though nothing reloads.
        Nav.LocationChanged += OnLocationChanged;

        await Session.InitAsync();
        Decode();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        Decode();
        StateHasChanged();
    }

    private void Decode()
    {
        _shared = WishlistCodec.TryDecode(CodeFromFragment());
        _rows = [];
        _canHelpWith = 0;
        if (_shared is null || !Session.Ready) return;

        foreach (var (key, wanted) in _shared.Wanted)
        {
            if (wanted <= 0) continue;
            if (!Session.Index.ByOwnershipKey.TryGetValue(key, out var printings)) continue;

            var card = printings[0];
            _rows.Add(new Row(card, wanted, Session.Owned[key]));
        }

        _rows = _rows
            .OrderByDescending(r => r.YouOwn > 0)
            .ThenBy(r => r.Card.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
        _canHelpWith = _rows.Count(r => r.YouOwn > 0);
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
