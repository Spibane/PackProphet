@* Reads cards off screenshots of the game, and shows what it found.

   One component, three hosts, because the reading is the same work every time and only the meaning
   of the answer differs. A pack's five cards belong on the log screen, where the pack itself gets
   logged; a Wonder Pick's line-up belongs on the Wonder Pick screen, where it feeds an appraisal;
   the two card lists belong with the collection. Each host renders its own actions into
   <Actions> or <Together>, and none of them has to know how a screenshot is read.

   Several pictures at once, because a sitting is several pictures: packs get opened in a run and
   Wonder Picks come in a batch, and scrolling the My Cards list past one screenful is the normal
   case rather than the exception. Each picture is read on its own and reported on its own — the
   pixel work never saw the others — and the hosts differ in what they do with the set. A pack and
   a Wonder Pick are separate events, so those pages act on one reading at a time via <Actions>.
   The collection is one thing, so that page acts on all of them together via <Together>, which is
   also the only way to get the ownership arithmetic right across pictures that overlap.

   Everything the hosts share lives here: the promise that nothing is uploaded, the warning about
   sets too new to recognise, the file input, the failure advice, and the tables of what was found. *@

@inject AppSession Session
@inject ArtHashSource Hashes
@inject ShotScanner Scanner

@if (_coverageWarning is not null)
{
    @* The one thing about this feature that will otherwise look like a bug. Card lists come live
       from the community database and fingerprints ship with the build, so the newest set is
       browsable and unrecognisable at the same time.

       Info rather than Warning: it is a plain fact about how current the build is, stated before
       the user has done anything, and nobody did anything wrong. *@
    <Notice Severity="Notice.Level.Info">@_coverageWarning</Notice>
}

@if (Intro is not null)
{
    <div class="text-body-secondary mb-2">@Intro</div>
}

@* The one claim worth making up front, in the fewest words that make it. How the recognition
   works is in the host's own disclosure, for anyone who wants it. *@
<p class="small text-body-secondary">
    Read <strong>in this browser</strong>. Nothing is uploaded.
</p>

@if (Choices.Count > 1)
{
    <fieldset class="mb-3">
        @* fs-6 because Bootstrap sizes a legend like a heading, and beside the file label below it
           this is a field label of exactly the same rank. *@
        <legend class="form-label fs-6 mb-1">@ChoiceLegend</legend>

        @* Offered before the files and re-applied after them. Re-reading a scan under a different
           screen costs nothing — the pixels were measured once and only the interpretation
           changes — which is exactly why the two halves are split, and it is why changing this
           re-reads every picture rather than asking for them again. *@
        @foreach (var (value, label, hint) in Choices)
        {
            <div class="form-check">
                <input class="form-check-input" type="radio" name="@_group"
                       id="@($"{_group}-{value?.ToString() ?? "auto"}")"
                       checked="@(_screen == value)"
                       @onchange="@(() => ChooseScreen(value))" />
                <label class="form-check-label" for="@($"{_group}-{value?.ToString() ?? "auto"}")">
                    @label
                    <span class="d-block small text-body-secondary">@hint</span>
                </label>
            </div>
        }
    </fieldset>
}

<label class="form-label" for="@FileId">@(Together is null ? "The Screenshot" : "The Screenshots")</label>
<InputFile id="@FileId" class="form-control mb-1" OnChange="Read"
           accept="image/*" multiple disabled="@_busy" />

@* Said next to the control rather than in the label, because it is the one thing about this input
   that is not obvious from looking at it. *@
<p class="small text-body-secondary mb-2">
    Several at once is fine: up to @MaxFiles, each read on its own.
</p>

@if (_busy)
{
    <Notice Severity="Notice.Level.Info">
        @if (_total > 1)
        {
            @* Counted, because reading eight pictures takes long enough that a bare "reading…"
               looks stuck. *@
            @* _done counts what is finished, so the one being read is the next after it. Clamped
               because the last file finishes before the notice comes down, and "picture 4 of 3"
               is a worse thing to flash than a repeated 3. *@
            <text>Reading picture @(Math.Min(_done + 1, _total)) of @_total&hellip;</text>
        }
        else
        {
            <text>Reading the image&hellip;</text>
        }
    </Notice>
}

@if (_tooMany is not null)
{
    <Notice Severity="Notice.Level.Warning">@_tooMany</Notice>
}

@foreach (var shot in _shots)
{
    var reading = shot.Fixed;

    @if (reading is { Ok: false })
    {
        <Notice Severity="Notice.Level.Warning">
            @if (_shots.Count > 1)
            {
                @* Named, because with several pictures on screen "that file could not be read" does
                   not say which one to retake. *@
                <strong>@shot.Name</strong>

                <text> &mdash; </text>
            }
            @reading.Error
        </Notice>
    }
    else
    {
        <h2 class="sub-head">
            @if (_shots.Count > 1)
            {
                @shot.Name
            }
            else
            {
                <text>What This Picture Says</text>
            }
        </h2>

        @if (reading.ScreenWasInferred && Choices.Count > 1)
        {
            <Notice Severity="Notice.Level.Info" Dense="true">
                Read as <strong>@ScreenName(reading.Screen)</strong>.
                @if (Choices.Any(c => c.Value == reading.Screen))
                {
                    <text>Say which above if that is wrong.</text>
                }
                else
                {
                    @* The guess landed on a screen this host does not offer, which on the collection
                       import means a pack's reveal or a Wonder Pick line-up. Pointing at the picker
                       would be pointing at a list the answer is not in, so it says what it did with
                       it instead: the cards are cards either way, and the event they came from is
                       logged on the page that page is for. *@
                    <text>
                        The cards are added the same way. Logging the pack or the pick itself is on
                        its own page.
                    </text>
                }
            </Notice>
        }

        <DataTable Label="@($"What {shot.Name} came to")" Fit="true" Class="mb-3">
            <tbody>
                <tr>
                    <th scope="row" class="fw-normal">Cards Recognised</th>
                    <td class="text-end fw-semibold">@reading.RecognisedCount.ToString("N0")</td>
                </tr>
                @if (reading.Screen == CardScreen.OwnershipGrid)
                {
                    <tr>
                        <th scope="row" class="fw-normal">Named by Their Place in the List</th>
                        <td class="text-end">
                            @reading.Matches.Count(m => m.Source == MatchSource.GridPosition).ToString("N0")
                        </td>
                    </tr>
                }
                @if (shot.Picks.Count > 0)
                {
                    <tr>
                        <th scope="row" class="fw-normal">Named by Hand</th>
                        <td class="text-end">@shot.Picks.Count.ToString("N0")</td>
                    </tr>
                }
                @if (reading.UnreadCells > 0)
                {
                    <tr>
                        <th scope="row" class="fw-normal text-warning-emphasis">
                            Card Slots Not Recognised
                        </th>
                        <td class="text-end text-warning-emphasis">
                            @reading.UnreadCells.ToString("N0")
                        </td>
                    </tr>
                }
            </tbody>
        </DataTable>

        @foreach (var note in reading.Notes)
        {
            <Notice Severity="Notice.Level.Warning">@note</Notice>
        }

        @* A hand that came up short. Asked here rather than written into the reading's own notes,
           because the answer changes underneath it: name the missing slot and the hand is complete,
           and a note fixed at the moment of reading would still be saying four. *@
        @if (IsHand(reading) && reading.NamedCount > 0 && reading.NamedCount < GameRules.WonderPickCardsShown)
        {
            <Notice Severity="Notice.Level.Warning">
                Only @reading.NamedCount of the @GameRules.WonderPickCardsShown cards have been named.
                Cards mid-animation, or partly behind another card, are the usual reason. Name
                the rest below, or take the shot again.
            </Notice>
        }

        @if (reading.Matches.Count == 0 && reading.UnreadCells == 0)
        {
            <Notice Severity="Notice.Level.Warning">
                Card slots were found but none could be named. A set released in the last few weeks may
                not have its artwork in this build yet.
            </Notice>
        }

        @if (reading.Matches.Count > 0)
        {
            @* DataTable, like the app's other twenty-six. This one was a hand-written wrapper --
               the same div with the same class and without the focus ring, the name or the
               keyboard stop the component exists to give it. *@
            <DataTable Label="@($"Cards read from {shot.Name}")" Class="mb-0">
                <thead>
                    <tr>
                        <th scope="col" colspan="2">Card</th>
                        <th scope="col">Read As</th>
                        @* Only the three-across list prints a count, so the column is only worth its
                           width on that screen. *@
                        @if (ShowsCopies(reading))
                        {
                            <th scope="col" class="text-end">Copies</th>
                        }
                        <th scope="col" class="text-end">You Have</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var match in reading.Matches)
                    {
                        <tr>
                            <td style="width: 2.5rem">
                                <span class="thumb"
                                      style="@match.Card.ArtVars"
                                      role="img" aria-label="@match.Card.Name"></span>
                            </td>
                            <td>
                                <a href="card/@match.Card.Key">@match.Card.Name</a>
                                <span class="d-block small text-body-secondary">@match.Card.Key</span>
                            </td>
                            <td class="small">@ReadAs(match)</td>
                            @if (ShowsCopies(reading))
                            {
                                <td class="text-end">
                                    @if (match.Copies is { } copies)
                                    {
                                        @copies
                                    }
                                    else
                                    {
                                        @* Said, not left blank. A blank cell reads as "none". *@
                                        <span class="text-body-secondary" title="The badge could not be read">Not read</span>
                                    }
                                </td>
                            }
                            <td class="text-end">@Session.CountOf(match.Card)</td>
                        </tr>
                    }
                </tbody>
            </DataTable>
        }

        @* The slots the reader gave up on, each with its picture and a box to name it.
           ==========================================================================================
           Offered rather than merely counted, because by the time a slot lands here every automatic
           answer has been tried: the artwork was too far from anything in the table, or too close to
           two things at once, or the card is half off the edge of the screen. A person looking at the
           picture settles all three in a second, and the alternative on offer was retaking the
           screenshot.

           Below the table rather than mixed into it. The table is what the app read and this is what
           it could not, and interleaving them would put rows that mean "I know this" next to rows
           that mean "you tell me" under one heading. *@
        @if (shot.Reading.UnreadSlots.Count > 0)
        {
            <section class="mb-3">
                @* Every slot that came back unnamed stays on this list, including the ones since
                   named. A pick made from a thumbnail is a pick that can be wrong, and a row that
                   vanishes the moment it is answered is a row that cannot be corrected — the card
                   would be in the table above with no way back to the picture it came from. *@
                <h3 class="sub-head">
                    @if (reading.UnreadCells == 0)
                    {
                        <text>Every slot named</text>
                    }
                    else if (reading.UnreadCells == 1)
                    {
                        <text>One slot could not be named</text>
                    }
                    else
                    {
                        <text>@reading.UnreadCells slots could not be named</text>
                    }
                </h3>
                <p class="small text-body-secondary mb-1">
                    Name one and it joins the list above. Leave it and nothing happens to it.
                </p>

                @{ var pool = PoolFor(reading); }
                @foreach (var slot in shot.Reading.UnreadSlots)
                {
                    <SlotFix Slot="slot"
                             Group="@($"{_group}-{shot.Id}")"
                             Picked="@shot.Picks.GetValueOrDefault((slot.Row, slot.Col))"
                             PreferSets="reading.SetsSeen"
                             Only="@(pool?.Cards)"
                             OnlyLabel="@(pool?.Label)"
                             OnPick="card => Name(shot, slot, card)" />
                }
            </section>
        }

        @if (reading.Matches.Count > 0 && Actions is not null)
        {
            @* The gap is this component's to give, not each host's. What a reading renders last is
               either the card table, which closes on mb-0, or the slot list -- so a host's first
               button lands flush against it, and both hosts had the same missing margin. *@
            <div class="mt-3">
                @Actions(reading)
            </div>
        }
    }
}

@* Once, after every picture, and only where the host asked for it. Advice repeated under each of
   five failures is five copies of the same three lines. *@
@if (_shots.Any(s => !s.Reading.Ok))
{
    @* Three things to try, not three things to read. Each is an instruction; the reason it works
       is not what someone staring at a failure needs. *@
    <ul class="small text-body-secondary">
        <li>Screenshot the <strong>whole screen</strong>, not one card.</li>
        <li>A screenshot, not a photo of a screen.</li>
        <li>Wait for the cards to stop moving.</li>
    </ul>
}

@* Only once something was actually named. A picture can be read cleanly and still name nothing —
   a set too new for this build — and the host's actions are about cards, so offering them over
   an empty reading is offering to apply nothing. This is the same condition the per-picture
   <Actions> block uses, kept in step with it. *@
@if (Together is not null && Readings.Any(r => r.Matches.Count > 0))
{
    @Together(Readings)
}

@code {
    /// <summary>
    /// 12 MB per picture, matching the deck screenshot import. A phone screenshot is a few megabytes
    /// and the cap is only here to refuse something that plainly is not one. Applied per file rather
    /// than to the batch: twenty ordinary screenshots are an ordinary sitting, and one 12 MB file is
    /// the thing worth refusing either way.
    /// </summary>
    private const int MaxBytes = 12 * 1024 * 1024;

    /// <summary>
    /// How many pictures one go may carry. Not a technical limit — each is read and released in
    /// turn — but a guard against a whole camera roll being handed over by a mis-tap, which would
    /// otherwise lock the page up for minutes with no way to say stop.
    /// </summary>
    private const int MaxFiles = 20;

    /// <summary>
    /// What this host lets the user say the pictures are. One entry means the host already knows —
    /// the log screen only ever imports a pack — and the picker is not rendered at all. The answer
    /// applies to every picture in the batch, which is right because a sitting is screenshots of
    /// the same screen.
    /// </summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<(CardScreen? Value, string Label, string Hint)> Choices { get; set; } = [];

    /// <summary>The legend over the picker, where there is one.</summary>
    [Parameter] public string ChoiceLegend { get; set; } = "What Is in the Picture";

    /// <summary>Host-specific instructions: which screen to photograph, and how to get to it.</summary>
    [Parameter] public RenderFragment? Intro { get; set; }

    /// <summary>
    /// What the host offers to do with one reading, rendered under that picture's own table and only
    /// when something was found in it. For the hosts where each picture is a separate event — a pack
    /// opened, a Wonder Pick offered — so they can be worked through one at a time.
    /// </summary>
    [Parameter] public RenderFragment<ShotReading>? Actions { get; set; }

    /// <summary>
    /// What the host offers to do with every reading at once, rendered below them all. For the host
    /// where the pictures describe one thing between them: the collection is not per-screenshot, and
    /// two overlapping shots of the My Cards list can only be reconciled by a host that sees both.
    /// </summary>
    [Parameter] public RenderFragment<IReadOnlyList<ShotReading>>? Together { get; set; }

    /// <summary>
    /// Distinguishes this instance's radio group and input ids from any other on the page. The log
    /// screen has its own controls and a duplicate id would tie the wrong label to the wrong input.
    /// </summary>
    [Parameter] public string Group { get; set; } = "shot";

    private string _group = "shot";

    /// <summary>The file input's id, kept distinct per instance so its label cannot bind to another.</summary>
    private string FileId => $"{_group}-file";

    private bool _busy;

    /// <summary>Pictures finished, for the progress count. The one being read is the next after it.</summary>
    private int _done;
    private int _total;
    private string? _tooMany;
    private CardScreen? _screen;
    private readonly List<Shot> _shots = [];
    private string? _coverageWarning;
    private ArtHashTable _table = ArtHashTable.Empty;

    /// <summary>
    /// The readings that came to something, in the order the pictures were given. Public so a host
    /// acting on the batch can re-derive it after the fact — the confirm step of a two-press action
    /// arrives without the plan the first press computed.
    /// </summary>
    public IReadOnlyList<ShotReading> Readings =>
        _shots.Where(s => s.Reading.Ok).Select(s => s.Fixed).ToArray();

    /// <summary>One picture and what it turned out to say. The scan is kept so the reading can be redone.</summary>
    private sealed class Shot
    {
        public required string Name { get; init; }

        /// <summary>
        /// Distinguishes this picture's controls from another picture's. The file name will not do:
        /// a phone hands over eight files and two of them can be called the same thing, and two
        /// fields sharing an id tie the wrong label to the wrong box.
        /// </summary>
        public required int Id { get; init; }

        /// <summary>Null when the pixel side failed, in which case <see cref="Reading"/> carries why.</summary>
        public ShotScan? Scan { get; init; }

        /// <summary>What the reader made of it, before anything the user has said.</summary>
        public required ShotReading Reading
        {
            get => _reading;
            set { _reading = value; _fixed = null; }
        }

        private ShotReading _reading = null!;
        private ShotReading? _fixed;

        /// <summary>
        /// Slots the user has named, by position in this picture. Kept beside the reading rather
        /// than folded into it, so re-reading under a different screen does not throw them away —
        /// the slots are a fact about the pixels and the answers are a fact about the cards, and
        /// neither depends on which screen the picture is taken to be of.
        /// </summary>
        public Dictionary<(int Row, int Col), PocketCard> Picks { get; } = [];

        /// <summary>
        /// The reading as it now stands, with everything the user has named folded in.
        ///
        /// Cached until something changes it, and the caching is load-bearing rather than a saving.
        /// A host can hold on to a reading between renders — the log screen does, to remember which
        /// picture's button has been pressed once — and a fresh instance every render would make
        /// that impossible to recognise. Invalidated wherever the two inputs move: a re-read under
        /// a different screen, and a slot being named.
        /// </summary>
        public ShotReading Fixed => _fixed ??= Reading.WithManual(Picks);

        /// <summary>Forgets the folded reading, after a pick has changed what it would be.</summary>
        public void Refold() => _fixed = null;
    }

    /// <summary>
    /// Records what the user says a slot is, or clears it again.
    ///
    /// Nothing is applied here. A named slot becomes another row in the same review table the
    /// recognised cards are in, and the host's own button is still what commits any of it — a card
    /// the user pointed at is evidence like any other, not an instruction.
    /// </summary>
    private void Name(Shot shot, ShotSlot slot, PocketCard? card)
    {
        if (card is null) shot.Picks.Remove((slot.Row, slot.Col));
        else shot.Picks[(slot.Row, slot.Col)] = card;

        shot.Refold();
    }

    protected override void OnParametersSet()
    {
        _group = Group;

        // A host offering exactly one screen has said what the pictures are; there is nothing to
        // infer and nothing to ask.
        if (Choices.Count == 1) _screen = Choices[0].Value;
    }

    protected override async Task OnInitializedAsync()
    {
        // Fetched before a file is chosen, so the coverage warning is on screen before someone
        // spends a minute finding screenshots of a set this build cannot recognise.
        _table = await Hashes.GetAsync();
        _coverageWarning = ArtHashCoverage.Of(_table, Session.Index, Session.Sets)
                                          .Warning(Session.Sets);
    }

    private async Task Read(InputFileChangeEventArgs e)
    {
        _tooMany = null;

        IReadOnlyList<IBrowserFile> files;
        try
        {
            files = e.GetMultipleFiles(MaxFiles);
        }
        catch (InvalidOperationException)
        {
            // The only way this throws: more files than the cap.
            _tooMany = $"That is more than {MaxFiles} pictures. "
                       + $"Choose up to {MaxFiles} at a time.";
            return;
        }

        // Nothing readable was chosen, from a cancelled picker or a mis-tap on a whole camera roll.
        // What is already on screen stays: someone part-way through a batch of eight has read work
        // in it, and throwing that away over a tap that produced no pictures is losing their place
        // for no reason. The warning above the results says why nothing new appeared.
        if (files.Count == 0) return;

        _shots.Clear();
        _done = 0;
        _busy = true;
        _total = files.Count;

        try
        {
            // The table is fetched when the component initialises, but the file input is on screen
            // before that finishes — so a picture chosen quickly would be read against an empty
            // table and reported as unrecognisable. Awaiting the memoised task costs nothing once it
            // has landed and waits exactly as long as needed when it has not.
            _table = await Hashes.GetAsync();

            foreach (var file in files)
            {
                // Rendered before each file rather than only at the end, so the count in the busy
                // notice moves and a long batch does not look hung.
                if (_total > 1) StateHasChanged();

                _shots.Add(await ReadOne(file, _shots.Count));
                _done++;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Reads one picture. Never throws: one unreadable file out of eight must not throw away the
    /// seven that were fine, so a failure becomes a failed reading in its own right and the batch
    /// carries on.
    /// </summary>
    private async Task<Shot> ReadOne(IBrowserFile file, int id)
    {
        try
        {
            await using var stream = file.OpenReadStream(MaxBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);

            var mime = string.IsNullOrEmpty(file.ContentType) ? "image/png" : file.ContentType;
            var scan = await Scanner.ScanAsync(
                $"data:{mime};base64,{Convert.ToBase64String(buffer.ToArray())}");

            return new Shot { Name = file.Name, Id = id, Scan = scan, Reading = Interpret(scan) };
        }
        catch (Exception ex)
        {
            return new Shot
            {
                Name = file.Name,
                Id = id,
                Reading = ShotReading.Failed(
                    $"That file could not be read ({ex.GetType().Name}).",
                    _screen ?? CardScreen.OwnershipGrid),
            };
        }
    }

    /// <summary>
    /// Re-reads the scans the page already has. Changing which screen the pictures are of does not
    /// need the images again: the pixel work produced measurements, and only their meaning is in
    /// question — which is what makes re-reading a batch of eight free rather than eight more scans.
    /// </summary>
    private ShotReading Interpret(ShotScan scan) =>
        new ScreenshotReader(Session.Index, _table).Read(scan, _screen);

    private void ChooseScreen(CardScreen? screen)
    {
        _screen = screen;

        foreach (var shot in _shots)
            if (shot.Scan is { } scan)
                shot.Reading = Interpret(scan);
    }

    /// <summary>
    /// Drops every reading on screen. For a host that has just acted on all of them at once.
    ///
    /// It exists because logging a pack is not something that can be done twice by accident. The
    /// collection import can be applied again and lands on the same collection — it sets counts —
    /// but a pack log increments them and appends an event, so a second press of a button that is
    /// still on screen opens twelve packs that were never opened. Clearing what has been consumed
    /// is a stronger guard than disabling it, because there is then nothing left to press.
    /// </summary>
    public void Clear()
    {
        _shots.Clear();
        _tooMany = null;
        _done = 0;
        _total = 0;
        StateHasChanged();
    }

    private static string ScreenName(CardScreen screen) => screen switch
    {
        CardScreen.OwnershipGrid => "a set's card list, five across",
        CardScreen.CopiesGrid => "your own cards, three across",
        CardScreen.PackReveal => "the cards from a pack",
        _ => "a Wonder Pick line-up",
    };

    /// <summary>
    /// The cards this picture can be of, where that is a short enough list to be worth searching
    /// instead of the whole game.
    ///
    /// A hand comes out of ONE pack, and the cards that WERE read say which one -- so the slot the
    /// reader could not name is one of that pack's eighty-odd cards and cannot be anything else.
    /// Offering all three thousand instead answers a closed question with an open list, and the
    /// answers it offers first are reprints of the same Pokemon from other sets: precisely the
    /// resemblance that stopped the slot being read in the first place.
    ///
    /// Null where there is nothing sound to narrow with, and each case is a real one: a card list
    /// is a SET rather than a pack and its cards span every pack in it; a hand of shared high
    /// rarities fits several packs; nothing was recognised at all. A wrong restriction is worse
    /// than none, because the card the user is looking at would not be in it.
    /// </summary>
    private (IReadOnlyList<PocketCard> Cards, string Label)? PoolFor(ShotReading reading)
    {
        if (!IsHand(reading)) return null;

        var guess = PackIdentifier.Identify(Session.Index, reading);
        var packs = guess.PackKey is { } one ? [one] : guess.Candidates;
        if (packs.Count == 0) return null;

        var cards = packs
            .SelectMany(key => Session.Index.ByPack.GetValueOrDefault(key) ?? [])
            .DistinctBy(c => c.Key)
            .ToArray();

        return cards.Length == 0
            ? null
            : (cards, string.Join(" or ", packs.Select(Session.PackLabel)));
    }

    /// <summary>Whether this reading came off the one screen that prints how many copies you hold.</summary>
    private static bool ShowsCopies(ShotReading reading) =>
        reading.Screen == CardScreen.CopiesGrid;

    /// <summary>
    /// A hand of five rather than a page of a list: a pack's reveal or a Wonder Pick's line-up.
    /// The two screens where the reading is expected to be complete, and where falling short of
    /// five is worth saying.
    /// </summary>
    private static bool IsHand(ShotReading reading) =>
        reading.Screen is CardScreen.PackReveal or CardScreen.WonderPick;

    /// <summary>
    /// How a row was arrived at, in the user's terms. Confidence is a word rather than a number: the
    /// distance behind it is meaningful against a threshold and meaningless as a quantity, and
    /// printing "7" would invite a precision that is not there.
    /// </summary>
    private static string ReadAs(ShotMatch match) => match switch
    {
        { Source: MatchSource.GridPosition } => "blank slot, named by the cards around it",
        { Source: MatchSource.Manual } => "you named it",
        { IsMarginal: true } => "artwork recognised, less certainly",
        _ => "artwork recognised",
    };
}
