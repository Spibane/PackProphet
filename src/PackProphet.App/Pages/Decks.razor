@page "/decks"
@inject AppSession Session
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Decks · PackProphet</PageTitle>

@if (!Session.Ready)
{
    <Loading />
}
else
{
    <div class="page-head folded">
        <h1 class="title">Decks</h1>
        @* The useful count, not the saved one. "6 saved" is a fact about your filing; how many you
           could build today is the thing you came to find out, and it is the figure that changes
           when you open a pack. *@
        <span class="subtitle">
            @Session.Profile.Decks.Count saved
            @if (_decks.Count > 0)
            {
                <text> &middot; </text>
                <strong>@Buildable buildable today</strong>
            }
        </span>

        <span class="actions">
            <a class="btn btn-sm btn-outline-primary" href="decks/import">Import</a>
            <a class="btn btn-sm btn-primary" href="decks/new">New deck</a>
        </span>
    </div>

    <PageShell Measure="PageShell.Width.Wide" Class="@(_decks.Count > 0 ? "railed" : null)">

    @if (_decks.Count > 0)
    {
        @* Two groups, which is the argument for a rail over a sidebar: the collection's has seven
           and this has two, and both are the right size for the page they are on. A fixed sidebar
           would have to pad one of them. *@
        <PageRail Id="decks-rail" OpenLabel="View" Count="@(_order == "buildable" ? 0 : 1)">
            <div class="rail-group">
                <span class="ttl" id="decks-layout">Layout</span>
                @* Two views because they answer different questions: the table compares decks
                   against each other, the grid lets you recognise one at a glance. *@
                <div class="rail-seg" role="group" aria-labelledby="decks-layout">
                    <button class="btn btn-sm @(Session.DeckGrid ? "btn-outline-secondary" : "btn-secondary")"
                            @onclick="() => Session.SetDeckGrid(false)"
                            aria-pressed="@Aria.Flag(!Session.DeckGrid)"
                            title="A table, for comparing">List</button>
                    <button class="btn btn-sm @(Session.DeckGrid ? "btn-secondary" : "btn-outline-secondary")"
                            @onclick="() => Session.SetDeckGrid(true)"
                            aria-pressed="@Aria.Flag(Session.DeckGrid)"
                            title="Cards, for recognising">Grid</button>
                </div>
            </div>

            @* The shelf has always been closest-to-buildable first, which is the right default and
               the wrong only option: it answers "what can I play tonight" and cannot answer "where
               is the one I made last week". A shelf of six does not need a sort; a shelf of thirty
               does, and nobody's stays at six.

               Remembered between visits, because a shelf is somewhere you come back to and an order
               that reset on arrival is one nobody would set twice. *@
            <div class="rail-group">
                <span class="ttl">Order</span>
                <select class="form-select form-select-sm" aria-label="Order the decks"
                        @onchange="OnOrder">
                    <option value="buildable" selected="@(_order == "buildable")">
                        Closest to buildable
                    </option>
                    <option value="name" selected="@(_order == "name")">By name</option>
                    <option value="size" selected="@(_order == "size")">Fullest first</option>
                    @* Your own arrangement, which no computed key can express: the three above rank
                       decks by a property, and "these two first because I am playing them this
                       week" is not a property of a deck. *@
                    <option value="custom" selected="@(_order == "custom")">My own order</option>
                </select>

                @if (_order == "custom")
                {
                    <span class="rail-hint">Drag a deck by its handle, or focus one and use the
                    arrow keys.</span>
                }
            </div>
        </PageRail>
    }

    <div class="shelf-main">
        @if (_decks.Count == 0)
        {
            <EmptyState>
                No decks yet. <a href="decks/import">Import one</a> from the game's share code,
                or <a href="decks/new">Build one from scratch</a>.
            </EmptyState>
        }
        else if (Session.DeckGrid)
        {
            <h2 class="sub-head">
                Your decks
                @* What the shelf is actually in, rather than the default said unconditionally. It
                   read "Closest to buildable first" under every order the rail could pick. *@
                <span class="small text-body-secondary fw-normal">@OrderSaid</span>
            </h2>

            <div class="showcase-grid @(_order == "custom" ? "dragsort" : "")" @ref="_shelf">
                @* Indexed rather than a foreach: the drag handle has to say "3 of 12" out loud,
                   and a position is not a property of the deck. *@
                @for (var i = 0; i < _decks.Count; i++)
                {
                    var deck = _decks[i];
                    var at = i;
                    <div class="showcase @(deck.Missing == 0 && deck.Cards > 0 ? "ready" : "")"
                         data-drag-id="@deck.Id">
                        @* The deck's face card, chosen as its rarest — in practice the card the
                           deck is named after and the one you recognise it by. *@
                        <a class="face" href="decks/@deck.Id"
                           style="@(deck.Face?.ArtVars)"
                           aria-label="Open @deck.Name">
                            @if (deck.Face is null)
                            {
                                <span class="empty">Empty Deck</span>
                            }
                        </a>

                        <div class="body">
                            <a class="nm" href="decks/@deck.Id">@deck.Name</a>

                            @if (_order == "custom")
                            {
                                <DragHandle Name="@deck.Name" Index="@at" Count="@_decks.Count"
                                            OnMove="MoveTo" Id="@deck.Id" />
                            }

                            <div class="meta">
                                @foreach (var energy in deck.Energies)
                                {
                                    <EnergyPip Type="@energy.ToString()" />
                                }
                                <span class="small text-body-secondary">@deck.Cards / @GameRules.DeckSize</span>
                            </div>

                            <div class="badges">
                                @if (deck.Cards == 0)
                                {
                                    <span class="badge text-bg-secondary">Empty</span>
                                }
                                else if (deck.Missing == 0)
                                {
                                    <span class="badge text-bg-success">Buildable</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-warning">@deck.Missing missing</span>
                                }

                                @if (deck.Report is { HasErrors: true })
                                {
                                    <span class="badge text-bg-danger">
                                        @deck.Report.Of(LintSeverity.Error).Count() error(s)
                                    </span>
                                }
                                else if (deck.Report is { FullyVerified: false })
                                {
                                    <span class="badge text-bg-secondary"
                                          title="Some rules could not be checked: card detail is missing for this set">
                                        Unverified
                                    </span>
                                }
                            </div>

                            @* A few more of the deck's cards, rarest first: enough to recognise the
                               deck by rather than a contents listing, which the deck page has. *@
                            @if (deck.Strip.Count > 0)
                            {
                                <div class="strip">
                                    @foreach (var card in deck.Strip)
                                    {
                                        <span class="thumb" style="@card.ArtVars"
                                              data-tip="@card.Name"></span>
                                    }
                                </div>
                            }

                            <div class="actions">
                                <a class="btn btn-sm btn-outline-secondary" href="decks/@deck.Id">Open</a>
                                <button class="btn btn-sm @(_confirming == deck.Id ? "btn-danger" : "btn-outline-danger")"
                                        @onclick="() => ConfirmDelete(deck.Id)" aria-live="polite"
                                        title="@(_confirming == deck.Id ? "Tap again to delete" : "Delete this deck")">
                                    @(_confirming == deck.Id ? "Really?" : "Delete")
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <h2 class="sub-head">
                Your decks
                <span class="small text-body-secondary fw-normal">@OrderSaid</span>
            </h2>
            <DataTable Label="Saved decks">
                <thead>
                    <tr>
                        @if (_order == "custom")
                        {
                            <th scope="col" class="grip"><span class="visually-hidden">Reorder</span></th>
                        }
                        <th scope="col">Deck</th>
                        <th scope="col" class="num">Cards</th>
                        <th scope="col" class="num">Missing</th>
                        <th scope="col">Legality</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody class="@(_order == "custom" ? "dragsort dragsort-rows" : "")" @ref="_shelf">
                    @for (var i = 0; i < _decks.Count; i++)
                    {
                        var deck = _decks[i];
                        var at = i;
                        <tr data-drag-id="@deck.Id">
                            @if (_order == "custom")
                            {
                                <td class="grip">
                                    <DragHandle Name="@deck.Name" Index="@at" Count="@_decks.Count"
                                                OnMove="MoveTo" Id="@deck.Id" />
                                </td>
                            }
                            <td>
                                <a href="decks/@deck.Id"><strong>@deck.Name</strong></a>
                            </td>
                            <td class="num">@deck.Cards</td>
                            <td class="num">
                                @if (deck.Cards == 0)
                                {
                                    <span class="text-body-tertiary">&mdash;</span>
                                }
                                else if (deck.Missing == 0)
                                {
                                    <span class="text-success-emphasis fw-semibold">Buildable</span>
                                }
                                else
                                {
                                    <span>@deck.Missing</span>
                                }
                            </td>
                            <td>
                                @if (deck.Report is null || deck.Cards == 0)
                                {
                                    <span class="text-body-tertiary small">&mdash;</span>
                                }
                                else if (deck.Report.HasErrors)
                                {
                                    <span class="badge text-bg-danger">
                                        @deck.Report.Of(LintSeverity.Error).Count() error(s)
                                    </span>
                                }
                                else if (!deck.Report.FullyVerified)
                                {
                                    <span class="badge text-bg-secondary"
                                          title="Some rules could not be checked: card detail is missing for this set">
                                        Unverified
                                    </span>
                                }
                                else
                                {
                                    <span class="badge text-bg-success">Legal</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-secondary" href="decks/@deck.Id">Open</a>
                                @* Two taps, and the confirmation is scoped to this row: a shared
                                   flag would arm every delete button at once. *@
                                <button class="btn btn-sm @(_confirming == deck.Id ? "btn-danger" : "btn-outline-danger")"
                                        @onclick="() => ConfirmDelete(deck.Id)" aria-live="polite"
                                        title="@(_confirming == deck.Id ? "Tap again to delete" : "Delete this deck")">
                                    @(_confirming == deck.Id ? "Really?" : "Delete")
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </DataTable>
        }
    </div>
    </PageShell>
}

@code {
    private const int StripSize = 5;

    /// <summary>
    /// One deck as this page needs it. Built once per change rather than per render: the linter
    /// and the missing count both walk the deck, and the grid renders each of them twice over.
    /// </summary>
    private sealed record Card(
        string Id, string Name, int Cards, int Missing,
        IReadOnlyList<EnergyType> Energies, LintReport? Report,
        PocketCard? Face, IReadOnlyList<PocketCard> Strip);

    /// <summary>
    /// How the shelf is ordered. Owned by the session rather than by this field, so it survives
    /// leaving the page — see AppSession.DeckOrder.
    /// </summary>
    private string _order => Session.DeckOrder;

    private void OnOrder(ChangeEventArgs e)
    {
        // Build() is not called here. SetDeckOrder raises Changed, which this page is subscribed
        // to, and that rebuilds -- calling both would order the shelf twice per change.
        if (e.Value?.ToString() is { Length: > 0 } order) Session.SetDeckOrder(order);
    }

    /// <summary>The order in words, under the heading, so the shelf says what it is in.</summary>
    private string OrderSaid => _order switch
    {
        "name" => "By name",
        "size" => "Fullest first",
        "custom" => "Your own order",
        _ => "Closest to buildable first",
    };

    /// <summary>
    /// The shelf element, whichever view is drawn. Only one of the two is ever in the DOM, so one
    /// field serves both -- but they are different elements, so the drag module has to be re-bound
    /// when the view changes, which is what _boundTo tracks.
    /// </summary>
    private ElementReference _shelf;
    private DragSorter? _sorter;
    private string _boundTo = "";

    private Task MoveTo((string Id, int To) move)
    {
        Session.MoveDeck(move.Id, move.To);
        return Task.CompletedTask;
    }

    /// <summary>
    /// Where a dropped deck landed, from dragsort.js. The DOM has already been rearranged by the
    /// drag; this makes it true, and the re-render that follows puts the elements back in an order
    /// that now matches.
    /// </summary>
    private Task Dropped(string id, int index)
    {
        Session.MoveDeck(id, index);
        return InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Custom is the only order a drag means anything in: dropping a deck halfway down an
        // alphabetical shelf would be undone by the next render.
        var want = _order == "custom" ? $"{Session.DeckGrid}" : "";
        if (want == _boundTo) return;

        _boundTo = want;

        if (_sorter is not null)
        {
            await _sorter.DisposeAsync();
            _sorter = null;
        }

        if (want.Length > 0)
            _sorter = await DragSorter.AttachAsync(JS, _shelf, Dropped);
    }

    /// <summary>How many decks could be built right now, for the bar.</summary>
    private int Buildable => _decks.Count(d => d.Cards > 0 && d.Missing == 0);

    private IReadOnlyList<Card> _decks = [];

    /// <summary>Which deck's delete button is armed, if any.</summary>
    private string? _confirming;

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnChanged;
        await Session.InitAsync();
        Build();
    }

    public async ValueTask DisposeAsync()
    {
        Session.Changed -= OnChanged;
        if (_sorter is not null) await _sorter.DisposeAsync();
    }

    private void OnChanged()
    {
        Build();
        InvokeAsync(StateHasChanged);
    }

    private void Build()
    {
        if (!Session.Ready) return;

        @* The engine still owns the default order -- it is the one that needs MissingCount, which
           is the session's to compute -- and the others are re-sorts of what it returns.

           Custom is not a sort at all: it is the order the profile already stores its decks in,
           which is what dragging rewrites. *@
        var ordered = _order switch
        {
            "name" => Session.Profile.Decks
                .OrderBy(d => d.Name, StringComparer.CurrentCultureIgnoreCase)
                .ToArray(),
            "size" => Session.Profile.Decks
                .OrderByDescending(d => d.DeckBuilderNrs.Count)
                .ThenBy(d => d.Name, StringComparer.CurrentCultureIgnoreCase)
                .ToArray(),
            "custom" => [.. Session.Profile.Decks],
            _ => Session.DecksByBuildability,
        };

        _decks = ordered.Select(deck =>
        {
            // The face is the user's pick where they made one; AppSession owns the fallback.
            var face = Session.FaceCardOf(deck);

            // The strip continues rarest-first, minus whatever is already the face.
            var strip = deck.DeckBuilderNrs
                .Distinct()
                .Select(Session.PrintingOf)
                .Where(c => c is not null && c.Key != face?.Key)
                .Select(c => c!)
                .OrderByDescending(c => Session.Index.Ladder.IndexOf(c.Rarity) ?? -1)
                .ThenBy(c => c.Name, StringComparer.CurrentCultureIgnoreCase)
                .Take(StripSize)
                .ToArray();

            return new Card(
                deck.Id, deck.Name,
                deck.DeckBuilderNrs.Count,
                Session.MissingCount(deck),
                deck.Energies,
                Session.Linter?.Lint(deck.DeckBuilderNrs, deck.Energies, Session.Owned),
                face,
                strip);
        }).ToArray();
    }

    private void ConfirmDelete(string id)
    {
        if (_confirming != id) { _confirming = id; return; }

        _confirming = null;
        Session.DeleteDeck(id);
    }

}
