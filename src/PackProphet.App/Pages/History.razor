@page "/history"
@inject AppSession Session
@implements IDisposable

<PageTitle>History · PackProphet</PageTitle>

@if (!Session.Ready)
{
    <Loading />
}
else
{
    <div class="page-head">
        <h1 class="title">History</h1>
        <span class="subtitle">From the packs you have logged</span>
    </div>

    <PageShell Measure="PageShell.Width.Wide" Class="sections">
        @if (_log.Count == 0)
        {
            <EmptyState>
                Nothing logged yet. Every pack you record on
                <a href="log">Log a pack</a> lands here, and this page also checks the odds
                engine against what you actually pulled.
            </EmptyState>
            @* A returning player has a real history the app has not seen, so the empty page says
               so rather than implying they have opened nothing. *@
            @if (Session.Lifetime is { } baseline)
            {
                <p class="text-body-secondary">
                    The game counted <strong>@baseline.PacksOpened</strong> packs and
                    <strong>@baseline.WonderPicks</strong> Wonder Picks before
                    @baseline.At.ToLocalTime().ToString("d MMM yyyy"). Totals only, so nothing
                    here can be broken down from them.
                </p>
            }
            else
            {
                <p class="text-body-secondary">
                    Played before finding this? Put the game's own lifetime totals into
                    <a href="settings">Settings</a> and they will be counted here.
                </p>
            }
        }
        else
        {
            <div class="summary mb-3">
                @* All-time first when it is known, since it is the fuller number. The logged count
                   stays beside it rather than being replaced: everything else on this page is
                   derived from logged packs, so the reader can see how much of the total those
                   cover. *@
                @if (Session.Lifetime is { } baseline)
                {
                    <div class="stat">
                        <span class="label">Packs, All Time</span>
                        <span class="value">@Session.LifetimePacks</span>
                        <span class="sub">@baseline.PacksOpened imported</span>
                    </div>
                    <div class="stat">
                        <span class="label">Wonder Picks, all time</span>
                        <span class="value">@Session.LifetimeWonderPicks</span>
                        <span class="sub">@baseline.WonderPicks imported</span>
                    </div>
                }
                <div class="stat">
                    <span class="label">Packs Logged</span>
                    <span class="value">@_log.Count</span>
                    <span class="sub">@_cards cards recorded</span>
                </div>
                <div class="stat">
                    <span class="label">Since</span>
                    <span class="value">@_first.ToLocalTime().ToString("d MMM yyyy")</span>
                    <span class="sub">@Rate()</span>
                </div>
                <div class="stat">
                    <span class="label">Cards per Pack</span>
                    <span class="value">@_perPack.ToString("0.0")</span>
                    @* A pack yields 4-6 cards, so a figure well below that means packs were logged
                       without all their pulls, and every number on this page derived from cards is
                       understated. *@
                    <span class="sub @(_perPack < 4 && _log.Count > 2 ? "text-warning-emphasis" : "")">
                        @(_perPack < 4 && _log.Count > 2 ? "below 4, so some pulls look unlogged" : "4 to 6 is normal")
                    </span>
                </div>
                <div class="stat">
                    <span class="label">Duplicates</span>
                    <span class="value">@_duplicateShare.ToString("P0")</span>
                    <span class="sub">@_distinctPulled distinct card(s) pulled</span>
                </div>
                <div class="stat">
                    <span class="label">Streak</span>
                    <span class="value">@_streak</span>
                    <span class="sub">
                        day(s) in a row@(_bestStreak > _streak ? $" · best {_bestStreak}" : "")
                    </span>
                </div>
                <div class="stat">
                    <span class="label">Busiest Day</span>
                    <span class="value">@_busiest.Count</span>
                    <span class="sub">@_busiest.Date.ToString("d MMM yyyy")</span>
                </div>
                <div class="stat">
                    <span class="label">Most Opened</span>
                    <span class="value fs-6">@_favouritePack</span>
                    <span class="sub">@_favouriteCount pack(s) · @_sets set(s) touched</span>
                </div>
                <div class="stat">
                    <span class="label">Points Earned</span>
                    <span class="value">@((_log.Count * GameRules.PackPointsPerPack).ToString("N0"))</span>
                    @* Earned over all time, not held: the balance after spending lives on the
                       Which pack page, and conflating the two would misreport both. *@
                    <span class="sub">Across every set, all time</span>
                </div>
            </div>

            @* Hits get a section rather than a number in a row of statistics, and it shows the
               card rather than a count of cards.

               A count and a rate rather than a personal best: once you pull a Crown a "best pull"
               never moves again. *@
            <div class="hits-panel mb-3">
                @if (_showcase is null)
                {
                    <div class="hits-empty">
                        <span class="value">No Hits Yet</span>
                        <span class="sub">
                            @_log.Count pack(s) in. Adjust what counts below if this is too strict.
                        </span>
                    </div>
                }
                else
                {
                    <a class="hit-art" href="card/@_showcase.Card.Key"
                       style="@_showcase.Card.ArtVars"
                       aria-label="Detail for @_showcase.Card.Name"></a>

                    <div class="hit-detail">
                        <span class="label">Hits</span>
                        <span class="value">@_hits</span>
                        <span class="sub">@HitNote()</span>

                        <div class="hit-card">
                            <span class="glyphs @_showcase.Rung.GlyphClass"
                                  title="@_showcase.Rung.Symbol">@_showcase.Rung.Glyphs</span>
                            <a href="card/@_showcase.Card.Key">@_showcase.Card.Name</a>
                            <span class="small text-body-secondary">
                                @_showcase.Card.Set&thinsp;@_showcase.Card.Number
                                &middot; pulled @_showcase.At.ToLocalTime().ToString("d MMM yyyy")
                            </span>
                        </div>

                        @if (_hitList.Count > 1)
                        {
                            @* Explicit rather than automatic. Rotating on its own would move the
                               page under the reader, and re-rolling on every render would make it
                               flicker on unrelated updates. *@
                            <button class="btn btn-sm btn-outline-secondary align-self-start"
                                    @onclick="Shuffle">Show me another</button>
                        }
                    </div>

                    @if (_hitList.Count > 1)
                    {
                        <div class="hit-strip">
                            @foreach (var hit in _hitList.Take(StripShown))
                            {
                                <a class="thumb @(hit == _showcase ? "on" : "")"
                                   href="card/@hit.Card.Key"
                                   style="@hit.Card.ArtVars"
                                   title="@hit.Card.Name, @hit.Rung.Symbol"
                                   aria-label="@hit.Card.Name"></a>
                            }
                            @if (_hitList.Count > StripShown)
                            {
                                <span class="more small text-body-secondary">
                                    +@(_hitList.Count - StripShown)
                                </span>
                            }
                        </div>
                    }
                }
            </div>

            @* What counts as a hit is the user's call. Someone opening thirty packs a week feels
               nothing below 2-star; someone on the free two a day has a good week on a 1-star. A
               set of chips rather than an "N and above" slider, so "2-star and Crown but not
               shinies" is sayable. *@
            <details class="mb-3">
                <summary class="small text-body-secondary">What counts as a hit?</summary>
                <div class="pt-2">
                    <div class="rarity-chips mb-1">
                        @foreach (var rung in Session.Index.Ladder.Rungs)
                        {
                            var on = Session.HitTiers.Contains(rung.Index);
                            <button class="rarity-chip @(on ? "on" : "")"
                                    @onclick="() => Session.ToggleHitTier(rung.Index)"
                                    aria-pressed="@Aria.Flag(on)" title="@rung.Symbol">
                                <span class="glyphs @rung.GlyphClass">@rung.Glyphs</span>
                                @rung.Symbol
                            </button>
                        }
                    </div>
                    <p class="small text-body-secondary mb-0">
                        Defaults to everything above the diamonds. At least one rung must stay
                        selected.
                    </p>
                </div>
            </details>

            <h2>Packs per day</h2>
            @* The caption carries the READING, not the fact. "The free allowance is 2 a day"
               states a rule and leaves the reader to apply it to thirty bars; saying what a bar of
               two means is the same rule already applied, which is the only form of it that helps
               while looking at the picture.

               And it is a reading rather than a verdict, which is the line this page does not
               cross: it says what a bar of two IS, not whether you should have opened more. *@
            <p class="small text-body-secondary">
                Last @DaysShown days. @Allowance a day is the free allowance@(Session.Profile.Resources.Premium ? " with premium" : ""),
                so a bar of @AllowanceWord is a day you kept up.
            </p>
            @* The label carries the shape of the chart, not just its title. "Packs opened per
               day" names the picture and says nothing about it; a reader who cannot see the bars
               needs the range, the total and where the peak is before deciding whether to open
               the numbers below. *@
            <div class="bars" role="img" aria-label="@BarsSummary">
                @foreach (var day in _perDay)
                {
                    <div class="bar-col" data-tip="@day.Date.ToString("ddd d MMM"): @day.Count pack(s)">
                        <div class="bar" style="height:@Height(day.Count, _perDayMax)%"></div>
                    </div>
                }
            </div>

            @* The axis is its own strip, with labels positioned by percentage rather than sitting
               inside a bar column. A label is far wider than one day's column — about four
               columns at 30 days on a phone — so inside the column it was simply clipped to
               nothing as the screen narrowed. Out here it can overflow its tick freely.

               The first and last dates are always drawn, so the range the chart covers is legible
               even when every intermediate label has been dropped. Which of the rest are drawn is
               AxisLabels' decision — a mark too close to one already placed is left off rather
               than printed over it. *@
            <div class="bars-axis">
                @{ var axis = AxisLabels(); }
                @for (var i = 0; i < _perDay.Count; i++)
                {
                    @if (axis.TryGetValue(i, out var kind))
                    {
                        <span class="@kind" style="left:@Percent(i)%">@_perDay[i].Date.ToString("d MMM")</span>
                    }
                }
            </div>

            @* The bars are a picture, so their data has to exist somewhere as text. Collapsed
               rather than visually hidden: thirty rows read out before the rest of the page is a
               worse answer than a control that says what it opens, and sighted users who want the
               exact figure off a bar have the same problem. *@
            <details class="mb-4">
                <summary class="small text-body-secondary">Show these as numbers</summary>
                <div class="pt-2">
                    <DataTable Label="Packs opened per day" Fit="true">
                        <thead>
                            <tr>
                                <th scope="col">Day</th>
                                <th scope="col" class="num">Packs</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var day in _perDay)
                            {
                                <tr>
                                    <th scope="row">@day.Date.ToString("ddd d MMM")</th>
                                    <td class="num">@day.Count</td>
                                </tr>
                            }
                        </tbody>
                    </DataTable>
                </div>
            </details>

            <h2>Packs per set</h2>
            <DataTable Label="Packs opened per set" Fit="true">
                <thead>
                    <tr>
                        <th scope="col">Set</th>
                        <th scope="col" class="num">Packs</th>
                        <th scope="col" class="num">Points Earned</th>
                        <th scope="col"><span class="visually-hidden">Share of Total</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _perSet)
                    {
                        <tr>
                            <td>
                                <strong>@row.Set</strong>
                                <span class="small text-body-secondary ms-1">@Session.Sets.DisplayName(row.Set)</span>
                            </td>
                            <td class="num">@row.Count</td>
                            @* Earned, not held: what you have now is the balance after spending,
                               which the points panel on Which pack owns. *@
                            <td class="num">@((row.Count * GameRules.PackPointsPerPack).ToString("N0"))</td>
                            <td style="width:10rem">
                                @* Redundant with the packs column for anyone who cannot see the bar
                                   fill, so it stays out of the accessibility tree entirely. *@
                                <div class="row-bar" aria-hidden="true"><span style="width:@Height(row.Count, _perSetMax)%"></span></div>
                            </td>
                        </tr>
                    }
                </tbody>
            </DataTable>

            @* The check and the record, side by side.
               ==================================================================================
               They answer the two halves of one question -- did the model hold up, and what did I
               actually open -- and reading either without the other is how a rarity a fifth out
               looks like a broken engine rather than eleven packs of one set.

               The recent list on the right is a summary; the editable table below it is the record
               itself, with its dates, its delete buttons and the switch for whether deleting also
               takes the cards back. Half a page is not enough for that, and a summary is what you
               want beside a comparison anyway. *@
            <div class="check-cols">
            <div class="check-odds">
            <div class="section-head">
                <h3 class="mb-0 h6">Did the odds hold up?</h3>
                @* Only offered once there is a baseline to scale to and logged packs to scale
                   from. Without both, the option is a button that cannot answer. *@
                @* One slice at a time. Series and sets sit in the same dropdown under their own
                   headings rather than behind a second control: they are the same question at two
                   zoom levels, and a set is as fine as the data goes, since pull rates are
                   published per set. *@
                <select class="form-select form-select-sm ms-auto" style="max-width:12rem"
                        @onchange="OnScope" aria-label="Which sets to check">
                    <option value="" selected="@(_scope.Length == 0)">Every Set</option>
                    <optgroup label="Series">
                        @foreach (var series in ScopedSeries())
                        {
                            <option value="series:@series" selected="@(_scope == $"series:{series}")">
                                Series @series
                            </option>
                        }
                    </optgroup>
                    <optgroup label="Set">
                        @foreach (var set in ScopedSets())
                        {
                            <option value="set:@set" selected="@(_scope == $"set:{set}")">@set</option>
                        }
                    </optgroup>
                </select>
                @if (Session.Lifetime is not null && _pricedPacks > 0)
                {
                    <div class="btn-group btn-group-sm" role="group" aria-label="Sample">
                        <button class="btn @(_lifetime ? "btn-outline-secondary" : "btn-secondary")"
                                @onclick="() => SetLifetimeCheck(false)" aria-pressed="@Aria.Flag(!_lifetime)"
                                title="Only the packs logged here, where both sides are measured">
                            Logged Packs
                        </button>
                        <button class="btn @(_lifetime ? "btn-secondary" : "btn-outline-secondary")"
                                @onclick="() => SetLifetimeCheck(true)" aria-pressed="@Aria.Flag(_lifetime)"
                                title="Scaled up to every pack the game says you have opened">
                            All @Session.LifetimePacks Packs
                        </button>
                    </div>
                }
            </div>
            @if (!_lifetime)
            {
                @* The caveat names its own sample. "Small samples swing wildly" is true of every
                   sample ever taken and tells a reader nothing about THIS one; the number is what
                   decides whether a row that is a fifth out is worth a second look or is exactly
                   what a hundred-odd packs would be expected to do.

                   Only where there is a sample to name. With nothing priceable in scope the
                   section below already says so, and "0 packs is a small sample" above it is the
                   page hedging about a comparison it has not made. *@
                <p class="small text-body-secondary">
                    What you pulled against what the engine predicted for the packs you opened.
                    @if (_scopePacks >= 1)
                    {
                        <text>@SampleCaveat</text>
                    }
                </p>
            }
            else
            {
                @* Each of these is a reason the numbers are softer than the logged view, and none
                   of them is visible in the table. *@
                <p class="small text-body-secondary">
                    All @Session.LifetimePacks packs the game counted, split across sets by what
                    your collection holds. Only the ratios are used, so inflation from trades and
                    Wonder Picks largely cancels. Two caveats:
                </p>
                <ul class="small text-body-secondary">
                    <li>
                        <strong>Held</strong> is your collection, not your pulls, and the only
                        record of an unlogged pack that exists. It counts cards from trades,
                        Wonder Picks and the points shop and misses ones you traded away, so it
                        runs high on the tradeable rungs. Promos and sets with no published rates
                        are left out of both sides.
                    </li>
                    <li>
                        Deluxe packs are estimated only from the cards <em>only they</em> can give
                        (the foils and their own new cards). Everything else in one is a
                        reprint credited to its own set.
                    </li>
                </ul>
                @if (_mix.Count > 0)
                {
                    <p class="small text-body-secondary">
                        Estimated split:
                        @string.Join(" · ", _mix.Take(6).Select(m => $"{m.Set} {m.Packs:0}"))@(_mix.Count > 6 ? $" · and {_mix.Count - 6} more" : "")
                    </p>
                }
                else
                {
                    @* Refused rather than approximated. With nothing owned there is no evidence
                       about which packs those were, and a total spread by guesswork would look
                       like a measurement. *@
                    <Notice Severity="Notice.Level.Warning" Dense="true">
                        Your collection has nothing in it that any pack could have produced, so
                        the total cannot be split across sets. The figures below are the logged
                        packs only.
                    </Notice>
                }
            }
            @if (_unpriceable > 0)
            {
                <Notice Severity="Notice.Level.Info" Dense="true">
                    @_unpriceable logged pack(s) came from a set with no published pull rates, so
                    they are left out of the comparison entirely rather than counted as zero.
                </Notice>
            }
            @if (_accuracy.Count == 0)
            {
                <p class="small text-body-secondary">
                    Nothing priceable to compare for @ScopeLabel().
                </p>
            }
            else
            {
                @* The pack count is what makes a row of wild differences readable: eleven packs of
                   one set explains a swing that would otherwise look like a broken model. *@
                <div class="small fw-semibold mt-2">
                    @ScopeLabel()
                    <span class="text-body-secondary fw-normal ms-1">
                        @_scopePacks.ToString("0.#") pack(s)@(_lifetimeActive ? " estimated" : "")
                    </span>
                </div>
                <DataTable Label="Pulls against expected, by rarity" Fit="true">
                    <thead>
                        <tr>
                            <th scope="col">Rarity</th>
                            <th scope="col" class="num">@(_lifetimeActive ? "held" : "pulled")</th>
                            <th scope="col" class="num">Expected</th>
                            <th scope="col" class="num">Difference</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _accuracy)
                        {
                            <tr>
                                <td>
                                    <span class="glyphs @row.Rung.GlyphClass" title="@row.Rung.Symbol">@row.Rung.Glyphs</span>
                                    <span class="small text-body-secondary ms-1">@row.Rung.Symbol</span>
                                </td>
                                <td class="num">@row.Observed</td>
                                <td class="num">@row.Expected.ToString("0.#")</td>
                                <td class="num @DiffClass(row)">@Diff(row)</td>
                            </tr>
                        }
                    </tbody>
                </DataTable>
            }

            </div>

            <div class="check-recent">
                <span class="micro">Every pack, newest first</span>
                <div class="recent-rows">
                    @foreach (var entry in _recent.Take(RecentBeside))
                    {
                        <div class="recent-row">
                            <span class="art" aria-hidden="true"
                                  style="--art:url('@Session.PackArtUrl($"{entry.Set}:{entry.Pack}")')"></span>
                            <span class="nm">@entry.Pack</span>
                            <span class="cards">
                                @entry.OwnershipKeys.Count cards
                                @if (NewIn(entry) is > 0 and var fresh)
                                {
                                    <text>&middot; </text><strong>@fresh new</strong>
                                }
                            </span>
                            <span class="when">@Ago(entry.At)</span>
                        </div>
                    }
                </div>
                @if (_log.Count > RecentBeside)
                {
                    <p class="note">@(_log.Count - RecentBeside) more, in the table below.</p>
                }
            </div>
            </div>

            <div class="section-head">
                <h3 class="mb-0 h6">Recent packs</h3>
                <button class="btn btn-sm @(_clearingAll ? "btn-danger" : "btn-outline-danger") ms-auto"
                        @onclick="ClearAll">
                    @(_clearingAll ? $"Really delete all {_log.Count}?" : "Delete All")
                </button>
            </div>

            @* One switch rather than two kinds of delete button. Logging a pack both records the
               opening and adds the cards to the collection, so undoing a mistake usually means
               undoing both — but not always: the cards might be genuinely owned and only the log
               entry wrong. The user says which. *@
            <label class="form-check form-switch small mb-2">
                <input class="form-check-input" type="checkbox" checked="@_alsoRemoveCards"
                       @onchange="e => _alsoRemoveCards = e.Value is true" />
                also take the cards back out of my collection when deleting
            </label>
            <p class="small text-body-secondary">
                Deleting returns the @GameRules.PackPointsPerPack pack points that opening earned,
                floored at zero. Only the date is editable.
            </p>

            <DataTable Label="Recent packs">
                <thead>
                    <tr><th scope="col">When</th><th scope="col">Pack</th><th scope="col">Cards</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr>
                </thead>
                <tbody>
                    @foreach (var entry in _recent)
                    {
                        @* Keyed on identity rather than position: deleting a row shifts every row
                           after it, and without a key the inputs would keep the previous row's
                           value. *@
                        <tr @key="entry">
                            <td>
                                <input class="form-control form-control-sm" type="date" style="width:9.5rem"
                                       value="@entry.At.ToLocalTime().ToString("yyyy-MM-dd")"
                                       max="@DateTime.Now.ToString("yyyy-MM-dd")"
                                       @onchange="e => Redate(entry, e)"
                                       aria-label="Date this pack was opened" />
                            </td>
                            <td>
                                <span class="pack-thumb"
                                      style="--art:url('@Session.PackArtUrl($"{entry.Set}:{entry.Pack}")')"></span>
                                <strong>@entry.Pack</strong>
                                <span class="small text-body-secondary">@entry.Set</span>
                            </td>
                            <td class="small">
                                @foreach (var card in Named(entry))
                                {
                                    <span class="logged-card">@card</span>
                                }
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm @(_confirming == entry ? "btn-danger" : "btn-outline-danger") py-0 px-2"
                                        @onclick="() => ConfirmDelete(entry)" aria-live="polite"
                                        title="@(_confirming == entry ? "Tap again to delete" : "Delete this logged pack")">
                                    @(_confirming == entry ? "Really?" : "Delete")
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </DataTable>
            @if (_log.Count > RecentShown)
            {
                <p class="small text-body-secondary">
                    Showing the most recent @RecentShown of @_log.Count.
                </p>
            }
        }
    </PageShell>
}

@code {
    private const int DaysShown = 30;

    /// <summary>Free packs a day at the current subscription, for the bar chart's reading.</summary>
    private int Allowance => GameRules.PacksPerDay(Session.Profile.Resources.Premium);

    /// <summary>The same figure as a word, because the caption is a sentence rather than a stat.</summary>
    private string AllowanceWord => Allowance switch
    {
        1 => "one", 2 => "two", 3 => "three", 4 => "four", _ => Allowance.ToString()
    };

    /// <summary>
    /// How much weight the odds check can bear, given how many packs are behind it.
    ///
    /// The figure decides the sentence. Under a hundred packs a rarity that turns up once instead
    /// of twice moves the whole row, so the honest reading is that nothing here is evidence yet;
    /// past a few hundred a persistent gap starts to mean something. Either way it is a check on
    /// the MODEL rather than on the user's luck, which is the distinction the old wording made and
    /// this keeps.
    /// </summary>
    private string SampleCaveat => CaveatFor((int)Math.Round(_scopePacks));

    /// <summary>
    /// The wording for a given sample size.
    ///
    /// Public and static so the thresholds can be tested directly: reaching them through the page
    /// needs a fixture whose logged packs are priceable, which is a property of the card data
    /// rather than of the sentence this returns.
    /// </summary>
    public static string CaveatFor(int packs)
    {
        {
            if (packs < 100)
                return $"{packs} packs is a small sample, so a rarity a fifth off is ordinary "
                     + "variance rather than evidence the model is wrong.";

            if (packs < 500)
                return $"{packs} packs is enough to notice a persistent gap and not enough to "
                     + "trust a single row. Read it as a check on the model, not on your luck.";

            return $"{packs} packs is a large enough sample that a gap which does not close is "
                 + "worth reporting. It is still a check on the model, not on your luck.";
        }
    }
    private const int RecentShown = 25;

    /// <summary>
    /// How many packs the summary beside the odds check lists.
    ///
    /// A handful, not the log: the table below is the log, with its dates and its delete buttons.
    /// This is the "and what did I actually open" that makes the comparison next to it readable.
    /// </summary>
    private const int RecentBeside = 5;

    /// <summary>
    /// Cards in this pack that were not already in the collection when it was logged.
    ///
    /// Recomputed against the collection as it stands now rather than stored, so it answers "how
    /// many of these would be new today" -- which is what the figure beside a pack in a list of
    /// packs is read as. An exact was-new-then would need a snapshot per pack that nothing keeps.
    /// </summary>
    private int NewIn(PackOpenEvent entry) =>
        entry.OwnershipKeys
            .Distinct()
            .Select(k => Session.Index.ByOwnershipKey.GetValueOrDefault(k)?.FirstOrDefault())
            .Count(c => c is not null && Session.CountOf(c) <= 1);

    /// <summary>
    /// How long ago, in the words a list of recent things uses. Not a date: the point of this
    /// column is recency, and "Today" reads faster than a date you have to subtract.
    /// </summary>
    private static string Ago(DateTimeOffset at)
    {
        var days = (DateTimeOffset.Now.Date - at.ToLocalTime().Date).Days;

        return days switch
        {
            <= 0 => "Today",
            1 => "Yesterday",
            < 7 => $"{days} days ago",
            < 14 => "Last week",
            < 60 => $"{days / 7} weeks ago",
            _ => at.ToLocalTime().ToString("d MMM"),
        };
    }

    private IReadOnlyList<PackOpenEvent> _log = [];
    private IReadOnlyList<PackOpenEvent> _recent = [];
    private int _cards;
    private const int StripShown = 14;

    /// <summary>One pulled card that counted as a hit, with when it happened.</summary>
    private sealed record Hit(PocketCard Card, RarityRung Rung, DateTimeOffset At);

    private int _hits;

    /// <summary>Every hit, newest first. Duplicates are kept: pulling the same card twice is two hits.</summary>
    private IReadOnlyList<Hit> _hitList = [];

    private Hit? _showcase;
    private int _unpriceable;
    private DateTimeOffset _first;

    private double _perPack;
    private int _distinctPulled;
    private double _duplicateShare;
    private int _streak;
    private int _bestStreak;
    private (DateTime Date, int Count) _busiest = (DateTime.Today, 0);
    private string _favouritePack = "—";
    private int _favouriteCount;
    private int _sets;

    private IReadOnlyList<(DateTime Date, int Count)> _perDay = [];
    private int _perDayMax = 1;

    /// <summary>
    /// What the bar chart says, in a sentence. The busiest day is named because it is the one
    /// thing a glance at the bars gives you and a title does not.
    /// </summary>
    private string BarsSummary
    {
        get
        {
            if (_perDay.Count == 0) return "Packs opened per day: nothing logged yet.";

            var total = _perDay.Sum(d => d.Count);
            if (total == 0)
                return $"Packs opened per day, last {DaysShown} days: none logged.";

            var peak = _perDay.MaxBy(d => d.Count);

            return $"Packs opened per day, {_perDay[0].Date:d MMM} to {_perDay[^1].Date:d MMM}: "
                 + $"{total} in total, most on {peak.Date:d MMM} with {peak.Count}.";
        }
    }

    private IReadOnlyList<(string Set, int Count)> _perSet = [];
    private int _perSetMax = 1;

    private sealed record Accuracy(RarityRung Rung, int Observed, double Expected);

    private IReadOnlyList<Accuracy> _accuracy = [];

    private bool _alsoRemoveCards = true;
    private PackOpenEvent? _confirming;
    private bool _clearingAll;

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnChanged;
        await Session.InitAsync();
        Build();
    }

    /// <summary>
    /// Move a logged pack to another day, keeping its time of day so several packs on one day
    /// keep their order. The clock time is never editable: the app cannot know what the game
    /// recorded, and pretending otherwise invites the user to chase a number that does not
    /// matter.
    /// </summary>
    private void Redate(PackOpenEvent entry, ChangeEventArgs e)
    {
        if (!DateTime.TryParse(e.Value?.ToString(), out var date)) return;

        var local = entry.At.ToLocalTime();
        var moved = new DateTimeOffset(
            date.Year, date.Month, date.Day,
            local.Hour, local.Minute, local.Second, local.Offset);

        Session.Mutate(p => p with
        {
            PackLog = p.PackLog.Select(x => ReferenceEquals(x, entry) ? x with { At = moved } : x).ToList()
        });

        _confirming = null;
    }

    private void ConfirmDelete(PackOpenEvent entry)
    {
        if (!ReferenceEquals(_confirming, entry)) { _confirming = entry; return; }

        _confirming = null;
        Delete([entry]);
    }

    private void ClearAll()
    {
        if (!_clearingAll) { _clearingAll = true; return; }

        _clearingAll = false;
        Delete(_log.ToArray());
    }

    /// <summary>
    /// Removes logged packs and reverses what logging them did: the pack points they earned
    /// always, and the cards they added when the user asked for that. One Mutate, so the whole
    /// thing is a single undo step.
    /// </summary>
    private void Delete(IReadOnlyList<PackOpenEvent> entries)
    {
        if (entries.Count == 0) return;

        var doomed = entries.ToHashSet(ReferenceEqualityComparer.Instance as IEqualityComparer<PackOpenEvent>);
        var alsoCards = _alsoRemoveCards;

        Session.Mutate(p =>
        {
            var points = new Dictionary<string, int>(p.Resources.PackPointsBySet);
            var collection = alsoCards ? new Dictionary<string, int>(p.Collection) : p.Collection;

            foreach (var entry in entries)
            {
                // Floored at zero: the points may already have been spent, and a negative
                // balance would make every downstream estimate nonsense.
                var before = points.GetValueOrDefault(entry.Set);
                var after = Math.Max(0, before - GameRules.PackPointsPerPack);
                if (after > 0) points[entry.Set] = after; else points.Remove(entry.Set);

                if (!alsoCards) continue;

                foreach (var key in entry.OwnershipKeys)
                {
                    var count = collection.GetValueOrDefault(key) - 1;
                    if (count > 0) collection[key] = count; else collection.Remove(key);
                }
            }

            return p with
            {
                Collection = collection,
                Resources = p.Resources with { PackPointsBySet = points },
                PackLog = p.PackLog.Where(x => !doomed.Contains(x)).ToList(),

                // Said, not merely done. Dropping the row leaves the other device holding a row
                // this one has never seen -- indistinguishable from a pack logged on the phone
                // while this laptop was closed -- and the next sync handed it back.
                RemovedLog = [.. p.RemovedLog, .. entries.Select(LogId.Of)]
            };
        });
    }

    public void Dispose() => Session.Changed -= OnChanged;

    private void OnChanged()
    {
        Build();
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Everything on this page, computed once per change. Cheap even for thousands of logged
    /// packs, because the expensive part — a pack's per-rarity expectation — is computed once
    /// per DISTINCT pack and then multiplied by how many of it were opened.
    /// </summary>
    private void Build()
    {
        if (!Session.Ready) return;

        _log = Session.Profile.PackLog;
        if (_log.Count == 0) return;

        _cards = _log.Sum(e => e.OwnershipKeys.Count);
        BuildHits();
        _first = _log.Min(e => e.At);
        _recent = _log.OrderByDescending(e => e.At).Take(RecentShown).ToArray();

        BuildTotals();
        BuildPerDay();
        BuildPerSet();
        BuildAccuracy();
    }

    /// <summary>
    /// Pulls at the rungs the user counts as a hit, newest first. Counted per card rather than
    /// per pack, because a pack can contain more than one.
    /// </summary>
    private void BuildHits()
    {
        var wanted = Session.HitTiers;
        var found = new List<Hit>();

        foreach (var entry in _log.OrderByDescending(e => e.At))
        {
            foreach (var key in entry.OwnershipKeys)
            {
                var card = Session.Index.ByOwnershipKey.GetValueOrDefault(key)?.FirstOrDefault();
                if (card is null) continue;

                var rung = Session.Index.Ladder.RungOf(card.Rarity);
                if (rung is null || !wanted.Contains(rung.Index)) continue;

                found.Add(new Hit(card, rung, entry.At));
            }
        }

        _hitList = found;
        _hits = found.Count;

        // The latest by default: it is the one the user came to look at. A previously chosen
        // showcase is kept if it is still a hit, so changing an unrelated filter does not snatch
        // the card away — but it must be dropped if the criteria no longer include it.
        if (_showcase is null || !found.Contains(_showcase)) _showcase = found.FirstOrDefault();
    }

    /// <summary>
    /// Picks another hit at random. Never repeats the one on screen, which is what makes a
    /// two-hit collection feel like the button does something.
    /// </summary>
    private void Shuffle()
    {
        if (_hitList.Count < 2) return;

        var others = _hitList.Where(h => h != _showcase).ToArray();
        _showcase = others[Random.Shared.Next(others.Length)];
    }

    private string HitNote()
    {
        if (_hits == 0) return "None yet";

        // The rate is the part that stays interesting: it moves with every pack, up or down. What
        // counts as a hit is NOT repeated here — the chips just below spell it out, and saying it
        // twice makes the line long enough to wrap for no gain.
        var per = (double)_log.Count / _hits;
        var rate = $"about 1 in every {per:0.#} packs";

        return rate;
    }

    private void BuildTotals()
    {
        _perPack = (double)_cards / _log.Count;

        var pulled = _log.SelectMany(e => e.OwnershipKeys).ToArray();
        _distinctPulled = pulled.Distinct(StringComparer.Ordinal).Count();
        _duplicateShare = pulled.Length == 0 ? 0 : 1.0 - ((double)_distinctPulled / pulled.Length);

        _sets = _log.Select(e => e.Set).Distinct(StringComparer.Ordinal).Count();

        var favourite = _log.GroupBy(e => $"{e.Set}:{e.Pack}")
            .OrderByDescending(g => g.Count())
            .First();
        _favouritePack = favourite.Key.Split(':')[1];
        _favouriteCount = favourite.Count();

        var byDay = _log.GroupBy(e => e.At.ToLocalTime().Date)
                        .ToDictionary(g => g.Key, g => g.Count());

        var busiest = byDay.OrderByDescending(kv => kv.Value).ThenByDescending(kv => kv.Key).First();
        _busiest = (busiest.Key, busiest.Value);

        BuildStreaks(byDay.Keys.OrderBy(d => d).ToArray());
    }

    /// <summary>
    /// Consecutive days with at least one pack logged. The current streak is measured back from
    /// the LAST logged day, not from today: a streak that silently resets to zero overnight
    /// punishes the user for the clock rather than reporting anything.
    /// </summary>
    private void BuildStreaks(DateTime[] days)
    {
        _streak = _bestStreak = 0;
        if (days.Length == 0) return;

        var run = 1;
        _bestStreak = 1;
        for (var i = 1; i < days.Length; i++)
        {
            run = days[i] == days[i - 1].AddDays(1) ? run + 1 : 1;
            _bestStreak = Math.Max(_bestStreak, run);
        }

        // Still live only if the run reaches today or yesterday; otherwise it is history.
        var last = days[^1];
        var today = DateTime.Now.Date;
        _streak = (today - last).TotalDays <= 1 ? run : 0;
    }

    private void BuildPerDay()
    {
        var counts = _log.GroupBy(e => e.At.ToLocalTime().Date)
                         .ToDictionary(g => g.Key, g => g.Count());

        // Every day in the window, including the empty ones: a bar chart that silently omits
        // zero days compresses a gap and makes a lapse look like steady play.
        var today = DateTime.Now.Date;
        _perDay = Enumerable.Range(0, DaysShown)
            .Select(i => today.AddDays(i - DaysShown + 1))
            .Select(d => (Date: d, Count: counts.GetValueOrDefault(d)))
            .ToArray();

        _perDayMax = Math.Max(1, _perDay.Max(d => d.Count));
    }

    private void BuildPerSet()
    {
        _perSet = _log.GroupBy(e => e.Set)
            .Select(g => (Set: g.Key, Count: g.Count()))
            .OrderByDescending(r => r.Count)
            .ToArray();

        _perSetMax = Math.Max(1, _perSet.Max(r => r.Count));
    }

    /// <summary>
    /// Whether the odds check is scaled to the game's lifetime pack count. OFF by default, and
    /// deliberately not persisted: the logged view is the one where both columns are measured
    /// rather than inferred, so it is what the page should show on arrival.
    /// </summary>
    private bool _lifetime;

    /// <summary>
    /// Whether the lifetime view actually took effect. It cannot when the collection is too empty
    /// to split the total across sets, and the distinction has to be visible: labelling logged
    /// pulls as lifetime figures would be the one dishonest thing this page could do.
    /// </summary>
    private bool _lifetimeActive;

    /// <summary>
    /// Which slice of the check is on screen: "" for everything, "series:A" or "set:A1" for one.
    /// One table at a time rather than a stack of them - nineteen sets is a page nobody reads,
    /// and comparing two of them is a matter of switching, not of scrolling.
    /// </summary>
    private string _scope = "";

    /// <summary>Logged packs the engine can price, i.e. the sample a lifetime estimate rests on.</summary>
    private int _pricedPacks;

    /// <summary>
    /// The check per SET, which every view is folded from. Held rather than rebuilt per scope so
    /// switching slices costs nothing and the slices cannot disagree with the total.
    /// </summary>
    private Dictionary<string, Dictionary<int, double>> _expBySet = new(StringComparer.OrdinalIgnoreCase);

    private Dictionary<string, Dictionary<int, int>> _obsBySet = new(StringComparer.OrdinalIgnoreCase);

    private Dictionary<string, double> _packsBySet = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>Packs behind the slice on screen: counted when logged, estimated when lifetime.</summary>
    private double _scopePacks;

    /// <summary>The estimated split across sets, or empty when the collection cannot support one.</summary>
    private IReadOnlyList<SetShare> _mix = [];

    private void SetLifetimeCheck(bool on)
    {
        if (_lifetime == on) return;
        _lifetime = on;
        BuildAccuracy();
    }

    private void OnScope(ChangeEventArgs e)
    {
        _scope = e.Value?.ToString() ?? "";
        BuildSelected();
    }

    /// <summary>Sets the check has anything to say about, in release order.</summary>
    private IEnumerable<string> ScopedSets() =>
        _expBySet.Keys.Union(_obsBySet.Keys, StringComparer.OrdinalIgnoreCase)
                 .OrderBy(Session.Sets.SortKey, StringComparer.Ordinal);

    private IEnumerable<string> ScopedSeries() =>
        ScopedSets().Select(Session.Sets.SeriesOf).Distinct().OrderBy(x => x, StringComparer.Ordinal);

    private string ScopeLabel() => _scope switch
    {
        { Length: 0 } => "every set",
        var v when v.StartsWith("series:") => $"series {v[7..]}",
        var v => v[4..]
    };

    /// <summary>
    /// Folds the per-set numbers into the one slice being shown. A set outside the slice is not
    /// merely hidden, it is excluded from both columns - a difference shown against an expectation
    /// from other sets would be meaningless.
    /// </summary>
    private void BuildSelected()
    {
        bool InScope(string set) => _scope switch
        {
            { Length: 0 } => true,
            var v when v.StartsWith("series:") => Session.Sets.SeriesOf(set) == v[7..],
            var v => set.Equals(v[4..], StringComparison.OrdinalIgnoreCase)
        };

        var exp = new Dictionary<int, double>();
        var obs = new Dictionary<int, int>();
        _scopePacks = 0;

        foreach (var set in ScopedSets().Where(InScope))
        {
            _scopePacks += _packsBySet.GetValueOrDefault(set);

            foreach (var (rung, n) in _expBySet.GetValueOrDefault(set) ?? [])
                exp[rung] = exp.GetValueOrDefault(rung) + n;
            foreach (var (rung, n) in _obsBySet.GetValueOrDefault(set) ?? [])
                obs[rung] = obs.GetValueOrDefault(rung) + n;
        }

        _accuracy = Session.Index.Ladder.Rungs
            .Where(r => obs.ContainsKey(r.Index) || exp.GetValueOrDefault(r.Index) > 0.05)
            .Select(r => new Accuracy(r, obs.GetValueOrDefault(r.Index),
                                         exp.GetValueOrDefault(r.Index)))
            .ToArray();
    }

    /// <summary>
    /// The odds check, built per SET and then folded into whatever grouping is on screen.
    ///
    /// Per set rather than per pack because pull rates are published per set: every pack of a set
    /// shares its rarity distribution, so the set is the smallest unit at which a rung comparison
    /// means anything. It is also the unit both groupings are built from, which is what stops the
    /// overall table and the broken-out ones from disagreeing.
    /// </summary>
    private void BuildAccuracy()
    {
        _accuracy = [];
        _mix = [];
        _lifetimeActive = false;
        _unpriceable = 0;
        _pricedPacks = 0;

        if (Session.Odds is null) return;

        var ladder = Session.Index.Ladder;
        var expected = _expBySet = new(StringComparer.OrdinalIgnoreCase);
        var observed = _obsBySet = new(StringComparer.OrdinalIgnoreCase);
        var packs = _packsBySet = new(StringComparer.OrdinalIgnoreCase);

        void AddExpected(string set, int rung, double n)
        {
            if (!expected.TryGetValue(set, out var byRung)) expected[set] = byRung = [];
            byRung[rung] = byRung.GetValueOrDefault(rung) + n;
        }

        void AddObserved(string set, int rung, int n)
        {
            if (!observed.TryGetValue(set, out var byRung)) observed[set] = byRung = [];
            byRung[rung] = byRung.GetValueOrDefault(rung) + n;
        }

        // ---- expected -------------------------------------------------------------------
        foreach (var group in _log.GroupBy(e => $"{e.Set}:{e.Pack}"))
        {
            var rates = Session.Odds.ExpectedCopies(group.Key);
            if (rates.Count == 0)
            {
                // No pull rates for this set. Left out rather than counted as zero expected,
                // which would read as the model having been wildly wrong.
                _unpriceable += group.Count();
                continue;
            }

            var opened = group.Count();
            var set = group.Key.Split(':')[0];
            _pricedPacks += opened;
            packs[set] = packs.GetValueOrDefault(set) + opened;

            foreach (var (cardKey, rate) in rates)
            {
                if (Session.Index.ByKey.GetValueOrDefault(cardKey) is not { } card) continue;
                if (ladder.IndexOf(card.Rarity) is not int rung) continue;

                AddExpected(set, rung, rate * opened);
            }
        }

        // ---- observed, from the cards actually recorded ---------------------------------
        foreach (var entry in _log)
        {
            if (Session.Odds.ExpectedCopies($"{entry.Set}:{entry.Pack}").Count == 0) continue;

            foreach (var pulled in entry.OwnershipKeys)
            {
                var card = Session.Index.ByOwnershipKey.GetValueOrDefault(pulled)?.FirstOrDefault();
                if (card is null) continue;
                if (ladder.IndexOf(card.Rarity) is not int rung) continue;

                // Credited to the pack that was opened, which for logged data is known exactly.
                AddObserved(entry.Set, rung, 1);
            }
        }

        // ---- scaled to a lifetime, which replaces BOTH sides ---------------------------
        if (_lifetime && Session.Lifetime is not null && Session.PackMix is { } mixer)
        {
            _mix = mixer.Estimate(Session.Owned, Session.LifetimePacks);
            if (_mix.Count > 0)
            {
                _lifetimeActive = true;
                expected.Clear();
                observed.Clear();
                packs.Clear();

                foreach (var share in _mix)
                {
                    packs[share.Set] = share.Packs;
                    foreach (var (rung, rate) in mixer.RungRatesPerPack(share.Set))
                        AddExpected(share.Set, rung, rate * share.Packs);
                }

                // Held, not pulled: nothing records what came out of a pack that was never
                // logged. Attributed by the SAME origin rule the split uses, so a card's copies
                // and its packs land in the same bucket.
                foreach (var card in Session.Index.All.DistinctBy(c => c.OwnershipKey))
                {
                    var copies = Session.Owned.Of(card);
                    if (copies <= 0) continue;
                    if (ladder.IndexOf(card.Rarity) is not int rung) continue;

                    var origin = mixer.OriginSet(card.OwnershipKey);
                    if (origin is null || !expected.ContainsKey(origin)) continue;

                    AddObserved(origin, rung, copies);
                }
            }
        }

        // A slice that no longer exists - a set whose only logged packs were just deleted -
        // falls back to everything rather than showing an empty table for a set that is gone.
        if (_scope.Length > 0 && !ScopedSets().Any(set => _scope switch
        {
            var v when v.StartsWith("series:") => Session.Sets.SeriesOf(set) == v[7..],
            var v => set.Equals(v[4..], StringComparison.OrdinalIgnoreCase)
        }))
            _scope = "";

        BuildSelected();
    }

    private string Rate()
    {
        var days = Math.Max(1, (DateTimeOffset.Now - _first).TotalDays);
        return $"{_log.Count / days:0.#} packs a day";
    }

    /// <summary>
    /// Which days get a date under them, by column index, each with the class that sets its
    /// priority when the axis has to thin out.
    ///
    /// The candidates are the two ends, the first of a month and every Monday — but a candidate is
    /// only taken when it clears the labels already chosen. Two of them a day or so apart print on
    /// top of each other: a Monday beside the last day, or a month that starts mid-week beside the
    /// Monday after it. Marking a day is no use if the mark cannot be read.
    ///
    /// Ends are placed first, since they are what makes the range legible at all, then month
    /// starts, then Mondays. Order within the axis is still by day, because the CSS pulls the
    /// FIRST and LAST labels inside the chart rather than letting them hang off its edges.
    ///
    /// Clearance is a share of the chart rather than a pixel figure: a label is about a tenth of
    /// this axis at the size it draws, and how wide the axis actually is belongs to the browser.
    /// At the widths where even a tenth is too tight, app.css drops the weekly and monthly marks
    /// outright and only the two ends survive.
    /// </summary>
    private Dictionary<int, string> AxisLabels()
    {
        var marks = new Dictionary<int, string>();
        var gap = Math.Max(1, _perDay.Count / 10);

        void Take(int i, string kind)
        {
            if (marks.Keys.All(at => Math.Abs(at - i) >= gap)) marks[i] = kind;
        }

        if (_perDay.Count == 0) return marks;

        Take(0, "edge");
        Take(_perDay.Count - 1, "edge");

        for (var i = 0; i < _perDay.Count; i++)
            if (_perDay[i].Date.Day == 1) Take(i, "major");

        for (var i = 0; i < _perDay.Count; i++)
            if (_perDay[i].Date.DayOfWeek == DayOfWeek.Monday) Take(i, "minor");

        return marks;
    }

    /// <summary>
    /// Centre of a day's column as a percentage across the chart, so an axis label can sit over
    /// its bar without being a child of it.
    /// </summary>
    private string Percent(int index) =>
        (100.0 * (index + 0.5) / Math.Max(1, _perDay.Count)).ToString("0.##",
            System.Globalization.CultureInfo.InvariantCulture);

    private static int Height(int value, int max) =>
        max <= 0 ? 0 : Math.Max(value > 0 ? 4 : 0, (int)Math.Round(100.0 * value / max));

    private static string Diff(Accuracy row)
    {
        var delta = row.Observed - row.Expected;
        return $"{(delta >= 0 ? "+" : "")}{delta:0.#}";
    }

    /// <summary>
    /// Only flagged once the gap is large in absolute terms AND relative to what was expected.
    /// One extra crown out of an expected 0.2 is unremarkable; colouring it red would make noise
    /// out of small numbers, which is the usual failure of this kind of table.
    /// </summary>
    private static string DiffClass(Accuracy row)
    {
        var delta = row.Observed - row.Expected;
        if (Math.Abs(delta) < 3 || row.Expected < 3) return "";

        return delta > 0 ? "text-success-emphasis" : "text-danger-emphasis";
    }

    private IEnumerable<string> Named(PackOpenEvent entry) =>
        entry.OwnershipKeys
            .Select(k => Session.Index.ByOwnershipKey.GetValueOrDefault(k)?.FirstOrDefault()?.Name)
            .Where(n => n is not null)
            .Select(n => n!);
}
