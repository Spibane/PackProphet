@page "/share"
@implements IDisposable
@inject AppSession Session
@inject NavigationManager Nav

<PageTitle>Shared Chase List · PackProphet</PageTitle>

@if (!Session.Ready)
{
    <Loading />
}
else if (_shared is null)
{
    <div class="page-head">
        <h1 class="title">Shared Chase List</h1>
    </div>
    <PageShell Measure="PageShell.Width.Wide">
        <p>
            This link could not be read. Ask for it again.
        </p>
    </PageShell>
}
else
{
    <div class="page-head">
        <h1 class="title">@_shared.ListName</h1>
        @* The in-game name is the one that lets you act on this. The collection name is what the
           owner called a save slot -- it identifies nothing to you. Shown when the link carries
           one; links made before the field existed, and owners who never set it, still decode. *@
        <span class="subtitle">
            @if (_shared.InGameName is { Length: > 0 } inGame)
            {
                <span>Find them in-game as <strong>@inGame</strong></span>
            }
            else
            {
                <span>Wanted by @_shared.OwnerName</span>
            }
            (read-only)
        </span>
    </div>

    @* The whole list arrives inside the link, decoded in the browser, so opening this page sends
       nothing anywhere. What the owner already has is deliberately not part of it — this is a
       want-list, not their collection. A link may fail to decode because it was truncated, edited
       by hand, or made by an incompatible version. *@
    @* One shell for the page, not one per block. Three of them stacked here, and the first wore
       `pb-0` to close the seam its own padding had opened between it and the next -- which is the
       shell being used as a wrapper for a paragraph rather than as the page's body. *@
    <PageShell>
    @if (_rows.Count == 0)
    {
        <EmptyState>
            None of these cards are in the current card data.
        </EmptyState>
    }
    else
    {
        <div class="summary">
            <div class="stat">
                <span class="label">Cards Wanted</span>
                <span class="value">@_rows.Count</span>
            </div>
            <div class="stat">
                <span class="label">You Can Offer</span>
                <span class="value">@_canHelpWith</span>
            </div>
        </div>

        <DataTable Label="Cards on this chase list">
            <thead>
                <tr>
                    <th scope="col">Card</th>
                    <th scope="col" class="num">Wants</th>
                    <th scope="col" class="num">You Own</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _rows)
                {
                    <tr class="@(row.YouOwn > 0 ? "row-best" : "")">
                        <td>
                            <span class="pack-thumb deck-thumb"
                                  data-tip-img="@row.Card.ArtUrl" data-tip="@row.Card.Name"
                                  style="@row.Card.ArtVars"></span>
                            <strong>@row.Card.Name</strong>
                            <span class="text-body-secondary small">
                                @row.Card.Set &middot; @Session.Index.Symbol(row.Card)
                            </span>
                            @if (row.YouOwn > 0)
                            {
                                <span class="badge text-bg-primary ms-1">You Can Offer This</span>
                            }
                        </td>
                        <td class="num">@row.Wanted</td>
                        <td class="num">
                            @(row.YouOwn > 0 ? row.YouOwn.ToString() : "—")
                        </td>
                    </tr>
                }
            </tbody>
        </DataTable>
    }
    </PageShell>
}

@code {
    private PackProphet.State.SharedChaseList? _shared;
    private sealed record Row(PocketCard Card, int Wanted, int YouOwn);
    private List<Row> _rows = [];
    private int _canHelpWith;

    /// <summary>
    /// The code sits after a `#`, not in the query string, because a link should never risk a
    /// 414 no matter how it grows — a fragment is never sent to a server at all.
    /// <see cref="SupplyParameterFromQueryAttribute"/> only ever sees the query string, so the
    /// fragment has to be read from the browser's own URL.
    /// </summary>
    private string? CodeFromFragment()
    {
        var fragment = new Uri(Nav.Uri).Fragment;
        return fragment.Length > 1 ? Uri.UnescapeDataString(fragment[1..]) : null;
    }

    protected override async Task OnInitializedAsync()
    {
        // A fragment-only URL change is a same-document navigation in every browser, so clicking
        // a second share link while this page is already open would otherwise go on showing the
        // first one's decoded content forever — Blazor still reports it through LocationChanged
        // even though nothing reloads.
        Nav.LocationChanged += OnLocationChanged;

        await Session.InitAsync();
        Decode();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        Decode();
        StateHasChanged();
    }

    private void Decode()
    {
        _shared = ChaseListCodec.TryDecode(CodeFromFragment());
        _rows = [];
        _canHelpWith = 0;
        if (_shared is null || !Session.Ready) return;

        foreach (var (key, wanted) in _shared.Wanted)
        {
            if (wanted <= 0) continue;
            if (!Session.Index.ByOwnershipKey.TryGetValue(key, out var printings)) continue;

            var card = printings[0];
            _rows.Add(new Row(card, wanted, Session.Owned[key]));
        }

        _rows = _rows
            .OrderByDescending(r => r.YouOwn > 0)
            .ThenBy(r => r.Card.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
        _canHelpWith = _rows.Count(r => r.YouOwn > 0);
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
