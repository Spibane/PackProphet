@page "/settings"
@using PackProphet.Sync
@implements IDisposable
@inject AppSession Session
@inject LocalStorageStateStore Store
@inject SyncService Sync

<PageTitle>Settings · PackProphet</PageTitle>

<div class="page-head">
    <h1 class="title">Settings</h1>
    @* The claim has to follow the truth. Sync is the one thing in this app that puts anything
       anywhere else, so the moment it is on, this line stops being accurate. *@
    <span class="subtitle">
        @(Sync.Paired
            ? "Stored in this browser, and encrypted on the sync server"
            : "Everything here is stored in this browser only")
    </span>
</div>

<PageShell Measure="PageShell.Width.Text" Class="sections">
    <h2>Appearance</h2>
    <p class="small text-body-secondary">
        The same control sits in the top bar. <strong>Auto</strong> follows this device's
        system setting and changes with it, including while the app is open.
    </p>
    <div class="btn-group btn-group-sm mb-4" role="group" aria-label="Theme">
        @foreach (var (value, label) in Themes)
        {
            <button class="btn @(Session.Theme == value ? "btn-secondary" : "btn-outline-secondary")"
                    @onclick="() => Session.SetThemeAsync(value)">@label</button>
        }
    </div>

    @* Two rows rather than one of six, because the settings are independent: every skin has a
       light and a dark form, so the pairs are not alternatives to each other. Only here and in
       the command palette -- the top bar's one cycling button is already the widest thing in a
       row that has to survive a phone. *@
    <p class="small text-body-secondary mb-2">
        <strong>Colours.</strong> Paper is warm and neutral, with red marking what is chosen;
        slate is the greys and blues the app shipped with. Either works in light or dark.
    </p>
    <div class="btn-group btn-group-sm mb-4" role="group" aria-label="Colours">
        @foreach (var (value, label) in Skins)
        {
            <button class="btn @(Session.Skin == value ? "btn-secondary" : "btn-outline-secondary")"
                    @onclick="() => Session.SetSkinAsync(value)">@label</button>
        }
    </div>

    @* Sits with Appearance rather than with the collection sections: it is about how much the
       page says rather than about what counts as complete. *@
    <div class="form-check mb-4">
        <input class="form-check-input" type="checkbox" id="gapstrip"
               checked="@Session.ShowGapStrip"
               @onchange="e => Session.SetShowGapStrip((bool)(e.Value ?? false))" />
        <label class="form-check-label" for="gapstrip">
            Show the evolution-gap bar on the Collection page
            <span class="d-block small text-body-secondary">
                Names the cards you own that cannot evolve yet. Worth leaving on with a large
                collection, where the list is short and specific; early on almost every chain is
                missing a stage, so it says the same thing every day. The
                <em>fills an evolution gap</em> filter works either way.
            </span>
        </label>
    </div>

    @* Beside the gap bar because it is the same kind of setting: how much a page explains itself.
       Both are dismissible in place, and this is where a dismissal is undone. *@
    <div class="form-check mb-4">
        <input class="form-check-input" type="checkbox" id="wonderintro"
               checked="@Session.ShowWonderIntro"
               @onchange="e => Session.SetShowWonderIntro((bool)(e.Value ?? false))" />
        <label class="form-check-label" for="wonderintro">
            Explain what Wonder Pick decides
            <span class="d-block small text-body-secondary">
                A paragraph on the Wonder Pick page separating what it works out (the bar an
                offer has to clear to be worth a stamina) from what the game's own offer
                screen already shows you. Worth reading once.
            </span>
        </label>
    </div>

    @* The plan drives every estimate in the app — the ranking, the completion figures, the point
       shop, the trade board — so it is editable here as well as on the Packs page. *@
    <h2>What counts as complete</h2>
    <p class="small text-body-secondary">
        One chip per rarity, carrying how many copies you want; tap to cycle none, one, two. This
        is the <strong>default</strong>, followed by every set without its own plan.
    </p>
    @if (Session.Ready)
    {
        <div class="rarity-chips mb-2">
            <RarityChips Plan="Session.Plan()" OnCycle="CyclePlan"
                         ShowFoils="Session.FoilSets.Count > 0" OnCycleFoils="Session.CycleFoilCopies" />
        </div>

        @* Overrides are made on the Packs page, one set at a time, and were previously findable
           only by navigating back to that same set. A list of what is currently overridden is the
           other half of the feature. *@
        @if (Overrides().Count > 0)
        {
            <p class="small text-body-secondary mb-1">
                These sets have their own plan and ignore the default:
            </p>
            <div class="d-flex flex-wrap gap-2 mb-4">
                @foreach (var set in Overrides())
                {
                    <span class="avail-chip on">
                        <span class="ttl">@set</span>
                        <span class="small"><PlanSummary Plan="Session.Profile.Targets.PlanFor(set)" /></span>
                        <button class="chip-link" @onclick="() => ClearOverride(set)"
                                title="Follow the default plan again">Use default</button>
                    </span>
                }
            </div>
        }
        else
        {
            <p class="small text-body-secondary mb-4">
                Every set follows this default. Give one its own from
                <a href="packs">Which pack</a>, with that set selected.
            </p>
        }
    }

    @* Placed before "your data" because it is the first thing a returning player is offered:
       without it every count on the History page reads as a fraction of the truth. *@
    <h2>What the game already counted</h2>
    <p class="small text-body-secondary">
        Open your profile in PTCGP and read off its lifetime totals. Everything you log from now
        on is <strong>added</strong> to these, so nothing is counted twice.
    </p>
    <p class="small text-body-secondary">
        The game gives counts only, never which packs. So per-set figures, the points ledger and
        the odds checks use packs logged here and nothing else.
    </p>
    <div class="d-flex gap-3 flex-wrap align-items-end mb-2">
        <label class="small">
            Packs Opened
            <input type="number" min="0" class="form-control form-control-sm"
                   style="width:8rem" value="@_packs" @onchange="OnPacks" />
        </label>
        <label class="small">
            Wonder Picks
            <input type="number" min="0" class="form-control form-control-sm"
                   style="width:8rem" value="@_wonder" @onchange="OnWonder" />
        </label>
        <button class="btn btn-sm btn-primary" @onclick="SaveLifetime">Save totals</button>
        @if (Session.Lifetime is not null)
        {
            <button class="btn btn-sm btn-outline-secondary" @onclick="ClearLifetime">Clear</button>
        }
    </div>
    @if (Session.Lifetime is { } lt)
    {
        <p class="small text-body-secondary mb-4">
            Read on @lt.At.ToLocalTime().ToString("d MMM yyyy, HH:mm"):
            @lt.PacksOpened packs and @lt.WonderPicks Wonder Picks. Logging since then brings the
            totals to <strong>@Session.LifetimePacks</strong> packs and
            <strong>@Session.LifetimeWonderPicks</strong> Wonder Picks.
        </p>
    }
    else
    {
        <p class="small text-body-secondary mb-4">
            Not set, so History counts only what has been logged here.
        </p>
    }

    @* Alt accounts are ordinary in this game and you can trade with yourself, so a second
       collection is a normal way to play. Managed here rather than in the top bar: switching is
       frequent, creating and deleting are not, and a delete button in the chrome of every page is
       how collections get erased by accident. *@
    <h2>Collections</h2>
    <p class="small text-body-secondary">
        Each holds its own cards, plan, decks, logs and resources. One is active at a time.
        @if (Session.MultipleProfiles)
        {
            <span>
                <a href="compare">Compare two of them</a> to find the trades you could make with
                yourself.
            </span>
        }
    </p>

    <DataTable Label="Your collections">
        <thead>
            <tr>
                <th scope="col">Collection</th>
                @* The name people find you by in the game. A shared chase list is unusable without
                   it -- whoever reads the list knows what you want and has no way to send it. *@
                <th scope="col" data-pri="2">In-game Name</th>
                <th scope="col" class="text-end">Cards</th>
                <th scope="col"><span class="visually-hidden">Actions</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var profile in Session.Profiles)
            {
                var active = profile.Id == Session.ActiveProfileId;
                <tr>
                    <td>
                        @if (_renaming == profile.Id)
                        {
                            <div class="input-group input-group-sm" style="max-width:16rem">
                                <input class="form-control" @bind="_rename" @bind:event="oninput"
                                       @onkeydown="e => RenameKey(e, profile.Id)" />
                                <button class="btn btn-primary" @onclick="() => SaveRename(profile.Id)">
                                    Save
                                </button>
                            </div>
                        }
                        else
                        {
                            <span>@profile.Name</span>
                            @if (active)
                            {
                                <span class="badge text-bg-primary ms-2">Active</span>
                            }
                        }
                    </td>
                    <td data-pri="2">
                        <input class="form-control form-control-sm" style="max-width:12rem"
                               value="@profile.InGameName" placeholder="Not set"
                               aria-label="In-game name for @profile.Name"
                               @onchange="e => SaveInGameName(profile.Id, e.Value?.ToString())" />
                    </td>
                    <td class="text-end">@Cards(profile)</td>
                    <td class="text-end">
                        <div class="d-flex gap-1 justify-content-end flex-wrap">
                            @if (!active)
                            {
                                <button class="btn btn-sm btn-primary"
                                        aria-label="@($"Switch to {profile.Name}")"
                                        @onclick="() => Switch(profile.Id)">Switch</button>
                            }
                            <button class="btn btn-sm btn-outline-secondary"
                                    @onclick="() => StartRename(profile)">Rename</button>
                            <button class="btn btn-sm btn-outline-secondary"
                                    @onclick="() => Duplicate(profile)">Duplicate</button>
                            @if (Session.MultipleProfiles)
                            {
                                <button class="btn btn-sm btn-outline-danger"
                                        @onclick="() => Delete(profile)">
                                    @(_deleting == profile.Id ? "Really delete?" : "Delete")
                                </button>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </DataTable>

    @* No delete button while there is one collection: the app has nowhere to put a tap without
       one, so the offer could only be refused. *@
    <p class="small text-body-tertiary">
        Deleting a collection cannot be undone, and export covers every collection at once, so a
        backup is the only way back.
    </p>

    <div class="input-group input-group-sm mb-2" style="max-width:22rem">
        <label class="visually-hidden" for="new-profile">Name for the new collection</label>
        <input class="form-control" id="new-profile" placeholder="Name a new collection"
               @bind="_newProfile"
               @bind:event="oninput" @onkeydown="NewProfileKey" />
        <button class="btn btn-outline-primary" @onclick="AddProfile"
                disabled="@string.IsNullOrWhiteSpace(_newProfile)">Add</button>
    </div>

    @* Beside the buttons that caused it rather than in the page-wide message box further down: a
       confirmation nobody scrolls to is not a confirmation. *@
    @if (_profileNote is not null)
    {
        <p class="small text-body-secondary mb-4">@_profileNote</p>
    }
    else
    {
        <div class="mb-4"></div>
    }

    @* Before "Your data" because it is the answer to the worry that section raises: clearing
       site data erases everything. A backup is the old answer and still the reliable one; this is
       the answer for someone who owns two devices. *@
    @if (Sync.Available)
    {
        <h2>Sync across devices</h2>

        @if (!Sync.Paired)
        {
            <p class="small text-body-secondary">
                No account. One device makes a code, the other types it. That code is the
                encryption key, applied before anything leaves this browser, so the server
                stores what it cannot read.
            </p>
            <p class="small text-body-secondary">
                Which is why the code cannot be recovered. Write it down.
            </p>

            <div class="d-flex gap-2 flex-wrap mb-3">
                <button class="btn btn-sm btn-primary" disabled="@Busy" @onclick="StartSync">
                    Set up sync
                </button>
                <button class="btn btn-sm btn-outline-primary" disabled="@Busy"
                        @onclick="() => _joining = !_joining">
                    I have a code
                </button>
            </div>

            @if (_joining)
            {
                <div class="d-flex gap-2 flex-wrap align-items-center mb-3">
                    <label class="small">
                        Code From Your Other Device
                        <input class="form-control form-control-sm" style="width:12rem"
                               autocomplete="off" autocapitalize="characters" spellcheck="false"
                               placeholder="XXXX-XXXX-XXXX"
                               value="@_typed" @oninput="OnCodeTyped" />
                    </label>
                    <button class="btn btn-sm btn-primary align-self-end" disabled="@Busy"
                            @onclick="Join">Join</button>
                </div>
            }
        }
        else
        {
            <p class="small text-body-secondary">
                Type this code on any other device to add it.
            </p>
            <p class="mb-2">
                <code class="fs-5 user-select-all">@PairingCode.Format(Sync.Code!)</code>
            </p>
            <p class="small text-body-secondary">
                Treat it like a password: anyone with it can read and change your
                collection. Losing it costs you the stored copy, not this device's.
            </p>

            <div class="d-flex gap-2 flex-wrap mb-3">
                <button class="btn btn-sm btn-primary" disabled="@Busy" @onclick="SyncNow">
                    @(Busy ? "Syncing…" : "Sync now")
                </button>
                <button class="btn btn-sm btn-outline-secondary" disabled="@Busy"
                        @onclick="() => _unpairing = !_unpairing">
                    Stop syncing
                </button>
            </div>

            @if (_unpairing)
            {
                @* Two buttons because they are genuinely different acts. Stopping affects this
                   device; deleting affects every device on the code, and cannot be undone. *@
                <Notice Severity="Notice.Level.Warning" Class="mb-3">
                    <p class="mb-2">Either way, your collection here is untouched.</p>
                    <div class="d-flex gap-2 flex-wrap">
                        <button class="btn btn-sm btn-outline-secondary"
                                @onclick="() => Unpair(false)">
                            Stop on this device
                        </button>
                        <button class="btn btn-sm btn-outline-danger"
                                @onclick="() => Unpair(true)">
                            Stop and delete the stored copy
                        </button>
                        <button class="btn btn-sm btn-link" @onclick="() => _unpairing = false">
                            Cancel
                        </button>
                    </div>
                </Notice>
            }
        }

        @if (Sync.Status == SyncStatus.Failed && Sync.Message is not null)
        {
            <Notice Severity="Notice.Level.Problem" Class="mb-3">@Sync.Message</Notice>
        }
        else if (_syncNote is not null)
        {
            <Notice Severity="Notice.Level.Success" Class="mb-3">@_syncNote</Notice>
        }

        @* Conflicts are not errors -- every one of them was resolved -- but they are the only
           moments a rule had to choose on the user's behalf, so they are the only ones said out
           loud.

           Conditioned on the notes rather than on the count, which is the honest question: this
           block exists to say what happened, and it has nothing to show for a count it cannot
           describe. The merge now guarantees the two agree, and this makes a heading over an empty
           list impossible even if that ever slips again. *@
        @if (Sync.LastMerge.Notes.Count > 0)
        {
            <Notice Severity="Notice.Level.Info" Class="mb-3">
                <p class="mb-1">Both devices had changed these, so one had to be picked:</p>
                <ul class="mb-0 small">
                    @foreach (var note in Sync.LastMerge.Notes)
                    {
                        <li>@note</li>
                    }
                </ul>
            </Notice>
        }

        <p class="small text-body-secondary mb-4">
            Syncs on open, and a few seconds after any change. Press <strong>Sync now</strong> to
            pull in a device someone is using right now.
        </p>
    }

    <h2>Your data</h2>
    @if (Sync.Paired)
    {
        <p class="small text-body-secondary">
            This browser holds your collection, and sync keeps an encrypted copy on the server.
            There is still no account, and the server still cannot read it, so an export is
            the only backup that survives losing the code.
        </p>
    }
    else
    {
        <p class="small text-body-secondary">
            Everything is stored in this browser only: nothing is uploaded and no account
            exists. That also means clearing site data erases it, so export a backup.
        </p>
    }
    <p class="small text-body-secondary">
        <kbd>Ctrl</kbd>+<kbd>Z</kbd> (or <kbd>&#8984;</kbd>+<kbd>Z</kbd>) undoes anything, on any
        page. The last @AppSession.UndoDepth changes are kept, for this session only.
    </p>
    <div class="d-flex gap-2 flex-wrap mb-4">
        <button class="btn btn-sm btn-primary" @onclick="Export">Export backup</button>
        <label class="btn btn-sm btn-outline-primary mb-0">
            Import backup
            <InputFile OnChange="Import" style="display:none" accept=".json" />
        </label>
        <a class="btn btn-sm btn-outline-primary" href="collection/screenshot">
            Import from a screenshot
        </a>
        <a class="btn btn-sm btn-outline-primary" href="collection/import">
            Import from another tracker
        </a>
        <a class="btn btn-sm btn-outline-primary" href="collection/export">
            Export collection as CSV
        </a>
        <button class="btn btn-sm btn-outline-danger" @onclick="ConfirmReset" aria-live="polite">
            @* Names the collection once there is more than one: "erase collection" beside a list
               of three reads as all of them, and it only ever erases the active one. *@
            @(_confirmingReset
                ? $"Really erase {(Session.MultipleProfiles ? Session.Profile.Name : "everything")}?"
                : Session.MultipleProfiles ? $"Erase {Session.Profile.Name}" : "Erase collection")
        </button>
    </div>

    @if (_message is not null)
    {
        <Notice Severity="Notice.Level.Info">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <span>@_message</span>
                @* The undo control sits next to the sentence that mentions it, rather than the
                   message naming an undo whose only control is on another page. *@
                @if (_offerUndo && Session.CanUndo)
                {
                    <button class="btn btn-sm btn-outline-primary py-0" @onclick="UndoLast">
                        Undo that
                    </button>
                }
            </div>
        </Notice>
    }

    @if (Session.Ready)
    {
        <h2>Card data</h2>
        <DataTable Label="Card data sources" Fit="true">
            <tbody>
                <tr><td>Source</td><td><strong>@SourceLabel</strong></td></tr>
                <tr><td>Cards</td><td>@Session.Index.All.Count entries</td></tr>
                <tr><td>Ownable Cards</td><td>@Session.Index.DistinctOwnableCards</td></tr>
                <tr><td>Sets</td><td>@Session.Index.BySet.Count</td></tr>
                <tr><td>Packs We Can Price</td><td>@Session.Odds!.PriceablePacks.Count()</td></tr>
                <tr>
                    <td>Packs We Cannot</td>
                    <td>
                        @Session.Odds!.UnpriceablePacks.Count()
                        <span class="text-body-secondary small">
                            (no published pull rates yet)
                        </span>
                    </td>
                </tr>
                @* Which sets are out but unmeasured, separately from which are not out at all.
                   Reporting both as "cannot price" made a set whose cards drop today look
                   identical to one nobody can have. *@
                @if (Session.SetsAwaitingRates.Count > 0)
                {
                    <tr>
                        <td>Released, Rates Unknown</td>
                        <td>
                            @string.Join(", ", Session.SetsAwaitingRates)
                            <div class="text-body-secondary small">
                                Out now, but nobody has published their pull rates. The
                                <a href="packs">Which pack</a> page offers to estimate them from
                                the newest measured set.
                            </div>
                        </td>
                    </tr>
                }
                @if (Session.AssumedRates.Count > 0)
                {
                    <tr>
                        <td>Priced by Assumption</td>
                        <td>
                            @foreach (var (set, donor) in Session.AssumedRates.OrderBy(kv => kv.Key))
                            {
                                <div>
                                    <strong>@set</strong> using @donor's distributions
                                    <button class="btn btn-sm btn-link p-0 align-baseline"
                                            @onclick="() => Session.SetAssumedRates(set, null)">Stop</button>
                                </div>
                            }
                            <div class="text-body-secondary small">
                                Only the slot shape is borrowed: per-card odds come from
                                each set's own card counts.
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </DataTable>
        @* This app is AGPL-3.0-or-later, and section 13 requires that anyone interacting with it
           over a network be offered its Corresponding Source. That obligation applies to the
           running app rather than to the repository, so the offer is made here. *@
        <h2>Licence and source</h2>
        <p class="small text-body-secondary">
            PackProphet is free software under the
            <a href="https://www.gnu.org/licenses/agpl-3.0.html" target="_blank" rel="noopener">
                GNU Affero General Public License, version 3 or later</a>.
            You may use, study, change and share it, and the complete source of this running copy
            is at
            <a href="https://github.com/Spibane/PackProphet" target="_blank" rel="noopener">
                github.com/Spibane/PackProphet</a>.
        </p>
        <p class="small text-body-secondary">
            The licence follows the card data: the only community dataset carrying attack text,
            ability text and evolution stage for every set is itself AGPL. Card data comes from
            <a href="https://github.com/chase-mew/pokemon-tcg-pocket-cards" target="_blank" rel="noopener">chase-mew/pokemon-tcg-pocket-cards</a>
            and
            <a href="https://github.com/flibustier/pokemon-tcg-pocket-database" target="_blank" rel="noopener">flibustier/pokemon-tcg-pocket-database</a>,
            artwork from
            <a href="https://github.com/flibustier/pokemon-tcg-exchange" target="_blank" rel="noopener">pokemon-tcg-exchange</a>,
            and all of it originates from
            <a href="https://pocket.limitlesstcg.com/cards" target="_blank" rel="noopener">Limitless TCG</a>.
            Full credits, including the reverse-engineered deck format and bundled third-party
            code, are in
            <a href="https://github.com/Spibane/PackProphet/blob/main/NOTICE.md" target="_blank" rel="noopener">NOTICE.md</a>.
        </p>
        <p class="small text-body-tertiary">
            Pokémon and Pokémon TCG Pocket are trademarks of Nintendo, Creatures Inc. and
            GAME FREAK inc. This is an unofficial fan tool, unaffiliated with and unendorsed by
            any of them.
        </p>

        <p class="small text-body-secondary">
            Card data is fetched from the community database so new sets appear without an
            update. If that fetch fails, a snapshot bundled with the app is used instead, and
            this row will say so.
        </p>
    }
</PageShell>

@code {
    // ---- Sync -----------------------------------------------------------------------

    private bool _joining;
    private bool _unpairing;
    private string _typed = "";

    private void OnCodeTyped(ChangeEventArgs e) => _typed = e.Value?.ToString() ?? "";
    private string? _syncNote;

    private bool Busy => Sync.Status == SyncStatus.Working;

    private async Task StartSync()
    {
        _joining = false;
        var code = await Sync.PairNewAsync();
        _syncNote = code is null
            ? null
            : $"Sync is on. Type {PairingCode.Format(code)} on your other device.";
    }

    private async Task Join()
    {
        _syncNote = null;

        // Failure reports itself through Sync.Message, which the Notice below already renders, so
        // there is nothing to do here but leave the field up so the code can be corrected.
        if (!await Sync.JoinAsync(_typed)) return;

        _joining = false;
        _typed = "";
        _syncNote = "Joined. Both devices now hold everything either of them had.";
    }

    private async Task SyncNow()
    {
        _syncNote = null;
        await Sync.SyncAsync();

        if (Sync.Status != SyncStatus.Synced) return;
        _syncNote = Sync.LastCameFromElsewhere
            ? "Synced, and brought in changes from another device."
            : "Synced. Everything was already up to date.";
    }

    private async Task Unpair(bool deleteRemote)
    {
        _unpairing = false;
        await Sync.UnpairAsync(deleteRemote);
        _syncNote = Sync.Message;
    }

    // Held as strings so a half-typed field is not rounded to zero mid-keystroke, and so an
    // empty box stays empty rather than showing a 0 the user did not enter.
    private string _packs = "";
    private string _wonder = "";

    /// <summary>
    /// Saved immediately, unlike the Packs page's debounced draft: nothing here re-ranks, so
    /// there is no expensive recompute to wait out between taps.
    /// </summary>
    private void CyclePlan(int tier)
    {
        var next = Session.Plan().Cycle(tier);

        // Refused rather than saved: a plan wanting nothing makes every screen read "complete".
        // Same rule as the Packs page.
        if (next.IsEmpty) return;

        Session.SetPlan(next);
    }

    // ---- Collections ----------------------------------------------------------------

    private string? _renaming;
    private string _rename = "";
    private string _newProfile = "";
    private string? _deleting;
    private string? _profileNote;

    private void Say(string note) => _profileNote = note;

    private int Cards(Profile profile) => profile.Collection.Values.Sum();

    private void Switch(string id)
    {
        _deleting = null;
        Session.SwitchProfile(id);
        Say($"switched to {Session.Profile.Name}.");
    }

    private void SaveInGameName(string id, string? name)
    {
        Session.SetInGameName(id, name);
        Say(string.IsNullOrWhiteSpace(name) ? "in-game name cleared." : $"in-game name saved as {name!.Trim()}.");
    }

    private void StartRename(Profile profile)
    {
        _renaming = profile.Id;
        _rename = profile.Name;
        _deleting = null;
    }

    private void SaveRename(string id)
    {
        Session.RenameProfile(id, _rename);
        _renaming = null;
    }

    private void RenameKey(KeyboardEventArgs e, string id)
    {
        if (e.Key == "Enter") SaveRename(id);
        else if (e.Key == "Escape") _renaming = null;
    }

    private void Duplicate(Profile profile)
    {
        _deleting = null;
        Session.DuplicateProfile(profile.Id);
        Say($"copied {profile.Name}. The copy is not active until you switch to it.");
    }

    /// <summary>
    /// Two taps, and the second one is the destructive one. There is no undo for this: the undo
    /// stack is cleared by the switch that follows, and a half-working undo is worse than none.
    /// </summary>
    private void Delete(Profile profile)
    {
        if (_deleting != profile.Id)
        {
            _deleting = profile.Id;
            return;
        }

        _deleting = null;
        if (Session.DeleteProfile(profile.Id)) Say($"deleted {profile.Name}.");
    }

    private void AddProfile()
    {
        if (string.IsNullOrWhiteSpace(_newProfile)) return;

        var name = _newProfile.Trim();
        _newProfile = "";
        Session.CreateProfile(name);
        Say($"added {name}, with the same plan as {Session.Profile.Name}. Switch to it to start entering cards.");
    }

    private void NewProfileKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddProfile();
    }

    private IReadOnlyList<string> Overrides() =>
        Session.Profile.Targets.PlanBySet.Keys
            .OrderBy(Session.Sets.SortKey, StringComparer.Ordinal)
            .ToArray();

    private void ClearOverride(string set) => Session.ClearPlanOverride(set);

    private void OnPacks(ChangeEventArgs e) => _packs = e.Value?.ToString() ?? "";

    private void OnWonder(ChangeEventArgs e) => _wonder = e.Value?.ToString() ?? "";

    private void SaveLifetime()
    {
        var packs = Num.Count(_packs);
        var wonder = Num.Count(_wonder);
        Session.SetLifetime(packs, wonder);
        _message = packs <= 0 && wonder <= 0
            ? "Lifetime totals cleared."
            : $"Saved: {packs} packs and {wonder} Wonder Picks before today.";
        _offerUndo = true;
    }

    private void ClearLifetime()
    {
        _packs = _wonder = "";
        Session.SetLifetime(0, 0);
        _message = "Lifetime totals cleared.";
        _offerUndo = true;
    }

    private static readonly (string Value, string Label)[] Themes =
    [
        ("auto", "Auto"), ("light", "Light"), ("dark", "Dark")
    ];

    private static readonly (string Value, string Label)[] Skins =
    [
        ("paper", "Paper"), ("slate", "Slate")
    ];

    private string? _message;
    private bool _confirmingReset;

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnChanged;
        Sync.Changed += OnChanged;
        await Session.InitAsync();

        // Prefilled from what was saved, so editing the figure means correcting it rather than
        // retyping it from memory.
        if (Session.Lifetime is { } lt)
        {
            _packs = lt.PacksOpened.ToString();
            _wonder = lt.WonderPicks.ToString();
        }
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private string SourceLabel => Session.Data!.Source == DataSource.Cdn
        ? "Live community database"
        : $"Bundled snapshot{(Session.Data.Version is { } v ? $" (v{v})" : "")}, CDN unreachable";

    private async Task Export()
    {
        _offerUndo = false;
        await Session.FlushAsync();
        var stamp = DateTimeOffset.Now.ToString("yyyy-MM-dd");
        await Store.ExportAsync(Session.State, $"packprophet-backup-{stamp}.json");
        _message = "Backup downloaded.";
    }

    private async Task Import(InputFileChangeEventArgs e)
    {
        _message = null;
        _offerUndo = false;
        try
        {
            // 8 MB ceiling: a legitimate backup is well under 1 MB, so anything larger is a
            // mistake and reading it would just hang the tab.
            await using var stream = e.File.OpenReadStream(8 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var json = await reader.ReadToEndAsync();

            var imported = StateSerializer.Deserialize(json);
            if (imported is null)
            {
                _message = "That file could not be read as a PackProphet backup, so nothing changed.";
                return;
            }

            Session.ReplaceState(imported);
            _message = $"Imported {imported.Active.Collection.Count} owned cards, replacing what was here.";
            _offerUndo = true;
        }
        catch (IOException)
        {
            _message = "That file was too large to read.";
        }
    }

    private void ConfirmReset()
    {
        if (!_confirmingReset) { _confirmingReset = true; return; }
        _confirmingReset = false;
        Session.Mutate(p => p with
        {
            Collection = new(),
            PackLog = [],
            WonderLog = [],

            // Otherwise both logs come straight back from the other device on the next sync,
            // leaving a history of packs whose cards this reset has just erased.
            RemovedLog =
            [
                .. p.RemovedLog,
                .. p.PackLog.Select(LogId.Of),
                .. p.WonderLog.Select(LogId.Of),
            ]
        });

        _message = Session.MultipleProfiles
            ? $"{Session.Profile.Name}: collection, pack log and Wonder Pick log erased. Your other collections are untouched."
            : "Collection, pack log and Wonder Pick log erased.";
        _offerUndo = true;
    }

    /// <summary>Whether the current message has something to undo.</summary>
    private bool _offerUndo;

    private void UndoLast()
    {
        Session.Undo();
        _offerUndo = false;
        _message = "Restored.";
    }

    public void Dispose()
    {
        Session.Changed -= OnChanged;
        Sync.Changed -= OnChanged;
    }
}
