<Project Sdk="Microsoft.NET.Sdk">

  <!-- Render tests for the App project.

       Kept separate from PackProphet.Tests, which covers the engine, runs in a second, and has no
       browser stack behind it. Pulling a Blazor WebAssembly reference and a DOM implementation
       into it would slow every engine test down, and the split means an SDK problem with
       referencing a WASM project cannot take the engine suite with it.

       The App project is the larger half of the codebase and had no tests at all, which is where
       nearly every bug found in review lived: a page that indexes an empty list compiles cleanly
       and passes every engine test. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- bUnit renders components outside a browser, so the browser-wasm identifier the App
         project carries must not propagate here. -->
    <RuntimeIdentifier></RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="bunit" Version="1.40.0" />
    <!-- Pinned above bunit's own dependency: AngleSharp 1.2.0 carries GHSA-pgww-w46g-26qg, fixed
         in 1.5.0. Test-only and never shipped, but a restore warning nobody can act on trains
         everyone to ignore restore warnings. -->
    <PackageReference Include="AngleSharp" Version="1.5.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PackProphet.App\PackProphet.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Bunit" />
    <Using Include="PackProphet.Domain" />
    <Using Include="PackProphet.State" />
  </ItemGroup>

  <!-- The published service worker, so its precache rules can be tested. It only runs in a
       published build, which means it is the one file in the app that never executes in
       development and never executes in CI either. -->
  <ItemGroup>
    <Content Include="..\..\src\PackProphet.App\wwwroot\service-worker.published.js"
             Link="service-worker.published.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The app's own JavaScript, so the error surface's coverage of it can be asserted. diag.js
       wraps every asynchronous entry point these files use, because Safari strips the message,
       file and line off anything that reaches window.onerror from a cross-origin script; a new
       kind of callback that escapes the wrappers is invisible until a report arrives with nothing
       in it. The vendored QR decoder is excluded: 10,000 lines of third-party code that nothing
       here asserts on. -->
  <ItemGroup>
    <Content Include="..\..\src\PackProphet.App\wwwroot\js\*.js"
             Exclude="..\..\src\PackProphet.App\wwwroot\js\vendor-jsQR.js"
             Link="js\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The stylesheet and the grid, read as text so the layout invariants that span the two of them
       can be asserted. Neither is compiled here; they are evidence, not code under test. -->
  <ItemGroup>
    <Content Include="..\..\src\PackProphet.App\wwwroot\css\app.css"
             Link="app.css" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\PackProphet.App\Components\CardGrid.razor"
             Link="CardGrid.razor.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Every page, as text. One invariant spans all of them: nothing below the bars may pad itself
       to the screen edge with a flat utility, because those do not clear a display cutout. -->
  <ItemGroup>
    <Content Include="..\..\src\PackProphet.App\Pages\*.razor"
             Link="pages\%(Filename).razor.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The components and the layout, as text as well, so a rule about how markup is WRITTEN can be
       asserted over all of it. Rendering cannot answer this one: an ARIA state that Blazor dropped
       is absent from the DOM, and a test looking at the DOM sees an element that simply has no such
       state rather than one that lost it. -->
  <ItemGroup>
    <Content Include="..\..\src\PackProphet.App\Components\*.razor"
             Link="markup\components\%(Filename).razor.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\PackProphet.App\Pages\*.razor"
             Link="markup\pages\%(Filename).razor.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\PackProphet.App\Layout\*.razor"
             Link="markup\layout\%(Filename).razor.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The same vendored snapshot the app ships, served to the loader over a fake HttpClient so a
       page renders against real card data rather than a handful of fixtures. -->
  <ItemGroup>
    <Content Include="..\..\src\PackProphet.App\wwwroot\data\snapshot\*.json"
             Link="snapshot\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>


  <!-- The card art fingerprints, so the screenshot import page renders against the same table it
       will have in production rather than against nothing. -->
  <ItemGroup>
    <Content Include="..\..\src\PackProphet.App\wwwroot\data\card-hashes.txt"
             Link="card-hashes.txt" CopyToOutputDirectory="PreserveNewest"
             Condition="Exists('..\..\src\PackProphet.App\wwwroot\data\card-hashes.txt')" />
  </ItemGroup>

  <!-- The vendored Bootstrap files, as a directory listing rather than as content: the precache
       rules no longer carry an exclusion for the unlinked half of the dist, because the unlinked
       half is not in the repository. A glob rather than two named files, so re-vendoring the whole
       dist shows up here as extra copies and fails the test that counts them. -->
  <ItemGroup>
    <Content Include="..\..\src\PackProphet.App\wwwroot\lib\bootstrap\dist\**\*"
             Link="lib\bootstrap\dist\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The same real PTCGP Tracker export the engine suite reads, so the page can be driven with a
       genuine workbook rather than one this project produced. -->
  <ItemGroup>
    <Content Include="..\PackProphet.Tests\fixtures\*"
             Link="fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
