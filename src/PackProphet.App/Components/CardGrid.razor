    /// </summary>
    [Parameter] public EventCallback<int> ImgFailedChanged { get; set; }

    /// <summary>
    /// How many filters the page currently has applied, for the count on the phone's filter
    /// button.
    ///
    /// Supplied rather than counted here, because the grid does not know what a filter is: it is
    /// handed <see cref="Cards"/> already narrowed, and <see cref="FilterChips"/> as opaque
