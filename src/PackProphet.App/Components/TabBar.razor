@inject AppSession Session
@inject PaletteSwitch Palette
@implements IDisposable

@* The five destinations that carry the loop the app is built around: record what you own, see
   which pack, log what you opened, and keep the list of what you are still missing. Wonder Pick
   is a separate in-game mechanic and sits behind More with everything else you go to
   occasionally.

   Hiding those seven is legitimate under the rule the rest of the UI follows: hide controls
   freely, never hide active state that changes what the numbers mean. A destination is not a
   claim about data. *@
<nav class="tab-bar" aria-label="Main">
    <NavLink class="tab" href="collection" Match="NavLinkMatch.All">
        <span class="ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" focusable="false">
                <rect x="3" y="3" width="7.5" height="7.5" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.8" />
                <rect x="13.5" y="3" width="7.5" height="7.5" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.8" />
                <rect x="3" y="13.5" width="7.5" height="7.5" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.8" />
                <rect x="13.5" y="13.5" width="7.5" height="7.5" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.8" />
            </svg>
        </span>
        <span class="lbl">Collection</span>
    </NavLink>

    <NavLink class="tab" href="packs">
        <span class="ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" focusable="false">
                <path d="M4 8.5 12 4l8 4.5v7L12 20l-8-4.5z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                <path d="M4 8.5 12 13l8-4.5M12 13v7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
            </svg>
        </span>
        <span class="lbl">Packs</span>
    </NavLink>

    @* Centred and larger: the only tab that writes something, and the one repeated many times a
       day. The others are places; this is the action. *@
    <NavLink class="tab tab-primary" href="log">
        <span class="ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="26" height="26" focusable="false">
                <path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
            </svg>
        </span>
        <span class="lbl">Log</span>
    </NavLink>

    <NavLink class="tab" href="chase">
        <span class="ico" aria-hidden="true">
            @* A bookmark, not a heart: these are the cards you are hunting, not the ones you love. *@
            <svg viewBox="0 0 24 24" width="22" height="22" focusable="false">
                <path d="M7 4h10a1 1 0 0 1 1 1v15l-6-4-6 4V5a1 1 0 0 1 1-1z"
                      fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
            </svg>
        </span>
        <span class="lbl">Chases</span>
    </NavLink>

    @* A native popover: top layer, light dismiss and Escape come free, and unlike a dialog it is
       non-modal, which is right for a menu. *@
    <button class="tab" popovertarget="nav-more" aria-label="More destinations">
        <span class="ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" focusable="false">
                <path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" />
            </svg>
        </span>
        <span class="lbl">More</span>
    </button>
</nav>

<MoreMenu Id="nav-more" />

@code {
    protected override void OnInitialized() => Session.Changed += OnChanged;

    public void Dispose() => Session.Changed -= OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);
}
