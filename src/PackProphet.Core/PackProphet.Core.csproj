<Project Sdk="Microsoft.NET.Sdk">

  <!-- Domain + engine. A plain library with no Blazor or UI reference, so "the engine is pure C#"
       is enforced by the compiler. Everything here is unit-testable without a browser. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>


  <!-- PoissonTail is an implementation detail, asserted directly against hand-computed values.
       Exposing internals to the test project avoids widening the public API for testability. -->
  <ItemGroup>
    <InternalsVisibleTo Include="PackProphet.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

</Project>
