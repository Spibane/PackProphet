@inherits LayoutComponentBase
@* NavHistory is injected here, and nowhere else needs to, purely so it is constructed at
   startup: it records navigation as it happens and cannot recover a history it did not see. *@
@inject NavHistory History
@inject AppSession Session
@implements IDisposable

@* Twelve nav links sit above every page, and Blazor does not move focus on navigation, so a
   keyboard or screen-reader user otherwise tabs through the whole bar again on arrival. Visible
   only when focused. *@
<a class="skip-link" href="#main">Skip to content</a>

<NavMenu />

@* Storage trouble is announced here rather than on any one page, because it is not about what you
   are looking at - it is about every edit you make from now on. role="alert" so a screen reader is
   told without having to find it. *@
@if (Session.SaveFailed || Session.StorageUnavailable || Session.LoadFailed)
{
    <div class="storage-alarm" role="alert">
        @if (Session.SaveFailed)
        {
            <strong>Your changes are not being saved.</strong>
            <span>
                The browser refused the write, which usually means its storage for this site is
                full. Export a backup now &mdash; anything you do until this clears will be lost on
                reload.
            </span>
        }
        else if (Session.StorageUnavailable)
        {
            <strong>This browser is not letting the app store anything.</strong>
            <span>
                Private browsing or blocked site data will do that. The app works for now, but
                nothing will survive a reload, so export a backup before you close the tab.
            </span>
        }
        else
        {
            <strong>Saved data was found but could not be read.</strong>
            <span>
                The app has started empty rather than refuse to open. The unreadable text has been
                set aside untouched under <code>packprophet.state.unreadable</code> in this site's
                local storage, so it can still be recovered by hand &mdash; importing a backup or
                entering cards will not overwrite it.
            </span>
        }
        <a href="settings">open settings</a>
    </div>
}

<main id="main" tabindex="-1">@Body</main>
<BusyOverlay />
@* Rendered once, above every page, because it is reachable from anywhere. *@
<CommandPalette />
@* Also markup-free: it owns the app-wide undo shortcut. *@
<UndoHotkeys />

@code {
    protected override void OnInitialized() => Session.Changed += OnChanged;

    public void Dispose() => Session.Changed -= OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);
}
