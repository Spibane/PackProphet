@page "/collection"
@page "/"
@implements IDisposable
@inject AppSession Session
@inject UiBusy Busy

<PageTitle>Collection · PackProphet</PageTitle>

@if (!Session.Ready)
{
    <Loading />
}
else
{
    <div class="page-head">
        <h1 class="title">Collection</h1>
        @* Where you are and how far along, in the header rather than in the filters bar: it is the
           answer the page exists to give, and the filters bar is for changing something rather
           than for reading a total. *@
        <span class="subtitle" title="Distinct cards you own here, total copies including duplicates, and progress against the rarities you have chosen to collect">
            @Label(_set)
            &middot; @Stats.Owned of @Stats.Cards owned
            @* Copies as well as cards, since they answer different questions: one is how far
               through the set you are, the other how much you are holding — and gold flair needs
               ten of a card, so duplicates are worth counting. *@
            &middot; @Stats.Copies copies
            &middot; target @TargetOwned / @TargetTotal
        </span>
        <span class="actions">
            <button class="btn btn-sm btn-outline-secondary" disabled="@(!Session.CanUndo)"
                    @onclick="Session.Undo" title="Undo (Ctrl+Z)">&#8630;</button>
            <button class="btn btn-sm btn-outline-secondary" disabled="@(!Session.CanRedo)"
                    @onclick="Session.Redo" title="Redo (Ctrl+Shift+Z)">&#8631;</button>
        </span>
    </div>

    @* The set tabs are the page's main control, but they are tall — two lines per tab, since each
       carries its own progress — so they sit below the header rather than making it a different
       height from every other page's. *@
    @* Closed by default, showing only which set you are in. Every set ever printed was on screen
       at all times -- a full row at 375px, and already wrapping past the right edge on a laptop --
       to answer a question asked once a session. The summary keeps the answer, the row keeps the
       choosing, and the choosing is what folds away. *@
    @* Uncontrolled, like the grid's own toolbar disclosure: the browser owns the open state, so
       there is nothing to keep in sync and it survives a re-render on its own. It also stays open
       across a pick, which is what you want while comparing percentages across sets. *@
    <details class="set-picker">
        <summary>
            @* Titled as well as shown: below 600px the name is shortened to keep this bar one
               line, and the full one should still be readable somewhere. *@
            <span class="cur" title="@CurrentSetLabel">@CurrentSetLabel</span>
            <span class="pct">@CurrentProgress.ToString("P0")</span>
            @* How many cards the filters have left, beside the two figures it belongs with: this
               bar is the one that says what you are looking at, and it is one line at every width,
               where the grid's bar wraps as soon as a filter is on. Failed art is a caveat on this
               number rather than a fact of its own, so it travels with it. *@
            <span class="tally">
                @Filtered.Count cards
                @if (_artFailed > 0)
                {
                    <span class="fail">&middot; @_artFailed art failed</span>
                }
            </span>
            <span class="fold-hint">change set</span>
        </summary>

        <div class="set-picker-body">
        @* A series at a time. One row of every set ever printed already wraps to three lines;
           grouping keeps it to one row per series indefinitely. *@
        <select class="form-select form-select-sm" style="max-width:9rem" aria-label="Series" @onchange="OnSeries">
            <option value="@AllSets" selected="@(_series == AllSets)">every series</option>
            @foreach (var series in Session.Sets.Series)
            {
                <option value="@series" selected="@(_series == series)">series @series</option>
            }
        </select>

        <div class="set-tabs">
            @if (_series == AllSets)
            {
                <button class="set-tab @(_set == AllSets ? "active" : "")"
                        @onclick="() => SelectSet(AllSets)" disabled="@Busy.IsBusy"
                        title="Every card from every series">
                    All cards
                    <span class="pct">@ProgressOf(_allCards).ToString("P0")</span>
                </button>
            }
            else
            {
                <button class="set-tab @(_set == SeriesAll ? "active" : "")"
                        @onclick="() => SelectSet(SeriesAll)" disabled="@Busy.IsBusy"
                        title="Every card in series @_series">
                    All @_series
                    <span class="pct">@ProgressOf(SeriesCards).ToString("P0")</span>
                </button>
                @foreach (var set in Session.Sets.SetsIn(_series))
                {
                    <button class="set-tab @(set == _set ? "active" : "")"
                            @onclick="() => SelectSet(set)" disabled="@Busy.IsBusy"
                            title="@Session.Sets.DisplayName(set)">
                        @* A wrapper from the set, so the row can be read at a glance rather than
                           decoded from two-character codes: B2a and B2b are the same three
                           characters in a different order, and their wrappers are not.

                           A wrapper and not the set's logo, which is what the sticky strip shows.
                           The logo is a wordmark 256px wide by 113 tall, and a tab has to hold it
                           beside a code and a percentage -- at the height those two lines allow it
                           is a smudge. A booster is tall, which is the shape the space left over
                           here actually is, and it is recognisable at 18px wide where lettering is
                           not. Same set, two pictures, because the two places have opposite
                           shapes to fill. *@
                        @if (SetArtUrl(set) is { Length: > 0 } art)
                        {
                            <span class="pack-thumb" aria-hidden="true"
                                  style="background-image:url('@art')"></span>
                        }
                        <span class="lbl">
                            @set
                            <span class="pct">@Progress(set).ToString("P0")</span>
                        </span>
                    </button>
                }
            }
        </div>
        </div>
    </details>

    @* Collection-wide rather than scoped to the visible set: evolution does not care which set a
       card came from, and scoping it would hide the gap whose fix lives one tab over. Collapsed by
       default, since the grid is what the page is for. *@
    @if (Session.ShowGapStrip && Session.Gaps is { Complete: false } gaps)
    {
        <div class="gap-strip">
            <button class="hd" @onclick="() => _showGaps = !_showGaps"
                    aria-expanded="@Aria.Flag(_showGaps)">
                <span class="chev" aria-hidden="true">@(_showGaps ? "▾" : "▸")</span>
                <strong>@gaps.BlockedCards</strong>
                @(gaps.BlockedCards == 1 ? "card you own cannot evolve" : "cards you own cannot evolve")
                <span class="text-body-secondary">
                    &mdash; @gaps.Gaps.Count missing
                    @(gaps.Gaps.Count == 1 ? "link" : "links"), across every set
                </span>
            </button>

            @* Early on nearly every evolution is missing a stage, so this reports a standing fact
               rather than something that resolves. The filter and the Settings toggle both remain,
               so dismissing hides the bar rather than the feature. *@
            <button class="x" @onclick="() => Session.SetShowGapStrip(false)"
                    title="Hide this bar for good. The 'fills an evolution gap' filter still works, and Settings brings it back."
                    aria-label="Hide the evolution gap bar">&times;</button>

            @if (_showGaps)
            {
                <p class="small text-body-secondary mb-2">
                    Any printing works &mdash; the game evolves on the printed name.
                    @if (_own != "gaps")
                    {
                        <button class="btn btn-sm btn-outline-primary py-0 ms-1"
                                @onclick="ShowGapFills">show them in the grid</button>
                    }
                </p>

                <ul class="gap-list">
                    @foreach (var gap in gaps.Gaps)
                    {
                        <li>
                            @if (gap.Easiest is { } easiest)
                            {
                                <a href="card/@easiest.Key">@gap.MissingName</a>
                                <span class="rr">@RarityName(easiest)</span>
                                <span class="text-body-secondary">from @easiest.Set</span>
                            }
                            else
                            {
                                <span>@gap.MissingName</span>
                            }

                            @if (gap.NoPackRoute)
                            {
                                <span class="badge text-bg-warning"
                                      title="No printing of it comes from a pack you can open, so opening will never produce one">
                                    no pack has it
                                </span>
                            }

                            <span class="text-body-secondary">
                                &mdash; blocks @string.Join(", ", gap.Blocks.Select(b => b.Name))
                            </span>

                            @if (gap.Requires is { } deeper)
                            {
                                <span class="text-body-secondary">
                                    (and it needs @deeper, which you also lack)
                                </span>
                            }
                        </li>
                    }
                </ul>

                @if (gaps.Unverified > 0)
                {
                    <p class="small text-body-tertiary mb-0">
                        @gaps.Unverified of @gaps.Checked owned Pokémon have no stage data published
                        yet, so a gap among them cannot be detected. A clean list is not proof there
                        are none.
                    </p>
                }
            }
        </div>
    }

    <PageShell Flush="true">
    <CardGrid Cards="Filtered" CountOf="Session.CountOf" Columns="Session.GridColumns"
              OnAdjust="OnAdjust" OnSweep="OnSweep" OnSet="OnSet"
              ListView="Session.ListView" ListViewChanged="Session.SetListView"
              Roomy="Session.ListRoomy" RoomyChanged="Session.SetListRoomy"
              RungOf="RungOf" TypeOf="Session.TypeLabel" StageOf="Session.StageLabel"
              SortKeyOf="Session.Sets.SortKey" GroupOf="GroupLabel" GroupArtOf="GroupArt"
              WantedOf="WantedOf" OnWant="ToggleWant"
              ShowCount="false" ImgFailedChanged="OnArtFailed"
              FactOf="Session.FactFor" FactsReady="Session.FactsReady">
        @* Filters live in the grid's toolbar rather than in a bar of their own. With a nav, a
           header, the set tabs, a filter row and a control row, this page put five bars above the
           first card; sharing one bar halves that without hiding anything. *@
        <Search>
            <input class="form-control form-control-sm grid-search"
                   placeholder="search name" aria-label="Search card names" value="@_search" @oninput="OnSearch" />
        </Search>

        @* What is currently narrowing the list, said on the bar itself. The controls that set
           these are folded into the disclosure; this is the state they leave behind, and without
           it the card count would quietly mean something other than what it says. Each chip
           clears its own filter. *@
        <FilterChips>
            @if (_search is { Length: > 0 })
            {
                <button class="chip-filter" @onclick="ClearSearch"
                        aria-label="Clear the name search">name: @_search &times;</button>
            }
            @if (_own != "all")
            {
                <button class="chip-filter" @onclick="ClearOwnFilter"
                        aria-label="Clear the ownership filter">@OwnFilterLabel &times;</button>
            }
            @if (_rarities.Count > 0)
            {
                <button class="chip-filter" @onclick="ClearRarityFilter"
                        aria-label="Clear the rarity filter">@RarityFilterLabel &times;</button>
            }
            @if (_types.Count > 0)
            {
                <button class="chip-filter" @onclick="ClearTypeFilter"
                        aria-label="Clear the type filter">@TypeFilterLabel &times;</button>
            }
            @if (_pack is { Length: > 0 })
            {
                <button class="chip-filter" @onclick="ClearPackFilter"
                        aria-label="Clear the pack filter">@_pack &times;</button>
            }
        </FilterChips>

        <Filters>
            <select class="form-select form-select-sm" style="max-width:11rem" aria-label="Filter by what you own" @onchange="OnOwnFilter">
                <option value="all">all cards</option>
                <option value="missing">missing only</option>
                <option value="owned">owned only</option>
                <option value="dupes">duplicates</option>
                <option value="needed">short of target</option>
                @* Only offered when there is something to see: a permanently empty filter that
                   returns nothing reads as a broken control. *@
                @if (Session.Gaps is { Complete: false })
                {
                    <option value="gaps">fills an evolution gap</option>
                }
            </select>

            @* Rarity and type as the game's own marks, and more than one at a time. A dropdown
               could hold exactly one rarity, which is the wrong shape for the question people
               actually ask -- "the stars and the crown, never mind the diamonds" -- and it named
               each rung in words where the game names it in symbols. Nothing selected means every
               rarity, so the control starts where the page starts.

               Symbols rather than an icon font: these are the glyphs the list view already draws,
               from the same rungs, so a chip and a card agree on what a rarity looks like. *@
            <div class="chip-group">
                <span class="ttl" id="rarity-chips-label">rarity</span>
                <div class="chip-toolbar" role="group" aria-labelledby="rarity-chips-label">
                @foreach (var rung in Session.Index.Ladder.Rungs)
                {
                    <button class="chip-tog @(_rarities.Contains(rung.Index) ? "on" : "")"
                            @onclick="() => ToggleRarity(rung.Index)"
                            aria-pressed="@Aria.Flag(_rarities.Contains(rung.Index))"
                            title="@rung.Symbol">
                        <span class="glyphs @rung.GlyphClass" aria-hidden="true">@rung.Glyphs</span>
                        <span class="visually-hidden">@rung.Symbol</span>
                    </button>
                }
                </div>
            </div>

            <span class="bar-sep" aria-hidden="true"></span>

            @* Type needs the printed card detail, which downloads after the card list does, so the
               control says so rather than quietly returning nothing. Ten energies and four trainer
               kinds: too many for a dropdown to be worth reading, and each has a pip already. *@
            <div class="chip-group">
                <span class="ttl" id="type-chips-label">type</span>
                <div class="chip-toolbar" role="group" aria-labelledby="type-chips-label">
                @foreach (var type in FilterTypes)
                {
                    <button class="chip-tog @(_types.Contains(type) ? "on" : "")"
                            @onclick="() => ToggleType(type)"
                            aria-pressed="@Aria.Flag(_types.Contains(type))"
                            disabled="@(!Session.FactsReady)"
                            title="@(Session.FactsReady ? type : $"{type} — still loading card detail")">
                        <EnergyPip Type="@type" />
                        <span class="visually-hidden">@type</span>
                    </button>
                }
                </div>
            </div>

            @* No pack filter for promo sets: their "Vol. N" groupings record how a promo was given
               away rather than packs you can open. *@
            @* The boosters themselves rather than their names in a dropdown. A set has two or
               three packs and you recognise them by the art on the wrapper -- it is what the game
               shows you when you choose one -- so a row of wrappers is both faster to read and
               fewer taps than opening a select. The name stays under each one: the art alone is
               not a label, and a pack whose art has not been published yet would otherwise be a
               blank button.

               One at a time, not several. A card lists the packs it comes from, so "cards in
               either of these two packs" is nearly the whole set and answers nothing; the question
               this filter exists for is "what is still missing from the pack I am about to open".
               Tapping the chosen pack again clears it. *@
            @if (!ViewingAll && !CardIndex.IsPromoSet(_set))
            {
                <span class="bar-sep" aria-hidden="true"></span>
                <div class="chip-group">
                    <span class="ttl" id="pack-picks-label">pack</span>
                    <div class="pack-picks" role="group" aria-labelledby="pack-picks-label">
                    @foreach (var p in PacksInSet)
                    {
                        <button class="pack-pick @(_pack == p ? "on" : "")"
                                @onclick="() => TogglePack(p)" aria-pressed="@Aria.Flag(_pack == p)"
                                title="@(_pack == p ? $"Show every pack in {_set} again" : $"Only cards from {p}")">
                            <span class="pack-thumb" aria-hidden="true"
                                  style="background-image:url('@Session.PackArtUrl($"{_set}:{p}")')"></span>
                            <span class="nm">@p</span>
                        </button>
                    }
                    </div>
                </div>
            }

        </Filters>
        <ToolbarExtras>
            @* Columns only mean something in the grid layout. *@
            @* select-narrow: on a phone the panel gives a full row to anything that sets a filter
               and half a row to a single control, and this is one of the single controls. *@
            <select class="form-select form-select-sm select-narrow" style="max-width:6rem" aria-label="Columns in the grid" @onchange="OnColumns"
                    hidden="@Session.ListView">
                @foreach (var n in new[] { 3, 4, 5, 6, 8, 10 })
                {
                    <option value="@n" selected="@(n == Session.GridColumns)">@n cols</option>
                }
            </select>
            @* Both act on one set. Across every set they would be indiscriminate, and "erase
               everything" lives in Settings. *@
            @if (!ViewingAll)
            {
                <button class="btn btn-sm btn-outline-secondary" @onclick="MarkTargetOwned"
                        disabled="@Busy.IsBusy"
                        title="Mark every card this set's plan wants as owned">
                    fill target
                </button>
                <button class="btn btn-sm btn-outline-danger" @onclick="ClearSet"
                        disabled="@Busy.IsBusy" aria-live="polite"
                        title="Set every card in this set back to zero. Undo works.">
                    @(_confirmClear ? "clear — sure?" : "clear set")
                </button>
            }
        </ToolbarExtras>
    </CardGrid>
    </PageShell>
}

@code {
    /// <summary>Sentinels for the aggregate views. Not real set codes, so they cannot collide.</summary>
    private const string AllSets = "*";
    private const string SeriesAll = "*series";

    private string _set = "A1";
    private string _series = "A";
    private string _search = "";
    private string _own = "all";

    /// <summary>
    /// Art the CDN did not give us, reported by the grid. Said beside the total on the set bar,
    /// because it is what stops the total from being the number of cards you can actually see.
    /// </summary>
    private int _artFailed;

    /// <summary>The grid polls the image loader for this, so it arrives rather than being read.</summary>
    private void OnArtFailed(int failed) => _artFailed = failed;

    /// <summary>
    /// Rarity rungs to show. Empty means every rarity rather than none: a filter nobody has
    /// touched must not hide the page's contents, and "show me nothing" is not a view anyone wants.
    /// </summary>
    private readonly HashSet<int> _rarities = [];

    /// <summary>Card types to show, by the label the facts carry. Empty means every type.</summary>
    private readonly HashSet<string> _types = new(StringComparer.OrdinalIgnoreCase);

    private string _pack = "";

    private string[] _sets = [];

    private bool _showGaps;

    private void ShowGapFills()
    {
        _own = "gaps";
        // Across every set, or the filter would show only the fills that happen to live in the
        // tab you were on and look as though the rest had vanished.
        _series = AllSets;
        _set = AllSets;
    }

    /// <summary>What the collapsed picker says you are looking at.</summary>
    private string CurrentSetLabel => _set switch
    {
        AllSets => "every set",
        SeriesAll => $"all of series {_series}",
        _ => $"{_set} — {Session.Sets.DisplayName(_set)}",
    };

    private double CurrentProgress => _set switch
    {
        AllSets => ProgressOf(_allCards),
        SeriesAll => ProgressOf(SeriesCards),
        _ => Progress(_set),
    };

    private string RarityName(PocketCard card) =>
        Session.Index.Ladder.Rungs.FirstOrDefault(r => r.Codes.Contains(card.Rarity))?.Symbol
            ?? card.Rarity;

    /// <summary>
    /// Which set to open on, so a link can land on one. The command palette needs it, and it
    /// also makes a particular set shareable and bookmarkable — the tab bar alone cannot be
    /// linked to.
    /// </summary>
    [SupplyParameterFromQuery(Name = "set")] public string? SetParam { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnChanged;
        Busy.Changed += OnChanged;   // buttons disable while work is in flight
        await Session.InitAsync();
        if (Session.Ready)
        {
            _sets = Session.Index.BySet.Keys.OrderBy(SetOrder).ToArray();
            // An unknown set in the URL is ignored rather than shown as an empty tab: a stale
            // bookmark should land on something.
            // The newest set, not the first one printed. _sets is in release order, and opening on
            // A1 meant every visit started on the set you finished longest ago -- the packs you are
            // actually opening are for the set that just came out.
            //
            // Promo sets are skipped even though they sort last: they are not openable, so the
            // newest of them is never the set you are working through.
            _set = SetParam is { Length: > 0 } wanted && _sets.Contains(wanted)
                ? wanted
                : _sets.LastOrDefault(set => !CardIndex.IsPromoSet(set)) ?? _sets.LastOrDefault() ?? "A1";
            _series = Session.Sets.SeriesOf(_set);
            _allCards = Session.Index.All
                .DistinctBy(c => c.OwnershipKey)
                .OrderBy(Session.Sets.SortKey, StringComparer.Ordinal)
                .ToArray();
        }
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    /// <summary>
    /// The page is already mounted when a link changes only the query string, so the set has
    /// to follow the parameter here as well — otherwise jumping to a set from the palette
    /// while on this page would change the URL and nothing else.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (!Session.Ready || SetParam is not { Length: > 0 } wanted) return;
        if (wanted == _set || !_sets.Contains(wanted)) return;

        _set = wanted;
        _series = Session.Sets.SeriesOf(_set);
        _pack = "";
    }

    // Set ordering comes from the catalogue now, so the tabs, the card lists and the grid's own
    // "set" column all agree: release order within a series, promos last in theirs.
    private string SetOrder(string set) => Session.Sets.SortKey(set);

    private Task SelectSet(string set, string? series = null)
    {
        _confirmClear = false;
        if (series is not null) _series = series;
        return SelectSetCore(set);
    }

    private Task SelectSetCore(string set) =>
        // Switching sets re-filters and re-chunks up to a few hundred tiles, which is slow
        // enough on a phone to look like a stall without a hint that work is happening.
        Busy.RunAsync($"Loading {Label(set)}\u2026", () => { _set = set; _pack = ""; });

    private string Label(string set) => set switch
    {
        AllSets => "all cards",
        SeriesAll => $"series {_series}",
        _ => set
    };

    private static string Text(ChangeEventArgs e) => e.Value?.ToString() ?? "";

    private Task OnSeries(ChangeEventArgs e)
    {
        var chosen = Text(e);
        // Land on the aggregate view for the chosen scope rather than an arbitrary set, so
        // switching series never silently shows a set you did not ask for.
        return SelectSet(chosen == AllSets ? AllSets : SeriesAll, chosen);
    }

    private void OnSearch(ChangeEventArgs e) => _search = Text(e);
    private void OnOwnFilter(ChangeEventArgs e) => SetOwnFilter(Text(e) is { Length: > 0 } v ? v : "all");

    private void ToggleRarity(int rung)
    {
        if (!_rarities.Remove(rung)) _rarities.Add(rung);
    }

    private void ToggleType(string type)
    {
        if (!_types.Remove(type)) _types.Add(type);
    }

    private void TogglePack(string pack) => _pack = _pack == pack ? "" : pack;

    /// <summary>
    /// The hearts read and write one list of their own — see <see cref="AppSession.WantList"/>.
    /// The page holds no state for it: which list a heart fills is a property of the collection,
    /// not of this visit to this page.
    /// </summary>
    private int WantedOf(PocketCard card) => Session.WantedOnHeartList(card.OwnershipKey);

    private void ToggleWant(PocketCard card) => Session.ToggleWanted(card.OwnershipKey);


    // One per chip on the toolbar. Parameterless because a Razor event handler cannot carry a
    // quoted string literal without escaping that the compiler then reads as an indexer.
    private void ClearSearch() => _search = "";
    private void ClearOwnFilter() => _own = "all";
    private void ClearRarityFilter() => _rarities.Clear();
    private void ClearTypeFilter() => _types.Clear();
    private void ClearPackFilter() => _pack = "";
    private void SetOwnFilter(string v) => _own = v;

    /// <summary>
    /// What the sticky strip calls the set a card belongs to, in the same words as the set picker's
    /// summary: the code is what the tabs are labelled with, the name is what anyone would call it.
    /// </summary>
    private string GroupLabel(PocketCard card) => $"{card.Set} — {Session.Sets.DisplayName(card.Set)}";

    /// <summary>
    /// The set's own expansion logo, which is what the strip shows beside its name — and what the
    /// log screen has always used for the same job. Published for every set at one size, so this
    /// is a string build rather than a lookup; a set whose logo is missing upstream degrades to a
    /// blank slot rather than a broken image, since a background-image fails silently.
    /// </summary>
    private static string GroupArt(PocketCard card) => PocketCard.SetLogoUrl(card.Set);

    /// <summary>The wording the ownership dropdown uses, so a chip and its control agree.</summary>
    private string OwnFilterLabel => _own switch
    {
        "missing" => "missing only",
        "owned"   => "owned only",
        "dupes"   => "duplicates",
        "needed"  => "short of target",
        "gaps"    => "fills an evolution gap",
        _         => _own,
    };

    /// <summary>The rarity's own symbol rather than its ladder index, which means nothing on a chip.</summary>
    /// <summary>
    /// One rarity is named; several are counted. Four symbols side by side on the bar would be
    /// wider than the count beside them and would read as the rarities themselves rather than as
    /// a filter, and the chips that set them are one disclosure away.
    /// </summary>
    private string RarityFilterLabel =>
        _rarities.Count == 1
        && Session.Index.Ladder.Rungs.FirstOrDefault(r => r.Index == _rarities.First()) is { } rung
            ? rung.Symbol
            : $"{_rarities.Count} rarities";

    private string TypeFilterLabel =>
        _types.Count == 1 ? _types.First() : $"{_types.Count} types";

    /// <summary>
    /// The types worth offering, in the game's own order: the ten energies, then the trainer
    /// kinds. Fixed rather than derived from the loaded cards, so the row does not reshuffle as
    /// card detail arrives, and it matches the pips the list view draws.
    /// </summary>
    private static readonly string[] FilterTypes =
    [
        "Grass", "Fire", "Water", "Lightning", "Psychic", "Fighting", "Darkness", "Metal",
        "Dragon", "Colorless", "Item", "Supporter", "Tool", "Stadium"
    ];
    private void OnColumns(ChangeEventArgs e)
    {
        if (int.TryParse(Text(e), out var n)) Session.SetGridColumns(n);
    }

    /// <summary>True for either aggregate view, where per-set actions do not apply.</summary>
    private bool ViewingAll => _set is AllSets or SeriesAll;

    private IReadOnlyList<PocketCard> InSet => _set switch
    {
        // De-duplicated by ownable card: a reprint is ONE card you either own or do not, so
        // listing it once per set would double-count it and make progress misleading.
        AllSets => _allCards,
        SeriesAll => SeriesCards,
        _ => Session.Index.BySet.TryGetValue(_set, out var c) ? c : []
    };

    private IReadOnlyList<PocketCard> _allCards = [];

    /// <summary>
    /// Every card in the series, in set order then number: A1-1 … A4b-379, then the series' promo
    /// set. Sorted by the catalogue's key rather than by set code, which put A10 before A2 and had
    /// no opinion about where promos belong.
    /// </summary>
    private IReadOnlyList<PocketCard> SeriesCards
    {
        get
        {
            // Cached per series. It was rebuilt on every access — a SelectMany, a DistinctBy and
            // a sort of ~1,900 cards — and InSet is read several times per render.
            if (_seriesCardsFor == _series) return _seriesCards;

            _seriesCardsFor = _series;
            return _seriesCards = Session.Sets.SetsIn(_series)
                .SelectMany(s => Session.Index.BySet.TryGetValue(s, out var c) ? c : [])
                .DistinctBy(c => c.OwnershipKey)
                .OrderBy(Session.Sets.SortKey, StringComparer.Ordinal)
                .ToArray();
        }
    }

    private IReadOnlyList<PocketCard> _seriesCards = [];
    private string _seriesCardsFor = "\u0000";

    private double ProgressOf(IReadOnlyList<PocketCard> cards) =>
        cards.Count == 0 ? 0 : (double)cards.Count(c => Session.CountOf(c) > 0) / cards.Count;

    /// <summary>
    /// A wrapper to stand for a set on its tab: the first pack's art. A set with several packs gets
    /// the first rather than all of them -- the tab is a few characters wide and the point is
    /// recognition, not a contents list -- and a set with none gets an empty string, which the
    /// markup reads as "draw no thumbnail".
    ///
    /// The catalogue is asked directly rather than through Session.PackArtUrl, which never returns
    /// nothing: where the catalogue has no mapping it guesses a URL from the pack's NAME. That
    /// guess is right for a real booster and wrong for a promo set, whose "packs" are the Vol. 1,
    /// Vol. 2 groupings recording how a promo was given away -- so every promo tab drew a
    /// background-image that 404s, which is a blank grey box rather than no box. Here a missing
    /// mapping has to mean no picture; the guess is still worth making everywhere a pack is named
    /// by itself.
    /// </summary>
    private string SetArtUrl(string set) =>
        Session.Index.ByPack.Keys
            .Where(k => k.StartsWith($"{set}:", StringComparison.OrdinalIgnoreCase))
            .OrderBy(k => k, StringComparer.Ordinal)
            .Select(k => Session.PackArt.UrlFor(k))
            .FirstOrDefault(u => !string.IsNullOrEmpty(u)) ?? "";

    private IEnumerable<string> PacksInSet =>
        InSet.Where(c => c.IsPackObtainable).SelectMany(c => c.Packs!)
             .Distinct().OrderBy(p => p, StringComparer.Ordinal);

    /// <param name="Cards">Distinct ownable cards in scope.</param>
    /// <param name="Owned">How many of those you hold at least one of.</param>
    /// <param name="Copies">Total copies held, duplicates included.</param>
    private sealed record Counts(int Cards, int Owned, int Copies);

    private Counts _counts = new(0, 0, 0);
    private string _countsFor = "";

    /// <summary>
    /// The three figures in the header, computed in ONE pass and cached.
    ///
    /// They are read during render, and "all cards" is 3,500 entries — so a property per figure
    /// meant three de-duplicating scans on every keystroke in the search box. Recomputed only
    /// when the scope or the collection actually changes.
    /// </summary>
    private Counts Stats
    {
        get
        {
            var signature = $"{_set}|{_series}|{Session.CollectionRevision}";
            if (signature == _countsFor) return _counts;

            var cards = 0;
            var owned = 0;
            var copies = 0;

            // De-duplicated by ownership key: a card reprinted in a later set is one card you
            // own, so counting entries would inflate both the total and the copies.
            foreach (var card in InSet.DistinctBy(c => c.OwnershipKey))
            {
                cards++;
                var n = Session.CountOf(card);
                if (n <= 0) continue;

                owned++;
                copies += n;
            }

            _countsFor = signature;
            return _counts = new Counts(cards, owned, copies);
        }
    }

    private int TotalInSet => Stats.Cards;
    private int OwnedInSet => Stats.Owned;

    // Progress against the chosen rarities, which is usually the number that matters: "42 of
    // 120 owned" is discouraging if 900 of the set are rarities you never wanted.
    private IEnumerable<string> TargetSets => _set switch
    {
        AllSets => Session.Index.OpenableSets,
        SeriesAll => Session.Sets.SetsIn(_series).Where(s => !CardIndex.IsPromoSet(s)),
        _ => [_set]
    };

    // Both figures come from the target itself. Working them out here is what let them disagree
    // with every other screen: the foil setting was ignored, and across several sets the owned
    // count was measured against the default plan while the total used each set's own.
    private (int Wanted, int Satisfied) TargetStat => Session.TargetProgress(TargetSets);

    private int TargetTotal => TargetStat.Wanted;

    private int TargetOwned => TargetStat.Satisfied;

    private double Progress(string set)
    {
        if (!Session.Index.BySet.TryGetValue(set, out var cards)) return 0;
        var distinct = cards.DistinctBy(c => c.OwnershipKey).ToList();
        return distinct.Count == 0 ? 0 : (double)distinct.Count(c => Session.CountOf(c) > 0) / distinct.Count;
    }

    private IReadOnlyList<PocketCard> _filtered = [];
    private string _filteredFor = "\u0000";

    /// <summary>
    /// Cards to show, cached.
    ///
    /// This is read during render, and a tap re-renders the page — so before caching, every added
    /// copy re-filtered and re-sorted the whole set. The signature includes the collection only
    /// when the active filter actually depends on counts: with "all cards" showing, owning one
    /// more of something cannot change WHICH cards are listed, just the number on one tile.
    /// </summary>
    private IReadOnlyList<PocketCard> Filtered
    {
        get
        {
            var countsMatter = _own is "missing" or "owned" or "dupes" or "needed" or "gaps";
            // Ordered, because a set's enumeration order is not part of its contract and an
            // unstable signature would rebuild the list on every render.
            var rarities = string.Join('.', _rarities.OrderBy(i => i));
            var types = string.Join('.', _types.OrderBy(t => t, StringComparer.Ordinal));
            var signature = $"{_set}|{_series}|{_search}|{_own}|{rarities}|{types}|{_pack}|" +
                            // The type of a card comes from the printed detail, which downloads
                            // after the card list. Without this the list built while it was still
                            // arriving would be cached and never rebuilt.
                            (_types.Count > 0 ? $"f{Session.FactsReady}|" : "") +
                            (countsMatter ? $"{Session.CollectionRevision}|{PlanSignature()}" : "");

            if (signature == _filteredFor) return _filtered;

            _filteredFor = signature;
            return _filtered = Build();
        }
    }

    /// <summary>
    /// Everything the "short of target" filter reads, as text, so the cached list is dropped when
    /// any of it changes.
    ///
    /// Per-SET plans, not just the visible one: in the all-sets view the filter now honours each
    /// set's own override, so a signature built from one plan would leave a stale list on screen
    /// after another set's plan changed. The foil count is in here for the same reason.
    /// </summary>
    private string PlanSignature()
    {
        var plans = TargetSets.Select(set =>
            set + ":" + string.Join('.', Session.Plan(set).CopiesByTier
                .OrderBy(kv => kv.Key).Select(kv => $"{kv.Key}={kv.Value}")));

        return string.Join('|', plans) + $"|foil{Session.FoilCopies}";
    }

    private IReadOnlyList<PocketCard> Build()
    {
            var q = InSet.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_search))
                q = q.Where(c => c.Name.Contains(_search, StringComparison.OrdinalIgnoreCase));

            if (_rarities.Count > 0)
                q = q.Where(c => Session.Index.Ladder.IndexOf(c.Rarity) is { } tier
                                 && _rarities.Contains(tier));

            if (_types.Count > 0)
                q = q.Where(c => _types.Contains(Session.TypeLabel(c)));

            if (!string.IsNullOrEmpty(_pack))
                q = q.Where(c => c.Packs is not null && c.Packs.Contains(_pack));

            q = _own switch
            {
                "missing" => q.Where(c => Session.CountOf(c) == 0),
                "owned" => q.Where(c => Session.CountOf(c) > 0),
                "dupes" => q.Where(c => Session.CountOf(c) > 1),
                // Every printing that would close a chain, not only the easiest one: any of them
                // works, and someone about to open a particular pack wants to know which of ITS
                // cards would do.
                "gaps" => q.Where(c => Session.GapFillKeys.Contains(c.OwnershipKey)),
                // "Short of target" must respect WHICH rarities are wanted, not just the copy
                // count — otherwise a rarity you deliberately ignore still shows as outstanding
                // work. Asked of the target, so a parallel foil nobody wants is not listed as
                // missing and a per-set override is honoured even in the all-sets view.
                "needed" => q.Where(c =>
                {
                    var required = Session.RequiredCopies(c);
                    return required > 0 && Session.CountOf(c) < required;
                }),
                _ => q
            };

            // Set THEN number. Ordering by number alone was the whole bug: it discarded the set
            // ordering the lists were built with, so "All A" came out A1-1, A2-1, A3-1. Within a
            // single set the two are identical, which is why it went unnoticed.
            return q.OrderBy(Session.Sets.SortKey, StringComparer.Ordinal).ToArray();
    }

    private void OnAdjust((PocketCard Card, int Delta) e) =>
        Session.Adjust([e.Card.OwnershipKey], e.Delta);

    /// <summary>
    /// A typed count. Its own undo step per row, deliberately: entering a collection is a long
    /// session of individual corrections, and collapsing them would make one mistyped row
    /// unrecoverable without discarding the rest.
    /// </summary>
    private void OnSet((PocketCard Card, int Count) e) => Session.SetCount(e.Card, e.Count);

    // One undo step for the whole sweep, which is the point of doing it in one call.
    private void OnSweep((IReadOnlyList<PocketCard> Cards, int Delta) e) =>
        Session.Adjust(e.Cards.Select(c => c.OwnershipKey), e.Delta);

    private Task MarkTargetOwned()
    {
        _confirmClear = false;
        return Busy.RunAsync($"Filling {_set}\u2026", FillTarget);
    }

    private bool _confirmClear;

    /// <summary>
    /// The inverse of "fill target". Two-step because it can wipe hundreds of entries — and
    /// even though undo covers it, an accidental wipe is alarming enough to be worth a pause.
    /// </summary>
    private Task ClearSet()
    {
        if (!_confirmClear) { _confirmClear = true; return Task.CompletedTask; }
        _confirmClear = false;

        return Busy.RunAsync($"Clearing {_set}\u2026", () =>
        {
            var keys = InSet.Select(c => c.OwnershipKey).Distinct().ToArray();
            Session.Mutate(p =>
            {
                var next = new Dictionary<string, int>(p.Collection);
                foreach (var key in keys) next.Remove(key);
                return p with { Collection = next };
            });
        });
    }

    private void FillTarget()
    {
        var target = Session.TargetForSet(_set);
        var outstanding = target.Outstanding(Session.Index, Session.Owned);
        if (outstanding.Count == 0) return;

        Session.Mutate(p =>
        {
            var next = new Dictionary<string, int>(p.Collection);
            foreach (var d in outstanding)
                next[d.Key] = (next.TryGetValue(d.Key, out var c) ? c : 0) + d.Remaining;
            return p with { Collection = next };
        });
    }

    private RarityRung? RungOf(PocketCard card)
    {
        var i = Session.Index.Ladder.IndexOf(card.Rarity);
        return i is null ? null : Session.Index.Ladder.Rungs[i.Value];
    }

    public void Dispose()
    {
        Session.Changed -= OnChanged;
        Busy.Changed -= OnChanged;
    }
}
