@implements IDisposable
@inject UiBusy Busy

@* Blocks pointer events while visible. On a single-threaded runtime a second click during a slow
   recompute queues more work and makes the stall longer, so the overlay both explains the wait and
   stops it being compounded. *@
@if (Busy.IsBusy)
{
    <div class="busy-veil" aria-live="polite" aria-busy="true">
        <div class="busy-card">
            <span class="busy-spinner" aria-hidden="true"></span>
            <span>@Busy.Label</span>
        </div>
    </div>
}

@code {
    protected override void OnInitialized() => Busy.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Busy.Changed -= OnChanged;
}
