@* One chip per rarity rung, carrying its own copy count. Selection and quantity are the same fact
   — a rarity you want zero of is one you ignore — so a single control says both, and "two of each
   diamond, one of the stars" is a few taps. Tap to cycle none / 1 / 2.

   Shared by the Packs page and Settings rather than written twice. The plan drives every estimate
   in the app, so two implementations could disagree about what a tap means. *@

@inject AppSession Session

@foreach (var rung in Session.Index.Ladder.Rungs)
{
    var want = Plan.Copies(rung.Index);
    <button class="rarity-chip @(want > 0 ? "on" : "")"
            aria-pressed="@Aria.Flag(want > 0)"
            @onclick="() => OnCycle.InvokeAsync(rung.Index)">
        <span class="glyphs @rung.GlyphClass">@rung.Symbol</span>@(want > 1 ? $" x{want}" : "")
    </button>
}

@* A different axis from rarity, so it sits apart from the rungs rather than in the row as if it
   were one. Only shown where foils exist at all: Deluxe sets are the only ones whose rates name
   foil slot codes. *@
@if (ShowFoils)
{
    <span class="bar-sep" aria-hidden="true"></span>
    @* Cycles like a rarity chip but carries its own count rather than inheriting a rung's: a
       parallel foil is a separate printing, so wanting two of every diamond says nothing about how
       many foils you want. *@
    <button class="rarity-chip @(Session.FoilCopies > 0 ? "on" : "")"
            aria-pressed="@Aria.Flag(Session.FoilCopies > 0)"
            @onclick="() => OnCycleFoils.InvokeAsync()">
        @* A mark of its own, like every rung has. The word alone was the only chip in the row
           with nothing to scan for, and it is the longest label of the eleven. *@
        <span class="glyphs foil">@RarityLadder.FoilMark</span>
        Parallel Foils@(Session.FoilCopies > 1 ? $" x{Session.FoilCopies}" : "")
    </button>
}

@code {
    /// <summary>
    /// The plan being edited. A draft on the Packs page, the saved plan on Settings — this
    /// component does not know or care which, it only reports taps.
    /// </summary>
    [Parameter, EditorRequired] public RarityPlan Plan { get; set; } = default!;

    /// <summary>Called with the rung that was tapped. The caller decides what a cycle does.</summary>
    [Parameter] public EventCallback<int> OnCycle { get; set; }

    [Parameter] public bool ShowFoils { get; set; }

    [Parameter] public EventCallback OnCycleFoils { get; set; }
}
